#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}
ssh_pwauth: false
%{ if daemon_json != "" || disable_auto_updates ~}
write_files:
%{ if daemon_json != "" ~}
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: '${daemon_json}'
%{ endif ~}
%{ if disable_auto_updates ~}
  - path: /etc/apt/apt.conf.d/99-skstacks-no-periodic
    permissions: "0644"
    content: |
      APT::Periodic::Enable "0";
      APT::Periodic::Update-Package-Lists "0";
      APT::Periodic::Unattended-Upgrade "0";
      APT::Periodic::Download-Upgradeable-Packages "0";
      APT::Periodic::AutocleanInterval "0";
  - path: /etc/apt/apt.conf.d/99-skstacks-no-auto-reboot
    permissions: "0644"
    content: |
      Unattended-Upgrade::Automatic-Reboot "false";
  - path: /etc/needrestart/conf.d/99-skstacks-no-auto-restart.conf
    permissions: "0644"
    content: |
      $nrconf{restart} = 'l';
  - path: /etc/default/motd-news
    permissions: "0644"
    content: |
      ENABLED=0
%{ endif ~}
%{ endif ~}
package_update: true
packages:
  - linux-generic-hwe-24.04
  - qemu-guest-agent
  - python3-docker
  - ca-certificates
  - curl
runcmd:
%{ if disable_auto_updates ~}
  # Neutralize background update/reboot paths first: runcmd (config stage)
  # always finishes before the packages list above installs the HWE kernel
  # (final stage), so this can't race that install or reboot the VM out
  # from under a short-lived test cluster.
  - systemctl disable --now apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service unattended-upgrades.service || true
  - systemctl mask apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service unattended-upgrades.service || true
  - systemctl disable --now motd-news.timer || true
  - systemctl mask motd-news.timer || true
  - sh -c 'command -v snap >/dev/null 2>&1 && snap refresh --hold=skstacks-ephemeral || true'
%{ endif ~}
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - sh -c 'echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list'
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
  - usermod -aG docker ${admin_user}
  - systemctl enable docker qemu-guest-agent
%{ if k3d ~}
  - curl -fsSL https://github.com/k3d-io/k3d/releases/download/v5.8.3/k3d-linux-amd64 -o /usr/local/bin/k3d
  - curl -fsSL https://dl.k8s.io/release/v1.31.5/bin/linux/amd64/kubectl -o /usr/local/bin/kubectl
  - chmod 0755 /usr/local/bin/k3d /usr/local/bin/kubectl
%{ endif ~}
# Reboot once so the HWE kernel is the running kernel before anything deploys.
power_state:
  mode: reboot
  condition: true
