#!/bin/bash
# =============================================================================
# SKGallery (Immich) Deployment Script
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKGallery (Immich Photo/Video Management)
# Environment: {{ env }}
# =============================================================================
set -e

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
APPNAME=skgallery
STACK_NAME=skgallery-{{ env }}

CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skgallery.yml"

# ---------------------------------------------------------------------------
# Colors for Output
# ---------------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ---------------------------------------------------------------------------
# Banner
# ---------------------------------------------------------------------------
echo -e "${CYAN}"
echo "SKGallery (Immich) Deployment - Photo & Video Management"
echo "Environment: {{ env | upper }}"
echo -e "${NC}"

# ---------------------------------------------------------------------------
# Source Environment Variables
# ---------------------------------------------------------------------------
if [ -f "${CONFIG_DIR}/${APPNAME}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    export $(cat ${CONFIG_DIR}/${APPNAME}.sh.env | grep -v '^#' | xargs)
fi

# ---------------------------------------------------------------------------
# Pre-deployment Checks
# ---------------------------------------------------------------------------
echo -e "${YELLOW}Running pre-deployment checks...${NC}"

# Check if compose file exists
if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# Check Docker availability
if ! docker info > /dev/null 2>&1; then
    echo -e "${RED}Error: Docker is not running or accessible${NC}"
    exit 1
fi

# Check Swarm mode
if ! docker node ls > /dev/null 2>&1; then
    echo -e "${RED}Error: This node is not part of a Docker Swarm${NC}"
    exit 1
fi

echo -e "${GREEN}Pre-deployment checks passed${NC}"

# ---------------------------------------------------------------------------
# Deploy Stack
# ---------------------------------------------------------------------------
echo -e "${YELLOW}Deploying ${STACK_NAME} stack...${NC}"
cd "${CONFIG_DIR}"
docker stack deploy -c "${COMPOSE_FILE}" "${STACK_NAME}"

# ---------------------------------------------------------------------------
# Wait for Services to Register
# ---------------------------------------------------------------------------
echo -e "${YELLOW}Waiting for services to register...${NC}"
sleep 10

# ---------------------------------------------------------------------------
# Force Update Services (Pull Latest Images)
# ---------------------------------------------------------------------------
echo -e "${YELLOW}Updating services...${NC}"

# Update each service with proper handling
for SERVICE in immich-server immich-machine-learning redis database; do
    SERVICE_FULL="${STACK_NAME}_${SERVICE}"
    if docker service ls --format "{{ '{{' }}.Name{{ '}}' }}" | grep -q "^${SERVICE_FULL}$"; then
        echo -e "${BLUE}  -> Updating ${SERVICE}...${NC}"
        docker service update --force --detach=false ${SERVICE_FULL} 2>/dev/null || true
    fi
done

# ---------------------------------------------------------------------------
# Wait for Services to Stabilize
# ---------------------------------------------------------------------------
echo -e "${YELLOW}Waiting for services to stabilize...${NC}"
sleep 15

# ---------------------------------------------------------------------------
# Service Status Check
# ---------------------------------------------------------------------------
echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}" | while read line; do
    echo -e "  ${line}"
done

# ---------------------------------------------------------------------------
# Health Check
# ---------------------------------------------------------------------------
echo -e "${YELLOW}Checking service health...${NC}"

check_service_health() {
    local SERVICE=$1
    local EXPECTED=$2
    local SERVICE_FULL="${STACK_NAME}_${SERVICE}"

    for _ in $(seq 1 36); do
        REPLICAS=$(docker service ls --filter "name=${SERVICE_FULL}" --format "{{ '{{' }}.Replicas{{ '}}' }}" 2>/dev/null || echo "0/0")
        [[ "$REPLICAS" == "${EXPECTED}/${EXPECTED}" ]] && break
        sleep 5
    done
    if [[ "$REPLICAS" == "${EXPECTED}/${EXPECTED}" ]]; then
        echo -e "${GREEN}  OK ${SERVICE}: ${REPLICAS}${NC}"
        return 0
    else
        echo -e "${YELLOW}  WARN ${SERVICE}: ${REPLICAS} (expected ${EXPECTED}/${EXPECTED})${NC}"
        return 1
    fi
}

ALL_HEALTHY=true
check_service_health "immich-server" "{{ skgallery.SERVER_REPLICAS | default(1) }}" || ALL_HEALTHY=false
check_service_health "immich-machine-learning" "{{ skgallery.ML_REPLICAS | default(1) }}" || ALL_HEALTHY=false
check_service_health "redis" "1" || ALL_HEALTHY=false
check_service_health "database" "1" || ALL_HEALTHY=false

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo ""
if [ "$ALL_HEALTHY" = true ]; then
    echo -e "${GREEN}Deployment successful.${NC}"
    echo -e "${GREEN}Access SKGallery at: https://skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skgallery.CLUSTERNAME | default(cluster_name) }}.{{ skgallery.DOMAIN | default(domain) }}${NC}"
else
    echo -e "${YELLOW}Deployment complete with warnings. Some services may still be starting up.${NC}"
    echo -e "${YELLOW}Monitor with: docker service ls | grep ${STACK_NAME}${NC}"

    echo -e "\n${YELLOW}Recent logs for services with issues:${NC}"
    for SERVICE in immich-server immich-machine-learning redis database; do
        SERVICE_FULL="${STACK_NAME}_${SERVICE}"
        REPLICAS=$(docker service ls --filter "name=${SERVICE_FULL}" --format "{{ '{{' }}.Replicas{{ '}}' }}" 2>/dev/null || echo "0/0")
        if [[ ! "$REPLICAS" =~ ^[0-9]+/[0-9]+$ ]] || [[ "${REPLICAS%/*}" != "${REPLICAS#*/}" ]]; then
            echo -e "\n${RED}=== ${SERVICE} logs ===${NC}"
            docker service logs --tail 10 ${SERVICE_FULL} 2>/dev/null || echo "No logs available"
        fi
    done
fi

# ---------------------------------------------------------------------------
# Post-Deployment Information
# ---------------------------------------------------------------------------
echo ""
echo -e "${CYAN}Useful Commands:${NC}"
echo -e "  ${BLUE}View logs:${NC}     docker service logs -f ${STACK_NAME}_immich-server"
echo -e "  ${BLUE}Check status:${NC}  docker service ls | grep ${STACK_NAME}"
echo -e "  ${BLUE}Scale ML:${NC}      docker service scale ${STACK_NAME}_immich-machine-learning=2"
echo -e "  ${BLUE}Redeploy:${NC}      /var/data/${STACK_NAME}/deploy"
echo ""
