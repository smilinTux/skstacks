# PostgreSQL Backup Configuration for skgallery
# Generated from vault variables

PGHOST=database
PGUSER={{ skgallery.DB_USERNAME | default('postgres') }}
PGPASSWORD={{ skgallery.DB_PASSWORD }}
PGDATABASE={{ skgallery.DB_DATABASE_NAME | default('immich') }}
# Days of dumps kept (pruned only after a good dump). BACKUP_NUM_KEEP is the
# older name, still honoured (one dump a day = one per day kept).
BACKUP_KEEP_DAYS={{ skgallery.BACKUP_KEEP_DAYS | default(skgallery.BACKUP_NUM_KEEP | default('7')) }}
BACKUP_FREQUENCY={{ skgallery.BACKUP_FREQUENCY | default('86400') }}
