# =============================================================================
# SKGallery PostgreSQL Environment Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: PostgreSQL with pgvecto.rs + vectorchord extensions for Immich
# Image: ghcr.io/immich-app/postgres (strategic)
# Environment: {{ env }}
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL Configuration
# ---------------------------------------------------------------------------
# REQUIRED: Database password (must be set in vault)
POSTGRES_PASSWORD={{ skgallery.DB_PASSWORD }}

# OPTIONAL: Database user (defaults to 'postgres')
POSTGRES_USER={{ skgallery.DB_USERNAME | default('postgres') }}

# OPTIONAL: Database name (defaults to 'immich')
POSTGRES_DB={{ skgallery.DB_DATABASE_NAME | default('immich') }}

# ---------------------------------------------------------------------------
# PostgreSQL Initialization
# ---------------------------------------------------------------------------
# Matches upstream Immich docker-compose default. --data-checksums protects
# against silent on-disk corruption (set only at initdb, cannot be added
# later without re-init).
POSTGRES_INITDB_ARGS={{ skgallery.POSTGRES_INITDB_ARGS | default('--data-checksums') }}

# ---------------------------------------------------------------------------
# Vector Extension Configuration
# ---------------------------------------------------------------------------
# The ghcr.io/immich-app/postgres image bundles both pgvecto.rs and
# vectorchord. The active extension is selected by DB_VECTOR_EXTENSION
# in skgallery.env (defaults to 'vectorchord').

# ---------------------------------------------------------------------------
# Performance Tuning (Optional)
# ---------------------------------------------------------------------------
{% if skgallery.POSTGRES_SHARED_BUFFERS is defined %}
# OPTIONAL: Shared buffer size (recommended: 25% of available RAM)
POSTGRES_SHARED_BUFFERS={{ skgallery.POSTGRES_SHARED_BUFFERS }}
{% endif %}

{% if skgallery.POSTGRES_EFFECTIVE_CACHE_SIZE is defined %}
# OPTIONAL: Effective cache size (recommended: 75% of available RAM)
POSTGRES_EFFECTIVE_CACHE_SIZE={{ skgallery.POSTGRES_EFFECTIVE_CACHE_SIZE }}
{% endif %}

{% if skgallery.POSTGRES_WORK_MEM is defined %}
# OPTIONAL: Work memory per operation
POSTGRES_WORK_MEM={{ skgallery.POSTGRES_WORK_MEM }}
{% endif %}

{% if skgallery.POSTGRES_MAINTENANCE_WORK_MEM is defined %}
# OPTIONAL: Maintenance work memory (for VACUUM, CREATE INDEX, etc.)
POSTGRES_MAINTENANCE_WORK_MEM={{ skgallery.POSTGRES_MAINTENANCE_WORK_MEM }}
{% endif %}
