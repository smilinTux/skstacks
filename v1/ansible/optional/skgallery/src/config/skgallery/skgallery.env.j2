# =============================================================================
# SKGallery (Immich) Environment Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKGallery (Immich Photo/Video Management)
# Environment: {{ env }}
# =============================================================================

# ---------------------------------------------------------------------------
# Database Configuration (Immich postgres image: pgvecto.rs + vectorchord)
# ---------------------------------------------------------------------------
# REQUIRED: DB_PASSWORD must be set in vault
DB_HOSTNAME=database
DB_PORT={{ skgallery.DB_PORT | default('5432') }}
DB_USERNAME={{ skgallery.DB_USERNAME | default('postgres') }}
DB_PASSWORD={{ skgallery.DB_PASSWORD }}
DB_DATABASE_NAME={{ skgallery.DB_DATABASE_NAME | default('immich') }}

# Full connection URL (auto-generated from above)
DB_URL=postgresql://{{ skgallery.DB_USERNAME | default('postgres') }}:{{ skgallery.DB_PASSWORD }}@database:{{ skgallery.DB_PORT | default('5432') }}/{{ skgallery.DB_DATABASE_NAME | default('immich') }}

# PGPASSWORD is required for Immich's internal backup service (pg_dumpall)
# This allows the backup service to authenticate when creating database dumps
PGPASSWORD={{ skgallery.DB_PASSWORD }}

# Vector extension - 'vectorchord' is the strategic default for Immich v1.132+.
# The Immich postgres image ships both extensions so legacy installs migrating
# from pgvecto.rs can do so in-place; the server auto-detects and re-encodes
# vector data on first start.
DB_VECTOR_EXTENSION={{ skgallery.DB_VECTOR_EXTENSION | default('vectorchord') }}

# ---------------------------------------------------------------------------
# Redis Configuration
# ---------------------------------------------------------------------------
REDIS_HOSTNAME=redis
REDIS_PORT={{ skgallery.REDIS_PORT | default('6379') }}
REDIS_DBINDEX={{ skgallery.REDIS_DBINDEX | default('0') }}
{% if skgallery.REDIS_PASSWORD is defined and skgallery.REDIS_PASSWORD %}
REDIS_PASSWORD={{ skgallery.REDIS_PASSWORD }}
{% endif %}

# ---------------------------------------------------------------------------
# Immich Server Configuration
# ---------------------------------------------------------------------------
# OPTIONAL: Immich version (defaults to pinned v2.7.5 for reproducible deploys)
IMMICH_VERSION={{ skgallery.IMMICH_VERSION | default('v2.7.5') }}

# OPTIONAL: Server host and port
IMMICH_SERVER_URL=http://immich-server:2283
IMMICH_API_URL_EXTERNAL={{ skgallery.IMMICH_API_URL_EXTERNAL | default('https://skgallery' + ('-' + env if env != 'prod' else '') + '.' + skgallery.CLUSTERNAME + '.' + skgallery.DOMAIN) }}

# ---------------------------------------------------------------------------
# Upload and Storage Configuration
# ---------------------------------------------------------------------------
# OPTIONAL: Upload location (mounted volume)
UPLOAD_LOCATION=/usr/src/app/upload

# OPTIONAL: Thumbnail settings
IMMICH_MEDIA_LOCATION=/usr/src/app/upload

# ---------------------------------------------------------------------------
# Backup Configuration
# ---------------------------------------------------------------------------
# Immich has an automatic database dump feature that stores backups in:
# UPLOAD_LOCATION/backups (which resolves to /usr/src/app/upload/backups)
#
# Default configuration:
# - Creates new dump daily at 2:00 AM
# - Keeps the last 14 database dumps
# - Schedule and retention can be configured in Admin Settings > Backup
#
# The backups directory will be automatically created in upload/backups
# You can also manually trigger a dump from Admin Settings > Jobs > Create Database Dump
#
# Reference: https://docs.immich.app/administration/backup-and-restore
# NOTE: These dumps contain only metadata, not photos/videos

# ---------------------------------------------------------------------------
# Machine Learning Configuration
# ---------------------------------------------------------------------------
# OPTIONAL: Machine learning server URL
IMMICH_MACHINE_LEARNING_URL=http://immich-machine-learning:3003

# OPTIONAL: Model cache settings
MACHINE_LEARNING_CACHE_FOLDER=/cache
TRANSFORMERS_CACHE=/cache

# OPTIONAL: Model time-to-live in seconds (how long to keep models loaded)
MACHINE_LEARNING_MODEL_TTL={{ skgallery.ML_MODEL_TTL | default('300') }}

# OPTIONAL: Preload models on startup for faster first inference
MACHINE_LEARNING_EAGER_WARMUP={{ skgallery.ML_EAGER_WARMUP | default('true') }}

# OPTIONAL: Face recognition model
MACHINE_LEARNING_FACIAL_RECOGNITION_MODEL={{ skgallery.ML_FACIAL_RECOGNITION_MODEL | default('buffalo_l') }}

# OPTIONAL: CLIP model for smart search
MACHINE_LEARNING_CLIP_MODEL={{ skgallery.ML_CLIP_MODEL | default('ViT-B-32__openai') }}

# ---------------------------------------------------------------------------
# Telemetry and Metrics
# ---------------------------------------------------------------------------
# OPTIONAL: Disable telemetry (default: true for privacy)
IMMICH_TELEMETRY_INCLUDE={{ skgallery.TELEMETRY_INCLUDE | default('all') }}

# OPTIONAL: Metrics endpoint (for Prometheus)
{% if skgallery.METRICS_ENABLED | default(false) | bool %}
IMMICH_METRICS=true
IMMICH_METRICS_PORT={{ skgallery.METRICS_PORT | default('8081') }}
{% endif %}

# ---------------------------------------------------------------------------
# Logging Configuration
# ---------------------------------------------------------------------------
# OPTIONAL: Log level (verbose, debug, log, warn, error)
LOG_LEVEL={{ skgallery.LOG_LEVEL | default('log') }}

# ---------------------------------------------------------------------------
# Timezone Configuration
# ---------------------------------------------------------------------------
TZ={{ skgallery.TZ | default('UTC') }}

# ---------------------------------------------------------------------------
# Worker Configuration
# ---------------------------------------------------------------------------
# OPTIONAL: Which workers to include (comma-separated)
# If not set, all workers run by default (recommended for full functionality)
# Common workers: api,thumbnail-generation,metadata-extraction,video-conversion,face-recognition,search-indexing
# NOTE: Setting this restricts which workers run. For thumbnail generation, either:
#   - Leave unset (all workers) - RECOMMENDED
#   - Or include 'thumbnail-generation' in the list
{% if skgallery.WORKERS_INCLUDE is defined and skgallery.WORKERS_INCLUDE %}
IMMICH_WORKERS_INCLUDE={{ skgallery.WORKERS_INCLUDE }}
{% endif %}

# ---------------------------------------------------------------------------
# External Library Configuration (Optional)
# ---------------------------------------------------------------------------
{% if skgallery.EXTERNAL_LIBRARY_PATH is defined and skgallery.EXTERNAL_LIBRARY_PATH %}
# OPTIONAL: Mount external photo libraries (read-only)
IMMICH_EXTERNAL_DOMAIN={{ skgallery.EXTERNAL_LIBRARY_PATH }}
{% endif %}

# ---------------------------------------------------------------------------
# OAuth/SSO Configuration (Optional)
# ---------------------------------------------------------------------------
{% if skgallery.OAUTH_ENABLED | default(false) | bool %}
# OPTIONAL: Enable OAuth authentication
OAUTH_ENABLED=true
OAUTH_ISSUER_URL={{ skgallery.OAUTH_ISSUER_URL }}
OAUTH_CLIENT_ID={{ skgallery.OAUTH_CLIENT_ID }}
OAUTH_CLIENT_SECRET={{ skgallery.OAUTH_CLIENT_SECRET }}
OAUTH_SCOPE={{ skgallery.OAUTH_SCOPE | default('openid email profile') }}
OAUTH_AUTO_REGISTER={{ skgallery.OAUTH_AUTO_REGISTER | default('true') }}
OAUTH_BUTTON_TEXT={{ skgallery.OAUTH_BUTTON_TEXT | default('Login with SSO') }}
{% endif %}

# ---------------------------------------------------------------------------
# SMTP Email Configuration (Optional)
# ---------------------------------------------------------------------------
{% if skgallery.SMTP_ENABLED | default(false) | bool %}
# OPTIONAL: Enable email notifications
SMTP_HOST={{ skgallery.SMTP_HOST }}
SMTP_PORT={{ skgallery.SMTP_PORT | default('587') }}
SMTP_USERNAME={{ skgallery.SMTP_USERNAME }}
SMTP_PASSWORD={{ skgallery.SMTP_PASSWORD }}
SMTP_FROM={{ skgallery.SMTP_FROM | default('skgallery@' + skgallery.DOMAIN) }}
SMTP_TRANSPORT={{ skgallery.SMTP_TRANSPORT | default('SMTP') }}
{% endif %}
