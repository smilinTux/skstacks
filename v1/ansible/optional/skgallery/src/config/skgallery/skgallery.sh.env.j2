# =============================================================================
# SKGallery (Immich) Shell Environment Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# This file is sourced by the deploy script for shell variable expansion
# Service: SKGallery (Immich Photo/Video Management)
# Environment: {{ env }}
# =============================================================================

# ---------------------------------------------------------------------------
# Stack Configuration
# ---------------------------------------------------------------------------
STACK_NAME=skgallery-{{ env }}
APP_NAME=skgallery
ENV={{ env }}

# ---------------------------------------------------------------------------
# Domain Configuration
# ---------------------------------------------------------------------------
CLUSTERNAME={{ skgallery.CLUSTERNAME | default(cluster_name) }}
DOMAIN={{ skgallery.DOMAIN | default(domain) }}

# ---------------------------------------------------------------------------
# Image Versions
# ---------------------------------------------------------------------------
IMMICH_VERSION={{ skgallery.IMMICH_VERSION | default('v2.7.5') }}
POSTGRES_VERSION={{ skgallery.POSTGRES_VERSION | default('14-vectorchord0.4.3-pgvectors0.2.0') }}
REDIS_VERSION={{ skgallery.REDIS_VERSION | default('7-alpine') }}

# ---------------------------------------------------------------------------
# Database Credentials (for shell scripts)
# ---------------------------------------------------------------------------
DB_USERNAME={{ skgallery.DB_USERNAME | default('postgres') }}
DB_PASSWORD={{ skgallery.DB_PASSWORD }}
DB_DATABASE_NAME={{ skgallery.DB_DATABASE_NAME | default('immich') }}

# ---------------------------------------------------------------------------
# Service URLs
# ---------------------------------------------------------------------------
SKGALLERY_URL=https://skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skgallery.CLUSTERNAME | default(cluster_name) }}.{{ skgallery.DOMAIN | default(domain) }}
