{%- set _base_domain = (skgallery.CLUSTERNAME | default(cluster_name)) ~ '.' ~ (skgallery.DOMAIN | default(domain)) -%}
{%- set _split = (skgallery.SPLIT_WORKERS | default(false) | string | lower) in ['true', 'yes', '1', 'on'] -%}
{%- set _lb_hc = (skgallery.TRAEFIK_HEALTHCHECK | default(true) | string | lower) not in ['false', 'no', '0', 'off'] -%}
{#- Postgres + redis on local disk on DATA_NODE (see the playbook guard): an NFS
    write stall on the shared /var/data froze the database and the job queue
    with it. Unset: the previous NFS paths, no node pin. -#}
{%- set _data_node = skgallery.DATA_NODE | default('', true) | string -%}
{%- set _db_path = skgallery.DB_DATA_PATH | default('/var/data/skgallery-' ~ env ~ '/db-data', true) | string -%}
{%- set _redis_path = skgallery.REDIS_DATA_PATH | default('/var/data/skgallery-' ~ env ~ '/redis-data', true) | string -%}
version: '3.8'

# =============================================================================
# SKGallery (Immich) Docker Swarm Stack
# =============================================================================
# Self-hosted photo and video management solution
# Components: immich-server, immich-machine-learning, postgres (pgvector), redis
# Environment: {{ env }}
# =============================================================================

networks:
  skgallery-{{ env }}:
    external: true
  cloud-public-{{ env }}:
    external: true

# No named volumes - all mounts are direct bind mounts
# Simpler, faster, zero-config

services:
  # ===========================================================================
  # Immich Server - Main API and Web Interface
  # ===========================================================================
  immich-server:
    image: ghcr.io/immich-app/immich-server:{{ skgallery.IMMICH_VERSION | default('v2.7.5') }}
    env_file: /var/data/config/skgallery-{{ env }}/skgallery.env
{% if _split %}
    # SPLIT_WORKERS: this service runs only the API (uploads, web, mobile).
    # Transcoding, thumbnails and the other jobs run in immich-microservices,
    # so a video encode can no longer starve uploads and the health check.
    environment:
      - IMMICH_WORKERS_INCLUDE=api
{% endif %}
    volumes:
      # === DIRECT BIND MOUNTS (NO NAMED VOLUMES) ===
      - /var/data/skgallery-{{ env }}/upload:/usr/src/app/upload
      - /var/data/skgallery-{{ env }}/thumbs:/usr/src/app/upload/thumbs
      - /var/data/skgallery-{{ env }}/profile:/usr/src/app/upload/profile
      # Note: Immich automatic database dumps are stored in UPLOAD_LOCATION/backups
      # which resolves to /usr/src/app/upload/backups (a subdirectory of upload)
      # No separate mount needed - backups will be created in upload/backups
      - /etc/localtime:/etc/localtime:ro
    logging:
      driver: json-file
      options:
        max-size: "{{ skgallery.LOG_MAX_SIZE | default('10m') }}"
        max-file: "{{ skgallery.LOG_MAX_FILES | default('5') }}"
    networks:
      - skgallery-{{ env }}
      - cloud-public-{{ env }}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:2283/api/server/ping || exit 1"]
      interval: {{ skgallery.HEALTH_CHECK_INTERVAL | default('30s') }}
      timeout: {{ skgallery.HEALTH_CHECK_TIMEOUT | default('10s') }}
      retries: {{ skgallery.HEALTH_CHECK_RETRIES | default(3) }}
      start_period: {{ skgallery.HEALTH_CHECK_START_PERIOD | default('60s') }}
    deploy:
      mode: replicated
      replicas: {{ skgallery.SERVER_REPLICAS | default(1) }}
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
        failure_action: rollback
      rollback_config:
        parallelism: 1
        delay: 10s
      restart_policy:
        condition: any
        delay: 10s
      placement:
        constraints:
          - node.role == worker
      resources:
        limits:
          cpus: '{{ skgallery.SERVER_CPU_LIMIT | default("2.0") }}'
          memory: {{ skgallery.SERVER_MEMORY_LIMIT | default("2G") }}
        reservations:
          cpus: '{{ skgallery.SERVER_CPU_RESERVATION | default("0.5") }}'
          memory: {{ skgallery.SERVER_MEMORY_RESERVATION | default("512M") }}
      labels:
        # === TRAEFIK: HTTP Configuration ===
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"

        # === TRAEFIK: Main Router ===
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.rule=Host(`skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}`)"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.entrypoints={{ skgallery.TRAEFIK_ENTRYPOINT | default('websecure') }}"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.tls=true"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.tls.certresolver={{ skgallery.TRAEFIK_CERTRESOLVER | default('main') }}"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.tls.options={{ skgallery.TRAEFIK_TLS_OPTIONS | default('intermediate@file') }}"
        # NOTE: middlewares default excludes gzip compression, which can cause
        # buffering issues (ECONNRESET) on large file uploads through the proxy.
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.middlewares={{ skgallery.TRAEFIK_MIDDLEWARES | default('upload-chain-no-crowdsec@file') }}"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.service=skgallery{% if env != 'prod' %}-{{ env }}{% endif %}"
{# === API ROUTER (raw upstream status codes) ===
    Immich's API (`/api/`, including `/api/socket.io` and the mobile app's
    uploads) and the `/.well-known/immich` discovery document.
    The main router's chain carries error-pages@file, which swaps every 4xx/5xx for an
    HTML page from the error-pages service and replays the ORIGINAL method there, so API
    clients never saw the app's real status or JSON error. This router sends the machine
    paths through the main chain with each error-pages-bearing chain swapped for its
    no-error-pages form (rate limit and security headers stay; the upload chains keep their
    buffering). skgallery.API_MIDDLEWARES replaces the derived chain. #}
{% set _api_swap = {'default@file': 'default-no-error-pages@file', 'default-no-crowdsec@file': 'default-no-error-pages@file', 'upload-chain@file': 'large-upload-buffering@file,default-security-headers@file', 'upload-chain-no-crowdsec@file': 'large-upload-buffering@file,default-security-headers@file', 'skai-chain@file': 'skai-headers@file,gzip@file', 'error-pages@file': '', 'error-pages-all@file': ''} %}
{% set _api_mw = [] %}
{% for _m in (skgallery.TRAEFIK_MIDDLEWARES | default('upload-chain-no-crowdsec@file')).split(',') %}
{% set _s = _api_swap.get(_m | trim, _m | trim) %}
{% if _s %}
{% set _ = _api_mw.append(_s) %}
{% endif %}
{% endfor %}
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}-api.rule=Host(`skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}`) && (PathPrefix(`/api/`) || PathPrefix(`/.well-known/`))"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}-api.entrypoints={{ skgallery.TRAEFIK_ENTRYPOINT | default('websecure') }}"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls=true"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.certresolver={{ skgallery.TRAEFIK_CERTRESOLVER | default('main') }}"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.options={{ skgallery.TRAEFIK_TLS_OPTIONS | default('intermediate@file') }}"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}-api.priority=150"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}-api.middlewares={{ skgallery.API_MIDDLEWARES | default(_api_mw | unique | join(','), true) }}"
        - "traefik.http.routers.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}-api.service=skgallery{% if env != 'prod' %}-{{ env }}{% endif %}"

        # === TRAEFIK: Service Configuration ===
        - "traefik.http.services.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.server.port=2283"

        # === TRAEFIK: Health Check ===
        # TRAEFIK_HEALTHCHECK: false drops it. With one immich-server replica a failed
        # probe has no other backend to fail over to: a short stall of the API (slow
        # storage, a long GC) turns into instant 503s for every client instead of
        # requests that wait it out. Swarm's container healthcheck still restarts a
        # dead task.
{% if _lb_hc %}
        - "traefik.http.services.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.healthcheck.path=/api/server/ping"
        - "traefik.http.services.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.healthcheck.interval=30s"
        - "traefik.http.services.skgallery{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.healthcheck.timeout=10s"
    depends_on:
      - redis
      - database
{% endif %}

{% if _split %}
  # ===========================================================================
  # Immich Microservices - background jobs (SPLIT_WORKERS only)
  # ===========================================================================
  # Same image and storage as immich-server, every worker except the API:
  # video transcoding, thumbnails, metadata, ML job dispatch. It holds its own
  # CPU and memory limits, so heavy jobs stay out of the API's cgroup. No
  # Traefik labels: it serves no HTTP. The image's built-in healthcheck probes
  # the API port, which this worker does not open, so it is disabled.
  immich-microservices:
    image: ghcr.io/immich-app/immich-server:{{ skgallery.IMMICH_VERSION | default('v2.7.5') }}
    env_file: /var/data/config/skgallery-{{ env }}/skgallery.env
    environment:
      - IMMICH_WORKERS_EXCLUDE=api
    volumes:
      - /var/data/skgallery-{{ env }}/upload:/usr/src/app/upload
      - /var/data/skgallery-{{ env }}/thumbs:/usr/src/app/upload/thumbs
      - /var/data/skgallery-{{ env }}/profile:/usr/src/app/upload/profile
      - /etc/localtime:/etc/localtime:ro
    logging:
      driver: json-file
      options:
        max-size: "{{ skgallery.LOG_MAX_SIZE | default('10m') }}"
        max-file: "{{ skgallery.LOG_MAX_FILES | default('5') }}"
    networks:
      - skgallery-{{ env }}
    healthcheck:
      disable: true
    deploy:
      mode: replicated
      replicas: {{ skgallery.MICROSERVICES_REPLICAS | default(1) }}
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
        failure_action: rollback
      rollback_config:
        parallelism: 1
        delay: 10s
      restart_policy:
        condition: any
        delay: 10s
      placement:
        constraints:
          - node.role == worker
      resources:
        limits:
          cpus: '{{ skgallery.MICROSERVICES_CPU_LIMIT | default("4.0") }}'
          memory: {{ skgallery.MICROSERVICES_MEMORY_LIMIT | default("4G") }}
        reservations:
          cpus: '{{ skgallery.MICROSERVICES_CPU_RESERVATION | default("0.5") }}'
          memory: {{ skgallery.MICROSERVICES_MEMORY_RESERVATION | default("1G") }}
    depends_on:
      - redis
      - database

{% endif %}
  # ===========================================================================
  # Immich Machine Learning - AI/ML Processing
  # ===========================================================================
  # Handles: face detection, object recognition, smart search, CLIP embeddings
  immich-machine-learning:
    image: ghcr.io/immich-app/immich-machine-learning:{{ skgallery.IMMICH_VERSION | default('v2.7.5') }}
    env_file: /var/data/config/skgallery-{{ env }}/skgallery.env
    volumes:
      # === DIRECT BIND MOUNT ===
      - /var/data/skgallery-{{ env }}/model-cache:/cache
    logging:
      driver: json-file
      options:
        max-size: "{{ skgallery.LOG_MAX_SIZE | default('10m') }}"
        max-file: "{{ skgallery.LOG_MAX_FILES | default('5') }}"
    networks:
      - skgallery-{{ env }}
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:3003/ping')"]
      interval: {{ skgallery.ML_HEALTH_CHECK_INTERVAL | default('30s') }}
      timeout: {{ skgallery.ML_HEALTH_CHECK_TIMEOUT | default('10s') }}
      retries: {{ skgallery.ML_HEALTH_CHECK_RETRIES | default(3) }}
      start_period: {{ skgallery.ML_HEALTH_CHECK_START_PERIOD | default('120s') }}
    deploy:
      mode: replicated
      replicas: {{ skgallery.ML_REPLICAS | default(1) }}
      update_config:
        parallelism: 1
        delay: 30s
        order: start-first
        failure_action: rollback
      rollback_config:
        parallelism: 1
        delay: 10s
      restart_policy:
        condition: any
        delay: 15s
      placement:
        constraints:
          - node.role == worker
      resources:
        limits:
          cpus: '{{ skgallery.ML_CPU_LIMIT | default("2.0") }}'
          memory: {{ skgallery.ML_MEMORY_LIMIT | default("4G") }}
        reservations:
          cpus: '{{ skgallery.ML_CPU_RESERVATION | default("0.5") }}'
          memory: {{ skgallery.ML_MEMORY_RESERVATION | default("1G") }}

  # ===========================================================================
  # Redis - In-memory Cache and Message Queue
  # ===========================================================================
  redis:
    image: redis:{{ skgallery.REDIS_VERSION | default('8.10.3-alpine@sha256:71885d8cc6e42f2bc0aa2eb853bfc4be200b5108a46ac50e117ae1df0531fb80') }}
    command: redis-server --appendonly yes --maxmemory {{ skgallery.REDIS_MAXMEMORY | default('128mb') }} --maxmemory-policy noeviction
    volumes:
      - {{ _redis_path }}:/data
    logging:
      driver: json-file
      options:
        max-size: "{{ skgallery.LOG_MAX_SIZE | default('10m') }}"
        max-file: "{{ skgallery.LOG_MAX_FILES | default('3') }}"
    networks:
      - skgallery-{{ env }}
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep PONG || exit 1"]
      interval: {{ skgallery.REDIS_HEALTH_CHECK_INTERVAL | default('10s') }}
      timeout: {{ skgallery.REDIS_HEALTH_CHECK_TIMEOUT | default('5s') }}
      retries: {{ skgallery.REDIS_HEALTH_CHECK_RETRIES | default(3) }}
      start_period: {{ skgallery.REDIS_HEALTH_CHECK_START_PERIOD | default('10s') }}
    deploy:
      mode: replicated
      replicas: 1
      update_config:
        parallelism: 1
        delay: 5s
        order: stop-first
      restart_policy:
        condition: any
        delay: 5s
      placement:
        constraints:
          - node.role == worker
{% if _data_node %}
          - node.hostname == {{ _data_node }}
{% endif %}
      resources:
        limits:
          cpus: '{{ skgallery.REDIS_CPU_LIMIT | default("0.5") }}'
          memory: {{ skgallery.REDIS_MEMORY_LIMIT | default("256M") }}
        reservations:
          cpus: '{{ skgallery.REDIS_CPU_RESERVATION | default("0.1") }}'
          memory: {{ skgallery.REDIS_MEMORY_RESERVATION | default("64M") }}

  # ===========================================================================
  # PostgreSQL - Vector Database (Immich strategic image)
  # ===========================================================================
  # ghcr.io/immich-app/postgres bundles BOTH pgvecto.rs and vectorchord
  # extensions on top of PostgreSQL, enabling in-place vector migration for
  # legacy installs. Reference: https://docs.immich.app/install/upgrading
  # The default tag is exactly what the pinned Immich release's docker-compose.yml
  # names (PG 14). Immich supports only that image; the PG major must not change
  # silently, so bump it only together with IMMICH_VERSION, per its release notes.
  database:
    image: ghcr.io/immich-app/postgres:{{ skgallery.POSTGRES_VERSION | default('14-vectorchord0.4.3-pgvectors0.2.0') }}
    env_file: /var/data/config/skgallery-{{ env }}/skgallery-db.env
    shm_size: {{ skgallery.DB_SHM_SIZE | default('128mb') }}
    volumes:
      # === DIRECT BIND MOUNT ===
      - {{ _db_path }}:/var/lib/postgresql/data
      - /etc/localtime:/etc/localtime:ro
    logging:
      driver: json-file
      options:
        max-size: "{{ skgallery.LOG_MAX_SIZE | default('10m') }}"
        max-file: "{{ skgallery.LOG_MAX_FILES | default('5') }}"
    networks:
      - skgallery-{{ env }}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d {{ skgallery.DB_DATABASE_NAME | default('immich') }} -U {{ skgallery.DB_USERNAME | default('postgres') }}"]
      interval: {{ skgallery.DB_HEALTH_CHECK_INTERVAL | default('10s') }}
      timeout: {{ skgallery.DB_HEALTH_CHECK_TIMEOUT | default('15s') }}
      retries: {{ skgallery.DB_HEALTH_CHECK_RETRIES | default(10) }}
      start_period: {{ skgallery.DB_HEALTH_CHECK_START_PERIOD | default('90s') }}
    deploy:
      mode: replicated
      replicas: 1
      update_config:
        parallelism: 1
        delay: 10s
        order: stop-first
      restart_policy:
        condition: any
        delay: 10s
      placement:
        constraints:
          - node.role == worker
{% if _data_node %}
          - node.hostname == {{ _data_node }}
{% endif %}
      resources:
        limits:
          cpus: '{{ skgallery.DB_CPU_LIMIT | default("2.0") }}'
          memory: {{ skgallery.DB_MEMORY_LIMIT | default("4G") }}
        reservations:
          cpus: '{{ skgallery.DB_CPU_RESERVATION | default("0.25") }}'
          memory: {{ skgallery.DB_MEMORY_RESERVATION | default("512M") }}

  # ===========================================================================
  # PostgreSQL Database Backup Service
  # ===========================================================================
  # Automated daily backups with retention policy
  postgres-db-backup:
    image: postgres:{{ skgallery.POSTGRES_BACKUP_VERSION | default('14.24@sha256:834a046089d76edd1d2e81c4741f3ad5d1853646ededc86c2708936aad31c1ed') }}
    env_file: /var/data/config/skgallery-{{ env }}/skgallery-backup.env
    environment:
      - PGTEMP=/dump/tmp
    volumes:
      # === DIRECT BIND MOUNT FOR BACKUPS ===
      - /var/data/skgallery-{{ env }}/database-dump:/dump
      - /etc/localtime:/etc/localtime:ro
    # One shell runs this script (list form, no `bash -s <<EOF` heredoc): an
    # unquoted heredoc made the OUTER shell expand the date once at container
    # start, so every run overwrote one file and a failed dump truncated the
    # only copy. Each run now gets its own name, dumps to a hidden temp file
    # renamed only on success, and prunes dumps older than BACKUP_KEEP_DAYS
    # only after a good dump (a run of failures never ages out the last one).
    # Every $ is $$ so docker stack deploy does not interpolate it.
    entrypoint:
      - bash
      - -c
      - |
        set -o pipefail
        trap 'exit 0' HUP INT TERM
        rm -f /dump/.dump_*.tmp
        sleep 2m & wait $$!
        while true; do
          NAME=dump_$$(date +%d-%m-%Y_%H_%M_%S).psql
          TMP=/dump/.$${NAME}.tmp
          if pg_dump -Fc -h database -U "$${PGUSER}" -d "$${PGDATABASE}" -f "$${TMP}" && [ -s "$${TMP}" ]; then
            mv -f "$${TMP}" "/dump/$${NAME}"
            echo "[backup] OK /dump/$${NAME} ($$(stat -c %s "/dump/$${NAME}") bytes)"
            DAYS=$${BACKUP_KEEP_DAYS:-7}
            [ "$${DAYS}" -ge 1 ] 2>/dev/null || DAYS=1
            find /dump -maxdepth 1 -type f -name 'dump_*.psql' ! -name "$${NAME}" -mmin +$$((DAYS * 1440)) -print -delete
          else
            echo "[backup] FAIL: dump failed or empty, previous dumps kept" >&2
            rm -f "$${TMP}"
          fi
          sleep "$${BACKUP_FREQUENCY:-1d}" & wait $$!
        done
    deploy:
      mode: replicated
      replicas: {{ skgallery.BACKUP_REPLICAS | default(1) }}
      placement:
        constraints:
          - node.role == worker
      resources:
        reservations:
          memory: 64M
          cpus: '.05'
        limits:
          memory: 256M
          cpus: '.25'
      restart_policy:
        condition: any
        delay: 10s
    networks:
      - skgallery-{{ env }}
    depends_on:
      - database
