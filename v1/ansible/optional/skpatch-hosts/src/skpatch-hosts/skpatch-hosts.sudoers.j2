# Managed by SKStacks optional/skpatch-hosts (provision_skpatch_hosts_nodes.yml).
# Do not edit by hand; rerun the playbook instead. Exact commands, absolute
# paths, no NOPASSWD: ALL, no unbounded wildcards.
#
# Confirmed against the shipped image's own server bundle
# (/app/dist/server/index.js, ghcr.io/theduffman85/linux-update-dashboard),
# not the upstream project's README -- found live 2026-10-28, the first
# time this check was ever reached end to end: the README-derived guesses
# this file used to carry (`apt list --upgradable`, `apt-get -s
# dist-upgrade`, `cat /var/run/reboot-required`) did not match a single
# command the app actually runs, so every check failed closed with
# "sudo: a password is required". The app self-documents its own
# sudoers-relevant commands via "# Sudoers-relevant command: ..." lines in
# its generated scripts; these are copied verbatim from there.
#
# Listing upgradable packages (`apt list --upgradable`) and simulating an
# upgrade (`apt-get -s -o Debug::NoLocking=1 upgrade`, which explicitly
# disables the dpkg lock requirement) both run as the plain user, no sudo
# at all -- neither needs a sudoers line. The reboot-pending check is a
# plain `[ -f /run/reboot-required ]` file test, not `cat`, also no sudo.
#
# Read-only commands (always present): refresh APT's metadata and audit
# dpkg's own state, both of which genuinely need root. sudoers treats
# ":" and "=" inside a command's arguments as meta-characters that must
# be backslash-escaped (found live 2026-10-28, via visudo -cf itself:
# "syntax error" pointing at the unescaped "::" in DPkg::Lock::Timeout=60)
# -- the escaped form still matches the real, unescaped argv sudo sees at
# exec time (confirmed by running the exact command through sudo -n as
# the provisioned account after installing this file).
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/bin/dpkg --audit
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/bin/apt-get -o DPkg\:\:Lock\:\:Timeout\=60 update -qq

{% if skp_node_allow_actions | bool %}
# Actions (upgrade/reboot): only present when this host's
# skpatch_hosts_allow_actions (or the instance-wide skpatch_hosts.ALLOW_ACTIONS when
# the host sets nothing) is true. Hypervisors, the NAS and anything else
# that must stay report-only set skpatch_hosts_allow_actions: false in their own
# group_vars, which keeps this whole block off regardless of the
# instance-wide knob. Same DPkg::Lock::Timeout=60 flag as the read-only
# update above (the app always passes it); "upgrade"/"full-upgrade", not
# "dist-upgrade" -- confirmed against getUpgradeAllCommand/
# getFullUpgradeAllCommand/the apt autoremove sudoersRelevantCommand() call
# in the same server bundle.
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/bin/apt-get -o DPkg\:\:Lock\:\:Timeout\=60 upgrade -y
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/bin/apt-get -o DPkg\:\:Lock\:\:Timeout\=60 full-upgrade -y
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/bin/apt-get -o DPkg\:\:Lock\:\:Timeout\=60 autoremove -y
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/sbin/reboot
# The "package manager needs repair" banner (dpkg was interrupted) runs this
# exact argv (builtinRepairIssueCommand in the same bundle). Without it the
# Repair button ends "sudo: a password is required" and the host stays
# blocked until someone logs in by hand.
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/bin/dpkg --configure -a
# The app exports DEBIAN_FRONTEND=noninteractive before every apt action, but
# sudo's env_reset drops it, so debconf falls back to its Teletype frontend,
# reads EOF from the app's /dev/null stdin and fails the package's configure
# step (found live 2026-11-12: console-setup failed mid full-upgrade and left
# dpkg interrupted). Keeping this ONE variable lets the app's own value reach
# apt. The frontends that could do anything else (Passthrough, Editor) need
# variables that env_reset still drops (DEBCONF_PIPE, EDITOR, VISUAL).
Defaults:{{ skpatch_user }} env_keep += "DEBIAN_FRONTEND"
# Upgrade-all also refreshes Snap packages on a host where the app detected
# snap (every Ubuntu server image), with this exact argv
# (sudoersRelevantCommand("snap refresh") in the same bundle). Without it,
# every upgrade on such a host ended "warning" on the snap step.
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/bin/snap refresh
# "Upgrade selected packages" runs `apt-get ... install --only-upgrade -y
# <pkg>...` (and `snap refresh <name>...` for snaps), with names that change
# on every call. These are NOT granted as apt-get or snap rules: any
# wildcard on apt-get lets the caller add `-o APT::Update::Pre-Invoke::=<cmd>`
# and become root, and a wildcard on snap has the same shape. Instead, only
# these two root-owned wrapper scripts (installed by the same playbook run,
# src/skpatch-hosts/skpatch-{apt-only-upgrade,snap-refresh}.sh) are
# granted, by absolute path with NO "*" and no arguments pinned: a sudoers
# command with no argument list accepts any arguments, and the wrapper itself
# rejects every argument that is not a plain package or snap name before it
# runs anything. The dashboard reaches the wrappers through its per-system
# script override, see README "Selected-package upgrades".
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/local/sbin/skpatch-apt-only-upgrade
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/local/sbin/skpatch-snap-refresh
{% if skp_node_is_proxmox | bool %}
# Proxmox VE only: the app's pre-reboot backup guard (getProxmoxBackupGuardCommand
# in the same bundle) runs this exact read-only argv and blocks the reboot
# ("Reboot blocked: could not verify Proxmox backup activity") when it fails.
# Without it a hypervisor could never be rebooted from the app, even by hand.
# Granted only where pvesh exists (or skpatch_hosts_proxmox is set), and only
# with the reboot line above. Whether a hypervisor gets a reboot SCHEDULE is
# the operator's choice in the dashboard, not this file's.
{{ skpatch_user }} ALL=(root) NOPASSWD: /usr/bin/pvesh get /cluster/tasks --output-format json
{% endif %}
{% endif %}

# Debian/Ubuntu (apt) is every host in both estates today. A non-Debian
# target needs its own read (and, if ALLOW_ACTIONS, action) lines added
# here by hand before provisioning it, confirmed the SAME way this file
# was corrected: read the shipped image's own server bundle for the exact
# "# Sudoers-relevant command: ..." lines that package manager emits,
# never the upstream project's README alone.
