# skpatch-hosts (linux-update-dashboard) runtime environment ({{ env }}). Root only (0600).
# LUDASH_ENCRYPTION_KEY decrypts every stored SSH credential: changing it
# makes them all unreadable and they must be re-entered.
LUDASH_ENCRYPTION_KEY={{ skpatch_hosts.LUDASH_ENCRYPTION_KEY }}
LUDASH_DB_PATH=/data/dashboard.db
LUDASH_BASE_URL=https://{{ skp_host }}
LUDASH_PORT=3001
LUDASH_HOST=0.0.0.0
# Behind Traefik: trust its X-Forwarded-* headers.
LUDASH_TRUST_PROXY=true
LUDASH_LOG_LEVEL={{ skpatch_hosts.LUDASH_LOG_LEVEL | default('info', true) }}
# Ceiling for the cmd_timeout_seconds setting (the app caps it at 600 without
# this). An upgrade on a slow host (a Pi working through a backlog, a large
# kernel jump) outlasts 600 s; past the limit the app stops watching, records
# "monitoring lost" and reconnects later while the upgrade keeps running under
# nohup. The setting itself (default 1800) is converged by the provisioning
# run's registrar (DASHBOARD_SETTINGS). LUDASH_DEFAULT_CMD_TIMEOUT is read but
# never used by the pinned image, so it is not set.
LUDASH_MAX_CMD_TIMEOUT={{ skp_max_cmd_timeout }}
{% if skp_auth_mode == 'oidc' %}
# AUTH_MODE oidc: the dashboard's own OIDC login against sksso (Authentik),
# no forward auth in front (README "Sign-in and the admin group"). Every
# LUDASH_OIDC_* / LUDASH_PASSWORD_LOGIN_ENABLED value here is "pinned" by
# upstream (server/auth/auth-config.ts): it always wins over anything saved
# in the dashboard's own Settings page and is never written to its
# database, so a vault change here cannot drift. Authentik's side is
# sksso's blueprint (sksso.SKPATCH_HOSTS_OIDC_CLIENT_SECRET), which must carry
# the same client secret as OIDC_CLIENT_SECRET below.
LUDASH_OIDC_ISSUER={{ skpatch_hosts.OIDC_ISSUER }}
LUDASH_OIDC_CLIENT_ID={{ skp_oidc_client_id }}
LUDASH_OIDC_CLIENT_SECRET={{ skpatch_hosts.OIDC_CLIENT_SECRET }}
LUDASH_OIDC_SCOPE={{ skp_oidc_scope }}
LUDASH_OIDC_GROUPS_CLAIM={{ skp_oidc_groups_claim }}
{% if skp_oidc_admin_groups %}
LUDASH_OIDC_ADMIN_GROUPS={{ skp_oidc_admin_groups }}
{% endif %}
{% if skp_oidc_read_only_groups %}
LUDASH_OIDC_READ_ONLY_GROUPS={{ skp_oidc_read_only_groups }}
{% endif %}
LUDASH_OIDC_UNMATCHED_ROLE={{ skp_oidc_unmatched_role }}
LUDASH_OIDC_END_SESSION={{ skp_oidc_end_session | lower }}
# Closes the separate first-run local-account path this role exists to
# remove. Upstream keeps password login enabled anyway if no other sign-in
# method is configured (lockout fallback); it will not here, since OIDC is.
LUDASH_PASSWORD_LOGIN_ENABLED=false
{% endif %}
TZ={{ skpatch_hosts.TZ | default('UTC', true) }}
NODE_ENV=production
{% for k, v in (skpatch_hosts.extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
