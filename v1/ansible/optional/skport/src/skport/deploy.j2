#!/bin/bash
set -e

# SKPort (Portainer) Deploy Script
# Environment: {{ env }}
APPNAME=skport
STACK_NAME=skport{% if env == 'prod' %}-prod{% elif env == 'staging' %}-staging{% else %}-dev{% endif %}

CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skport.yml"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}Deploying ${STACK_NAME} stack (Portainer)...${NC}"

# Source environment variables (may set CLUSTERNAME/DOMAIN for the URL banner)
if [ -f "${CONFIG_DIR}/${APPNAME}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APPNAME}.sh.env"
fi

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

echo -e "${YELLOW}Deploying stack configuration...${NC}"
echo -e "${BLUE}Stack name: ${STACK_NAME}${NC}"
echo -e "${BLUE}Compose file: ${COMPOSE_FILE}${NC}"

cd "${CONFIG_DIR}"

docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 5

echo -e "${YELLOW}Forcing service update to pull latest pinned image...${NC}"
docker service update --force --detach=false "${STACK_NAME}_portainer" || true

sleep 10

echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_portainer" --format "{% raw %}{{.Replicas}}{% endraw %}")
if [[ "$REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} Portainer is healthy and running!${NC}"
    echo -e "${GREEN}UI: https://skport{% if env != 'prod' %}-{{ env }}{% endif %}.${CLUSTERNAME:-skstack01}.${DOMAIN:-example.com}${NC}"
    echo -e "${YELLOW}First visit within 5 minutes creates the admin account (no default password is set).${NC}"
else
    echo -e "${RED}${STACK_NAME} Portainer health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}Recent logs:${NC}"
    docker service logs --tail 20 "${STACK_NAME}_portainer" || true
fi

echo -e "${GREEN}Deployment complete!${NC}"
