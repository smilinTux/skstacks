version: '3.8'

services:
  portainer:
    image: portainer/portainer-ce:{{ skport.portainer_version | default('2.45.3') }}
    env_file:
      - /var/data/config/skport-{{ env }}/skport.env
    volumes:
      # Portainer's own data directory (direct bind mount, per SKStacks
      # Volume Management Standards)
      - /var/data/skport-{{ env }}/data:/data
      - /etc/localtime:/etc/localtime:ro
      # No Docker socket bind mount: Docker access goes through the
      # skfence/skfenceha socket-proxy service via DOCKER_HOST (see
      # skport.env.j2 and README.md "Security").
    networks:
      - cloud-public-{{ env }}
      - cloud-socket-proxy-{{ env }}
      - skport-{{ env }}

    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      resources:
        reservations:
          memory: 256M
          cpus: '0.25'
        limits:
          memory: 1G
          cpus: '1.0'
      restart_policy:
        condition: any
        delay: 10s
      rollback_config:
        parallelism: 1
      labels:
        # === TRAEFIK: HTTP ===
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        # === TRAEFIK: ROUTERS ===
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}.rule=Host(`skport{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skport.CLUSTERNAME | default(cluster_name) }}.{{ skport.DOMAIN | default(domain) }}`)"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}.entrypoints=websecure"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}.tls=true"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}.tls.certresolver=main"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}.tls.options=intermediate@file"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}.middlewares={{ skport.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file', true) }}"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}.service=skport{% if env != 'prod' %}-{{ env }}{% endif %}"
{# === API ROUTER (raw upstream status codes) ===
    Portainer's HTTP API (`/api/`: stacks, webhooks, websocket, system status) is
    what scripts, CI and the CLI call.
    The main router's chain carries error-pages@file, which swaps every 4xx/5xx for an
    HTML page from the error-pages service and replays the ORIGINAL method there, so API
    clients never saw the app's real status or JSON error. This router sends the machine
    paths through the main chain with each error-pages-bearing chain swapped for its
    no-error-pages form (rate limit and security headers stay; the upload chains keep their
    buffering). skport.API_MIDDLEWARES replaces the derived chain. #}
{% set _api_swap = {'default@file': 'default-no-error-pages@file', 'default-no-crowdsec@file': 'default-no-error-pages@file', 'upload-chain@file': 'large-upload-buffering@file,default-security-headers@file', 'upload-chain-no-crowdsec@file': 'large-upload-buffering@file,default-security-headers@file', 'skai-chain@file': 'skai-headers@file,gzip@file', 'error-pages@file': '', 'error-pages-all@file': ''} %}
{% set _api_mw = [] %}
{% for _m in (skport.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file', true)).split(',') %}
{% set _s = _api_swap.get(_m | trim, _m | trim) %}
{% if _s %}
{% set _ = _api_mw.append(_s) %}
{% endif %}
{% endfor %}
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}-api.rule=Host(`skport{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skport.CLUSTERNAME | default(cluster_name) }}.{{ skport.DOMAIN | default(domain) }}`) && (PathPrefix(`/api/`))"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}-api.entrypoints=websecure"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls=true"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.certresolver=main"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.options=intermediate@file"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}-api.priority=150"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}-api.middlewares={{ skport.API_MIDDLEWARES | default(_api_mw | unique | join(','), true) }}"
        - "traefik.http.routers.skport{% if env != 'prod' %}-{{ env }}{% endif %}-api.service=skport{% if env != 'prod' %}-{{ env }}{% endif %}"
        # === TRAEFIK: SERVICES ===
        - "traefik.http.services.skport{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.server.port=9000"

networks:
  cloud-public-{{ env }}:
    external: true
  cloud-socket-proxy-{{ env }}:
    external: true
  skport-{{ env }}:
    external: true
