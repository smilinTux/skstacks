# SKPort (Portainer) Environment Configuration
# Environment: {{ env }}
# Generated from vault variables

# Docker access via SKFence/SKFenceHA socket-proxy
# SKPort never mounts /var/run/docker.sock directly. It reaches the Swarm
# API through whichever socket-proxy is running ({{ socket_proxy_stack }}
# was auto-detected at deploy time).
DOCKER_HOST=tcp://tasks.{{ socket_proxy_stack }}-{{ env }}_socket-proxy:2375

# Timezone
TZ={{ skport.TZ | default('America/New_York') }}

# Traefik terminates TLS in front of this service, so Portainer must serve
# plain HTTP on its internal port and must not try to redirect to HTTPS.
HTTP_ENABLED=true
SSL_ENABLED=false
HTTP_ADDR=0.0.0.0:9000
HTTPS_ADDR=

# Admin account
# No ADMIN_PASSWORD is set here on purpose: baking any literal default
# would be the same credential on every instance that forgets to change
# it. Portainer's own first-run setup wizard is the fail-closed path: the
# first person to reach the UI within 5 minutes of the container starting
# creates the admin account interactively. See README.md.
