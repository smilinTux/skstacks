{% set sfx = '' if env == 'prod' else '-' + env %}
{% set local_root = skfetch.LOCAL_ROOT | default('/var/lib/skfetch' + sfx) %}
{% set media = skfetch.MEDIA_PATH | default('/var/data/' + app + '-' + env) %}
{% set cfgdir = '/var/data/config/' + app + '-' + env %}
{% set subnet = skfetch.BRIDGE_SUBNET | default('172.30.60.0/24') %}
{% set net = subnet.split('/')[0].rsplit('.', 1)[0] %}
{% set lan = skfetch.LAN_BIND_ADDRESS | default('127.0.0.1') %}
{% set stream = skfetch.STREAM_NETWORK | default('skstream-' + env) %}
{% set flare = (skfetch.FLARESOLVERR_ENABLED | default(true) | string | lower) in ['true', 'yes', '1', 'on'] %}
# Generated by Ansible (skfetch). Traefik file-provider routes for the *arr web
# UIs, pointing at their LAN binds. qBittorrent is never routed. Each host needs
# its own Authentik provider bound to an admins group (see README.md).
{% set mw = skfetch.TRAEFIK_MIDDLEWARES | default(['default-security-headers@file', 'authentik@file']) %}
{% set uis = [('sonarr', 8989), ('radarr', 7878), ('lidarr', 8686), ('prowlarr', 9696)] %}
http:
  routers:
{% for n, p in uis %}
    skfetch{{ sfx }}-{{ n }}:
      rule: "Host(`{{ n }}{{ sfx }}.{{ skfetch.CLUSTERNAME }}.{{ skfetch.DOMAIN }}`)"
      entryPoints: [websecure]
      tls: { certResolver: {{ skfetch.TRAEFIK_CERT_RESOLVER | default('main') }} }
      middlewares: {{ mw | to_json }}
      service: skfetch{{ sfx }}-{{ n }}
{% endfor %}
  services:
{% for n, p in uis %}
    skfetch{{ sfx }}-{{ n }}:
      loadBalancer: { servers: [ { url: "http://{{ lan }}:{{ p }}" } ] }
{% endfor %}
