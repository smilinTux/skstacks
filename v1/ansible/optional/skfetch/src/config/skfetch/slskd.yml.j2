# Generated by Ansible (skfetch). slskd seed, written only if absent (0600).
# slskd owns it after first start (FORCE_SEED rewrites it).
soulseek:
  username: {{ skfetch.SLSKD_SOULSEEK_USERNAME | string | to_json }}
  password: {{ skfetch.SLSKD_SOULSEEK_PASSWORD | string | to_json }}
  listen_port: {{ skfetch.SLSKD_LISTEN_PORT | default(50300) | int }}
web:
  port: 5030
  authentication:
    username: {{ skfetch.SLSKD_WEB_USERNAME | string | to_json }}
    password: {{ skfetch.SLSKD_WEB_PASSWORD | string | to_json }}
    api_keys:
      soularr:
        key: {{ skfetch.SLSKD_API_KEY | string | to_json }}
        cidr: {{ skfetch.SLSKD_API_CIDR | default('0.0.0.0/0,::/0') | to_json }}
directories:
  downloads: /app/downloads
  incomplete: /app/incomplete
shares:
  directories: []
