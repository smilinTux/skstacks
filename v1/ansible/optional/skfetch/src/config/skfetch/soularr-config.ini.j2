{% set subnet = skfetch.BRIDGE_SUBNET | default('172.30.60.0/24') %}
{% set net = subnet.split('/')[0].rsplit('.', 1)[0] %}
# Generated by Ansible (skfetch). Soularr seed, written only if absent (0600).
[Lidarr]
api_key = {{ skfetch.LIDARR_API_KEY }}
host_url = http://{{ net }}.13:8686
download_dir = /data/slskd-downloads
disable_sync = False

[Slskd]
api_key = {{ skfetch.SLSKD_API_KEY }}
host_url = http://{{ net }}.2:5030
url_base = /
download_dir = /downloads
delete_searches = False
stalled_timeout = {{ skfetch.SOULARR_STALLED_TIMEOUT | default(3600) | int }}
