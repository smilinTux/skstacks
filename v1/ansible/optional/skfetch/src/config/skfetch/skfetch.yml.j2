# skfetch: host-level docker compose project (NOT a swarm stack), started by
# skfetch[-<env>].service on the media node. qBittorrent shares gluetun's
# network namespace (network_mode: service:gluetun), which swarm cannot do, and
# gluetun needs NET_ADMIN + /dev/net/tun. Secrets only in skfetch.env (0600).
# *arr SQLite on local disk (LOCAL_ROOT); media and incomplete downloads on the
# media dataset (MEDIA_PATH, mounted at /data).
{% set sfx = '' if env == 'prod' else '-' + env %}
{% set local_root = skfetch.LOCAL_ROOT | default('/var/lib/skfetch' + sfx) %}
{% set media = skfetch.MEDIA_PATH | default('/var/data/' + app + '-' + env) %}
{% set cfgdir = '/var/data/config/' + app + '-' + env %}
{% set subnet = skfetch.BRIDGE_SUBNET | default('172.30.60.0/24') %}
{% set net = subnet.split('/')[0].rsplit('.', 1)[0] %}
{% set lan = skfetch.LAN_BIND_ADDRESS | default('127.0.0.1') %}
{% set stream = skfetch.STREAM_NETWORK | default('skstream-' + env) %}
{% set flare = (skfetch.FLARESOLVERR_ENABLED | default(true) | string | lower) in ['true', 'yes', '1', 'on'] %}
{% set slskd = (skfetch.SLSKD_ENABLED | default(false) | string | lower) in ['true', 'yes', '1', 'on'] %}
name: {{ app }}-{{ env }}

services:
  gluetun:
    image: {{ skfetch.GLUETUN_IMAGE | default('qmcgaw/gluetun@sha256:cbafe0945d0fe5a3c55ca64d43a85c5db270458f4c645ee65797b527f6f57a64') }}
    restart: on-failure
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    cap_add: [NET_ADMIN]
    devices: ["/dev/net/tun:/dev/net/tun"]
    env_file: {{ cfgdir }}/skfetch.env
    environment:
      TZ: {{ skfetch.TZ | default('UTC') | to_json }}
      VPN_SERVICE_PROVIDER: {{ skfetch.VPN_SERVICE_PROVIDER | default('private internet access') | to_json }}
      VPN_TYPE: {{ skfetch.VPN_TYPE | default('openvpn') | to_json }}
      SERVER_REGIONS: {{ skfetch.SERVER_REGIONS | default('') | to_json }}
      VPN_PORT_FORWARDING: {{ skfetch.VPN_PORT_FORWARDING | default('on') | string | to_json }}
      # Hands the forwarded port to qBittorrent, which shares this namespace
      # and trusts localhost (qBittorrent.conf WebUI\LocalHostAuth=false).
      VPN_PORT_FORWARDING_UP_COMMAND: {{ ("/bin/sh -c 'wget -q -O- --retry-connrefused --post-data \"json={\\\"listen_port\\\":{{PORTS}}}\" http://127.0.0.1:8080/api/v2/app/setPreferences'") | to_json }}
      HTTP_CONTROL_SERVER_ADDRESS: ":8000"
    volumes:
      - {{ local_root }}/gluetun:/gluetun
    networks:
      skfetch: { ipv4_address: {{ net }}.2 }
    mem_limit: {{ skfetch.GLUETUN_MEM_LIMIT | default('256m') }}

  qbittorrent:
    image: {{ skfetch.QBITTORRENT_IMAGE | default('lscr.io/linuxserver/qbittorrent@sha256:3d4c4545d51a690a0df15a2ff99038823a88a9822df8e794526447b9afbd7384') }}
    restart: on-failure
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    # Never published: only reachable inside the VPN namespace and the bridge.
    network_mode: service:gluetun
    depends_on:
      gluetun: { condition: service_healthy }
    environment:
      PUID: "{{ skfetch.PUID | default(1000) }}"
      PGID: "{{ skfetch.PGID | default(1000) }}"
      TZ: {{ skfetch.TZ | default('UTC') | to_json }}
      WEBUI_PORT: "8080"
    volumes:
      - {{ local_root }}/qbittorrent:/config
      - {{ media }}:/data
    mem_limit: {{ skfetch.QBITTORRENT_MEM_LIMIT | default('768m') }}
{% for a in [('prowlarr', 9696, 10, '384m'),
             ('sonarr', 8989, 11, '640m'),
             ('radarr', 7878, 12, '640m'),
             ('lidarr', 8686, 13, '640m')] %}

  {{ a[0] }}:
{% if a[0] == 'prowlarr' %}
    image: {{ skfetch.PROWLARR_IMAGE | default('lscr.io/linuxserver/prowlarr@sha256:6660787a99b2e58203539583663c973b48979fc00ff2cb78dc0ea17429e1f6ef') }}
{% elif a[0] == 'sonarr' %}
    image: {{ skfetch.SONARR_IMAGE | default('lscr.io/linuxserver/sonarr@sha256:c7d1df25e428da6c9ace05daea0d34e59522978a3843ea1944812f855af4086c') }}
{% elif a[0] == 'radarr' %}
    image: {{ skfetch.RADARR_IMAGE | default('lscr.io/linuxserver/radarr@sha256:51a9ac2a9eb47afc833541e5fd6c11b86eb9f810694c22fa2429e3078e9194b2') }}
{% elif a[0] == 'lidarr' %}
    image: {{ skfetch.LIDARR_IMAGE | default('lscr.io/linuxserver/lidarr@sha256:a91ef0642c15c9bd7c4260fee98fa99972c61601e37c8a96411d6a9cf0e9ad40') }}
{% endif %}
    restart: on-failure
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    environment:
      PUID: "{{ skfetch.PUID | default(1000) }}"
      PGID: "{{ skfetch.PGID | default(1000) }}"
      TZ: {{ skfetch.TZ | default('UTC') | to_json }}
    volumes:
      - {{ local_root }}/{{ a[0] }}:/config
{% if a[0] != 'prowlarr' %}
      - {{ media }}:/data
{% endif %}
    ports: ["{{ lan }}:{{ a[1] }}:{{ a[1] }}"]
    networks:
      skfetch: { ipv4_address: {{ net }}.{{ a[2] }} }
{% if stream and a[0] != 'prowlarr' %}
      {{ stream }}: {}
{% endif %}
    mem_limit: {{ skfetch[a[0] | upper + '_MEM_LIMIT'] | default(a[3]) }}
{% endfor %}
{% if flare %}

  flaresolverr:
    image: {{ skfetch.FLARESOLVERR_IMAGE | default('ghcr.io/flaresolverr/flaresolverr@sha256:c80ae007ce2ccdcd217a12426e4f039ef763ff90738c808d38810c3e59323767') }}
    restart: on-failure
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    environment:
      TZ: {{ skfetch.TZ | default('UTC') | to_json }}
      LOG_LEVEL: info
    networks:
      skfetch: { ipv4_address: {{ net }}.20 }
    mem_limit: {{ skfetch.FLARESOLVERR_MEM_LIMIT | default('512m') }}
{% endif %}
{% if slskd %}

  # slskd (Soulseek) in the VPN namespace, like qBittorrent; Soularr feeds it
  # Lidarr's wanted albums. Secrets only in the slskd.yml / config.ini seeds.
  slskd:
    image: {{ skfetch.SLSKD_IMAGE | default('slskd/slskd@sha256:d0963a3e5b16facd295bf4f2156dad0182f246b1b21a032cae12f5494c694843') }}
    restart: on-failure
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    user: "{{ skfetch.PUID | default(1000) }}:{{ skfetch.PGID | default(1000) }}"
    network_mode: service:gluetun
    depends_on:
      gluetun: { condition: service_healthy }
    environment:
      TZ: {{ skfetch.TZ | default('UTC') | to_json }}
      SLSKD_REMOTE_CONFIGURATION: "false"
    volumes:
      - {{ local_root }}/slskd:/app
      - {{ media }}/slskd-downloads:/app/downloads
    mem_limit: {{ skfetch.SLSKD_MEM_LIMIT | default('512m') }}

  soularr:
    image: {{ skfetch.SOULARR_IMAGE | default('mrusse08/soularr@sha256:61ee506de5fb1447f3abd4a5a47e2537fad152ddf8c7e0392a36ef00b4f1c3d9') }}
    restart: on-failure
    logging: { driver: json-file, options: { max-size: "10m", max-file: "3" } }
    user: "{{ skfetch.PUID | default(1000) }}:{{ skfetch.PGID | default(1000) }}"
    depends_on: [lidarr, slskd]
    environment:
      PUID: "{{ skfetch.PUID | default(1000) }}"
      PGID: "{{ skfetch.PGID | default(1000) }}"
      TZ: {{ skfetch.TZ | default('UTC') | to_json }}
      SCRIPT_INTERVAL: "{{ skfetch.SOULARR_INTERVAL | default(300) }}"
      WEBUI_ENABLED: "false"
    volumes:
      - {{ local_root }}/soularr:/data
      - {{ media }}/slskd-downloads:/downloads
    networks:
      skfetch: { ipv4_address: {{ net }}.21 }
    mem_limit: {{ skfetch.SOULARR_MEM_LIMIT | default('256m') }}
{% endif %}

networks:
  skfetch:
    driver: bridge
    ipam: { config: [ { subnet: {{ subnet }} } ] }
{% if stream %}
  {{ stream }}:
    external: true
{% endif %}
