{% set sfx = '' if env == 'prod' else '-' + env %}
{% set local_root = skfetch.LOCAL_ROOT | default('/var/lib/skfetch' + sfx) %}
{% set media = skfetch.MEDIA_PATH | default('/var/data/' + app + '-' + env) %}
{% set cfgdir = '/var/data/config/' + app + '-' + env %}
{% set subnet = skfetch.BRIDGE_SUBNET | default('172.30.60.0/24') %}
{% set net = subnet.split('/')[0].rsplit('.', 1)[0] %}
{% set lan = skfetch.LAN_BIND_ADDRESS | default('127.0.0.1') %}
{% set stream = skfetch.STREAM_NETWORK | default('skstream-' + env) %}
{% set flare = (skfetch.FLARESOLVERR_ENABLED | default(true) | string | lower) in ['true', 'yes', '1', 'on'] %}
# Generated by Ansible (skfetch). Host-level compose project; see README.md
# ("Why host-level"). Boot hardening as skstream-dumb: waits for swarm when the
# *arr apps join a swarm overlay, WantedBy docker.service, never gives up.
[Unit]
Description=skfetch{{ sfx }} (Sonarr/Radarr/Lidarr/Prowlarr + qBittorrent via VPN)
After=docker.service network-online.target remote-fs.target
Wants=network-online.target
Requires=docker.service
RequiresMountsFor={{ media }} {{ cfgdir }}
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=0
{% if stream %}
ExecStartPre=/usr/local/sbin/sk-wait-swarm-net {{ stream }}
{% endif %}
ExecStart=/usr/bin/docker compose -p {{ app }}-{{ env }} -f {{ cfgdir }}/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -p {{ app }}-{{ env }} -f {{ cfgdir }}/docker-compose.yml down
Restart=on-failure
RestartSec=20

[Install]
WantedBy=multi-user.target docker.service
