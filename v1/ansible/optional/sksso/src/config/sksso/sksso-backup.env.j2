# PostgreSQL backup sidecar configuration
# Generated from vault variables

PGHOST=postgres
PGUSER={{ sksso.postgres_user }}
PGPASSWORD={{ sksso.postgres_password }}
PGDATABASE={{ sksso.postgres_db | default('authentik') }}
# Days of dumps kept (pruned only after a good dump). backup_num_keep is the
# older name, still honoured (one dump a day = one per day kept).
BACKUP_KEEP_DAYS={{ sksso.backup_keep_days | default(sksso.backup_num_keep | default('7')) }}
BACKUP_FREQUENCY={{ sksso.backup_frequency | default('1d') }}
