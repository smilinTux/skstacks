# Authentik SSO Environment Configuration
# Generated from vault variables

# PostgreSQL Configuration
POSTGRES_USER={{ sksso.postgres_user }}
POSTGRES_PASSWORD={{ sksso.postgres_password }}
POSTGRES_DB={{ sksso.postgres_db | default('authentik') }}
TZ={{ sksso.TZ | default('UTC') }}

# GeoIP Configuration (optional; leave geoip_account_id/geoip_license_key
# unset to disable - Authentik runs fine without GeoIP)
{% if sksso.geoip_account_id is defined and sksso.geoip_license_key is defined %}
GEOIPUPDATE_EDITION_IDS={{ sksso.geoip_edition_ids | default('GeoLite2-City') }}
GEOIPUPDATE_FREQUENCY={{ sksso.geoip_frequency | default('8') }}
GEOIPUPDATE_ACCOUNT_ID={{ sksso.geoip_account_id }}
GEOIPUPDATE_LICENSE_KEY={{ sksso.geoip_license_key }}
AUTHENTIK_AUTHENTIK__GEOIP=/geoip/GeoLite2-City.mmdb
AUTHENTIK_EVENTS__CONTEXT_PROCESSORS__GEOIP=/tmp/non-existent-file
AUTHENTIK_EVENTS__CONTEXT_PROCESSORS__ASN=/tmp/non-existent-file
{% endif %}

# Server/worker environment configuration
AUTHENTIK_REDIS__HOST=redis
AUTHENTIK_POSTGRESQL__HOST=postgres
AUTHENTIK_POSTGRESQL__USER={{ sksso.postgres_user }}
AUTHENTIK_POSTGRESQL__NAME={{ sksso.postgres_db | default('authentik') }}
AUTHENTIK_POSTGRESQL__PASSWORD={{ sksso.postgres_password }}

# Authentik secret key (required - Django session/crypto signing key)
AUTHENTIK_SECRET_KEY={{ sksso.authentik_secret_key }}

# Logging (default: warning for prod, info for staging, debug for dev)
AUTHENTIK_LOG_LEVEL={{ sksso.log_level | default('warning' if env == 'prod' else 'info' if env == 'staging' else 'debug') }}

# Startup/update/error-reporting toggles
AUTHENTIK_DISABLE_STARTUP_ANALYTICS={{ sksso.disable_startup_analytics | default('false') }}
AUTHENTIK_DISABLE_UPDATE_CHECK={{ sksso.disable_update_check | default('false') }}
AUTHENTIK_ERROR_REPORTING__ENABLED={{ sksso.error_reporting_enabled | default('true') }}

# Email (SMTP) - optional, only rendered if sksso.email_host is set
{% if sksso.email_host is defined %}
AUTHENTIK_EMAIL__HOST={{ sksso.email_host }}
AUTHENTIK_EMAIL__PORT={{ sksso.email_port | default('465') }}
AUTHENTIK_EMAIL__USERNAME={{ sksso.email_username }}
AUTHENTIK_EMAIL__PASSWORD={{ sksso.email_password }}
AUTHENTIK_EMAIL__USE_TLS={{ sksso.email_use_tls | default('false') }}
AUTHENTIK_EMAIL__USE_SSL={{ sksso.email_use_ssl | default('true') }}
AUTHENTIK_EMAIL__TIMEOUT={{ sksso.email_timeout | default('10') }}
AUTHENTIK_EMAIL__FROM={{ sksso.email_from }}
{% endif %}

# CSRF trusted origins (behind a reverse proxy, Django rejects a POST whose
# Origin header doesn't match one of these). sksso.CLUSTERNAME and
# sksso.DOMAIN are required instance vars - see README.md.
AUTHENTIK_CSRF__TRUSTED_ORIGINS=https://sso{% if env != 'prod' %}-{{ env }}{% endif %}.{{ sksso.CLUSTERNAME }}.{{ sksso.DOMAIN }},https://sso{% if env != 'prod' %}-{{ env }}{% endif %}.{{ sksso.DOMAIN }}
