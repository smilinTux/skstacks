INSTANCENAME=sksso
CLUSTERNAME={{ sksso.CLUSTERNAME }}
DOMAIN={{ sksso.DOMAIN }}
{% if sksso.CLOUDFLARED | default(false) %}
BASE_DOMAIN={{ sksso.DOMAIN }}
{% else %}
BASE_DOMAIN={{ sksso.CLUSTERNAME }}.{{ sksso.DOMAIN }}
{% endif %}
INSTANCE={{ sksso.INSTANCE | default('primary') }}
APP_ENV={{ env }}

# Network configuration reference (sourced from vault)
# IMPORTANT: network subnets must match your instance's network registry.
# These values are embedded in the deploy script at template time.
{% for network in app_networks | default([]) %}
# {{ network.name }}: {{ network.subnet }}
{% endfor %}
