{% set capauth_base = sksso.DOMAIN if (sksso.CLOUDFLARED | default(false)) else (sksso.CLUSTERNAME ~ '.' ~ sksso.DOMAIN) %}
{% set capauth_host = sksso.CAPAUTH_HOST | default('capauth' ~ ('' if env == 'prod' else '-' ~ env) ~ '.' ~ capauth_base) %}
# CapAuth OIDC identity provider (sksso.CAPAUTH_ENABLED). Rendered 0600.
# The issuer is the exact public HTTPS origin browsers use.
CAPAUTH_OIDC_ISSUER=https://{{ capauth_host }}
CAPAUTH_BASE_URL=https://{{ capauth_host }}
CAPAUTH_SERVICE_ID={{ capauth_host }}
CAPAUTH_OIDC_CLIENTS_FILE=/config/oidc-clients.json
# New keys enroll as pending until an admin approves them (README "CapAuth login").
CAPAUTH_REQUIRE_APPROVAL={{ 'true' if (sksso.CAPAUTH_REQUIRE_APPROVAL | default(true) | string | lower) in ('true', 'yes', 'on', '1') else 'false' }}
CAPAUTH_ADMIN_TOKEN={{ sksso.CAPAUTH_ADMIN_TOKEN }}
# All state (key registry, OIDC requests/codes, the RS256 signing key) under /data.
CAPAUTH_HOME=/data
CAPAUTH_DATA_DIR=/data
CAPAUTH_DB_PATH=/data/keys.db
CAPAUTH_OIDC_STATE_DB=/data/oidc_state.db
CAPAUTH_OIDC_SIGNING_KEY_PATH=/data/oidc_signing_key.pem
