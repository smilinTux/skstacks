# Authentik blueprint: the OAuth2/OIDC login of sksec-web (crowdsec-web-ui),
# AUTH_MODE: oidc. Rendered by tasks/sksec_web_blueprint.yml into
# /var/data/config/sksso-<env>/blueprints/ and mounted at /blueprints/custom;
# the Authentik worker discovers and applies it (idempotent, re-applied on
# change and periodically). The client secret is NOT in this file: it comes
# from the SKSEC_WEB_OIDC_CLIENT_SECRET environment variable (!Env).
#
# The application slug (sksso_sksec_web_client_id) is the SAME value
# sksec-web's own deploy defaults its portal tile to (AUTHENTIK_TILE_SLUG,
# default the router name, e.g. "sksec-web"): shared/tasks/
# authentik_portal_tile.yml finds this exact Application by slug and keeps
# this provider when it manages the tile (shared/src/
# authentik_portal_tile.py "keeping its existing provider"), so oidc mode
# ends up with ONE Authentik Application, not two. Visibility/who-may-sign-
# in is therefore the portal tile's own group binding (AUTHENTIK_TILE_GROUP
# in sksec-web's vault), not a binding owned by this blueprint.
version: 1
metadata:
  name: sksec-web-oidc (managed by skstacks sksso)
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_providers_oauth2.scopemapping
    id: groups-scope
    identifiers:
      name: {{ (sksso_sksec_web_client_id ~ ": OIDC groups claim") | to_json }}
    attrs:
      scope_name: groups
      description: "sksec-web (crowdsec-web-ui): the signed-in user's Authentik group names, for AUTH_OIDC_GROUPS_CLAIM"
      expression: "return {\"groups\": [group.name for group in request.user.ak_groups.all()]}"

  - model: authentik_providers_oauth2.oauth2provider
    id: provider
    identifiers:
      name: {{ sksso_sksec_web_client_id | to_json }}
    attrs:
      client_type: confidential
      client_id: {{ sksso_sksec_web_client_id | to_json }}
      client_secret: !Env SKSEC_WEB_OIDC_CLIENT_SECRET
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      sub_mode: hashed_user_id
      issuer_mode: per_provider
      # Authentik 2026.2+: a new provider without grant_types gets none and
      # every authorize fails with invalid_request. Sign-in is the code flow.
      grant_types: [authorization_code, refresh_token]
      redirect_uris:
        - matching_mode: strict
          url: {{ ('https://' ~ sksso_sksec_web_host ~ '/api/auth/oidc/callback') | to_json }}
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
        - !KeyOf groups-scope

  - model: authentik_core.application
    id: application
    identifiers:
      slug: {{ sksso_sksec_web_client_id | to_json }}
    attrs:
      name: {{ sksso_sksec_web_app_name | to_json }}
      provider: !KeyOf provider
      meta_launch_url: {{ ('https://' ~ sksso_sksec_web_host ~ '/') | to_json }}
