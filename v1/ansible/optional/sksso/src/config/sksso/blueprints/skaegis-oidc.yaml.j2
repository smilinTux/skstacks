# Authentik blueprint: the OpenID login of skaegis (the Wazuh dashboard),
# skaegis.AUTH_MODE: oidc. Rendered by tasks/skaegis_blueprint.yml into
# /var/data/config/sksso-<env>/blueprints/ and mounted at /blueprints/custom;
# the Authentik worker discovers and applies it (idempotent, re-applied on
# change and periodically). The client secret is NOT in this file: it comes
# from the SKAEGIS_OIDC_CLIENT_SECRET environment variable (!Env).
#
# Access mode admin-only (APPLICATION_ACCESS_SSO_STANDARD): the application is
# bound to the group skadmin here, in the blueprint, so the gate is closed
# even when skaegis's portal tile is switched off. The tile task in skaegis's
# own deploy uses the SAME slug and the SAME group, finds this binding and
# leaves it unchanged (one Application, one binding). The dashboard maps the
# groups claim to its admin role from skadmin only; never "authentik Admins".
version: 1
metadata:
  name: skaegis-oidc (managed by skstacks sksso)
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_core.group
    id: admin-group
    identifiers:
      name: skadmin

  - model: authentik_providers_oauth2.scopemapping
    id: groups-scope
    identifiers:
      name: {{ (sksso_skaegis_client_id ~ ": OIDC groups claim") | to_json }}
    attrs:
      scope_name: groups
      description: "skaegis (Wazuh dashboard): the signed-in user's Authentik group names, mapped to backend roles by the indexer"
      expression: "return {\"groups\": [group.name for group in request.user.ak_groups.all()]}"

  - model: authentik_providers_oauth2.oauth2provider
    id: provider
    identifiers:
      name: {{ sksso_skaegis_client_id | to_json }}
    attrs:
      client_type: confidential
      client_id: {{ sksso_skaegis_client_id | to_json }}
      client_secret: !Env SKAEGIS_OIDC_CLIENT_SECRET
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      # The indexer's subject_key is preferred_username, so the subject mode
      # only affects the opaque `sub`.
      sub_mode: hashed_user_id
      issuer_mode: per_provider
      # Authentik 2026.2+: a new provider without grant_types gets none and
      # every authorize fails with invalid_request. Sign-in is the code flow.
      grant_types: [authorization_code, refresh_token]
      redirect_uris:
        - matching_mode: strict
          url: {{ ('https://' ~ sksso_skaegis_host ~ '/auth/openid/login') | to_json }}
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
        - !KeyOf groups-scope

  - model: authentik_core.application
    id: application
    identifiers:
      slug: {{ sksso_skaegis_client_id | to_json }}
    attrs:
      name: {{ sksso_skaegis_app_name | to_json }}
      provider: !KeyOf provider
      meta_launch_url: {{ ('https://' ~ sksso_skaegis_host ~ '/') | to_json }}
      policy_engine_mode: any

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf application
      group: !KeyOf admin-group
      order: 0
    attrs:
      enabled: true
      negate: false
      timeout: 30
