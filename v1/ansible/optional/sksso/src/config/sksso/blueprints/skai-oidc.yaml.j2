# Authentik blueprint: the OAuth2/OIDC sign-in of skai (Open WebUI),
# skai.AUTH_MODE: oidc. Rendered by tasks/skai_blueprint.yml into
# /var/data/config/sksso-<env>/blueprints/ and mounted at /blueprints/custom;
# the Authentik worker discovers and applies it (idempotent, re-applied on
# change and periodically). The client secret is NOT in this file: it comes
# from the SKAI_OIDC_CLIENT_SECRET environment variable (!Env).
#
# The application slug (sksso_skai_client_id) is the SAME value skai's own
# deploy defaults its portal tile to (AUTHENTIK_TILE_SLUG, default "skai"):
# shared/tasks/authentik_portal_tile.yml finds this exact Application by slug
# and keeps this provider when it manages the tile, so there is ONE Authentik
# Application, not two.
#
# Who may sign in (access mode app-groups): the application is bound here to
# the global admin group (sksso.ADMIN_GROUP, default skadmin) and to the skai
# users group (SKAI_USERS_GROUP, default skai-users), policy engine mode any,
# so the gate is closed even with skai's portal tile switched off. The group
# is created here; with SKAI_USERS set its membership IS that list (usernames,
# instance vars; a list here replaces the members on every apply), without it
# membership is left to the Authentik UI. skai's tile task binds the same
# groups and finds these bindings. Who becomes an Open WebUI admin is the
# groups claim (scope profile) matched against skai.ADMIN_GROUP.
#
# Open WebUI's callback is /oauth/oidc/login/callback (v0.13; the legacy
# /oauth/oidc/callback is registered too).
version: 1
metadata:
  name: skai-oidc (managed by skstacks sksso)
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_core.group
    id: admin-group
    identifiers:
      name: {{ sksso_skai_admin_group | to_json }}

  - model: authentik_core.group
    id: users-group
    identifiers:
      name: {{ sksso_skai_users_group | to_json }}
{% if sksso_skai_users | length > 0 %}
    attrs:
      users:
{% for u in sksso_skai_users %}
        - !Find [authentik_core.user, [username, {{ u | to_json }}]]
{% endfor %}
{% endif %}

  - model: authentik_providers_oauth2.oauth2provider
    id: provider
    identifiers:
      name: {{ sksso_skai_client_id | to_json }}
    attrs:
      client_type: confidential
      client_id: {{ sksso_skai_client_id | to_json }}
      client_secret: !Env SKAI_OIDC_CLIENT_SECRET
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
{% if sksso_skai_authentication_flow | length > 0 %}
      authentication_flow: !Find [authentik_flows.flow, [slug, {{ sksso_skai_authentication_flow | to_json }}]]
{% else %}
      authentication_flow: null
{% endif %}
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      sub_mode: hashed_user_id
      issuer_mode: per_provider
      # Authentik 2026.2+: a new provider without grant_types gets none and
      # every authorize fails with invalid_request. Sign-in is the code flow.
      grant_types: [authorization_code, refresh_token]
      redirect_uris:
        - matching_mode: strict
          url: {{ ('https://' ~ sksso_skai_host ~ '/oauth/oidc/login/callback') | to_json }}
        - matching_mode: strict
          url: {{ ('https://' ~ sksso_skai_host ~ '/oauth/oidc/callback') | to_json }}
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]

  - model: authentik_core.application
    id: application
    identifiers:
      slug: {{ sksso_skai_client_id | to_json }}
    attrs:
      name: {{ sksso_skai_app_name | to_json }}
      provider: !KeyOf provider
      meta_launch_url: {{ ('https://' ~ sksso_skai_host ~ '/') | to_json }}
      policy_engine_mode: any

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf application
      group: !KeyOf admin-group
      order: 0
    attrs:
      enabled: true
      negate: false
      timeout: 30

  - model: authentik_policies.policybinding
    identifiers:
      target: !KeyOf application
      group: !KeyOf users-group
      order: 10
    attrs:
      enabled: true
      negate: false
      timeout: 30
