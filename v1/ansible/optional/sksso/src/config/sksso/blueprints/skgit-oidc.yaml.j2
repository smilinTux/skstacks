# Authentik blueprint: the OAuth2/OIDC sign-in of skgit (Forgejo),
# skgit.AUTH_MODE: oidc. Rendered by tasks/skgit_blueprint.yml into
# /var/data/config/sksso-<env>/blueprints/ and mounted at /blueprints/custom;
# the Authentik worker discovers and applies it (idempotent, re-applied on
# change and periodically). The client secret is NOT in this file: it comes
# from the SKGIT_OIDC_CLIENT_SECRET environment variable (!Env).
#
# The application slug (sksso_skgit_client_id) is the SAME value skgit's own
# deploy defaults its portal tile to (AUTHENTIK_TILE_SLUG, default "skgit"):
# shared/tasks/authentik_portal_tile.yml finds this exact Application by slug
# and keeps this provider when it manages the tile, so oidc mode ends up with
# ONE Authentik Application, not two. Who may sign in is therefore the portal
# tile's own group binding (skgit.AUTHENTIK_TILE_GROUP), not a binding owned
# by this blueprint.
#
# Forgejo's callback is /user/oauth2/<auth source name>/callback; the source
# name is the one knob sksso.SKGIT_OIDC_SOURCE_NAME (default "SKStack SSO"),
# URL-encoded once in tasks/skgit_blueprint.yml. skgit's deploy creates the
# auth source under the same name (skgit.OIDC_SOURCE_NAME).
#
# authentication_flow: unset renders null, so the provider uses the brand's
# default login. sksso.SKGIT_OIDC_AUTHENTICATION_FLOW: capauth-authentication
# opts this one application into the CapAuth (PGP) login flow (see README
# "CapAuth login (optional)"); removing the knob unbinds it again.
version: 1
metadata:
  name: skgit-oidc (managed by skstacks sksso)
  labels:
    blueprints.goauthentik.io/instantiate: "true"
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: provider
    identifiers:
      name: {{ sksso_skgit_client_id | to_json }}
    attrs:
      client_type: confidential
      client_id: {{ sksso_skgit_client_id | to_json }}
      client_secret: !Env SKGIT_OIDC_CLIENT_SECRET
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
{% if sksso_skgit_authentication_flow | length > 0 %}
      authentication_flow: !Find [authentik_flows.flow, [slug, {{ sksso_skgit_authentication_flow | to_json }}]]
{% else %}
      authentication_flow: null
{% endif %}
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      sub_mode: hashed_user_id
      issuer_mode: per_provider
      # Authentik 2026.2+: a new provider without grant_types gets none and
      # every authorize fails with invalid_request. Sign-in is the code flow.
      grant_types: [authorization_code, refresh_token]
      redirect_uris:
        - matching_mode: strict
          url: {{ ('https://' ~ sksso_skgit_host ~ '/user/oauth2/' ~ sksso_skgit_source_name_enc ~ '/callback') | to_json }}
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]

  - model: authentik_core.application
    id: application
    identifiers:
      slug: {{ sksso_skgit_client_id | to_json }}
    attrs:
      name: {{ sksso_skgit_app_name | to_json }}
      provider: !KeyOf provider
      meta_launch_url: {{ ('https://' ~ sksso_skgit_host ~ '/') | to_json }}
