#!/bin/bash
set -e

# SKSSO ({{ env }}) deployment script
APPNAME=sksso
STACK_NAME={{ app }}-{{ env }}

CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/sksso.yml"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}Deploying ${STACK_NAME} stack (Authentik SSO)...${NC}"

# Source environment variables
if [ -f "${CONFIG_DIR}/${APPNAME}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    set -a
    source "${CONFIG_DIR}/${APPNAME}.sh.env"
    set +a
fi

# Export domain variables for Docker Compose variable substitution
export CLUSTERNAME DOMAIN BASE_DOMAIN INSTANCE APP_ENV

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# ============================================================================
# Network configuration (sourced from vault via Ansible templating)
# IMPORTANT: network subnets must match your instance's network registry.
# ============================================================================
declare -A NETWORKS
{% for network in app_networks | default([]) %}
NETWORKS["{{ network.name }}"]="{{ network.subnet }}"
{% endfor %}

ensure_networks() {
    echo -e "${YELLOW}Checking Docker overlay networks...${NC}"

    for NETWORK_NAME in "${!NETWORKS[@]}"; do
        SUBNET="${NETWORKS[$NETWORK_NAME]}"

        if docker network ls --format "{{ '{{' }}.Name{{ '}}' }}" | grep -q "^${NETWORK_NAME}$"; then
            CURRENT_SUBNET=$(docker network inspect "${NETWORK_NAME}" --format "{{ '{{' }}range .IPAM.Config{{ '}}' }}{{ '{{' }}.Subnet{{ '}}' }}{{ '{{' }}end{{ '}}' }}" 2>/dev/null | head -1)
            if [ "${CURRENT_SUBNET}" != "${SUBNET}" ]; then
                echo -e "${YELLOW}Network ${NETWORK_NAME} exists with subnet ${CURRENT_SUBNET}, expected ${SUBNET}${NC}"
                CONTAINERS_USING=$(docker network inspect "${NETWORK_NAME}" --format "{{ '{{' }}len .Containers{{ '}}' }}" 2>/dev/null || echo "0")
                if [ "${CONTAINERS_USING}" = "0" ]; then
                    docker network rm "${NETWORK_NAME}" 2>/dev/null || true
                    sleep 1
                    if docker network create --driver overlay --attachable --subnet "${SUBNET}" "${NETWORK_NAME}"; then
                        echo -e "${GREEN}Network ${NETWORK_NAME} recreated with subnet ${SUBNET}${NC}"
                    else
                        echo -e "${RED}Failed to recreate network ${NETWORK_NAME}${NC}"
                        exit 1
                    fi
                else
                    echo -e "${YELLOW}Network ${NETWORK_NAME} is in use (${CONTAINERS_USING} containers), leaving it alone${NC}"
                fi
            else
                echo -e "${GREEN}Network ${NETWORK_NAME} exists with correct subnet ${SUBNET}${NC}"
            fi
        else
            echo -e "${YELLOW}Creating overlay network ${NETWORK_NAME} with subnet ${SUBNET}...${NC}"
            if docker network create --driver overlay --attachable --subnet "${SUBNET}" "${NETWORK_NAME}"; then
                echo -e "${GREEN}Network ${NETWORK_NAME} created${NC}"
                sleep 2
            else
                echo -e "${RED}Failed to create network ${NETWORK_NAME}${NC}"
                exit 1
            fi
        fi
    done

    echo -e "${GREEN}Network verification complete${NC}"
}

ensure_networks

echo -e "${YELLOW}Deploying stack configuration...${NC}"
cd "${CONFIG_DIR}"
docker stack deploy -c "${COMPOSE_FILE}" "${STACK_NAME}"

sleep 10

echo -e "${YELLOW}Forcing service updates to pull latest images...${NC}"
docker service update --force --detach=false ${STACK_NAME}_server || true
docker service update --force --detach=false ${STACK_NAME}_worker || true

echo -e "${YELLOW}Waiting for services to stabilize...${NC}"
sleep 15

echo -e "${GREEN}Service status:${NC}"
docker service ls | grep "${STACK_NAME}"

echo -e "${YELLOW}Checking service health...${NC}"
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_server" --format "{{ '{{.Replicas}}' }}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} Authentik server is healthy and running.${NC}"
    echo -e "${GREEN}SSO URL: https://sso{% if env != 'prod' %}-{{ env }}{% endif %}.${BASE_DOMAIN}${NC}"
    echo -e "${GREEN}Initial setup: https://sso{% if env != 'prod' %}-{{ env }}{% endif %}.${BASE_DOMAIN}/if/flow/initial-setup/${NC}"
else
    echo -e "${RED}${STACK_NAME} Authentik server health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_server
fi

echo -e "${GREEN}Deployment complete.${NC}"
