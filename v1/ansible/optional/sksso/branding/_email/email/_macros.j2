[% macro h1(text) %]<tr><td style="padding:0 0 16px 0;"><h1 style="margin:0;font-family:[[ e.heading_font | default(e.font) ]];font-size:22px;line-height:1.3;color:[[ e.heading ]];">[[ text ]]</h1></td></tr>[% endmacro %]
[% macro p(text) %]<tr><td style="padding:0 0 16px 0;">[[ text ]]</td></tr>[% endmacro %]
[% macro button(href, label) %]<tr><td align="center" style="padding:8px 0 28px 0;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
    <td align="center" style="background-color:[[ e.accent ]];border-radius:8px;">
      <a id="confirm" href="[[ href ]]" rel="noopener noreferrer" target="_blank" style="display:inline-block;padding:14px 32px;font-size:16px;font-weight:700;color:[[ e.accent_text ]];text-decoration:none;border-radius:8px;">[[ label ]]</a>
    </td>
  </tr></table>
</td></tr>[% endmacro %]
[% macro fallback(href) %]<tr><td style="padding:16px 0 12px 0;">{% trans 'If the button does not work, copy this link into your browser:' %}<br><a href="[[ href ]]" style="color:[[ e.link ]];word-break:break-all;">[[ href ]]</a></td></tr>[% endmacro %]
[% macro note(text) %]<tr><td style="padding:0 0 4px 0;">[[ text ]]</td></tr>[% endmacro %]
