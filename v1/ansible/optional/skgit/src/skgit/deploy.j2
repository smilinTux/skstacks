#!/bin/bash
set -e

# SKGit deployment script (rendered)
APP="skgit"
STACK_NAME="skgit-{{ env }}"
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${GREEN}Deploying ${STACK_NAME} stack...${NC}"

# === Network Configuration (from vault) ===
# These networks are required for the stack to function
declare -A REQUIRED_NETWORKS
{% for network in app_networks %}
REQUIRED_NETWORKS["{{ network.name }}"]="{{ network.subnet }}"
{% endfor %}

# === Ensure Docker Swarm Overlay Networks Exist (Idempotent) ===
echo -e "${YELLOW}Ensuring required overlay networks exist...${NC}"

create_network_if_missing() {
    local network_name="$1"
    local subnet="$2"

    if docker network ls --format '{% raw %}{{.Name}}{% endraw %}' | grep -q "^${network_name}$"; then
        echo -e "${BLUE}  Network ${network_name} already exists${NC}"
    else
        echo -e "${YELLOW}  Creating network ${network_name} (subnet: ${subnet})...${NC}"
        if docker network create \
            --driver overlay \
            --attachable \
            --subnet "${subnet}" \
            "${network_name}" >/dev/null 2>&1; then
            echo -e "${GREEN}  Network ${network_name} created successfully${NC}"
            sleep 2
        else
            echo -e "${RED}  Failed to create network ${network_name}${NC}"
            echo -e "${YELLOW}    Attempting to continue anyway...${NC}"
        fi
    fi
}

for network_name in "${!REQUIRED_NETWORKS[@]}"; do
    create_network_if_missing "${network_name}" "${REQUIRED_NETWORKS[${network_name}]}"
done

echo -e "${GREEN}Network setup complete${NC}"

# Source environment variables
echo -e "${YELLOW}Loading environment variables...${NC}"

if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${BLUE}  Loading ${APP}.sh.env${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi

if [ -f "${CONFIG_DIR}/${APP}.env" ]; then
    echo -e "${BLUE}  Loading ${APP}.env${NC}"
    set -a
    grep -v '^#' "${CONFIG_DIR}/${APP}.env" | while IFS= read -r line; do
        [ -z "$line" ] && continue
        export "$line"
    done
    set +a
fi

if [ -f "${CONFIG_DIR}/postgres.env" ]; then
    echo -e "${BLUE}  Loading postgres.env${NC}"
    set -a
    grep -v '^#' "${CONFIG_DIR}/postgres.env" | while IFS= read -r line; do
        [ -z "$line" ] && continue
        export "$line"
    done
    set +a
fi

# Export environment for docker stack deploy
export CLUSTERNAME DOMAIN INSTANCE APP_ENV INSTANCENAME INSTANCE_URL
export SHARED_SECRET RUNNER_NAME RUNNER_REGISTRATION_TOKEN DOCKER_BIND_ADDR
export CPU_LIMIT CPU_RESERVATION

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

echo -e "${YELLOW}Deploying stack configuration...${NC}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 5

echo -e "${YELLOW}Updating services with new configuration...${NC}"
docker service update --force --detach=false ${STACK_NAME}_forgejo || true
docker service update --force --detach=false ${STACK_NAME}_postgres || true
docker service update --force --detach=false ${STACK_NAME}_db-backup || true

echo -e "${YELLOW}Waiting for services to stabilize...${NC}"
sleep 10

echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

echo -e "${YELLOW}Checking service health...${NC}"
REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_forgejo" --format "{% raw %}{{.Replicas}}{% endraw %}")
if [[ "$REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} is healthy and running.${NC}"
    echo -e "${GREEN}Access at: ${INSTANCE_URL}${NC}"
else
    echo -e "${RED}${STACK_NAME} health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_forgejo
fi

# === Runners (opt-in; see src/skgit/start-runners.sh) ===
RUNNERS_DIR="/var/data/${STACK_NAME}"
RUNNERS_COMPOSE="${CONFIG_DIR}/skgit-runners.yml"
START_SCRIPT="${RUNNERS_DIR}/start-runners.sh"

echo -e "${YELLOW}Checking/starting runners...${NC}"

if [ -f "${START_SCRIPT}" ]; then
    echo -e "${BLUE}  Starting runners via ${START_SCRIPT}${NC}"
    cd "${RUNNERS_DIR}"
    ./start-runners.sh
else
    echo -e "${YELLOW}  start-runners.sh not found, skipping${NC}"
fi

if [ -f "${RUNNERS_COMPOSE}" ]; then
    echo -e "${GREEN}Runners status:${NC}"
    docker compose -f "${RUNNERS_COMPOSE}" --project-name "${STACK_NAME}-runners" ps
else
    echo -e "${YELLOW}  Runners compose not found, checking containers${NC}"
    docker ps --filter "name=${STACK_NAME}-(dind|runner)" --format "table {% raw %}{{.Names}}\t{{.Status}}\t{{.Ports}}{% endraw %}"
fi

echo -e "${GREEN}Deployment complete.${NC}"
