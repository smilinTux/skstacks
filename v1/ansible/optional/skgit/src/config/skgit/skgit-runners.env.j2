INSTANCE_URL=https://{{ skgit.SUBDOMAIN_PREFIX | default('skgit') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skgit.CLUSTERNAME }}.{{ skgit.DOMAIN }}
# REQUIRED: no default. See skgit.sh.env.j2 for why a runner registration
# secret must never fall back to a literal value in a published framework.
RUNNER_REGISTRATION_TOKEN={{ skgit.RUNNER_REGISTRATION_TOKEN }}
RUNNER_NAME=skgit-{{ env }}-runner
