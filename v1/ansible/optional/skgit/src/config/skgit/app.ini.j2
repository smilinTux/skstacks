{%- set _base_domain = skgit.CLUSTERNAME ~ '.' ~ skgit.DOMAIN %}
{%- set _metrics_token = skgit.METRICS_TOKEN | default('') %}
{%- set _metrics_enabled = (skgit.METRICS_ENABLED if skgit.METRICS_ENABLED is defined else (_metrics_token | length > 0)) | bool %}
[server]
DOMAIN = {{ skgit.SUBDOMAIN_PREFIX | default('git') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}
ROOT_URL = https://{{ skgit.SUBDOMAIN_PREFIX | default('git') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}/
SSH_DOMAIN = {{ skgit.SUBDOMAIN_PREFIX | default('git') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}
SSH_PORT = 222
APP_DATA_PATH = /data/forgejo
# NOTE: this key is inert. Forgejo reads the repository root from [repository] ROOT,
# not from [server] REPOSITORY_ROOT, so the live instance actually stores repos under
# APP_DATA_PATH/forgejo-repositories (/data/forgejo/forgejo-repositories). Do NOT
# "correct" this to [repository] ROOT without physically moving the repositories
# first - doing so points Forgejo at an empty directory and every repo disappears.
REPOSITORY_ROOT = /data/git/repositories
ENABLE_PUSH_CREATE_USER = true
ENABLE_PUSH_CREATE_ORG = true
WORK_PATH = /data/gitea
# Both of these default to FALSE in Forgejo. They were present in a live app.ini but
# absent from an earlier version of this template, so a run of this playbook would
# have silently turned off the built-in SSH server (killing git+ssh on :222, which the
# Traefik TCP router points at) and the LFS server (orphaning any LFS objects).
START_SSH_SERVER = true
LFS_START_SERVER = true
{% if skgit.LFS_JWT_SECRET is defined and skgit.LFS_JWT_SECRET | length > 0 %}
LFS_JWT_SECRET = {{ skgit.LFS_JWT_SECRET }}
{% endif %}

[repository]
ENABLE_PUSH_CREATE_USER = true
ENABLE_PUSH_CREATE_ORG = true
MAX_CREATION_LIMIT = -1
DEFAULT_PUSH_CREATE_PRIVATE = true

[repository.upload]
FILE_MAX_SIZE = 5120
MAX_FILES = 100

[git]
MAX_GIT_DIFF_LINES = 1000000

[git.timeout]
DEFAULT = 3600
MIGRATE = 3600
MIRROR = 3600
CLONE = 3600
PULL = 3600
GC = 3600

[oauth2]
{% if skgit.OAUTH2_JWT_SECRET is defined and skgit.OAUTH2_JWT_SECRET | length > 0 %}
JWT_SECRET = {{ skgit.OAUTH2_JWT_SECRET }}
{% endif %}

[database]
DB_TYPE = postgres
HOST = skgit-{{ env }}_postgres:5432
NAME = forgejo
USER = forgejo
PASSWD = {{ skgit.POSTGRES_PASSWORD }}

[security]
INSTALL_LOCK = true
# REQUIRED: no default. A published framework must fail closed rather than
# ship every un-configured instance with the same secret key / internal token.
SECRET_KEY = {{ skgit.SECRET_KEY }}
INTERNAL_TOKEN = {{ skgit.INTERNAL_TOKEN }}

[lfs]
ENABLED = true
PATH = /data/lfs
MAX_FILE_SIZE = 5368709120
MAX_BATCH_SIZE = 20

[actions]
ENABLED = true
DEFAULT_ACTIONS_URL = https://code.forgejo.org

[packages]
ENABLED = true
{% if skgit.email_enabled | default(false) | bool %}

[mailer]
ENABLED = true
PROTOCOL = {% if (skgit.email_secure | default('ssl')) == 'ssl' %}smtps{% else %}smtp+starttls{% endif %}

SMTP_ADDR = {{ skgit.email_host }}
SMTP_PORT = {{ skgit.email_port | default(465) }}
SMTP_HOST = {{ skgit.email_host }}
FROM = {{ skgit.email_from }}
USER = {{ skgit.email_username }}
PASSWD = {{ skgit.email_password }}
{% endif %}

[log]
LEVEL = {{ skgit.LOG_LEVEL | default('Info') }}
ROOT_PATH = /data/log
MODE = {{ skgit.LOG_MODE | default('console,file') }}
FILE_NAME = {{ skgit.LOG_FILE | default('/data/log/forgejo.log') }}

[log.logger.router]
MODE = {{ skgit.LOG_ROUTER | default('console') }}
FILE_NAME = {{ skgit.LOG_FILE | default('/data/log/forgejo-router.log') }}

[metrics]
# Fail closed: this is the config Forgejo actually reads (this
# framework's entrypoint bypasses the image's environment-to-ini step,
# so app.ini -- not skgit.env's FORGEJO__metrics__* -- is authoritative).
ENABLED = {{ 'true' if _metrics_enabled else 'false' }}
ENABLED_ISSUE_BY_LABEL = {{ skgit.METRICS_ENABLED_ISSUE_BY_LABEL | default('true') }}
{% if _metrics_token %}
TOKEN = {{ _metrics_token }}
{% endif %}
