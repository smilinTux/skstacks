# PostgreSQL Backup Configuration for skgit
# Daily backups with 7-day retention

# PostgreSQL connection
PGPASSWORD={{ skgit.POSTGRES_PASSWORD }}

# Backup schedule (in seconds)
# 86400 = 24 hours (daily)
BACKUP_FREQUENCY={{ skgit.BACKUP_FREQUENCY | default('86400') }}

# Number of backup files to keep
BACKUP_NUM_KEEP={{ skgit.BACKUP_NUM_KEEP | default('7') }}
