# PostgreSQL Environment Variables for Forgejo

# Database Configuration
POSTGRES_USER=forgejo
POSTGRES_PASSWORD={{ skgit.POSTGRES_PASSWORD }}
POSTGRES_DB=forgejo

# Authentication Method
POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# Locale and Collation
POSTGRES_INITDB_ARGS=--locale=C --encoding=UTF8

# Timezone
TZ={{ skgit.TZ | default('UTC') }}

# Performance tuning
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_WAL_BUFFERS=16MB
POSTGRES_DEFAULT_STATISTICS_TARGET=100

# User and Group
USER_UID={{ skgit.USER_UID | default(1000) }}
USER_GID={{ skgit.USER_GID | default(1000) }}
