INSTANCENAME=skgit
CLUSTERNAME={{ skgit.CLUSTERNAME }}
DOMAIN={{ skgit.DOMAIN }}
INSTANCE_URL=https://{{ skgit.SUBDOMAIN_PREFIX | default('git') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skgit.CLUSTERNAME }}.{{ skgit.DOMAIN }}
RUNNER_NAME=skgit-{{ env }}-runner
# REQUIRED: no default. A published framework must fail closed rather than
# register CI runners against a shared literal token.
RUNNER_REGISTRATION_TOKEN={{ skgit.RUNNER_REGISTRATION_TOKEN }}
DOCKER_BIND_ADDR={{ skgit.DOCKER_BIND_ADDR | default('0.0.0.0') }}
SHARED_SECRET={{ skgit.SHARED_SECRET }}
