{%- set _base_domain = skgit.CLUSTERNAME ~ '.' ~ skgit.DOMAIN -%}
{%- set _r = 'skgit' ~ ('' if env == 'prod' else '-' ~ env) -%}
{%- set _host = (skgit.SUBDOMAIN_PREFIX | default('skgit')) ~ ('' if env == 'prod' else '-' ~ env) ~ '.' ~ _base_domain -%}
{%- set _web_mw = skgit.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file', true) -%}
{#- Crawler gate (Anubis): on unless skgit.ANUBIS_ENABLED is false. See README "Crawler gate". -#}
{#- Plain Jinja on purpose (no Ansible `bool` filter): true/false or their strings. -#}
{%- set _anubis = (skgit.ANUBIS_ENABLED | default(true) | string | lower) not in ['false', 'no', 'off', '0'] -%}
version: '3.8'

networks:
  cloud-public-{{ env }}:
    external: true
  skgit-{{ env }}:
    external: true

services:
  forgejo:
    image: codeberg.org/forgejo/forgejo:{{ skgit.FORGEJO_VERSION | default('17.0.1') }}
    user: "1000:1000"
    working_dir: /data
    entrypoint: /usr/local/bin/forgejo
    command: web
    env_file: /var/data/config/skgit-{{ env }}/skgit.env
    # No FORGEJO__* environment here. This service runs `forgejo web` directly
    # (not the image's s6 setup), so nothing turns FORGEJO__* variables into
    # app.ini: they were silently ignored. app.ini.j2, re-rendered by every
    # deploy, is the only Forgejo configuration (reverse proxy trust, session,
    # git.config, ...). Do not add environment-to-ini: skgit.env still carries
    # keys such as FORGEJO__security__INSTALL_LOCK=false that would reopen the
    # installer if they were ever applied.
    networks:
      - skgit-{{ env }}
      - cloud-public-{{ env }}
    volumes:
      # === NFS DATA - DIRECT BIND (NO NAMED VOLUME) ===
      - /var/data/skgit-{{ env }}/data:/data
      - /var/data/skgit-{{ env }}/config:/data/gitea/conf
      - /var/data/logs/skgit-{{ env }}:/data/log
      # Session files directory for file-based sessions (persistent across restarts)
      - /var/data/runtime/skgit-{{ env }}/sessions:/data/gitea/sessions
    # Traefik routing configured via Docker labels (Docker provider).
    # No file provider needed - Traefik auto-discovers services via Docker Swarm provider.
    # SSH (port 22) is exposed via a Traefik TCP router on port 222.
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints: {{ (skgit.placement_constraints | default([])) | tojson }}
      resources:
        limits:
          cpus: '${CPU_LIMIT}'
          memory: 4g
        reservations:
          cpus: '${CPU_RESERVATION}'
          memory: 2g
      labels:
        # === TRAEFIK: HTTP ===
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        # Main web router
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.rule=Host(`{{ skgit.SUBDOMAIN_PREFIX | default('skgit') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}`)"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.entrypoints=websecure"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.tls=true"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.tls.certresolver=main"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.tls.options=intermediate@file"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.middlewares={{ skgit.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file', true) }}"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.service={{ _r ~ '-anubis' if _anubis else _r }}"
        # === CONTAINER REGISTRY ROUTER (no middleware interference) ===
        # Dedicated route for /v2/ container registry API - higher priority to match before main router
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-registry.rule=Host(`{{ skgit.SUBDOMAIN_PREFIX | default('skgit') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}`) && PathPrefix(`/v2`)"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-registry.entrypoints=websecure"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-registry.tls=true"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-registry.tls.certresolver=main"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-registry.tls.options=intermediate@file"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-registry.priority=100"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-registry.service=skgit{% if env != 'prod' %}-{{ env }}{% endif %}"
{#  === DIRECT ROUTER (crawler gate on: everything that is not a browser page) ===
    With Anubis in front of the web UI, these paths still go straight to
    Forgejo so no git, API, registry, runner, OAuth or asset client ever sees a
    challenge, and an Anubis outage cannot break them: git smart HTTP and LFS
    (/<owner>/<repo>[.git]/info/refs, git-upload-pack, git-receive-pack,
    info/lfs/), the whole /api/ tree (REST, packages, runner RPC, which keeps its
    own priority 200 router when CrowdSec is on), the login page and the OAuth2 /
    OIDC flows (/user/login, /user/oauth2/<source>/callback, /login/oauth/*,
    /.well-known/*), static assets, avatars, robots.txt, favicon and /metrics
    (token protected). /v2 keeps its own registry router. Priority 150 sits
    above the main router (implicit, the rule length) and the registry (100),
    below runner RPC (200). Same middleware chain as the main router. #}
{% if _anubis %}
        # === DIRECT ROUTER: non-browser paths skip the Anubis crawler gate ===
        - "traefik.http.routers.{{ _r }}-direct.rule=Host(`{{ _host }}`) && (PathPrefix(`/api/`) || PathPrefix(`/assets/`) || PathPrefix(`/avatars/`) || PathPrefix(`/repo-avatars/`) || PathPrefix(`/user/login`) || PathPrefix(`/user/oauth2/`) || PathPrefix(`/login/oauth/`) || PathPrefix(`/.well-known/`) || Path(`/robots.txt`) || Path(`/favicon.ico`) || Path(`/favicon.svg`) || Path(`/metrics`) || PathRegexp(`^/[^/]+/[^/]+/(info/refs|git-upload-pack|git-receive-pack|info/lfs/)`))"
        - "traefik.http.routers.{{ _r }}-direct.entrypoints=websecure"
        - "traefik.http.routers.{{ _r }}-direct.tls=true"
        - "traefik.http.routers.{{ _r }}-direct.tls.certresolver=main"
        - "traefik.http.routers.{{ _r }}-direct.tls.options=intermediate@file"
        - "traefik.http.routers.{{ _r }}-direct.priority=150"
        - "traefik.http.routers.{{ _r }}-direct.middlewares={{ _web_mw }}"
        - "traefik.http.routers.{{ _r }}-direct.service={{ _r }}"
{% endif %}
{# Runner RPC router: skips the CrowdSec forward-auth.
    === RUNNER RPC ROUTER (skip the CrowdSec forward-auth) ===
    Rendered only when the main router runs crowdsec-bouncer (the only case it is
    needed), so an instance without that knob renders byte-identical to v2.26.4.
    Forgejo Actions runners poll /api/actions/runner.v1.RunnerService/ every few
    seconds. When the CrowdSec bouncer's LAPI lookup times out (~5 s) the bouncer
    fails closed with 403, so runners lose FetchTask/UpdateLog/UpdateTask calls.
    Forgejo still authenticates every runner RPC with the runner token.
    Override with skgit.RUNNER_RPC_MIDDLEWARES to put the bouncer back. #}
{% if 'crowdsec-bouncer' in (skgit.TRAEFIK_MIDDLEWARES | default('', true)) %}
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-runner-rpc.rule=Host(`{{ skgit.SUBDOMAIN_PREFIX | default('skgit') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}`) && PathPrefix(`/api/actions/runner.v1.RunnerService/`)"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-runner-rpc.entrypoints=websecure"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-runner-rpc.tls=true"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-runner-rpc.tls.certresolver=main"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-runner-rpc.tls.options=intermediate@file"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-runner-rpc.priority=200"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-runner-rpc.middlewares={{ skgit.RUNNER_RPC_MIDDLEWARES | default('default-no-crowdsec@file', true) }}"
        - "traefik.http.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-runner-rpc.service=skgit{% if env != 'prod' %}-{{ env }}{% endif %}"
{% endif %}
        # Service configuration
        - "traefik.http.services.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.server.port=3000"
        # === STICKY SESSIONS: Required to prevent ERR_NETWORK_CHANGED errors ===
        # Even with replicas: 1, multiple Traefik workers can cause requests to be routed
        # through different workers, leading to connection state issues.
        # Sticky sessions ensure all requests from the same client use the same Traefik worker.
        - "traefik.http.services.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky=true"
        - "traefik.http.services.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie=true"
        - "traefik.http.services.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie.name=skgit_session"
        - "traefik.http.services.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie.secure=true"
        - "traefik.http.services.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie.httpOnly=true"
        - "traefik.http.services.skgit{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie.sameSite=lax"
        # === TRAEFIK: TCP (SSH) ===
        - "traefik.tcp.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-ssh.rule=HostSNI(`*`)"
        - "traefik.tcp.routers.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-ssh.entrypoints=ssh"
        - "traefik.tcp.services.skgit{% if env != 'prod' %}-{{ env }}{% endif %}-ssh.loadbalancer.server.port=222"
    healthcheck:
      test: ["CMD", "curl", "-f", "-H", "User-Agent: Health-Check", "http://localhost:3000/"]
      interval: 60s   # Longer interval to reduce load
      timeout: 30s    # More generous timeout for Git operations
      retries: 2      # Fewer retries to prevent premature restarts
      # skgit.HEALTH_START_PERIOD (default 60m): a major Forgejo upgrade runs
      # its DB and repository migrations before the first answer, which on
      # slow or NFS storage takes far longer than 300s; with 300s and 2
      # retries Swarm killed the task mid-migration (15 -> 17). A healthy
      # Forgejo turns healthy as soon as it answers, so a long period costs
      # nothing on a normal start.
      start_period: {{ skgit.HEALTH_START_PERIOD | default('60m', true) }}
    # Note: depends_on doesn't work in Docker Swarm mode.
    # Forgejo retries the database connection instead (configured in app.ini).
    # start_period gives postgres time to become ready.
{% if _anubis %}

  # === CRAWLER GATE (Anubis, proof-of-work) ===
  # Browser page views (anything claiming Mozilla/Opera) get a short
  # proof-of-work challenge once per week per client, then a signed cookie;
  # known good crawlers are allowed by IP, non-browser clients (git, curl,
  # Go, Docker, CI) pass untouched. Scrapers that rotate Chrome user agents
  # over many IPs no longer reach Forgejo's expensive history pages (blame,
  # commits, raw, archive) that each spawn git processes. Policy: Anubis's
  # built-in default. git, API, registry, OAuth and assets never come here
  # (see the direct router on the forgejo service).
  # skgit.ANUBIS_ENABLED: false removes this service and routes the web UI
  # straight to Forgejo again.
  anubis:
    image: {{ skgit.ANUBIS_IMAGE | default('ghcr.io/techarohq/anubis:v1.28.2@sha256:5fcbce70ee6168be5b226d19bec90111d0acd0daf13028fa06b044cf3ebbbd5f') }}
    environment:
      - BIND=:8923
      - METRICS_BIND=:9090
      - TARGET=http://skgit-{{ env }}_forgejo:3000
      # Only ever redirect back to this host after a challenge (no open redirect).
      - REDIRECT_DOMAINS={{ _host }}
      # Forgejo serves the role's robots.txt (it reaches Forgejo directly).
      - SERVE_ROBOTS_TXT=false
      - SLOG_LEVEL={{ skgit.ANUBIS_LOG_LEVEL | default('INFO', true) }}
    networks:
      - skgit-{{ env }}
      - cloud-public-{{ env }}
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints: {{ (skgit.placement_constraints | default([])) | tojson }}
      resources:
        limits:
          cpus: '0.5'
          memory: 256M
        reservations:
          cpus: '0.05'
          memory: 64M
      labels:
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        # The main web router (labels on the forgejo service) points here.
        - "traefik.http.services.{{ _r }}-anubis.loadbalancer.server.port=8923"
    healthcheck:
      test: ["CMD", "/ko-app/anubis", "--healthcheck"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
{% endif %}

  postgres:
    image: postgres:16.15@sha256:f9a7b9ebf6f56201f949db745e47bc423c0f0f8294bafe991cc10bf74b029657
    env_file: /var/data/config/skgit-{{ env }}/postgres.env
    environment:
      - PGTEMP=/var/lib/postgresql/data/tmp
    networks:
      - skgit-{{ env }}
    volumes:
      # === NFS DATA - DIRECT BIND (NO NAMED VOLUME) ===
      - /var/data/runtime/skgit-{{ env }}/postgres:/var/lib/postgresql/data
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints: {{ (skgit.placement_constraints | default([])) | tojson }}
      resources:
        limits:
          cpus: '0.5'
          memory: 512M
        reservations:
          cpus: '0.25'
          memory: 256M
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U forgejo']
      interval: 20s
      timeout: 10s
      retries: 5
      start_period: 30s

  db-backup:
    image: postgres:16.15@sha256:f9a7b9ebf6f56201f949db745e47bc423c0f0f8294bafe991cc10bf74b029657
    env_file: /var/data/config/skgit-{{ env }}/postgres-backup.env
    environment:
      - PGTEMP=/dump/tmp
    networks:
      - skgit-{{ env }}
    deploy:
      placement:
        constraints: {{ (skgit.placement_constraints | default([])) | tojson }}
    volumes:
      # === NFS DATA - DIRECT BIND (NO NAMED VOLUME) ===
      - /var/data/skgit-{{ env }}/database-dump:/dump
      # Config files (read-only bind mounts)
      - /etc/localtime:/etc/localtime:ro
    # NOTE: do NOT wrap this in `bash -c 'bash -s <<EOF ... EOF'`. An unquoted
    # heredoc makes the OUTER shell expand ${TS}/${TMP}/${FINAL} before the inner
    # shell ever sees them; they are unset there, so the dump redirect becomes
    # `> ""` and every cycle dies with `: No such file or directory`. Pass the
    # script as a single argv element instead, so exactly one shell expands it.
    entrypoint:
      - bash
      - -c
      - |
        trap "break;exit" SIGHUP SIGINT SIGTERM
        sleep 2m
        while /bin/true; do
          TS=$$(date +%d-%m-%Y_%H_%M_%S)
          TMP=/dump/dump_$${TS}.sql.gz.tmp
          FINAL=/dump/dump_$${TS}.sql.gz
          set -o pipefail
          if pg_dumpall -h postgres -U forgejo | gzip -c > "$${TMP}"; then
            SIZE=$$(stat -c %s "$${TMP}")
            if [ "$${SIZE}" -gt 1024 ]; then
              mv "$${TMP}" "$${FINAL}"
              echo "[backup] OK: $${FINAL} ($${SIZE} bytes)"
              ls -tr /dump/dump_*.sql.gz | head -n -"$${BACKUP_NUM_KEEP}" | xargs -r rm
            else
              echo "[backup] FAIL: dump too small ($${SIZE} bytes), discarding" 1>&2
              rm -f "$${TMP}"
            fi
          else
            echo "[backup] FAIL: pg_dumpall pipe exited non-zero, discarding" 1>&2
            rm -f "$${TMP}"
          fi
          set +o pipefail
          sleep $${BACKUP_FREQUENCY}
        done

# Runner services (Forgejo Actions + DinD) are deployed separately via
# skgit-runners.yml (docker compose, not swarm) so they can bind-mount the
# host Docker socket path and run privileged/DinD containers. See
# src/skgit/start-runners.sh and src/skgit/stop-runners.sh.

# No named volumes - all mounts are direct bind mounts
# Simpler, faster, zero-config
