# SKGit (Forgejo) Environment Configuration
# Generated from vault variables with environment-specific best practice defaults

{%- set _base_domain = skgit.CLUSTERNAME ~ '.' ~ skgit.DOMAIN %}

# Container User/Group (vault-controlled)
USER_UID={{ skgit.USER_UID | default(1000) }}
USER_GID={{ skgit.USER_GID | default(1000) }}

# Database Configuration (vault-controlled)
FORGEJO__database__DB_TYPE=postgres
FORGEJO__database__HOST=postgres:5432
FORGEJO__database__NAME=forgejo
FORGEJO__database__USER=forgejo
FORGEJO__database__PASSWD={{ skgit.POSTGRES_PASSWORD }}

# Shared Secret for Actions (vault-controlled)
SHARED_SECRET={{ skgit.SHARED_SECRET }}
FORGEJO__actions__RUN_AS__SHARED_SECRET={{ skgit.SHARED_SECRET }}

# Actions Configuration
FORGEJO__actions__ENABLED={{ skgit.ACTIONS_ENABLED | default("true") }}
FORGEJO__actions__DEFAULT_ACTIONS_URL=https://code.forgejo.org

# Packages Configuration
FORGEJO__packages__ENABLED={{ skgit.PACKAGES_ENABLED | default("true") }}

# Server Configuration (vault-controlled with environment-specific defaults)
FORGEJO__server__DOMAIN={{ skgit.SUBDOMAIN_PREFIX | default('git') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}
FORGEJO__server__ROOT_URL=https://{{ skgit.SUBDOMAIN_PREFIX | default('git') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}/
FORGEJO__server__SSH_DOMAIN={{ skgit.SUBDOMAIN_PREFIX | default('git') }}{% if env != 'prod' %}-{{ env }}{% endif %}.{{ _base_domain }}
FORGEJO__server__SSH_PORT=222

# Repository Configuration
FORGEJO__lfs__ENABLED={{ skgit.LFS_ENABLED | default("true") }}
FORGEJO__lfs__PATH=/data/lfs
FORGEJO__server__APP_DATA_PATH=/data/forgejo
FORGEJO__server__REPOSITORY_ROOT=/data/git/repositories
FORGEJO__server__ENABLE_PUSH_CREATE_USER={{ skgit.ENABLE_PUSH_CREATE_USER | default("true") }}
FORGEJO__server__ENABLE_PUSH_CREATE_ORG={{ skgit.ENABLE_PUSH_CREATE_ORG | default("true") }}

# Security Configuration (vault-controlled, REQUIRED - no default)
FORGEJO__security__INSTALL_LOCK=false
FORGEJO__security__SECRET_KEY={{ skgit.SECRET_KEY }}
FORGEJO__security__INTERNAL_TOKEN={{ skgit.INTERNAL_TOKEN }}

# Installation Configuration
FORGEJO__install__LOCK=false
FORGEJO__install__FORCE_ADMIN={{ skgit.FORCE_ADMIN | default("true") }}

# REQUIRED | Admin Configuration (vault-controlled, no default)
FORGEJO__admin__USERNAME={{ skgit.ADMIN_USERNAME | default("skadmin") }}
FORGEJO__admin__PASSWORD={{ skgit.ADMIN_PASSWORD }}
FORGEJO__admin__EMAIL={{ skgit.ADMIN_EMAIL }}

# Environment-specific logging levels (industry best practices)
# Production: minimal logging for performance
# Staging: moderate logging for troubleshooting
# Development: maximum logging for debugging
FORGEJO__log__LEVEL={{ skgit.LOG_LEVEL | default("Info" if env == "prod" else "Info" if env == "staging" else "Debug") }}
FORGEJO__log__ROOT_PATH=/data/log
FORGEJO__log__MODE={{ skgit.LOG_MODE | default("console,file") }}
FORGEJO__log__logger__router__MODE={{ skgit.LOG_ROUTER | default("console") }}
FORGEJO__log__logger__router__FILE_NAME={{ skgit.LOG_FILE | default("/data/log/forgejo-router.log") }}

# Environment-specific resource limits (scaled by environment)
CPU_LIMIT={{ skgit.CPU_LIMIT | default("2.0" if env == "prod" else "1.0" if env == "staging" else "0.5") }}
MEMORY_LIMIT={{ skgit.MEMORY_LIMIT | default("4Gi" if env == "prod" else "2Gi" if env == "staging" else "1Gi") }}
CPU_RESERVATION={{ skgit.CPU_RESERVATION | default("1.0" if env == "prod" else "0.5" if env == "staging" else "0.25") }}
MEMORY_RESERVATION={{ skgit.MEMORY_RESERVATION | default("2Gi" if env == "prod" else "1Gi" if env == "staging" else "512Mi") }}

# Environment-specific replicas
REPLICAS=1

# Environment-specific security settings
TLS_ENABLED={{ skgit.TLS_ENABLED | default("true" if env != "dev" else "false") }}
DEBUG_MODE={{ skgit.DEBUG_MODE | default("false" if env != "dev" else "true") }}
SECURITY_HEADERS={{ skgit.SECURITY_HEADERS | default("true" if env == "prod" else "false") }}

# Environment-specific monitoring levels
MONITORING_ENABLED={{ skgit.MONITORING_ENABLED | default("true") }}
METRICS_INTERVAL={{ skgit.METRICS_INTERVAL | default("10s" if env == "prod" else "15s" if env == "staging" else "30s") }}
HEALTH_CHECK_INTERVAL={{ skgit.HEALTH_CHECK_INTERVAL | default("10s" if env == "prod" else "30s" if env == "staging" else "60s") }}
LOG_METRICS={{ skgit.LOG_METRICS | default("false" if env == "prod" else "true" if env == "staging" else "true") }}

# Metrics Configuration
FORGEJO__metrics__ENABLED=true
FORGEJO__metrics__ENABLED_ISSUE_BY_LABEL=true
FORGEJO__metrics__TOKEN={{ skgit.METRICS_TOKEN | default('') }}

# Email Configuration (SMTP) - Configured from vault if email_enabled is true
EMAIL_ENABLED={{ skgit.email_enabled | default(false) }}
{% if skgit.email_enabled | default(false) | bool %}
FORGEJO__mailer__ENABLED=true
FORGEJO__mailer__HOST={{ skgit.email_host }}
FORGEJO__mailer__PORT={{ skgit.email_port | default(465) }}
FORGEJO__mailer__USER={{ skgit.email_username }}
FORGEJO__mailer__PASSWD='{{ skgit.email_password }}'
FORGEJO__mailer__FROM={{ skgit.email_from }}
{% if skgit.email_secure | default('ssl') == 'ssl' %}
FORGEJO__mailer__IS_TLS_ENABLED=false
FORGEJO__mailer__IS_SSL_ENABLED=true
{% else %}
FORGEJO__mailer__IS_TLS_ENABLED=true
FORGEJO__mailer__IS_SSL_ENABLED=false
{% endif %}
{% endif %}
