#!/bin/sh
# Block until the local docker engine is an active swarm member, then give an
# attachable overlay up to 120s to become visible locally. ExecStartPre of
# host-level containers that join a swarm overlay (skstream DUMB).
# Usage: sk-wait-swarm-net <network> [timeout_seconds, default 600]
# Exit 1 on swarm timeout so systemd retries (Restart=always, no start limit).
NET="${1:?network}"; T="${2:-600}"; i=0
until [ "$(docker info --format '{{.Swarm.LocalNodeState}}' 2>/dev/null)" = active ] \
   && [ -n "$(docker info --format '{{.Swarm.NodeID}}' 2>/dev/null)" ]; do
  i=$((i+2)); [ "$i" -ge "$T" ] && { echo "swarm not active after ${T}s"; exit 1; }; sleep 2
done
j=0
until docker network inspect "$NET" >/dev/null 2>&1; do
  j=$((j+2)); [ "$j" -ge 120 ] && { echo "$NET not visible locally yet; attaching via manager"; break; }; sleep 2
done
echo "swarm active, $NET ready"
