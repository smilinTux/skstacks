#!/usr/bin/env python3
"""Converge the parts of DUMB / cli_debrid state that skstream manages as code.

Both config files are seeded once and then owned by the apps (UI edits, token
refreshes), so a deploy must not re-render them. This script upserts only the
keys skstream owns and leaves everything else byte-for-byte as parsed:

  dumb_config.json   cli_debrid release pin (release_version_enabled/release_version)
  cli_debrid config  "Other Plex Watchlist" sources (one per Plex Home profile, keyed
                     by username), one "My Friends Plex RSS Watchlist" source, and
                     their content_source_check_period, hard filter_out
                     patterns on each managed scraping version (append only),
                     preferred_filter_out [pattern, weight] pairs (upsert by
                     pattern), each managed version's foreign_language_penalty,
                     the global Scraping.minimum_scrape_score and
                     Reverse Parser.default_version

Sources it did not create are never removed or edited. The desired state comes
as JSON on stdin (it carries tokens, so never as argv):

  {"cli_debrid_version": "v0.7.81" | "",
   "other_watchlists": [{"username": "JD", "token": "...", "display_name": "..."}],
   "friends_rss_url": "https://rss.plex.tv/..." | "",
   "versions": ["1080p"], "cutoff_date": "", "check_minutes": 5,
   "filter_out": ["<regex>", ...] | null,
   "preferred_filter_out": [["<regex>", 400], ...] | null,
   "foreign_language_penalty": 1000 | null, "minimum_scrape_score": 1.0 | null,
   "reverse_parser_default_version": "1080p" | null}

filter_out null means DEFAULT_FILTER_OUT (the play sends null when
CLI_DEBRID_FILTER_OUT is unset); absent or [] adds nothing. The same goes for
preferred_filter_out and DEFAULT_PREFERRED_FILTER_OUT.
foreign_language_penalty / minimum_scrape_score null mean the DEFAULT_* values
below (the play sends null when the knob is unset); absent leaves the key alone.
reverse_parser_default_version null means the first managed version.

Prints {"dumb_changed": bool, "cli_changed": bool} and nothing secret.
"""
import argparse
import fcntl
import json
import os
import sys

DATA = "/data/cli_debrid"  # the unit binds <LOCAL_ROOT>/dumb-data at /data
OTHER = "Other Plex Watchlist"
FRIENDS = "My Friends Plex RSS Watchlist"

# Hard-reject foreign-dub releases. cli_debrid's language_code "en" plus
# foreign_language_penalty only lowers a score, so on nor a cached Russian
# season pack (The.Rainmaker.S02.1080p.Ru.Ultradox) still won S02E02/E03 over
# plenty of English releases (2026-11-10), and a library scan found more
# Russian-only audio (ViruseProject, ColdFilm, LostFilm, MegaPeer). Matches the
# language tags and the Russian dub/tracker groups as whole words, and any
# Cyrillic letter (titles like "Благодетель / The Rainmaker"). cli_debrid
# treats a pattern with regex metacharacters as a case-insensitive regex.
#
# Second pattern: 3D Blu-ray ISO torrents. cli_debrid does not count an .iso as
# video, so on nor (2026-11-15) Ant-Man and Captain America: The Winter Soldier
# (both ...1080p.3D.BluRay...-RARBG ISOs) were "collected" as the 0 MB
# RARBG.com.mp4 promo clip the torrent also carries. A bare "3D" is not matched
# (Piranha 3D, Jackass 3D are titles), only 3D next to a disc or SBS tag, SBS,
# BDMV, ISO, COMPLETE BLURAY and RARBG.com.
#
# Third pattern: RiffTrax releases, where comedians talk over the episode to
# mock it and the riff track is the default audio. On nor (2026-11-22)
# Stranger.Things.s01e01.2016.1080p.Rifftrax.6ch.2ch.AVC.mkv was collected
# next to the real BluRay S01E01. Its riff track is tagged English, so neither
# the language filters nor skstream-langguard can tell it apart.
#
# Fourth pattern: AUDIONEW / NEW AUDIO, a theater cam rip with a cleaner audio
# track laid over it. cli_debrid drops CAM/TS/TELESYNC only through PTT's
# "trash" flag, and PTT does not know this tag, so on nor (2026-11-24)
# You.Can.See.Everything.2026.AUDIONEW.1080P was collected as a 1080p release.
DEFAULT_FILTER_OUT = [
    r"(?i)\b(rus|ru|rudub|ukr|ultradox|lostfilm|newstudio|hdrezka|alexfilm|jaskier|baibako"
    r"|coldfilm|ideafilm|dublyazh|viruseproject|megapeer|rutor|rutracker)\b|[А-Яа-яЁё]",
    r"(?i)\b3d[ ._-]+(blu-?ray|bd|h-?sbs|sbs|half|full|h?ou|tab)\b|\b(h-?sbs|bdmv|iso|complete[ ._-]?blu-?ray)\b"
    r"|\brarbg\.com\b",
    r"(?i)\briff[ ._-]?trax\b",
    r"(?i)\b(audio[ ._-]?new|new[ ._-]?audio)\b",
]

# Rank down, not drop, multi/dual-audio releases and the dub groups behind them.
# They carry English but mark a foreign track as the default (Heart of the Beast
# MULTi YTO: French default with French forced subs; a Plex scan on nor found
# ~1150 such files: iTA-ENG CYBER/NAHOM/Licdom/MIRCrew, MULTi VF2/TRUEFRENCH,
# Hindi dual audio, LATINO), and cli_debrid's language detection exempts
# MULTi/DUAL. 400 puts them near 240 against ~640 for a plain English release,
# still above minimum_scrape_score, so a title that only exists as multi-audio
# is still found. "Multi.Sub" (subtitles) is not matched. skstream-langguard
# then selects the English track per Plex user.
DEFAULT_PREFERRED_FILTER_OUT = [
    [r"(?i)\b(multi\d?|dual|ita|hin|hindi|latino|esp|vff|vf2|vfq|vfi|truefrench|french|lektor|hebdub"
     r"|cyber|nahom|licdom|realdmdj|mircrew|icv|yto|selezen|exkinoray|new-team|hdhub4u)\b(?![ ._-]?subs?\b)", 400],
]

# Drop, not just rank down, a release whose name tags an audio language other
# than the version's (cli_debrid's own detection: subtitle tags, MULTi/DUAL/DL
# and the title's original language are exempt). The Adding queue takes any
# cached release before any uncached one whatever its score, so the stock
# penalty (30) let a cached Russian pack beat uncached English releases on nor.
# The penalty is multiplied by language_weight (default 3): 1000 puts a tagged
# release near -2350, while real releases scored 483-953 on nor, so a minimum
# score of 1 drops exactly those. This is cli_debrid's documented way to drop
# releases (see audio_description_penalty); minimum_scrape_score is global.
DEFAULT_FOREIGN_LANGUAGE_PENALTY = 1000
DEFAULT_MINIMUM_SCRAPE_SCORE = 1.0


def _source(kind, display_name, versions, cutoff_date, **extra):
    return {"enabled": True, **extra, "versions": list(versions), "media_type": "All",
            "display_name": display_name, "allow_specials": False,
            "custom_symlink_subfolder": "", "cutoff_date": cutoff_date,
            "exclude_genres": [], "list_length_limit": 0, "type": kind}


def _next_id(sources, kind):
    nums = [int(k.rsplit("_", 1)[1]) for k in sources if k.rsplit("_", 1)[-1].isdigit()]
    return f"{kind}_{max(nums, default=0) + 1}"


def converge_dumb(cfg, version):
    """Pin cli_debrid to `version` in a parsed dumb_config. '' leaves it alone.

    cli_debrid v0.7.29 (ef4deb5b) folded CLI Battery into the main process and
    dropped cli_battery/main.py, but DUMB (2.22.1 and 2.23.0 both bake 0.7.23)
    still starts it as its own service. With a newer pin that service crashes and,
    because DUMB makes cli_debrid depend on it, cli_debrid never starts. So a pin
    also switches DUMB's standalone CLI Battery off.
    """
    if not version:
        return False
    changed = False
    cd = cfg.setdefault("cli_debrid", {})
    want = {"release_version_enabled": True, "release_version": version, "branch_enabled": False}
    if not all(cd.get(k) == v for k, v in want.items()):
        cd.update(want)
        changed = True
    battery = cfg.get("cli_battery")
    if isinstance(battery, dict) and battery.get("enabled") is not False:
        battery["enabled"] = False
        changed = True
    # DUMB points cli_debrid at /cli_debrid/data, a symlink to /data/cli_debrid made
    # at container start. With a release pin DUMB reinstalls /cli_debrid on every
    # start, and on nor the link was gone by the time cli_debrid ran (PermissionError
    # on /cli_debrid/data, every start). Point cli_debrid at the real paths instead.
    paths = {"config_file": f"{DATA}/config/config.json", "log_file": f"{DATA}/logs/debug.log"}
    env = {"USER_CONFIG": f"{DATA}/config/", "USER_LOGS": f"{DATA}/logs/",
           "USER_DB_CONTENT": f"{DATA}/db_content/"}
    cur_env = cd.setdefault("env", {})
    if any(cd.get(k) != v for k, v in paths.items()) or any(cur_env.get(k) != v for k, v in env.items()):
        cd.update(paths)
        cur_env.update(env)
        changed = True
    return changed


def converge_cli(cfg, spec):
    """Upsert managed content sources into a parsed cli_debrid config."""
    sources = cfg.setdefault("Content Sources", {})
    versions = spec.get("versions") or ["1080p"]
    cutoff = str(spec.get("cutoff_date") or "")
    managed, changed = [], False

    for w in spec.get("other_watchlists") or []:
        user, token = w["username"], w["token"]
        sid = next((k for k, v in sources.items()
                    if isinstance(v, dict) and v.get("type") == OTHER and v.get("username") == user), None)
        if sid is None:
            sid = _next_id(sources, OTHER)
            sources[sid] = _source(OTHER, w.get("display_name") or f"Plex Watchlist - {user}",
                                   versions, cutoff, username=user, token=token)
            changed = True
        elif sources[sid].get("token") != token or not sources[sid].get("enabled"):
            sources[sid].update(token=token, enabled=True)
            changed = True
        managed.append(sid)

    url = spec.get("friends_rss_url") or ""
    if url:
        sid = next((k for k, v in sources.items() if isinstance(v, dict) and v.get("type") == FRIENDS), None)
        if sid is None:
            sid = _next_id(sources, FRIENDS)
            sources[sid] = _source(FRIENDS, "Plex Friends Watchlist", versions, cutoff, url=url)
            changed = True
        elif sources[sid].get("url") != url or not sources[sid].get("enabled"):
            sources[sid].update(url=url, enabled=True)
            changed = True
        managed.append(sid)

    patterns = spec.get("filter_out", [])
    if patterns is None:
        patterns = DEFAULT_FILTER_OUT
    if patterns:
        scraping = cfg.setdefault("Scraping", {}).setdefault("versions", {})
        for v in versions:
            fo = scraping.setdefault(v, {}).setdefault("filter_out", [])
            have = {x.get("pattern") if isinstance(x, dict) else x for x in fo}
            for pat in patterns:
                if pat not in have:
                    fo.append(pat)
                    changed = True

    if "preferred_filter_out" in spec:
        pairs = spec["preferred_filter_out"]
        if pairs is None:
            pairs = DEFAULT_PREFERRED_FILTER_OUT
        scraping = cfg.setdefault("Scraping", {}).setdefault("versions", {})
        for v in versions:
            pfo = scraping.setdefault(v, {}).setdefault("preferred_filter_out", [])
            for pat, weight in pairs:
                weight = int(weight) if float(weight).is_integer() else float(weight)
                cur = next((x for x in pfo if isinstance(x, list) and x and x[0] == pat), None)
                if cur is None:
                    pfo.append([pat, weight])
                    changed = True
                elif len(cur) < 2 or cur[1] != weight:
                    cur[1:] = [weight]
                    changed = True

    if "foreign_language_penalty" in spec:
        penalty = spec["foreign_language_penalty"]
        penalty = DEFAULT_FOREIGN_LANGUAGE_PENALTY if penalty is None else float(penalty)
        scraping = cfg.setdefault("Scraping", {}).setdefault("versions", {})
        for v in versions:
            ver = scraping.setdefault(v, {})
            if ver.get("foreign_language_penalty") != penalty:
                ver["foreign_language_penalty"] = int(penalty) if penalty.is_integer() else penalty
                changed = True
    if "minimum_scrape_score" in spec:
        score = spec["minimum_scrape_score"]
        score = DEFAULT_MINIMUM_SCRAPE_SCORE if score is None else float(score)
        sc = cfg.setdefault("Scraping", {})
        if sc.get("minimum_scrape_score") != score:
            sc["minimum_scrape_score"] = score
            changed = True

    # cli_debrid labels a file it did not scrape itself (Plex sync, reverse parser)
    # "<Reverse Parser default_version>**", and never matches the generic 1080p /
    # 2160p names, so with an empty default (the seed) every such row on nor was a
    # bare "**". The rescrape route strips the stars to "", and an item with no
    # version is scraped with default settings: no filter_out, no penalties. That
    # is how a Russian Supersex pack and an Italian Tulsa King came back
    # (2026-11-15). Default it to a managed version.
    if "reverse_parser_default_version" in spec:
        want = spec["reverse_parser_default_version"] or versions[0]
        rp = cfg.setdefault("Reverse Parser", {})
        if rp.get("default_version") != want:
            rp["default_version"] = want
            changed = True

    minutes = spec.get("check_minutes")
    if minutes and managed:
        period = cfg.setdefault("Debug", {}).setdefault("content_source_check_period", {})
        for sid in managed:
            if period.get(sid) != int(minutes):
                period[sid] = int(minutes)
                changed = True
    return changed


def _rewrite(path, fn, arg):
    """Load, apply fn, and atomically replace `path` (same owner and mode) under
    the app's own lock file when it has one. Returns whether it changed."""
    lock = os.path.join(os.path.dirname(path), "config.lock")
    with open(lock if os.path.exists(lock) else path, "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        with open(path) as f:
            cfg = json.load(f)
        if not fn(cfg, arg):
            return False
        st = os.stat(path)
        tmp = path + ".skstream-converge.tmp"
        with open(tmp, "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
        os.chmod(tmp, st.st_mode & 0o7777)
        os.chown(tmp, st.st_uid, st.st_gid)
        os.replace(tmp, path)
        return True


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--dumb-config", required=True)
    p.add_argument("--cli-config", required=True)
    a = p.parse_args(argv)
    spec = json.load(sys.stdin)
    out = {"dumb_changed": _rewrite(a.dumb_config, converge_dumb, spec.get("cli_debrid_version") or ""),
           "cli_changed": _rewrite(a.cli_config, converge_cli, spec)}
    print(json.dumps(out))


if __name__ == "__main__":
    main()
