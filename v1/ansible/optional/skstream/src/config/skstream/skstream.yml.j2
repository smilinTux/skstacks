version: '3.8'

# skstream: Plex (+ optional Kometa) in swarm. The Real-Debrid side (zurg +
# rclone FUSE mount + cli_debrid) is NOT in this stack: it runs host-level as
# skstream-dumb.service on the media node (see README.md, "Why host-level").
# Plex is pinned to that node (skstream.placement_constraints, default the
# node label skstream-media=true) so it sees the FUSE mount via rslave.
{% set sfx = '' if env == 'prod' else '-' + env %}
{% set local_root = skstream.LOCAL_ROOT | default('/var/lib/skstream' + sfx) %}
{% set constraints = (skstream.placement_constraints | default(['node.labels.skstream-media == true'])) | tojson %}

services:
  plex:
    image: {{ skstream.PLEX_IMAGE | default('plexinc/pms-docker:1.43.5.11079-b3b13e506@sha256:6d778d41daae68f89115aa87a44ae14a96b23e71a2093da173b5a9aac4091336') }}
    # Plex needs time to close its SQLite DB cleanly.
    stop_grace_period: 60s
    env_file: /var/data/config/{{ app }}-{{ env }}/plex.env
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "3" }
    volumes:
      - type: bind
        source: /var/data/{{ app }}-{{ env }}/plex/config
        target: /config
      - type: bind
        source: /var/data/{{ app }}-{{ env }}/plex/transcode
        target: /transcode
      # SQLite must not live on NFS: with it there Plex logs "Waited over 10
      # seconds for a busy database" and API clients time out. Local disk on
      # the media node; Plex's own periodic DB backups go to /config (NFS).
      - type: bind
        source: {{ local_root }}/plex-db
        target: "/config/Library/Application Support/Plex Media Server/Plug-in Support/Databases"
      - type: bind
        source: /var/data/{{ app }}-{{ env }}/zurg/mnt
        target: /mnt/debrid
        read_only: true
        bind:
          propagation: rslave
{% for b in skstream.PLEX_EXTRA_BINDS | default([]) if b is mapping and b.source is defined and b.target is defined %}
      # extra read-only media for Plex libraries (e.g. skfetch downloads)
      - type: bind
        source: {{ b.source }}
        target: {{ b.target }}
        read_only: true
{% endfor %}
    networks:
      - {{ app }}-{{ env }}
      - cloud-public-{{ env }}
    deploy:
      mode: replicated
      # dnsrr (default): "plex" resolves straight to the task IP, no VIP.
      # Host-level containers attached to this attachable overlay (skstream
      # DUMB, skfetch) get their IPs from the local daemon, which can hand
      # out an address already held as this service's VIP (seen after a
      # full-cluster reboot). "plex" then resolved to an IP owned by another
      # container and calls were black-holed; freeing the IP left stale
      # IPVS routing. Plex publishes no ports and Traefik targets task IPs,
      # so dnsrr costs nothing here. PLEX_ENDPOINT_MODE: vip | dnsrr.
      endpoint_mode: {{ skstream.PLEX_ENDPOINT_MODE | default('dnsrr') }}
      replicas: 1
      restart_policy:
        condition: any
        delay: 10s
      placement:
        constraints: {{ constraints }}
      resources:
        limits:
          cpus: '{{ skstream.PLEX_RESOURCES_LIMITS_CPUS | default("2.00") }}'
          memory: {{ skstream.PLEX_RESOURCES_LIMITS_MEMORY | default("3G") }}
      labels:
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        - "traefik.http.routers.skstream{{ sfx }}.rule=Host(`skstream{{ sfx }}.{{ skstream.CLUSTERNAME }}.{{ skstream.DOMAIN }}`)"
        - "traefik.http.routers.skstream{{ sfx }}.entrypoints=websecure"
        - "traefik.http.routers.skstream{{ sfx }}.tls=true"
        - "traefik.http.routers.skstream{{ sfx }}.tls.certresolver=main"
        - "traefik.http.routers.skstream{{ sfx }}.service=skstream{{ sfx }}"
        - "traefik.http.services.skstream{{ sfx }}.loadbalancer.server.port=32400"
{% if skstream.tls_options | default('') %}
        - "traefik.http.routers.skstream{{ sfx }}.tls.options={{ skstream.tls_options }}"
{% endif %}
{% set _mw = (skstream.router_middlewares_pre | default([])) + (skstream.router_middlewares | default([])) %}
{% if _mw %}
        - "traefik.http.routers.skstream{{ sfx }}.middlewares={{ _mw | join(',') }}"
{# === API ROUTER (raw upstream status codes) ===
    Plex is an API first: apps, TVs, Tautulli and the plex.tv relay call `/library`, `/identity`,
    `/:/`, `/hubs`, `/status`, `/media` and many more. Only the browser UI (`/web`) is a page, so this
    router takes every path except `/web`.
    The instance's router chain (router_middlewares) usually carries error-pages@file, which
    swaps every 4xx/5xx for an HTML page and replays the ORIGINAL method there, so API
    clients never saw the app's real status or JSON error. This router sends the machine
    paths through the same chain with each error-pages-bearing chain swapped for its
    no-error-pages form; anything else in the chain (SSO, custom middlewares) is kept.
    skstream.API_MIDDLEWARES replaces the derived chain. #}
{% set _api_swap = {'default@file': 'default-no-error-pages@file', 'default-no-crowdsec@file': 'default-no-error-pages@file', 'upload-chain@file': 'large-upload-buffering@file,default-security-headers@file', 'upload-chain-no-crowdsec@file': 'large-upload-buffering@file,default-security-headers@file', 'skai-chain@file': 'skai-headers@file,gzip@file', 'error-pages@file': '', 'error-pages-all@file': ''} %}
{% set _api_mw = [] %}
{% for _m in (_mw | join(',')).split(',') %}
{% set _s = _api_swap.get(_m | trim, _m | trim) %}
{% if _s %}
{% set _ = _api_mw.append(_s) %}
{% endif %}
{% endfor %}
        - "traefik.http.routers.skstream{{ sfx }}-api.rule=Host(`skstream{{ sfx }}.{{ skstream.CLUSTERNAME }}.{{ skstream.DOMAIN }}`) && !PathPrefix(`/web`)"
        - "traefik.http.routers.skstream{{ sfx }}-api.entrypoints=websecure"
        - "traefik.http.routers.skstream{{ sfx }}-api.tls=true"
        - "traefik.http.routers.skstream{{ sfx }}-api.tls.certresolver=main"
{% if skstream.tls_options | default('') %}
        - "traefik.http.routers.skstream{{ sfx }}-api.tls.options={{ skstream.tls_options }}"
{% endif %}
        - "traefik.http.routers.skstream{{ sfx }}-api.priority=150"
        - "traefik.http.routers.skstream{{ sfx }}-api.middlewares={{ skstream.API_MIDDLEWARES | default(_api_mw | unique | join(','), true) }}"
        - "traefik.http.routers.skstream{{ sfx }}-api.service=skstream{{ sfx }}"
{% endif %}
{% if skstream.KOMETA_ENABLED | default(false) | bool %}

  kometa:
    image: {{ skstream.KOMETA_IMAGE | default('kometateam/kometa@sha256:93b0909d1a34d75985c2258f451aac4ece4216d02f0c4914a0a4fa4be39a88c0') }}
    env_file: /var/data/config/{{ app }}-{{ env }}/kometa.env
    environment:
      - TZ={{ skstream.TZ | default('UTC') }}
      - KOMETA_RUN=false
      - KOMETA_TIME={{ skstream.KOMETA_TIME | default('03:00') }}
      - KOMETA_PLEX_URL=http://plex:32400
    logging:
      driver: json-file
      options: { max-size: "10m", max-file: "3" }
    volumes:
      - type: bind
        source: /var/data/{{ app }}-{{ env }}/kometa/config
        target: /config
    networks:
      - {{ app }}-{{ env }}
    deploy:
      mode: replicated
      replicas: 1
      restart_policy:
        condition: any
        delay: 60s
      placement:
        constraints: {{ constraints }}
      resources:
        limits:
          cpus: '{{ skstream.KOMETA_RESOURCES_LIMITS_CPUS | default("1.00") }}'
          memory: {{ skstream.KOMETA_RESOURCES_LIMITS_MEMORY | default("768M") }}
{% endif %}

networks:
  {{ app }}-{{ env }}:
    external: true
  cloud-public-{{ env }}:
    external: true
