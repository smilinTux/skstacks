# Generated by Ansible (skstream). Plex as a host-level container on the media
# node, used when skstream.PLEX_MODE is "host" (the default "swarm" runs Plex
# in the stack instead and this unit is not installed).
# Why host-level: a swarm service cannot get a device, so swarm Plex cannot
# use the iGPU (/dev/dri) for hardware transcoding (see README.md, "Plex
# hardware transcoding"). Same pattern as skstream-dumb.service.
#  - joins the {{ app }}-{{ env }} overlay as "plex", so DUMB, Kometa and the
#    zurg hook keep calling http://plex:32400
#  - publishes 32400 on PLEX_LAN_BIND_ADDRESS only; Traefik reaches it through
#    the file-provider route skstream-traefik.yml
#  - never runs next to a swarm Plex task (one database, one server)
{% set sfx = '' if env == 'prod' else '-' + env %}
{% set local_root = skstream.LOCAL_ROOT | default('/var/lib/skstream' + sfx) %}
{% set mnt = '/var/data/' + app + '-' + env + '/zurg/mnt' %}
{% set transcode = skstream.PLEX_TRANSCODE_DIR | default('/var/data/' + app + '-' + env + '/plex/transcode', true) %}
{% set hw = skstream.PLEX_HW_TRANSCODE | default(false) | bool %}
{% set render_gid = skstream.PLEX_RENDER_GID | default(skstream_render_gid | default(''), true) | string %}
[Unit]
Description=skstream{{ sfx }} Plex Media Server (host-level)
After=docker.service network-online.target remote-fs.target skstream-dumb{{ sfx }}.service
Wants=network-online.target skstream-dumb{{ sfx }}.service
Requires=docker.service
RequiresMountsFor=/var/data/{{ app }}-{{ env }}
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=90
ExecStartPre=/usr/local/sbin/sk-wait-swarm-net {{ app }}-{{ env }}
ExecStartPre=/bin/sh -c 'for i in $$(seq 1 90); do docker ps -q --filter label=com.docker.swarm.service.name={{ app }}-{{ env }}_plex | grep -q . || exit 0; sleep 2; done; echo "swarm {{ app }}-{{ env }}_plex is still running here; refusing to start a second Plex" >&2; exit 1'
ExecStartPre=-/usr/bin/docker rm -f skstream-plex{{ sfx }}
ExecStartPre=/bin/mkdir -p {{ transcode }}
ExecStart=/usr/bin/docker run --rm --name skstream-plex{{ sfx }} --hostname skstream-plex{{ sfx }} \
  --env-file /var/data/config/{{ app }}-{{ env }}/plex.env \
  --cpus {{ skstream.PLEX_RESOURCES_LIMITS_CPUS | default("2.00") }} \
  --memory {{ skstream.PLEX_RESOURCES_LIMITS_MEMORY | default("3G") }} \
  --stop-timeout 60 \
  --log-opt max-size=10m --log-opt max-file=3 \
{% if hw %}
  --device /dev/dri:/dev/dri \
{% if render_gid %}
  --group-add {{ render_gid }} \
{% endif %}
{% endif %}
  -p {{ skstream.PLEX_LAN_BIND_ADDRESS }}:32400:32400 \
  -v /var/data/{{ app }}-{{ env }}/plex/config:/config \
  -v {{ transcode }}:/transcode \
  "--volume={{ local_root }}/plex-db:/config/Library/Application Support/Plex Media Server/Plug-in Support/Databases" \
  -v {{ mnt }}:/mnt/debrid:ro,rslave \
{% for b in skstream.PLEX_EXTRA_BINDS | default([]) if b is mapping and b.source is defined and b.target is defined %}
  -v {{ b.source }}:{{ b.target }}:ro \
{% endfor %}
  --network {{ app }}-{{ env }} --network-alias plex \
  {{ skstream.PLEX_IMAGE | default('plexinc/pms-docker:1.43.5.11079-b3b13e506@sha256:6d778d41daae68f89115aa87a44ae14a96b23e71a2093da173b5a9aac4091336') }}
ExecStop=/usr/bin/docker stop -t 60 skstream-plex{{ sfx }}

[Install]
WantedBy=multi-user.target docker.service
