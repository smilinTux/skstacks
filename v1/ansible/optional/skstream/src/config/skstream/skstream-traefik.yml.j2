{% set sfx = '' if env == 'prod' else '-' + env %}
{% set _mw = (skstream.router_middlewares_pre | default([])) + (skstream.router_middlewares | default([])) %}
# Generated by Ansible (skstream). Traefik file-provider route for Plex when
# skstream.PLEX_MODE is "host": the same router the swarm labels define, pointed
# at the LAN bind of skstream-plex.service. Middlewares must be @file names.
http:
  routers:
    skstream{{ sfx }}:
      rule: "Host(`skstream{{ sfx }}.{{ skstream.CLUSTERNAME }}.{{ skstream.DOMAIN }}`)"
      entryPoints: [websecure]
      tls:
        certResolver: {{ skstream.TRAEFIK_CERT_RESOLVER | default('main') }}
{% if skstream.tls_options | default('') %}
        options: {{ skstream.tls_options }}
{% endif %}
{% if _mw %}
      middlewares: {{ _mw | to_json }}
{% endif %}
      service: skstream{{ sfx }}
  services:
    skstream{{ sfx }}:
      loadBalancer: { servers: [ { url: "http://{{ skstream.PLEX_LAN_BIND_ADDRESS }}:32400" } ] }
