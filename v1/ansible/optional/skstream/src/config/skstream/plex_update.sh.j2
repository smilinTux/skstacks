#!/bin/sh
# Generated by Ansible (skstream). zurg on_library_update hook: ask Plex for a
# partial scan of every changed directory so new titles appear in seconds, not
# on the next full scan. zurg passes paths relative to the mount root, e.g.
# "movies/Some Movie (2020)". Plex ignores a path outside a section's
# locations, so every section is asked. The token is read at runtime from
# DUMB's own config, so no secret is written into this file.
T=$(python3 -c 'import json;print(json.load(open("/config/dumb_config.json"))["dumb"]["plex_token"])') || exit 0
P=http://plex:32400
S=$(curl -s --max-time 15 -H "X-Plex-Token: $T" -H "Accept: application/json" "$P/library/sections" \
  | python3 -c 'import json,sys;print(" ".join(d["key"] for d in json.load(sys.stdin)["MediaContainer"]["Directory"]))') || exit 0
for a in "$@"; do
  for s in $S; do
    curl -s -o /dev/null --max-time 20 -G -H "X-Plex-Token: $T" \
      --data-urlencode "path=/mnt/debrid/{{ skstream.RCLONE_MOUNT_NAME | default('rclone_RD') }}/$a" "$P/library/sections/$s/refresh"
  done
  echo "plex partial scan requested: $a"
done
