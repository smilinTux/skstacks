# Generated by Ansible (skstream). DUMB: zurg (Real-Debrid WebDAV) + rclone
# FUSE mount + cli_debrid (+ cli_battery) for Plex.
# Host-level, not a swarm service: a swarm service on Docker 27 cannot get
# /dev/fuse, --privileged or apparmor=unconfined (see README.md).
# Boot-race hardening (an outage once came from a host container that started
# before swarm and then stayed down after a docker restart):
#  - waits for swarm before joining the {{ app }}-{{ env }} overlay
#  - WantedBy docker.service: a docker stop/start brings it back
#  - StartLimitIntervalSec=0: never gives up; stale FUSE mount cleaned on stop
# SQLite state (/data, /log) is on local disk; /config is on NFS.
{% set sfx = '' if env == 'prod' else '-' + env %}
{% set local_root = skstream.LOCAL_ROOT | default('/var/lib/skstream' + sfx) %}
{% set mnt = '/var/data/' + app + '-' + env + '/zurg/mnt' %}
[Unit]
Description=skstream{{ sfx }} DUMB (zurg + rclone + cli_debrid) for Plex
After=docker.service network-online.target remote-fs.target
Wants=network-online.target
Requires=docker.service
RequiresMountsFor=/var/data/{{ app }}-{{ env }}
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=10
TimeoutStartSec=0
TimeoutStopSec=90
ExecStartPre=/usr/local/sbin/sk-wait-swarm-net {{ app }}-{{ env }}
ExecStartPre=-/usr/bin/docker rm -f skstream-dumb{{ sfx }}
ExecStartPre=-/bin/umount -l {{ mnt }}/{{ skstream.RCLONE_MOUNT_NAME | default('rclone_RD') }}
ExecStartPre=/bin/mkdir -p {{ local_root }}/rclone-cache {{ local_root }}/dumb-data {{ local_root }}/dumb-log
ExecStart=/usr/bin/docker run --rm --name skstream-dumb{{ sfx }} --hostname skstream-dumb{{ sfx }} \
  --cap-add SYS_ADMIN \
  --device /dev/fuse:/dev/fuse:rwm \
  --security-opt apparmor:unconfined \
  --shm-size 128m \
  --memory {{ skstream.DUMB_MEMORY_LIMIT | default('2g') }} \
  --stop-timeout 60 \
  --log-opt max-size=10m --log-opt max-file=3 \
  -e TZ={{ skstream.TZ | default('UTC') }} -e PUID={{ skstream.PUID | default(1000) }} -e PGID={{ skstream.PGID | default(1000) }} \
  -v /var/data/{{ app }}-{{ env }}/dumb/config:/config \
  -v {{ local_root }}/dumb-log:/log \
  -v {{ local_root }}/dumb-data:/data \
{% for b in skstream.DUMB_EXTRA_BINDS | default([]) if b is mapping and b.source is defined and b.target is defined %}
  -v {{ b.source }}:{{ b.target }}{{ ':ro' if (b.read_only | default(true) | bool) else '' }} \
{% endfor %}
  -v {{ local_root }}/rclone-cache:/cache \
  -v {{ mnt }}:/mnt/debrid:rshared \
  --network {{ app }}-{{ env }} --network-alias dumb \
  {{ skstream.DUMB_IMAGE | default('iampuid0/dumb@sha256:e2cef506fc6c40027ca092f6f86759c516fc4386b3f0fa4bd1048b4be50f1877') }}
ExecStop=/usr/bin/docker stop -t 60 skstream-dumb{{ sfx }}
ExecStopPost=-/bin/umount -l {{ mnt }}/{{ skstream.RCLONE_MOUNT_NAME | default('rclone_RD') }}

[Install]
WantedBy=multi-user.target docker.service
