# skhome (HomeCenter) runtime environment ({{ env }}). Root only (0600):
# AUTH_SECRET signs sessions and encrypts the stored mail password / AI key.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=file:/data/homecenter.db
AUTH_SECRET={{ skhome.AUTH_SECRET }}
AUTH_URL=https://{{ skh_host }}
UPLOAD_DIR=/data/uploads
MODELS_DIR=/data/models
MAX_UPLOAD_BYTES={{ skhome.MAX_UPLOAD_BYTES | default(26214400, true) }}
# First boot only: HomeCenter seeds the admin account once, then ignores
# these. Changing them later in the vault has no effect on an existing
# instance (see README "First admin account").
ADMIN_NAME={{ skhome.ADMIN_NAME | default('Admin', true) }}
ADMIN_EMAIL={{ skhome.ADMIN_EMAIL | default('admin@localhost', true) }}
{% if skhome.ADMIN_PASSWORD | default('', true) %}
ADMIN_PASSWORD={{ skhome.ADMIN_PASSWORD }}
{% endif %}
# ADMIN_PASSWORD left unset above when the vault does not set one: HomeCenter's
# own seed then uses "changeme" AND forces a password reset on first login,
# which is safer than this framework baking in the same literal for every
# instance that forgets to set it (v1/tests/test_no_default_secrets.py).
NOTIFY_INTERVAL_MINUTES={{ skhome.NOTIFY_INTERVAL_MINUTES | default(360, true) }}
DIGEST_HOUR={{ skhome.DIGEST_HOUR | default(8, true) }}
DOCUMENT_REINDEX_HOURS={{ skhome.DOCUMENT_REINDEX_HOURS | default(6, true) }}
EMBEDDING_IDLE_MINUTES={{ skhome.EMBEDDING_IDLE_MINUTES | default(10, true) }}
{% if skhome.SEARCH_INDEX_PATH | default('', true) %}
SEARCH_INDEX_PATH={{ skhome.SEARCH_INDEX_PATH }}
{% endif %}
{% if skhome.SMTP_HOST | default('', true) %}
# Email is off (no SMTP_HOST) by default: "leave blank and no email is ever
# sent" (upstream README). Settings saved in the app's own UI win over
# these and survive even if the vault block is later removed.
SMTP_HOST={{ skhome.SMTP_HOST }}
SMTP_PORT={{ skhome.SMTP_PORT | default(587, true) }}
{% if skhome.SMTP_USER | default('', true) %}
SMTP_USER={{ skhome.SMTP_USER }}
SMTP_PASS={{ skhome.SMTP_PASS | default('', true) }}
{% endif %}
{% if skhome.SMTP_SECURE is defined %}
SMTP_SECURE={{ '1' if skhome.SMTP_SECURE | bool else '0' }}
{% endif %}
MAIL_FROM={{ skhome.MAIL_FROM | default('HomeCenter <no-reply@homecenter.local>', true) }}
{% if skhome.MAIL_DRY_RUN | default(false) | bool %}
MAIL_DRY_RUN=1
{% endif %}
{% endif %}
TZ={{ skhome.TZ | default('UTC', true) }}
{% for k, v in (skhome.extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
