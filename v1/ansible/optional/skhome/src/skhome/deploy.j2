#!/bin/bash
set -e

# Never force-restart a service on its FIRST install (first-boot migrate +
# seed must finish); a redeploy restarts the app when the play changed its
# env file or the AUTH_SECRET, and the backup sidecar when it changed the
# backup script, which the stack spec cannot see (env_file / bind mounts).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot migrate/seed must finish)"
    return 1
}

# skhome (HomeCenter) Deploy Script
# Environment: {{ env }}
APPNAME=skhome
STACK_NAME=skhome-{{ env }}
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skhome.yml"
APP="${STACK_NAME}_app"
BACKUP="${STACK_NAME}_backup"

if [ -f "${CONFIG_DIR}/${APPNAME}.sh.env" ]; then
    source "${CONFIG_DIR}/${APPNAME}.sh.env"
fi

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo "Error: Compose file not found: ${COMPOSE_FILE}"
    exit 1
fi

cd "${CONFIG_DIR}"

record_preexisting "${APP}" "${BACKUP}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

if [ "${RESTART_APP:-0}" = 1 ]; then
    echo "The play changed the env file or AUTH_SECRET of ${APP}"
    preexisted "${APP}" && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=true "${APP}" || true
fi
if [ "${RESTART_BACKUP:-0}" = 1 ]; then
    echo "The play changed the backup script of ${BACKUP}"
    preexisted "${BACKUP}" && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=true "${BACKUP}" || true
fi

# Budget tied to FIRST_INSTALL_WAIT_SECONDS (skhome.sh.env, from
# skhome.first_install_wait_seconds): the SAME knob the compose
# healthcheck's start_period uses, so a slow first boot (migrate deploy +
# seed + loading the bundled embedding model) gets the same patience from
# both the ansible wait and Swarm's own health-triggered restart policy.
WAIT_SECONDS="${FIRST_INSTALL_WAIT_SECONDS:-120}"
ATTEMPTS=$(( (WAIT_SECONDS + 4) / 5 ))
echo "Waiting up to ${WAIT_SECONDS}s for ${APP} to converge..."
for _ in $(seq 1 "${ATTEMPTS}"); do
    REPLICAS=$(docker service ls --filter "name=${APP}" --format "{% raw %}{{.Replicas}}{% endraw %}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$REPLICAS" == "1/1" ]]; then
    echo "${APP} is running"
else
    echo "${APP} not converged after ${WAIT_SECONDS}s: ${REPLICAS}"
    docker service logs --tail 20 "${APP}" || true
fi
BACKUP_REPLICAS_NOW=$(docker service ls --filter "name=${BACKUP}" --format "{% raw %}{{.Replicas}}{% endraw %}" | head -1)
echo "${BACKUP}: ${BACKUP_REPLICAS_NOW:-not deployed (BACKUP_ENABLED false)}"
echo "Web UI: https://${SKHOME_HOST:-unknown}/"
echo "Deployment complete!"
