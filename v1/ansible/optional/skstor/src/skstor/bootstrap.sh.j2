#!/bin/bash
# =============================================================================
# SKStor Garage Cluster Layout Bootstrap
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKStor (Garage S3-compatible object storage)
# Environment: {{ env }}
# =============================================================================
# Swarm can schedule the garage task on any node in the cluster, not
# necessarily the manager that ran `docker stack deploy`, so this script is
# copied to and executed on whichever node is actually running the
# {{ app }}-{{ env }}_garage task (see the "Find swarm node running the
# Garage task" / "Run Garage cluster layout bootstrap" tasks in the
# deploy_{{ app }}-{{ env }}.yml playbook) instead of being run inline by
# deploy.j2 on the manager.
#
# One-time cluster layout bootstrap. Garage refuses to serve S3 traffic on a
# node with no assigned layout, so a brand-new instance needs this once; a
# redeploy of an already-bootstrapped node is a no-op. `garage status` can't
# tell the two apart (it lists a connected node before it has a role, and
# truncates IDs), so this keys off the current layout version: 0 = never applied.
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

APP="{{ app }}"
ENV_NAME="{{ env }}"
STACK_NAME="${APP}-${ENV_NAME}"

CONTAINER_ID=$(docker ps -q --filter "label=com.docker.swarm.service.name=${STACK_NAME}_garage" | head -1)
if [ -z "${CONTAINER_ID}" ]; then
    echo -e "${RED}Could not find a running garage container to bootstrap.${NC}"
    exit 1
fi

NODE_ID=$(docker exec "${CONTAINER_ID}" /garage node id -q | cut -d@ -f1)
LAYOUT_VERSION=$(docker exec "${CONTAINER_ID}" /garage layout show | grep -oE 'Current cluster layout version: [0-9]+' | grep -oE '[0-9]+$' || true)
if [ "${LAYOUT_VERSION:-0}" -ge 1 ]; then
    echo -e "${GREEN}Layout already applied (version ${LAYOUT_VERSION}).${NC}"
else
    echo -e "${YELLOW}No layout assigned yet - bootstrapping single-node layout...${NC}"
    docker exec "${CONTAINER_ID}" /garage layout assign -z dc1 -c {{ skstor.layout_capacity | default('1G') }} "${NODE_ID}"
    docker exec "${CONTAINER_ID}" /garage layout apply --version $(( ${LAYOUT_VERSION:-0} + 1 ))
    echo -e "${GREEN}Layout applied for node ${NODE_ID}.${NC}"
    echo -e "${YELLOW}No bucket/key exists yet. See this service's README.md for the${NC}"
    echo -e "${YELLOW}one-time 'garage key create' / 'garage bucket create' / 'garage${NC}"
    echo -e "${YELLOW}bucket allow' commands each consumer needs.${NC}"
fi
