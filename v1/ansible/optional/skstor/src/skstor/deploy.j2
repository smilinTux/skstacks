#!/bin/bash
# =============================================================================
# SKStor Deploy Script
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKStor (Garage S3-compatible object storage)
# Environment: {{ env }}
# =============================================================================
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

APP="skstor"
ENV_NAME="{{ env }}"
CONFIG_DIR="/var/data/config/${APP}-${ENV_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"
STACK_NAME="${APP}-${ENV_NAME}"

if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi
export CLUSTERNAME DOMAIN INSTANCE APP_ENV BASE_DOMAIN

echo -e "${GREEN}Deploying ${STACK_NAME} stack (Garage S3)...${NC}"

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 10

echo -e "${YELLOW}Checking service health...${NC}"
REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_garage" --format "{{ '{{.Replicas}}' }}")
if [[ "$REPLICAS" != "1/1" ]]; then
    echo -e "${RED}${STACK_NAME} Garage health check: ${REPLICAS}${NC}"
    docker service logs --tail 20 "${STACK_NAME}_garage" || true
    exit 1
fi
echo -e "${GREEN}${STACK_NAME} Garage is healthy and running.${NC}"

# One-time cluster layout bootstrap. Garage refuses to serve S3 traffic on a
# node with no assigned layout, so a brand-new instance needs this once; a
# redeploy of an already-bootstrapped node is a no-op (its node ID already
# shows up in `garage status`).
CONTAINER_ID=$(docker ps -q --filter "label=com.docker.swarm.service.name=${STACK_NAME}_garage" | head -1)
if [ -z "${CONTAINER_ID}" ]; then
    echo -e "${RED}Could not find a running garage container to bootstrap.${NC}"
    exit 1
fi

NODE_ID=$(docker exec "${CONTAINER_ID}" /garage node id -q | cut -d@ -f1)
if docker exec "${CONTAINER_ID}" /garage status | grep -q "${NODE_ID}"; then
    echo -e "${GREEN}Layout already assigned for node ${NODE_ID}.${NC}"
else
    echo -e "${YELLOW}No layout assigned yet - bootstrapping single-node layout...${NC}"
    docker exec "${CONTAINER_ID}" /garage layout assign -z dc1 -c 1 "${NODE_ID}"
    LAYOUT_VERSION=$(docker exec "${CONTAINER_ID}" /garage layout show | grep -oE 'version [0-9]+' | head -1 | awk '{print $2}')
    docker exec "${CONTAINER_ID}" /garage layout apply --version "${LAYOUT_VERSION:-1}"
    echo -e "${GREEN}Layout applied for node ${NODE_ID}.${NC}"
    echo -e "${YELLOW}No bucket/key exists yet. See this service's README.md for the${NC}"
    echo -e "${YELLOW}one-time 'garage key create' / 'garage bucket create' / 'garage${NC}"
    echo -e "${YELLOW}bucket allow' commands each consumer needs.${NC}"
fi

echo -e "${GREEN}Deployment complete!${NC}"
