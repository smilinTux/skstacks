# Generated by Ansible - DO NOT EDIT MANUALLY
# skstor ({{ env }}): Garage config. Reference:
# https://garagehq.deuxfleurs.fr/documentation/reference-manual/configuration/
# See this service's README.md for the one-time layout/key/bucket bootstrap.

# ponytail: metadata_dir/data_dir default onto the shared NFS bind mount
# (/var/lib/garage/{meta,data}, see skstor.yml.j2), same as every other
# service on this estate. db_engine defaults to "sqlite" rather than
# Garage's own default "lmdb": Garage's docs say LMDB "is prone to database
# corruption after an unclean shutdown (e.g. a process kill or a power
# outage)" and recommend metadata_auto_snapshot_interval to recover from
# that -- and "Sqlite ... does not have the issues listed above for LMDB"
# (same page, #db_engine). A Swarm reschedule of this replicas=1 service is
# exactly that kind of unclean shutdown, and LMDB is memory-mapped, which is
# a well-known bad combination with network filesystems generally (not a
# Garage-specific claim). Sqlite is slower, but this is a single-writer
# instance, not a high-throughput cluster, so correctness wins. An operator
# who wants LMDB's speed back can set skstor.db_engine=lmdb and point
# skstor.meta_dir at a node-local SSD bind mount plus a Swarm placement
# constraint pinning this service to that node -- that trade (fast, but
# ties the service to one node) is the ceiling this default is avoiding.
metadata_dir = "{{ skstor.meta_dir | default('/var/lib/garage/meta') }}"
data_dir = "{{ skstor.data_dir | default('/var/lib/garage/data') }}"
db_engine = "{{ skstor.db_engine | default('sqlite') }}"

# Single node today, matching this framework's single-manager Swarm pattern.
# Bump to 3 (and add peers) only once this service moves to the multi-node
# pattern v2/platform/swarm/stacks/skobject already uses.
replication_factor = {{ skstor.REPLICATION_FACTOR | default(1) }}

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
# Required, no default: a random 32-byte hex string (`openssl rand -hex 32`),
# unique per instance. This is node-to-node RPC auth, not an S3 credential.
rpc_secret = "{{ skstor.rpc_secret }}"

[s3_api]
s3_region = "{{ skstor.GARAGE_S3_REGION | default('garage') }}"
api_bind_addr = "[::]:3900"
