# skbom (Dependency-Track) frontend environment ({{ env }}). Root-only
# (0600), same convention as the role's other env files, although nothing
# in here is secret (OIDC_CLIENT_ID is a public SPA client id).
TZ={{ skbom.TZ | default('UTC', true) }}
# The frontend's own entrypoint writes this into the SPA's served config at
# container start; it must be the public URL the browser calls the API on,
# which is this same host (PathPrefix(`/api`) routes it to apiserver).
API_BASE_URL=https://{{ skb_host }}
BASE_PATH=/
{% if skbom.OIDC_ENABLED | default(false) | bool %}
# Same issuer and client id as apiserver's ALPINE_OIDC_* (one Authentik
# OIDC application, trusted by both sides). See README.md "OIDC login".
OIDC_ISSUER={{ skbom.OIDC_ISSUER }}
OIDC_CLIENT_ID={{ skbom.OIDC_CLIENT_ID }}
OIDC_LOGIN_BUTTON_TEXT={{ skbom.OIDC_LOGIN_BUTTON_TEXT | default('Login with SSO', true) }}
{% endif %}
