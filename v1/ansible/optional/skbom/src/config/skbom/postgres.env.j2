# skbom Postgres. Root-only (0600). Unlike skflow's Windmill, Dependency-
# Track needs no cluster-level roles, just ownership of its own database,
# so POSTGRES_USER/POSTGRES_DB are enough (no superuser-only migration
# step to account for here).
POSTGRES_USER={{ skbom.DB_USERNAME | default('dtrack', true) }}
POSTGRES_PASSWORD={{ skbom.DB_PASSWORD | default('', true) }}
POSTGRES_DB={{ skbom.DB_NAME | default('dtrack', true) }}
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256
TZ={{ skbom.TZ | default('UTC', true) }}
