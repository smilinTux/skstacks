# skbom Postgres dump sidecar. Root-only (0600). pg_dumpall, the same
# choice skflow makes, for the same reason stated there (cluster-level
# roles a single-database dump would lose); skbom does not actually use
# cluster-level roles today, but the dump loop itself is copied verbatim
# from skflow's pattern (see skbom.yml.j2), so the env shape matches too.
PGPASSWORD={{ skbom.DB_PASSWORD | default('', true) }}
PGUSER={{ skbom.DB_USERNAME | default('dtrack', true) }}
PGDATABASE={{ skbom.DB_NAME | default('dtrack', true) }}
# sleep(1) duration: seconds, or 1d
BACKUP_FREQUENCY={{ skbom.BACKUP_FREQUENCY | default('86400', true) }}
# Days of dumps kept (pruned only after a good dump)
BACKUP_KEEP_DAYS={{ skbom.BACKUP_KEEP_DAYS | default(skbom.BACKUP_NUM_KEEP | default('7', true), true) }}
