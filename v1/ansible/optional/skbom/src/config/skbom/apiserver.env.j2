# skbom (Dependency-Track) apiserver environment ({{ env }}). Root-only
# (0600): carries the database password and, when OIDC is on, the OIDC
# client id (public, but kept in the same root-only file as everything
# else this role renders).
TZ={{ skbom.TZ | default('UTC', true) }}
LOGGING_LEVEL={{ skbom.LOGGING_LEVEL | default('INFO', true) }}
# JVM heap: the node hosting this is sized for a 3G heap by default
# (EXTRA_JAVA_OPTIONS, not JAVA_OPTIONS: the image's own JAVA_OPTIONS
# already carries the GC flags, this only adds to them).
EXTRA_JAVA_OPTIONS={{ skbom.EXTRA_JAVA_OPTIONS | default('-Xmx3g', true) }}

# External Postgres: this stack's own `postgres` service, never the
# upstream image's embedded H2.
ALPINE_DATABASE_MODE=external
ALPINE_DATABASE_URL=jdbc:postgresql://postgres:5432/{{ skbom.DB_NAME | default('dtrack', true) }}
ALPINE_DATABASE_DRIVER=org.postgresql.Driver
ALPINE_DATABASE_USERNAME={{ skbom.DB_USERNAME | default('dtrack', true) }}
ALPINE_DATABASE_PASSWORD={{ skbom.DB_PASSWORD | default('', true) }}

# Prometheus-format /metrics, unauthenticated: feeds a future Grafana
# (skmon) panel. Not a vault knob: this program's whole point is a running
# scanner, so there is no instance-level reason to turn its own metrics off.
ALPINE_METRICS_ENABLED=true

{% if skbom.OIDC_ENABLED | default(false) | bool %}
# OIDC against Authentik (off by default; see README.md "OIDC login").
ALPINE_OIDC_ENABLED=true
ALPINE_OIDC_ISSUER={{ skbom.OIDC_ISSUER }}
ALPINE_OIDC_CLIENT_ID={{ skbom.OIDC_CLIENT_ID }}
ALPINE_OIDC_USERNAME_CLAIM={{ skbom.OIDC_USERNAME_CLAIM | default('preferred_username', true) }}
ALPINE_OIDC_TEAMS_CLAIM={{ skbom.OIDC_TEAMS_CLAIM | default('groups', true) }}
ALPINE_OIDC_USER_PROVISIONING={{ 'true' if skbom.OIDC_USER_PROVISIONING | default(true) | bool else 'false' }}
ALPINE_OIDC_TEAM_SYNCHRONIZATION={{ 'true' if skbom.OIDC_TEAM_SYNCHRONIZATION | default(false) | bool else 'false' }}
{% endif %}
{% for k, v in (skbom.EXTRA_ENV | default({}, true)).items() %}
{{ k }}={{ v }}
{% endfor %}
