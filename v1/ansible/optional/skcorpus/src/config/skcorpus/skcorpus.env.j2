# skcorpus runtime environment ({{ env }}). Root only (0600): the bearer token
# and the backend credentials (use a READ-ONLY Qdrant key).
API_TOKEN={{ skcorpus.API_TOKEN }}
QDRANT_URL={{ skc_qdrant_url }}
{% if skcorpus.QDRANT_API_KEY | default('', true) | string | length > 0 %}
QDRANT_API_KEY={{ skcorpus.QDRANT_API_KEY }}
{% endif %}
FALKORDB_HOST={{ skc_falkordb_host }}
FALKORDB_PORT={{ skc_falkordb_port }}
{% if skcorpus.FALKORDB_USERNAME | default('', true) | string | length > 0 %}
FALKORDB_USERNAME={{ skcorpus.FALKORDB_USERNAME }}
{% endif %}
{% if skcorpus.FALKORDB_PASSWORD | default('', true) | string | length > 0 %}
FALKORDB_PASSWORD={{ skcorpus.FALKORDB_PASSWORD }}
{% endif %}
EMBED_URL={{ skc_embed_url }}
{% if skcorpus.EMBED_API_KEY | default('', true) | string | length > 0 %}
EMBED_API_KEY={{ skcorpus.EMBED_API_KEY }}
{% endif %}
MAX_K={{ skc_max_k }}
MAX_WINDOW={{ skc_max_window }}
MAX_GRAPH_ROWS={{ skc_max_graph_rows }}
MAX_TEXT_CHARS={{ skc_max_text_chars }}
# Each corpus is served at /c/<name>/; the all-corpora routes only on request.
GLOBAL_ROUTES={{ 'true' if skc_global_routes | bool else 'false' }}
# Coherence self-check: sample, re-embed, compare (see the README).
COHERENCE_SAMPLE={{ skc_coherence_sample }}
COHERENCE_INTERVAL_SECONDS={{ skc_coherence_interval }}
COHERENCE_MIN_COSINE={{ skc_coherence_min_cosine }}
COHERENCE_THRESHOLD={{ skc_coherence_threshold }}
