# SKPulse (Uptime-Kuma) Environment Configuration
# Environment: {{ env }}

# Uptime-Kuma Configuration
# Note: Uptime-Kuma stores configuration in /app/data directory
# Admin credentials are set during first-time setup via web UI

# Base URL for uptime-kuma (used for notifications and links)
UPTIME_KUMA_BASE_URL=https://skpulse{% if env != 'prod' %}-{{ env }}{% endif %}.{{ cluster_name | default(skpulse.CLUSTERNAME | default('cluster1')) }}.{{ domain | default(skpulse.DOMAIN | default('example.com')) }}/

# Cluster and Domain Information
CLUSTERNAME={{ cluster_name | default(skpulse.CLUSTERNAME | default('cluster1')) }}
DOMAIN={{ domain | default(skpulse.DOMAIN | default('example.com')) }}

# Port (internal, Traefik handles external routing)
PORT=3001


