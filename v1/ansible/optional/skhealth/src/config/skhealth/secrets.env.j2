# skhealth alert credentials. Rendered by the deploy, root only (0600).
{% if (skh.alerts.telegram_bot_token | string | length > 0) and (skh.alerts.telegram_chat_id | string | length > 0) %}
SKHEALTH_TELEGRAM_TOKEN={{ skh.alerts.telegram_bot_token | string | quote }}
SKHEALTH_TELEGRAM_CHAT_ID={{ skh.alerts.telegram_chat_id | string | quote }}
{% endif %}
{% if skh.alerts.webhook_url | string | length > 0 %}
SKHEALTH_WEBHOOK_URL={{ skh.alerts.webhook_url | string | quote }}
{% endif %}
