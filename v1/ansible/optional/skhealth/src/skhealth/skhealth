def load_state(path: str) -> dict:
    try:
        with open(path) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_state(path: str, data: dict) -> None:
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".state.")
    with os.fdopen(fd, "w") as fh:
        json.dump(data, fh, indent=1, sort_keys=True)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def main(argv: list[str]) -> int:
    os.environ["PATH"] = SAFE_PATH
    args = list(argv)
    config_path = DEFAULT_CONFIG
    if "--config" in args:
        i = args.index("--config")
        config_path = args[i + 1]
        del args[i:i + 2]
    cmd = "run"
    if "--test" in args:
        cmd = "test"
        args.remove("--test")
    if args:
        cmd = args[0]
    if cmd in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    if cmd not in ("run", "check", "test", "status"):
        print(f"skhealth: unknown command {cmd!r} (run, check, --test, status)", file=sys.stderr)
        return 2
    with open(config_path) as fh:
        cfg = json.load(fh)
    secrets = read_env_file(cfg.get("secrets_file", "/etc/skhealth/secrets.env"))
    cluster = cfg.get("cluster") or "cluster"
    host = cfg.get("host_label") or short_host()
    state_dir = cfg.get("state_dir", "/var/lib/skhealth")
    state_file = os.path.join(state_dir, "state.json")
    now = float(cfg.get("now") or time.time())

    if cmd == "test":
        configured, ok, notes = send(cfg, secrets, cluster, host,
                                     [{"kind": "test", "key": "test", "message": "skhealth test message"}])
        if configured == 0:
            print("skhealth: no alert channel configured (telegram or webhook)", file=sys.stderr)
            return 1
        print(f"skhealth: test message sent through {ok}/{configured} channel(s)"
              + (f" ({'; '.join(notes)})" if notes else ""))
        return 0 if ok == configured else 1

    if cmd == "status":
        st = load_state(state_file)
        print(json.dumps({"cluster": cluster, "host": host, "last_run": st.get("last_run"),
                          "telegram": bool(secrets.get("SKHEALTH_TELEGRAM_TOKEN")),
                          "webhook": bool(secrets.get("SKHEALTH_WEBHOOK_URL")),
                          "problems": {k: {"message": v.get("message"), "alerted": v.get("alerted"),
                                           "count": v.get("count")}
                                       for k, v in st.get("problems", {}).items()}}, indent=1, sort_keys=True))
        return 0

    os.makedirs(state_dir, mode=0o700, exist_ok=True)
    with open(os.path.join(state_dir, "lock"), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("skhealth: another run holds the lock; skipping")
            return 0
        saved = load_state(state_file)
        problems, ran, disabled = collect(cfg, now, saved.get("last_run"))
        if cmd == "check":
            for key, msg in sorted(problems.items()):
                print(f"{key}: {msg}")
            print(f"skhealth: {len(problems)} problem(s); checks run: {', '.join(sorted(ran)) or 'none'}")
            return 0
        new, events = transition(saved.get("problems", {}), problems, ran, disabled, now,
                                 int(cfg.get("confirm_runs", 2)), float(cfg.get("realert_hours", 6)))
        delivered = True
        if events:
            configured, ok, notes = send(cfg, secrets, cluster, host, events)
            for e in events:
                print(f"{LABELS.get(e['kind'], e['kind'])}: {e['message']}")
            if configured and not ok:
                delivered = False
                print(f"skhealth: alert NOT delivered ({'; '.join(notes)}); state kept, retrying next run",
                      file=sys.stderr)
            elif notes:
                print(f"skhealth: partial delivery ({'; '.join(notes)})", file=sys.stderr)
        if delivered:
            save_state(state_file, {"version": 1, "last_run": now, "problems": new})
        print(f"skhealth: {len(problems)} problem(s), {len(events)} alert event(s); "
              f"checks run: {', '.join(sorted(ran)) or 'none'}")
        return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
