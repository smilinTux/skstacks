# SKDash Environment Configuration
# Dashboard service configuration

# Environment
NODE_ENV=production
UID=1000
GID=1000

# Port Configuration
PORT=8080

# Docker Environment
IS_DOCKER=true

# Instance Configuration
INSTANCENAME={{ app }}-{{ env }}
CLUSTERNAME={{ skdash.CLUSTERNAME | default('cluster1') }}
DOMAIN={{ skdash.DOMAIN | default('example.com') }}

# Timezone
TZ={{ skdash.TZ | default('UTC') }}
