# skgym (openGym api) runtime environment ({{ env }}). Root only (0600).
# No secret lives here: the session secret is the file <DATA_DIR>/secret.
# Passkeys are bound to this exact host and need https.
RP_ID={{ skg_host }}
ORIGIN=https://{{ skg_host }}
RP_NAME={{ skgym.RP_NAME | default('openGym', true) }}
PORT=3000
DATA_DIR=/data
# web overwrites X-Forwarded-For / X-Real-IP with its peer, so the sign-in
# throttle may read them.
TRUST_PROXY=1
FIRST_USER_ADMIN={{ '1' if skgym.FIRST_USER_ADMIN | default(true) | bool else '0' }}
ADMIN_UIDS={{ skgym.ADMIN_UIDS | default('', true) }}
INVITE_ONLY={{ '1' if skgym.INVITE_ONLY | default(false) | bool else '0' }}
ALLOW_GUEST={{ '1' if skgym.ALLOW_GUEST | default(true) | bool else '0' }}
PASSWORD_LOGIN={{ '1' if skgym.PASSWORD_LOGIN | default(false) | bool else '0' }}
DEFAULT_LANG={{ skgym.DEFAULT_LANG | default('', true) }}
SESSION_DAYS={{ skgym.SESSION_DAYS | default(90, true) }}
AUDIT_LOG={{ '1' if skgym.AUDIT_LOG | default(true) | bool else '0' }}
AUDIT_IP={{ skgym.AUDIT_IP | default('off', true) }}
AUDIT_MAX={{ skgym.AUDIT_MAX | default(5000) }}
AUDIT_DAYS={{ skgym.AUDIT_DAYS | default(90) }}
MEDIA_UPLOADS={{ '1' if skgym.MEDIA_UPLOADS | default(true) | bool else '0' }}
MEDIA_QUOTA_MB={{ skgym.MEDIA_QUOTA_MB | default(200) }}
{% if skgym.VAPID_SUBJECT | default('', true) %}
VAPID_SUBJECT={{ skgym.VAPID_SUBJECT }}
{% endif %}
# The AI Coach sends workout data to a third-party model provider once an
# admin connects one. Off unless the vault says otherwise.
COACH_DISABLED={{ '1' if skgym.COACH_DISABLED | default(true) | bool else '0' }}
TZ={{ skgym.TZ | default('UTC', true) }}
{% for k, v in (skgym.extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
