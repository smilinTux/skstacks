#!/bin/bash
set -e

# Never force-restart a service on its FIRST install (first-boot init must
# finish); a redeploy restarts the api when the play changed its env file or
# the session secret, and the backup sidecar when it changed the backup
# script, which the stack spec cannot see (env_file / bind mounts).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

# skgym (openGym) Deploy Script
# Environment: {{ env }}
APPNAME=skgym
STACK_NAME=skgym-{{ env }}
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skgym.yml"
API="${STACK_NAME}_api"
WEB="${STACK_NAME}_web"
BACKUP="${STACK_NAME}_backup"

if [ -f "${CONFIG_DIR}/${APPNAME}.sh.env" ]; then
    source "${CONFIG_DIR}/${APPNAME}.sh.env"
fi

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo "Error: Compose file not found: ${COMPOSE_FILE}"
    exit 1
fi

cd "${CONFIG_DIR}"

record_preexisting "${API}" "${BACKUP}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

if [ "${RESTART_API:-0}" = 1 ]; then
    echo "The play changed the env file or the session secret of ${API}"
    preexisted "${API}" && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=true "${API}" || true
fi
if [ "${RESTART_BACKUP:-0}" = 1 ]; then
    echo "The play changed the backup script of ${BACKUP}"
    preexisted "${BACKUP}" && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=true "${BACKUP}" || true
fi

echo "Waiting for ${API} to converge..."
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${API}" --format "{% raw %}{{.Replicas}}{% endraw %}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$REPLICAS" == "1/1" ]]; then
    echo "${API} is running"
else
    echo "${API} not converged: ${REPLICAS}"
    docker service logs --tail 20 "${API}" || true
fi
WEB_REPLICAS_NOW=$(docker service ls --filter "name=${WEB}" --format "{% raw %}{{.Replicas}}{% endraw %}" | head -1)
echo "${WEB}: ${WEB_REPLICAS_NOW:-unknown} (want ${WEB_REPLICAS:-1}/${WEB_REPLICAS:-1})"
echo "Web UI: https://${SKGYM_HOST:-unknown}/"
echo "Deployment complete!"
