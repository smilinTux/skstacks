version: '3.8'

services:
  vikunja:
    # Pinned: see README.md "Upgrading Vikunja" before ever bumping this.
    image: vikunja/vikunja:{{ skboard.VIKUNJA_VERSION | default('0.24.6') }}
    env_file: /var/data/config/skboard-{{ env }}/skboard.env

    logging:
      driver: json-file
      options:
        max-size: "{{ skboard.LOG_MAX_SIZE | default('10m') }}"
        max-file: "{{ skboard.LOG_MAX_FILES | default('3') }}"

    volumes:
      # Single bind mount: sqlite db + files/ subdir both live under here,
      # matching the live reference deployment's single-volume layout.
      - /var/data/skboard-{{ env }}/data:/app/vikunja

    networks:
      - cloud-public-{{ env }}
      - skboard-{{ env }}

    # No Docker-level healthcheck: the vikunja/vikunja image ships no shell
    # and no wget/curl (verified: docker exec fails with "executable file
    # not found in $PATH" for both), so a CMD-style test cannot run inside
    # the container. The upstream image itself defines no HEALTHCHECK either.
    # Swarm still detects and restarts a genuinely crashed process via the
    # container exit code and the restart_policy below.

    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      resources:
        limits:
          cpus: '{{ skboard.RESOURCES_LIMITS_CPUS | default("0.50") }}'
          memory: {{ skboard.RESOURCES_LIMITS_MEMORY | default("512M") }}
        reservations:
          cpus: '{{ skboard.RESOURCES_RESERVATIONS_CPUS | default("0.10") }}'
          memory: {{ skboard.RESOURCES_RESERVATIONS_MEMORY | default("128M") }}
      restart_policy:
        # Matches the live reference deployment's restart policy exactly.
        # See README.md "Restart policy footgun" before changing this.
        condition: {{ skboard.RESTART_POLICY_CONDITION | default('on-failure') }}
        delay: {{ skboard.RESTART_POLICY_DELAY | default('10s') }}
        max_attempts: {{ skboard.RESTART_POLICY_MAX_ATTEMPTS | default(3) }}
        window: {{ skboard.RESTART_POLICY_WINDOW | default('120s') }}
      labels:
        # === TRAEFIK: HTTP ===
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        # === TRAEFIK: ROUTERS ===
        - "traefik.http.routers.skboard{% if env != 'prod' %}-{{ env }}{% endif %}.rule=Host(`skboard{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skboard.CLUSTERNAME | default(cluster_name) }}.{{ skboard.DOMAIN | default(domain) }}`)"
        - "traefik.http.routers.skboard{% if env != 'prod' %}-{{ env }}{% endif %}.entrypoints=websecure"
        - "traefik.http.routers.skboard{% if env != 'prod' %}-{{ env }}{% endif %}.tls=true"
        - "traefik.http.routers.skboard{% if env != 'prod' %}-{{ env }}{% endif %}.tls.certresolver=main"
        - "traefik.http.routers.skboard{% if env != 'prod' %}-{{ env }}{% endif %}.tls.options=intermediate@file"
        - "traefik.http.routers.skboard{% if env != 'prod' %}-{{ env }}{% endif %}.middlewares=default-no-crowdsec@file"
        - "traefik.http.routers.skboard{% if env != 'prod' %}-{{ env }}{% endif %}.service=skboard{% if env != 'prod' %}-{{ env }}{% endif %}"
        # === TRAEFIK: SERVICES ===
        - "traefik.http.services.skboard{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.server.port=3456"

networks:
  cloud-public-{{ env }}:
    external: true
  skboard-{{ env }}:
    external: true
