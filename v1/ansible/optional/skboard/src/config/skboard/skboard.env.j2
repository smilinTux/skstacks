# =============================================================================
# SKBoard (Vikunja) Environment Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKBoard (Vikunja Kanban/task board)
# Environment: {{ env }}
# =============================================================================

# ---------------------------------------------------------------------------
# Database: sqlite, no standalone DB service. The single bind-mounted volume
# below holds both the sqlite file and the files/ upload directory, so these
# two paths are structural, not instance configuration.
# ---------------------------------------------------------------------------
VIKUNJA_DATABASE_TYPE=sqlite
VIKUNJA_DATABASE_PATH=/app/vikunja/vikunja.db
VIKUNJA_FILES_BASEPATH=/app/vikunja/files
VIKUNJA_FILES_MAXSIZE={{ skboard.FILES_MAXSIZE | default('20MB') }}

VIKUNJA_LOG_LEVEL={{ skboard.LOG_LEVEL | default('INFO') }}
VIKUNJA_MAILER_ENABLED={{ skboard.MAILER_ENABLED | default('false') }}
VIKUNJA_SERVICE_ENABLEREGISTRATION={{ skboard.ENABLEREGISTRATION | default('true') }}
VIKUNJA_SERVICE_TIMEZONE={{ skboard.TIMEZONE | default('UTC') }}
VIKUNJA_DEFAULTSETTINGS_WEEK_START={{ skboard.WEEK_START | default('0') }}

# ---------------------------------------------------------------------------
# JWT signing secret (required - no default: Vikunja auto-generates one at
# boot if unset, which invalidates every session on every restart/reschedule.
# See README.md "Required vault keys".)
# ---------------------------------------------------------------------------
VIKUNJA_SERVICE_JWTSECRET={{ skboard.JWT_SECRET }}

VIKUNJA_SERVICE_PUBLICURL=https://skboard{% if env != 'prod' %}-{{ env }}{% endif %}.{{ cluster_name | default(skboard.CLUSTERNAME | default('cluster1')) }}.{{ domain | default(skboard.DOMAIN | default('example.com')) }}/

# ---------------------------------------------------------------------------
# Optional outbound mail (only rendered if skboard.MAILER_ENABLED is true and
# these are set; skipped entirely otherwise since the live reference
# deployment runs with mailer disabled)
# ---------------------------------------------------------------------------
{% if skboard.MAILER_HOST is defined %}
VIKUNJA_MAILER_HOST={{ skboard.MAILER_HOST }}
VIKUNJA_MAILER_PORT={{ skboard.MAILER_PORT | default('587') }}
VIKUNJA_MAILER_USERNAME={{ skboard.MAILER_USERNAME }}
VIKUNJA_MAILER_PASSWORD={{ skboard.MAILER_PASSWORD }}
VIKUNJA_MAILER_FROMEMAIL={{ skboard.MAILER_FROMEMAIL | default('vikunja@' + (domain | default(skboard.DOMAIN | default('example.com')))) }}
{% endif %}
