#!/bin/bash
# =============================================================================
# SKBoard Deploy Script
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKBoard (Vikunja Kanban/task board)
# Environment: {{ env }}
# =============================================================================
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Set basic variables first
APP="skboard"
STACK_NAME="skboard{% if env == 'prod' %}-prod{% elif env == 'staging' %}-staging{% else %}-dev{% endif %}"
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

# Source environment variables (may override CONFIG_DIR)
if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi

echo -e "${CYAN}SKBoard - Vikunja Kanban/task board${NC}"
echo -e "${GREEN}Deploying ${STACK_NAME} stack...${NC}"

# Export environment for docker
export CLUSTERNAME DOMAIN INSTANCE APP_ENV

# =============================================================================
# Network Configuration (from vault or defaults)
# IMPORTANT: Network subnets MUST match shared/networks registry
# =============================================================================
# Define networks array from vault or use defaults
# Reference: See shared/networks for all registered network subnets
# skboard-prod: 172.16.234.0/24
# skboard-staging: 172.16.233.0/24
# skboard-dev: 172.16.232.0/24
# cloud-public-prod: 172.16.200.0/24
# cloud-public-staging: 172.16.201.0/24
# cloud-public-dev: 172.16.202.0/24
declare -A NETWORKS
{% for network in app_networks | default([{'name': 'skboard-' + env, 'subnet': '172.16.234.0/24'}, {'name': 'cloud-public-' + env, 'subnet': '172.16.200.0/24'}]) %}
NETWORKS["{{ network.name }}"]="{{ network.subnet }}"
{% endfor %}

# =============================================================================
# Network Management Functions
# =============================================================================
# -----------------------------------------------------------------------------
# Network safety: a deploy never deletes an existing network (same pattern in
# every deploy.j2 and in shared/tasks/create_networks.yml).
#   exists, same subnet      -> reused
#   exists, other subnet     -> deploy stops; set the vault to the live subnet
#   missing                  -> created
# NETWORK_RECREATE_ON_MISMATCH=true (env, or vault network_recreate_on_mismatch)
# may recreate only this service's own network; shared cloud-* never.
# -----------------------------------------------------------------------------
NETWORK_VAULT_KEY="skboard.networks"
NETWORK_OWNED="{{ app }}-{{ env }}"
NETWORK_RECREATE_ON_MISMATCH="${NETWORK_RECREATE_ON_MISMATCH:-{{ network_recreate_on_mismatch | default(false) | string | lower }}}"

ensure_network() {
    local name="$1" subnet="$2" live
    if ! docker network ls --format '{% raw %}{{.Name}}{% endraw %}' | grep -qx "${name}"; then
        echo "Creating overlay network ${name} (${subnet})"
        docker network create --driver overlay --attachable --subnet "${subnet}" "${name}" || return 1
        sleep 2
        return 0
    fi
    live=$(docker network inspect "${name}" --format '{% raw %}{{range .IPAM.Config}}{{.Subnet}} {{end}}{% endraw %}' 2>/dev/null | awk '{print $1}')
    if [ -z "${live}" ] || [ "${live}" = "${subnet}" ]; then
        echo "Network ${name} exists (subnet ${live:-unknown}), reusing it"
        return 0
    fi
    if [ "${NETWORK_RECREATE_ON_MISMATCH}" = "true" ] && [ "${name}" = "${NETWORK_OWNED}" ] && [ "${name#cloud-}" = "${name}" ]; then
        echo "NETWORK_RECREATE_ON_MISMATCH=true: recreating ${name} (${live} -> ${subnet})"
        docker network rm "${name}" || return 1
        sleep 2
        docker network create --driver overlay --attachable --subnet "${subnet}" "${name}" || return 1
        sleep 2
        return 0
    fi
    echo "ERROR: network ${name} exists with subnet ${live}, but the configured subnet is ${subnet}." >&2
    echo "ERROR: refusing to delete it (other stacks may be attached). To adopt the live network, set the ${name} subnet to ${live} in the vault (${NETWORK_VAULT_KEY})." >&2
    if [ "${name}" = "${NETWORK_OWNED}" ] && [ "${name#cloud-}" = "${name}" ]; then
        echo "ERROR: or, to recreate this service's own network with ${subnet}, remove the stack and rerun with NETWORK_RECREATE_ON_MISMATCH=true." >&2
    fi
    return 1
}

for network_name in "${!NETWORKS[@]}"; do
    ensure_network "${network_name}" "${NETWORKS[$network_name]}" || { echo "ERROR: network setup failed for ${network_name}" >&2; exit 1; }
done

echo -e "${CYAN}=============================================================${NC}"

# =============================================================================
# Stack Deployment
# =============================================================================

# Check if compose file exists
if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# Record whether Vikunja already exists BEFORE deploying: on a first install
# its first task runs the initial SQLite migrations, and a forced restart
# would kill it mid-migration and leave a half-migrated vikunja.db.
if docker service inspect "${STACK_NAME}_vikunja" >/dev/null 2>&1; then
    VIKUNJA_EXISTED=1
else
    VIKUNJA_EXISTED=0
fi

# Deploy stack
echo -e "${YELLOW}Deploying stack configuration...${NC}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

# Wait for services to register
sleep 5

# Force update services (redeploy only: restarts to pick up changed
# bind-mounted config; skipped on first install, see VIKUNJA_EXISTED above)
if [ "${VIKUNJA_EXISTED}" = "1" ]; then
    echo -e "${YELLOW}Forcing service updates to pull latest images...${NC}"
    timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_vikunja || true
else
    echo -e "${YELLOW}First install: skipping forced update so Vikunja's initial migrations can finish${NC}"
fi

# Wait for stabilization
echo -e "${YELLOW}Waiting for services to stabilize...${NC}"
sleep 15

# Show service status
echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

# Health check
echo -e "${YELLOW}Checking service health...${NC}"
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_vikunja" --format "{% raw %}{{.Replicas}}{% endraw %}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done

if [[ "$REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} SKBoard is healthy and running!${NC}"
    echo -e "${GREEN}Web UI: https://skboard{% if env != 'prod' %}-{{ env }}{% endif %}.${CLUSTERNAME:-{{ skboard.CLUSTERNAME | default(cluster_name) }}}.${DOMAIN:-{{ skboard.DOMAIN | default(domain) }}}${NC}"
else
    echo -e "${RED}${STACK_NAME} SKBoard health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_vikunja
fi

echo ""
echo -e "${GREEN}Deployment complete!${NC}"
echo -e "${CYAN}=============================================================${NC}"
echo -e "${CYAN}SK = staycuriousANDkeepsmilin${NC}"
