#!/bin/bash
# =============================================================================
# SKBoard Deploy Script
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKBoard (Vikunja Kanban/task board)
# Environment: {{ env }}
# =============================================================================
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Set basic variables first
APP="skboard"
STACK_NAME="skboard{% if env == 'prod' %}-prod{% elif env == 'staging' %}-staging{% else %}-dev{% endif %}"
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

# Source environment variables (may override CONFIG_DIR)
if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi

echo -e "${CYAN}SKBoard - Vikunja Kanban/task board${NC}"
echo -e "${GREEN}Deploying ${STACK_NAME} stack...${NC}"

# Export environment for docker
export CLUSTERNAME DOMAIN INSTANCE APP_ENV

# =============================================================================
# Network Configuration (from vault or defaults)
# IMPORTANT: Network subnets MUST match shared/networks registry
# =============================================================================
# Define networks array from vault or use defaults
# Reference: See shared/networks for all registered network subnets
# skboard-prod: 172.16.234.0/24
# skboard-staging: 172.16.233.0/24
# skboard-dev: 172.16.232.0/24
# cloud-public-prod: 172.16.200.0/24
# cloud-public-staging: 172.16.201.0/24
# cloud-public-dev: 172.16.202.0/24
declare -A NETWORKS
{% for network in app_networks | default([{'name': 'skboard-' + env, 'subnet': '172.16.234.0/24'}, {'name': 'cloud-public-' + env, 'subnet': '172.16.200.0/24'}]) %}
NETWORKS["{{ network.name }}"]="{{ network.subnet }}"
{% endfor %}

# =============================================================================
# Network Management Functions
# =============================================================================
check_and_create_network() {
    local network_name="$1"
    local subnet="$2"

    echo -e "${BLUE}Checking network: ${network_name}${NC}"

    # Check if network exists
    if docker network ls --format "{% raw %}{{.Name}}{% endraw %}" | grep -q "^${network_name}$"; then
        # Network exists - check if subnet matches
        CURRENT_SUBNET=$(docker network inspect "${network_name}" --format '{% raw %}{{range .IPAM.Config}}{{.Subnet}}{{end}}{% endraw %}' 2>/dev/null | head -1)

        if [ "${CURRENT_SUBNET}" = "${subnet}" ]; then
            echo -e "${GREEN}Network ${network_name} exists with correct subnet ${subnet}${NC}"
            return 0
        else
            echo -e "${YELLOW}Network ${network_name} has subnet ${CURRENT_SUBNET}, expected ${subnet}${NC}"
            echo -e "${YELLOW}Checking if network is in use...${NC}"

            # Check if network is attached to any containers/services
            CONTAINERS=$(docker network inspect "${network_name}" --format '{% raw %}{{range .Containers}}{{.Name}} {{end}}{% endraw %}' 2>/dev/null)
            if [ -n "${CONTAINERS}" ]; then
                echo -e "${RED}Cannot update network ${network_name} - in use by: ${CONTAINERS}${NC}"
                echo -e "${YELLOW}Please stop services using this network first${NC}"
                return 1
            fi

            # Remove and recreate with correct subnet
            echo -e "${YELLOW}Recreating network ${network_name} with correct subnet...${NC}"
            docker network rm "${network_name}" 2>/dev/null || true
            sleep 2
        fi
    fi

    # Create network
    echo -e "${YELLOW}Creating overlay network: ${network_name} (${subnet})${NC}"
    if docker network create \
        --driver overlay \
        --attachable \
        --subnet "${subnet}" \
        "${network_name}"; then
        echo -e "${GREEN}Network ${network_name} created successfully${NC}"
        sleep 2
        return 0
    else
        echo -e "${RED}Failed to create network ${network_name}${NC}"
        return 1
    fi
}

# =============================================================================
# Pre-deployment: Ensure all required networks exist
# =============================================================================
echo -e "${CYAN}=============================================================${NC}"
echo -e "${CYAN}Network Configuration${NC}"
echo -e "${CYAN}=============================================================${NC}"

NETWORK_ERRORS=0
for network_name in "${!NETWORKS[@]}"; do
    subnet="${NETWORKS[$network_name]}"
    if ! check_and_create_network "${network_name}" "${subnet}"; then
        NETWORK_ERRORS=$((NETWORK_ERRORS + 1))
    fi
done

if [ ${NETWORK_ERRORS} -gt 0 ]; then
    echo -e "${RED}${NETWORK_ERRORS} network(s) failed to configure${NC}"
    echo -e "${YELLOW}Attempting to continue deployment anyway...${NC}"
fi

echo -e "${CYAN}=============================================================${NC}"

# =============================================================================
# Stack Deployment
# =============================================================================

# Check if compose file exists
if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# Deploy stack
echo -e "${YELLOW}Deploying stack configuration...${NC}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

# Wait for services to register
sleep 5

# Force update services
echo -e "${YELLOW}Forcing service updates to pull latest images...${NC}"
docker service update --force --detach=false ${STACK_NAME}_vikunja || true

# Wait for stabilization
echo -e "${YELLOW}Waiting for services to stabilize...${NC}"
sleep 15

# Show service status
echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

# Health check
echo -e "${YELLOW}Checking service health...${NC}"
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_vikunja" --format "{% raw %}{{.Replicas}}{% endraw %}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done

if [[ "$REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} SKBoard is healthy and running!${NC}"
    echo -e "${GREEN}Web UI: https://skboard{% if env != 'prod' %}-{{ env }}{% endif %}.${CLUSTERNAME:-{{ skboard.CLUSTERNAME | default(cluster_name) }}}.${DOMAIN:-{{ skboard.DOMAIN | default(domain) }}}${NC}"
else
    echo -e "${RED}${STACK_NAME} SKBoard health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_vikunja
fi

echo ""
echo -e "${GREEN}Deployment complete!${NC}"
echo -e "${CYAN}=============================================================${NC}"
echo -e "${CYAN}SK = staycuriousANDkeepsmilin${NC}"
