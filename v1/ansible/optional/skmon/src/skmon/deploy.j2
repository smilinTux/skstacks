#!/bin/bash
set -e

# Never force-restart a service on its FIRST install: a restart in the middle
# of first-boot init (schema migrations, initial setup) can leave it corrupt.
# record_preexisting runs before the stack deploy; only services that already
# existed then are force-updated afterwards (a redeploy still restarts them to
# pick up changed bind-mounted config files).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

APP="skmon"
{% set sfx = '' if env == 'prod' else '-' ~ env %}
STACK_NAME="{{ app }}-{{ env }}"
CONFIG_DIR="/var/data/config/${APP}-{{ env }}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}🚀 Deploying ${APP} stack (Monitoring)...${NC}"

# Source environment variables
if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}📦 Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi

# Export environment for docker
export CLUSTER_NAME DOMAIN INSTANCE APP_ENV

# Check if compose file exists
if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}❌ Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# Deploy stack with prune and registry auth
echo -e "${YELLOW}📝 Deploying stack configuration...${NC}"
{% if not skmon_parked %}
record_preexisting "${STACK_NAME}_victoriametrics" "${STACK_NAME}_grafana" "${STACK_NAME}_loki" "${STACK_NAME}_alertmanager"
{% endif %}
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

# Wait a moment for services to register
sleep 10

{% if not skmon_parked %}
# Force update services to pull latest images
echo -e "${YELLOW}🔄 Forcing service updates to pull latest images...${NC}"
{% for svc in ['victoriametrics', 'grafana', 'loki', 'alertmanager'] %}
preexisted ${STACK_NAME}_{{ svc }} && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_{{ svc }} || true
{% endfor %}

# Wait for services to stabilize
echo -e "${YELLOW}⏳ Waiting for services to stabilize...${NC}"
sleep 30
{% endif %}

# Show service status
echo -e "${GREEN}📊 Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

{% if not skmon_parked %}
# Health check
echo -e "${YELLOW}🏥 Checking service health...${NC}"
{% set pve_on = ((skmon.PVE | default({}, true)).enabled | default(false) | bool) if (skmon.PVE | default({}, true)) is mapping else false %}
{% set waits = [('loki', 'LOKI', 'Loki'), ('grafana', 'GRAFANA', 'Grafana'), ('victoriametrics', 'VM', 'VictoriaMetrics'), ('alertmanager', 'ALERTMANAGER', 'Alertmanager'), ('vmalert', 'VMALERT', 'vmalert'), ('bridge', 'BRIDGE', 'skmon-bridge'), ('skswarm-exporter', 'SKSWARM', 'skswarm-exporter')] + ([('pve-exporter', 'PVE', 'pve-exporter')] if pve_on else []) %}
{% for svc, var, label in waits %}

# Check {{ label }}
for _ in $(seq 1 36); do
    {{ var }}_REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_{{ svc }}" --format "{{ '{{.Replicas}}' }}")
    [[ "${{ '{' ~ var ~ '_REPLICAS}' }}" == "1/1" ]] && break
    sleep 5
done
if [[ "${{ '{' ~ var ~ '_REPLICAS}' }}" == "1/1" ]]; then
    echo -e "${GREEN}✅ {{ label }} is healthy and running!${NC}"
else
    echo -e "${RED}⚠️  {{ label }} health check: ${{ '{' ~ var ~ '_REPLICAS}' }}${NC}"
    echo -e "${YELLOW}📋 Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_{{ svc }}
fi
{% endfor %}

{% else %}
echo -e "${YELLOW}skmon.replicas is 0: stack deployed scaled to 0, skipping health waits${NC}"
{% endif %}
echo -e "${GREEN}✨ Deployment complete!${NC}"
echo -e "${GREEN}🌐 Access URLs:${NC}"
echo -e "${GREEN}   - Grafana: https://skmon{{ sfx }}.{{ skmon.CLUSTERNAME }}.{{ skmon.DOMAIN }}${NC}"
echo -e "${GREEN}   - vmui (VictoriaMetrics): https://vmui{{ sfx }}.{{ skmon.CLUSTERNAME }}.{{ skmon.DOMAIN }}${NC}"
echo -e "${GREEN}   - Alertmanager: https://alertmanager{{ sfx }}.{{ skmon.CLUSTERNAME }}.{{ skmon.DOMAIN }}${NC}"
echo -e "${YELLOW}📋 Useful commands:${NC}"
echo -e "  - View service logs: docker service logs ${STACK_NAME}_<service>"
echo -e "  - View service status: docker service ls --filter name=${STACK_NAME}"
