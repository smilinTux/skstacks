#!/bin/bash
set -e

# Never force-restart a service on its FIRST install: a restart in the middle
# of first-boot init (schema migrations, initial setup) can leave it corrupt.
# record_preexisting runs before the stack deploy; only services that already
# existed then are force-updated afterwards (a redeploy still restarts them to
# pick up changed bind-mounted config files).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

APP="skmon"
STACK_NAME="{{ app }}-{{ env }}"
CONFIG_DIR="/var/data/config/${APP}-{{ env }}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}🚀 Deploying ${APP} stack (Monitoring & Tracing)...${NC}"

# Source environment variables
if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}📦 Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi

# Export environment for docker
export CLUSTER_NAME DOMAIN INSTANCE APP_ENV

# Check if compose file exists
if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}❌ Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# Deploy stack with prune and registry auth
echo -e "${YELLOW}📝 Deploying stack configuration...${NC}"
record_preexisting "${STACK_NAME}_prometheus" "${STACK_NAME}_grafana" "${STACK_NAME}_loki" "${STACK_NAME}_promtail" "${STACK_NAME}_node-exporter" "${STACK_NAME}_cadvisor" "${STACK_NAME}_alertmanager" "${STACK_NAME}_jaeger"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

# Wait a moment for services to register
sleep 10

# Force update services to pull latest images
echo -e "${YELLOW}🔄 Forcing service updates to pull latest images...${NC}"
preexisted ${STACK_NAME}_prometheus && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_prometheus || true
preexisted ${STACK_NAME}_grafana && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_grafana || true
preexisted ${STACK_NAME}_loki && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_loki || true
preexisted ${STACK_NAME}_promtail && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_promtail || true
preexisted ${STACK_NAME}_node-exporter && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_node-exporter || true
preexisted ${STACK_NAME}_cadvisor && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_cadvisor || true
preexisted ${STACK_NAME}_alertmanager && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_alertmanager || true
preexisted ${STACK_NAME}_jaeger && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_jaeger || true

# Wait for services to stabilize
echo -e "${YELLOW}⏳ Waiting for services to stabilize...${NC}"
sleep 30

# Show service status
echo -e "${GREEN}📊 Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

# Health check
echo -e "${YELLOW}🏥 Checking service health...${NC}"

# Check Loki
for _ in $(seq 1 36); do
    LOKI_REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_loki" --format "{{ '{{.Replicas}}' }}")
    [[ "$LOKI_REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$LOKI_REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}✅ Loki is healthy and running!${NC}"
else
    echo -e "${RED}⚠️  Loki health check: ${LOKI_REPLICAS}${NC}"
    echo -e "${YELLOW}📋 Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_loki
fi

# Check Grafana
for _ in $(seq 1 36); do
    GRAFANA_REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_grafana" --format "{{ '{{.Replicas}}' }}")
    [[ "$GRAFANA_REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$GRAFANA_REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}✅ Grafana is healthy and running!${NC}"
else
    echo -e "${RED}⚠️  Grafana health check: ${GRAFANA_REPLICAS}${NC}"
    echo -e "${YELLOW}📋 Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_grafana
fi

# Check Prometheus
for _ in $(seq 1 36); do
    PROM_REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_prometheus" --format "{{ '{{.Replicas}}' }}")
    [[ "$PROM_REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$PROM_REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}✅ Prometheus is healthy and running!${NC}"
else
    echo -e "${RED}⚠️  Prometheus health check: ${PROM_REPLICAS}${NC}"
    echo -e "${YELLOW}📋 Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_prometheus
fi

# Check Alertmanager
for _ in $(seq 1 36); do
    ALERTMANAGER_REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_alertmanager" --format "{{ '{{.Replicas}}' }}")
    [[ "$ALERTMANAGER_REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$ALERTMANAGER_REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}✅ Alertmanager is healthy and running!${NC}"
else
    echo -e "${RED}⚠️  Alertmanager health check: ${ALERTMANAGER_REPLICAS}${NC}"
    echo -e "${YELLOW}📋 Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_alertmanager
fi

# Check Jaeger
for _ in $(seq 1 36); do
    JAEGER_REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_jaeger" --format "{{ '{{.Replicas}}' }}")
    [[ "$JAEGER_REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$JAEGER_REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}✅ Jaeger is healthy and running!${NC}"
else
    echo -e "${RED}⚠️  Jaeger health check: ${JAEGER_REPLICAS}${NC}"
    echo -e "${YELLOW}📋 Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_jaeger
fi

echo -e "${GREEN}✨ Deployment complete!${NC}"
echo -e "${GREEN}🌐 Access URLs:${NC}"
echo -e "${GREEN}   - Grafana: https://skmon{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skmon.CLUSTERNAME }}.{{ skmon.DOMAIN }}${NC}"
echo -e "${GREEN}   - Prometheus: https://prometheus{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skmon.CLUSTERNAME }}.{{ skmon.DOMAIN }}${NC}"
echo -e "${GREEN}   - Alertmanager: https://alertmanager{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skmon.CLUSTERNAME }}.{{ skmon.DOMAIN }}${NC}"
echo -e "${GREEN}   - Jaeger: https://jaeger{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skmon.CLUSTERNAME }}.{{ skmon.DOMAIN }}${NC}"
echo -e "${YELLOW}📋 Useful commands:${NC}"
echo -e "  - View Loki health: curl http://localhost:3100/ready"
echo -e "  - View service logs: docker service logs ${STACK_NAME}_<service>"
echo -e "  - Check metrics: curl http://localhost:9090/metrics"
