# =============================================================================
# SKMon Environment Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKMon (Prometheus, Grafana, Loki, Promtail, cAdvisor, node-exporter,
#          Alertmanager, Jaeger)
# Environment: {{ env }}
# Cluster: {{ skmon.CLUSTERNAME }}
# Domain: {{ skmon.DOMAIN }}
# =============================================================================

# Prometheus Configuration
PROMETHEUS_RETENTION={{ skmon.PROMETHEUS_RETENTION | default('30d') }}
PROMETHEUS_SCRAPE_INTERVAL={{ skmon.PROMETHEUS_SCRAPE_INTERVAL | default('15s') }}
PROMETHEUS_EVALUATION_INTERVAL={{ skmon.PROMETHEUS_EVALUATION_INTERVAL | default('15s') }}

# Grafana Configuration
GF_SECURITY_ADMIN_USER={{ skmon.GRAFANA_ADMIN_USER }}
GF_SECURITY_ADMIN_PASSWORD={{ skmon.GRAFANA_ADMIN_PASSWORD }}
GF_SECURITY_SECRET_KEY={{ skmon.GRAFANA_SECRET_KEY }}
GF_SERVER_ROOT_URL={{ skmon.GRAFANA_ROOT_URL }}
GF_INSTALL_PLUGINS=grafana-clock-panel,grafana-simple-json-datasource,grafana-piechart-panel,marcusolsson-json-datasource,grafana-worldmap-panel
{% if skmon.SMTP_ENABLED | default(false) %}
# Grafana SMTP Configuration
GF_SMTP_ENABLED=true
GF_SMTP_HOST={{ skmon.SMTP_HOST }}
GF_SMTP_PORT={{ skmon.SMTP_PORT }}
GF_SMTP_USER={{ skmon.SMTP_USER }}
GF_SMTP_PASSWORD={{ skmon.SMTP_PASSWORD }}
GF_SMTP_FROM_ADDRESS={{ skmon.SMTP_FROM_ADDRESS }}
GF_SMTP_FROM_NAME={{ skmon.SMTP_FROM_NAME | default('Grafana') }}
{% if skmon.SMTP_SECURE | default(true) %}
GF_SMTP_SKIP_VERIFY=false
GF_SMTP_REQUIRE_TLS=true
{% endif %}
{% endif %}

# Loki Configuration
LOKI_RETENTION_PERIOD={{ skmon.LOKI_RETENTION_PERIOD | default('30d') }}

# Domain Configuration
CLUSTERNAME={{ skmon.CLUSTERNAME }}
DOMAIN={{ skmon.DOMAIN }}
INSTANCE={{ skmon.INSTANCE | default('skmon-' + env) }}
APP_ENV={{ skmon.APP_ENV | default(env) }}
