# =============================================================================
# SKMon Environment Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKMon (VictoriaMetrics, Grafana, Loki, Alertmanager)
# Environment: {{ env }}
# Cluster: {{ skmon.CLUSTERNAME }}
# Domain: {{ skmon.DOMAIN }}
# =============================================================================

# Grafana Configuration
GF_SECURITY_ADMIN_USER={{ skmon.GRAFANA_ADMIN_USER }}
GF_SECURITY_ADMIN_PASSWORD={{ skmon.GRAFANA_ADMIN_PASSWORD }}
GF_SECURITY_SECRET_KEY={{ skmon.GRAFANA_SECRET_KEY }}
GF_SERVER_ROOT_URL={{ skmon_grafana_url }}
# Sign-in: Authentik OIDC only admits `skadmin` (admin-only), mapped to Grafana Admin and nothing
# else. The local admin user (above) and the login form stay for break-glass. The client secret
# is a Docker secret file, never an env value.
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Authentik
GF_AUTH_GENERIC_OAUTH_CLIENT_ID={{ skmon.GRAFANA_OIDC_CLIENT_ID }}
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET__FILE=/run/secrets/grafana_oidc_client_secret
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://{{ skmon.AUTHENTIK_HOST | default('', true) }}/application/o/authorize/
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://{{ skmon.AUTHENTIK_HOST | default('', true) }}/application/o/token/
GF_AUTH_GENERIC_OAUTH_API_URL=https://{{ skmon.AUTHENTIK_HOST | default('', true) }}/application/o/userinfo/
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH=groups
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'skadmin') && 'GrafanaAdmin' || ''
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
GF_AUTH_DISABLE_LOGIN_FORM=false
GF_USERS_ALLOW_SIGN_UP=false
{# skmon.GRAFANA_PLUGINS: list of plugin ids; [] installs none. Current Grafana
   refuses Angular plugins (simple-json-datasource, piechart-panel, worldmap-panel). #}
{% set _gf_plugins = skmon.GRAFANA_PLUGINS | default([]) %}
{% if _gf_plugins %}
GF_INSTALL_PLUGINS={{ _gf_plugins | join(",") }}
{% endif %}
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/provisioning/dashboards/estate-overview.json
{% if skmon.SMTP_ENABLED | default(false) %}
# Grafana SMTP Configuration
GF_SMTP_ENABLED=true
GF_SMTP_HOST={{ skmon.SMTP_HOST }}
GF_SMTP_PORT={{ skmon.SMTP_PORT }}
GF_SMTP_USER={{ skmon.SMTP_USER }}
GF_SMTP_PASSWORD={{ skmon.SMTP_PASSWORD }}
GF_SMTP_FROM_ADDRESS={{ skmon.SMTP_FROM_ADDRESS }}
GF_SMTP_FROM_NAME={{ skmon.SMTP_FROM_NAME | default('Grafana') }}
{% if skmon.SMTP_SECURE | default(true) %}
GF_SMTP_SKIP_VERIFY=false
GF_SMTP_REQUIRE_TLS=true
{% endif %}
{% endif %}

# Domain Configuration
CLUSTERNAME={{ skmon.CLUSTERNAME }}
DOMAIN={{ skmon.DOMAIN }}
INSTANCE={{ skmon.INSTANCE | default('skmon-' + env) }}
APP_ENV={{ skmon.APP_ENV | default(env) }}
