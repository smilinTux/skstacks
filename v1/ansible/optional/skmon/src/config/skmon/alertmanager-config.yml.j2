# Alertmanager routing, timers and inhibition (skmon v2 spec 8.2, 9.1, 9.5).
# Two receivers, both the bridge: people (bridge) and the dead-man's switch (watchdog).
# The bridge is addressed by its full Swarm service name (skmon-<env>_bridge): Alertmanager
# is also on the shared cloud-public-<env> overlay, where a short alias can resolve to
# another stack's service.
route:
  receiver: bridge
  group_by: [alertname, estate, class]
  group_wait: 30s
  group_interval: 2m
  repeat_interval: 24h
  routes:
    # Dead-man's switch: always firing, delivered once a minute to the bridge's /watchdog
    # path only. First so nothing else can catch it; no continue, so it never reaches a person.
    - matchers: ['alertname="Watchdog"']
      receiver: watchdog
      group_wait: 0s
      group_interval: 1m
      repeat_interval: 1m
    # Critical storage and node alerts leave 5 s after the first one (the 60 s budget, 8.1).
    - matchers: ['severity="critical"', 'class=~"storage|node"']
      group_wait: 5s
      repeat_interval: 4h
    # Every other critical alert: normal group_wait, repeat every 4 h.
    - matchers: ['severity="critical"']
      repeat_interval: 4h
    # Warnings (and anything else) inherit the root's 24 h repeat.

# Ordered from widest to narrowest (spec 8.2).
inhibit_rules:
  # 1. A down node mutes every other alert on that node. The catch-all target is safe:
  #    an alert never inhibits itself.
  - source_matchers: ['alertname=~"NodeDown|SwarmNodeNotReady"']
    target_matchers: ['alertname=~".+"']
    equal: [node]
  # 2. A firing storage alert mutes its consequences estate-wide. IoPressureHigh is a
  #    storage-class warning and one of the consequences, so it is not a source.
  - source_matchers: ['class="storage"', 'alertname!="IoPressureHigh"']
    target_matchers: ['alertname=~"ServiceBelowReplicas|TasksStuckPreparing|ContainerCrashloop|HttpEndpointDown|IoPressureHigh"']
    equal: [estate]
  # 3. Authentik down mutes the endpoint probes of every target behind forward auth.
  - source_matchers: ['alertname="AuthentikDown"']
    target_matchers: ['alertname="HttpEndpointDown"', 'forward_auth="true"']
    equal: [estate]
  # 4. A critical mutes the warning for the same alert and target.
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: [alertname, node, instance, service]

receivers:
  - name: bridge
    webhook_configs:
      - url: http://skmon-{{ env }}_bridge:8080/alert
        send_resolved: true
  - name: watchdog
    webhook_configs:
      - url: http://skmon-{{ env }}_bridge:8080/watchdog
