# vmalert rules, class container (spec 8).
groups:
  - name: skmon-container
    rules:
      # The kernel's OOM kill counter, per host. Where cadvisor saw the container that was
      # killed, that series (with stack, service and name) is reported instead of the host
      # one: `or on(node)` keeps a host series only when no container series of that node fired.
      # increase_prometheus, not increase: MetricsQL's increase counts the first sample of a
      # series it has just started seeing as an increase from 0 when the value is small, so
      # an agent restart on a host with a few old OOM kills would fire this alert.
      - alert: OomKill
        expr: >-
          increase_prometheus(container_oom_events_total[5m]) > 0
          or on(node) increase_prometheus(node_vmstat_oom_kill[5m]) > 0
        labels:
          severity: warning
          class: container
          estate: "{{ skmon.ESTATE }}"
        annotations:
{% raw %}
          summary: "The kernel killed a process for lack of memory on {{ $labels.node }}{{ if $labels.service }} (service {{ $labels.service }}){{ end }}."
{% endraw %}
          runbook: "Check the memory limit of the killed container against its usage, then the host's memory pressure."

      # A wedged Docker daemon, or an agent that lost the Docker socket, ends here, not in NodeDown.
      - alert: CadvisorScrapeFailing
        expr: up{job="alloy-cadvisor"} == 0
        for: 2m
        labels:
          severity: warning
          class: container
          estate: "{{ skmon.ESTATE }}"
        annotations:
{% raw %}
          summary: "Container metrics of {{ $labels.node }} cannot be scraped."
{% endraw %}
          runbook: "Check that the Docker daemon on the host answers (docker info) and that the agent can read the Docker socket."

      # increase_prometheus, not increase: see rules/container.yml.j2 (OomKill).
      - alert: ContainerCrashloop
        expr: increase_prometheus(skswarm_service_task_failures_total[10m]) >= 3
        labels:
          severity: warning
          class: container
          estate: "{{ skmon.ESTATE }}"
        annotations:
{% raw %}
          summary: "Service {{ $labels.service }} had {{ $value }} failed tasks in 10 minutes."
{% endraw %}
          runbook: "Read the logs of the failed tasks (docker service logs) and the exit code in docker service ps --no-trunc."
