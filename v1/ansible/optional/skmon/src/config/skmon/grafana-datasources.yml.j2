apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://skmon-{{ env }}_victoriametrics:8428
    isDefault: true
    editable: true
    jsonData:
      timeInterval: "30s"
      httpMethod: POST

  - name: Loki
    type: loki
    access: proxy
    url: http://skmon-{{ env }}_loki:3100
    editable: true
    jsonData:
      maxLines: 1000
