    {
      "type": "timeseries",
      "title": "CPU usage (cores)",
      "description": "Cores used. Data links open this service's logs and CPU flame graph for the same time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "sum by (service, task_slot, node) (rate(container_cpu_usage_seconds_total{image!=\"\", stack=~\"$stack\", service=~\"$service\", node=~\"$node\"}[$__rate_interval]))",
          "legendFormat": "{{service}}.{{task_slot}} ({{node}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
