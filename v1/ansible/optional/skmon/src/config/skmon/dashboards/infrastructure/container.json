    {
      "type": "stat",
      "title": "Container starts in range",
      "description": "Containers (including replacements) that started inside the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "count(container_start_time_seconds{image!=\"\", stack=~\"$stack\", service=~\"$service\", node=~\"$node\"} > time() - $__range_s) or vector(0)",
          "legendFormat": "starts",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
