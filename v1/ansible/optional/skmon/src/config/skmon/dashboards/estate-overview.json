        "h": 6,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "status-history",
      "title": "Nodes",
      "description": "One row per node, from the agent's host-metrics scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "up{job=\"alloy-unix\"}",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.9,
        "colWidth": 0.9,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Storage health",
      "description": "Pools, NFS, D-state and IO pressure, the same series the storage alerts watch. Red is anything above 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "count(node_zfs_zpool_state{state!=\"online\"} == 1) or vector(0)",
          "legendFormat": "ZFS pools not online",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "count(node_filesystem_device_error{fstype=~\"nfs4?\"} == 1) or vector(0)",
          "legendFormat": "NFS mounts in error",
          "refId": "B",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "max(node_processes_state{state=\"D\"}) or vector(0)",
          "legendFormat": "D-state processes (max)",
          "refId": "C",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "max(rate(node_pressure_io_stalled_seconds_total[$__rate_interval])) or vector(0)",
          "legendFormat": "IO stalled (max s/s)",
          "refId": "D",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "table",
      "title": "Services below replicas",
      "description": "Swarm services whose running count is under the desired count (the value is the running count).",
      "datasource": {
        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "skswarm_service_replicas_running < on (stack, service) skswarm_service_replicas_desired",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "estate": true,
              "mode": true
            },
            "renameByName": {
              "Value": "running"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "service",
            "desc": false
          }
        ]
      },
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      }
    },
    {
      "type": "row",
      "title": "Alerts and certificates",
      "collapsed": false,
      "panels": [],
      "id": 7,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "table",
      "title": "Firing alerts",
      "description": "Every alert vmalert currently has firing.",
      "datasource": {
        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "alertstate": true,
              "job": true,
              "instance": true,
              "Value": true,
              "estate": true
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "severity",
            "desc": false
          }
        ]
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "table",
      "title": "Certificates expiring soonest",
      "description": "The five https probes whose certificate expires first.",
      "datasource": {
        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "bottomk(5, min by (probe, severity) (probe_ssl_earliest_cert_expiry) - time())",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "estate": true
            },
            "renameByName": {
              "Value": "expires in"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "expires in",
            "desc": false
          }
        ]
      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "type": "row",
      "title": "Top containers",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "bargauge",
      "title": "Top containers by CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "topk(5, sum by (stack, service, node) (rate(container_cpu_usage_seconds_total{service!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{stack}}/{{service}} ({{node}})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "CPU cores used, five busiest Swarm containers.",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      }
    },
    {
      "type": "bargauge",
      "title": "Top containers by memory",
      "datasource": {
        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "topk(5, sum by (stack, service, node) (container_memory_working_set_bytes{service!=\"\"}))",
          "legendFormat": "{{stack}}/{{service}} ({{node}})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Working set bytes, five largest Swarm containers.",
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      }
    }
