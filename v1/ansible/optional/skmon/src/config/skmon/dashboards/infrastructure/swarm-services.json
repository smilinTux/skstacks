        "type": "prometheus",
        "uid": "skmon-vm"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skmon-vm"
          },
          "expr": "skswarm_service_replicas_desired{stack=~\"$stack\", service=~\"$service\"} - on (stack, service) skswarm_service_replicas_running{stack=~\"$stack\", service=~\"$service\"}",
