set -e

# sknet (Akvorado flow collector) Deploy Script
# Environment: {{ env }}
APPNAME=sknet
STACK_NAME=sknet-{{ env }}
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/sknet.yml"
ORCHESTRATOR="${STACK_NAME}_orchestrator"

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo "Error: Compose file not found: ${COMPOSE_FILE}"
    exit 1
fi

cd "${CONFIG_DIR}"

# Swarm configs are read from ${CONFIG_DIR}/configs once, here, and stored in
# the Raft log; each is named after its content, so a changed file rolls the
# service that mounts it, and --prune drops the superseded ones.
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

# First boot creates the Kafka topic and the ClickHouse schema before the
# other Akvorado services get a configuration, so the poll budget is generous
# (HEALTH_WAIT_SECONDS, default 300) and the result is a warning, never a
# failed deploy.
echo "Waiting for ${ORCHESTRATOR} to converge..."
WAIT=${HEALTH_WAIT_SECONDS:-300}
for _ in $(seq 1 $(( (WAIT + 4) / 5 ))); do
    REPLICAS=$(docker service ls --filter "name=${ORCHESTRATOR}" --format "{% raw %}{{.Replicas}}{% endraw %}")
    [[ -n "$REPLICAS" && "${REPLICAS%%/*}" == "${REPLICAS##*/}" && "${REPLICAS##*/}" != 0 ]] && break
    sleep 5
done
if [[ -n "$REPLICAS" && "${REPLICAS%%/*}" == "${REPLICAS##*/}" && "${REPLICAS##*/}" != 0 ]]; then
    echo "${ORCHESTRATOR} is running (${REPLICAS})"
else
    echo "${ORCHESTRATOR} not converged: ${REPLICAS}"
    docker service logs --tail 20 "${ORCHESTRATOR}" || true
fi
echo "Flow console: https://{{ sknet_host }}/"
{% if sknet_live_enabled | default(false) | bool %}
echo "Live view: https://{{ sknet_live_host }}/"
{% endif %}
echo "Flow inlet: udp {{ sknet_netflow_port }} (NetFlow v9) and udp {{ sknet_ipfix_port }} (IPFIX) on {{ sknet_data_node }}"
echo "Deployment complete!"
