# sknet exporter unit (one instance per interface), rendered by exporters.yml
# to /etc/systemd/system/sknet-softflowd@.service. The instance name is the
# interface name; everything per instance comes from
# /etc/sknet/softflowd-<instance>.env (SKNET_IFACE, SKNET_IFINDEX,
# SKNET_COLLECTOR, SKNET_PORT, SKNET_OPTIONS, SKNET_BPF). Do not edit on the
# host: the play rewrites it.
#   -i <index>:<name>   forces the interface index softflowd puts in the flow
#                       records (softflowd 1.0.0 and later), so Akvorado's
#                       static interface metadata can name the port
#   -v 9 -T full        NetFlow v9, full 5-tuple tracking
#   -N                  no promiscuous mode (a tun or WireGuard device has none)
#   -d                  stay in the foreground, systemd supervises it
[Unit]
Description=sknet softflowd exporter on %i
Documentation=https://github.com/irino/softflowd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile={{ sknet_x_etc }}/softflowd-%i.env
RuntimeDirectory=sknet-softflowd
ExecStart={{ sknet_x_binary }} -d -i ${SKNET_IFINDEX}:${SKNET_IFACE} -n ${SKNET_COLLECTOR}:${SKNET_PORT} -v 9 -T full -N -p /run/sknet-softflowd/%i.pid -c /run/sknet-softflowd/%i.ctl $SKNET_OPTIONS ${SKNET_BPF}
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
MemoryMax={{ sknet_x_memory_max }}
CPUQuota={{ sknet_x_cpu_quota }}

[Install]
WantedBy=multi-user.target
