# sknet live view proxy ({{ env }}): Traefik terminates TLS and the sign-in, this
# only forwards to the ntopng on LIVE_UPSTREAM (an IPv4 literal). Rendered by
# tasks/render.yml only when LIVE_UPSTREAM is set.
{
	admin off
	auto_https off
}

:8080 {
	# Health endpoint for the Swarm healthcheck; answers without touching ntopng.
	handle /_sknet_health {
		respond "ok" 200
	}
	handle {
		reverse_proxy {{ sknet_live_upstream }}
	}
}
