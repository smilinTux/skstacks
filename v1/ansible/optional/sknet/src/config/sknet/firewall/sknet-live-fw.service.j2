#
# sknet live view allowlist: re-applies the iptables chain at boot, before the ntopng unit.
[Unit]
Description=sknet live view port allowlist
After=network-pre.target
Before=sknet-live.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ sknet_l_fw_script }}

[Install]
WantedBy=multi-user.target
