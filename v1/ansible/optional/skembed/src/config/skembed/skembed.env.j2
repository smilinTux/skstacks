# skembed runtime environment ({{ env }}). Root only (0600): the Hugging Face
# token and the API key. Read by text-embeddings-inference (HF_TOKEN, API_KEY).
{% if skembed.HF_TOKEN | default('', true) | string | length > 0 %}
HF_TOKEN={{ skembed.HF_TOKEN }}
{% endif %}
{% if skembed.API_KEY | default('', true) | string | length > 0 %}
API_KEY={{ skembed.API_KEY }}
{% endif %}
