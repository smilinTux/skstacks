PGHOST=skmem-pg
PGUSER=postgres
PGPASSWORD={{ skmem_pg_password }}
PGDATABASE=skmemory
# Days of dumps kept (pruned only after a good dump); skmem_pg_backup_num_keep
# is the older name, still honoured.
BACKUP_KEEP_DAYS={{ skmem_pg_backup_keep_days | default(skmem_pg_backup_num_keep | default('7')) }}
BACKUP_FREQUENCY={{ skmem_pg_backup_frequency | default('1d') }}
