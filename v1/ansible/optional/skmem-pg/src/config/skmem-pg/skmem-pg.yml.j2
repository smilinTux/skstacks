# skmem-pg swarm stack template (rendered to /var/data/config/skmem-pg-{{ env }}/skmem-pg.yml)
version: "3.8"
services:
  skmem-pg:
    image: smilintux/skmem-pg:pg17-bm25-age
    command: ["-c", "shared_preload_libraries=pg_search,age"]
    environment:
      POSTGRES_PASSWORD: "{{ skmem_pg_password }}"   # from SERVICE vault
      POSTGRES_DB: skmemory
    volumes:
      - /var/data/runtime/{{ app }}-{{ env }}/postgres:/var/lib/postgresql/data
      - /var/data/config/{{ app }}-{{ env }}/init:/docker-entrypoint-initdb.d:ro
    networks:
      - skmem-pg-{{ env }}
      - cloud-public-{{ env }}
    deploy:
      replicas: 1
      placement:
        constraints: [node.role == worker]
      restart_policy: { condition: any }
      resources:
        limits: { memory: 4G }
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 15s
      timeout: 5s
      retries: 10

  # Crash-consistent pg_dump backups (mirrors sksso/authentik postgres-db-backup).
  # Dumps -> /var/data/{{ app }}-{{ env }}/database-dump ; inside the storage host's snapshots, copied offsite by skbackup (restic).
  skmem-pg-backup:
    image: postgres:17.11
    env_file: /var/data/config/{{ app }}-{{ env }}/{{ app }}-backup.env
    environment:
      - PGTEMP=/dump/tmp
    volumes:
      - /var/data/{{ app }}-{{ env }}/database-dump:/dump
      - /etc/localtime:/etc/localtime:ro
    # One shell runs this script (list form, no `bash -s <<EOF` heredoc): an
    # unquoted heredoc made the OUTER shell expand the date once at container
    # start, so every run overwrote one file and a failed dump truncated the
    # only copy. Each run now gets its own name, dumps to a hidden temp file
    # renamed only on success, and prunes dumps older than BACKUP_KEEP_DAYS
    # only after a good dump (a run of failures never ages out the last one).
    # Every $ is $$ so docker stack deploy does not interpolate it.
    entrypoint:
      - bash
      - -c
      - |
        set -o pipefail
        trap 'exit 0' HUP INT TERM
        rm -f /dump/.dump_*.tmp
        sleep 2m & wait $$!
        while true; do
          NAME=dump_$$(date +%d-%m-%Y_%H_%M_%S).psql
          TMP=/dump/.$${NAME}.tmp
          if pg_dump -Fc -h skmem-pg -U "$${PGUSER}" -d "$${PGDATABASE}" -f "$${TMP}" && [ -s "$${TMP}" ]; then
            mv -f "$${TMP}" "/dump/$${NAME}"
            echo "[backup] OK /dump/$${NAME} ($$(stat -c %s "/dump/$${NAME}") bytes)"
            DAYS=$${BACKUP_KEEP_DAYS:-7}
            [ "$${DAYS}" -ge 1 ] 2>/dev/null || DAYS=1
            find /dump -maxdepth 1 -type f -name 'dump_*.psql' ! -name "$${NAME}" -mmin +$$((DAYS * 1440)) -print -delete
          else
            echo "[backup] FAIL: dump failed or empty, previous dumps kept" >&2
            rm -f "$${TMP}"
          fi
          sleep "$${BACKUP_FREQUENCY:-1d}" & wait $$!
        done
    networks:
      - skmem-pg-{{ env }}
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - "node.role == worker"
      restart_policy: { condition: any }
networks:
  skmem-pg-{{ env }}:
    external: true
  cloud-public-{{ env }}:
    external: true
