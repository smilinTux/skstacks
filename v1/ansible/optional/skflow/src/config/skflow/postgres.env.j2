# skflow Postgres. Root-only (0600). Unused when DATABASE_URL is external.
# The image's POSTGRES_USER is a superuser: Windmill's migrations create
# their own roles (windmill_user, windmill_admin) and need that.
POSTGRES_USER=windmill
POSTGRES_PASSWORD={{ skflow.DB_PASSWORD | default('', true) }}
POSTGRES_DB=windmill
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256
TZ={{ skflow.TZ | default('UTC', true) }}
