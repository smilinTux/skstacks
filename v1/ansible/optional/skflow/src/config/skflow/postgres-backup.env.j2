# skflow Postgres dump sidecar. Root-only (0600).
# pg_dumpall, not pg_dump: Windmill keeps cluster-level roles its RLS
# policies are granted to, and a single-database dump loses them.
PGPASSWORD={{ skflow.DB_PASSWORD | default('', true) }}
PGUSER=windmill
PGDATABASE=windmill
# sleep(1) duration: seconds, or 1d
BACKUP_FREQUENCY={{ skflow.BACKUP_FREQUENCY | default('86400', true) }}
# Days of dumps kept (pruned only after a good dump)
BACKUP_KEEP_DAYS={{ skflow.BACKUP_KEEP_DAYS | default(skflow.BACKUP_NUM_KEEP | default('7', true), true) }}
