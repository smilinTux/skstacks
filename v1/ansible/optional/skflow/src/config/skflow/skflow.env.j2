# skflow (Windmill) environment, shared by server and workers.
# Root-only (0600): DATABASE_URL carries the database password.
{% if (skflow.DATABASE_URL | default('', true) | string | length) > 0 %}
DATABASE_URL={{ skflow.DATABASE_URL }}
{% else %}
DATABASE_URL=postgres://windmill:{{ skflow.DB_PASSWORD | default('', true) | string | urlencode | replace('/', '%2F') }}@postgres:5432/windmill?sslmode=disable
{% endif %}
BASE_URL=https://{{ sf_host }}
JSON_FMT={{ 'true' if skflow.JSON_LOGS | default(false) | bool else 'false' }}
RUST_LOG={{ skflow.LOG_LEVEL | default('info', true) }}
DISABLE_NSJAIL={{ 'true' if skflow.DISABLE_NSJAIL | default(true) | bool else 'false' }}
CREATE_WORKSPACE_REQUIRE_SUPERADMIN={{ 'true' if skflow.CREATE_WORKSPACE_REQUIRE_SUPERADMIN | default(true) | bool else 'false' }}
{% if (skflow.SUPERADMIN_SECRET | default('', true) | string | length) > 0 %}
SUPERADMIN_SECRET={{ skflow.SUPERADMIN_SECRET }}
{% endif %}
{% if (skflow.COOKIE_DOMAIN | default('', true) | string | length) > 0 %}
COOKIE_DOMAIN={{ skflow.COOKIE_DOMAIN }}
{% endif %}
TZ={{ skflow.TZ | default('UTC', true) }}
{% for k, v in (skflow.EXTRA_ENV | default({}, true)).items() %}
{{ k }}={{ v }}
{% endfor %}
