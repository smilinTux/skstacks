# skai provision service ({{ env }}). Root only (0600): the provisioner admin's
# credentials, the same values as in skai.env (Open WebUI created that admin
# from them on first start). Nothing else.
SKAI_PROVISION_URL=http://skai:8080
WEBUI_ADMIN_EMAIL={{ ska_provisioner_email }}
WEBUI_ADMIN_PASSWORD={{ skai.PROVISIONER_PASSWORD }}
