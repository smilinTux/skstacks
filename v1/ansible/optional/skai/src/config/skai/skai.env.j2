# skai (Open WebUI {{ env }}) environment. Root only (0600): it carries the
# gateway key, the DB password, the OIDC secret, the provisioner password and
# the corpus tool token. ENABLE_PERSISTENT_CONFIG=false: this file is the
# configuration on every start; nothing set in the admin UI survives a restart.
# Env names confirmed against Open WebUI v0.13.4 backend/open_webui/{config,env}.py.
ENABLE_PERSISTENT_CONFIG=false
WEBUI_URL=https://{{ ska_host }}
WEBUI_NAME={{ skai.WEBUI_NAME | default('SKAI', true) }}
WEBUI_SECRET_KEY={{ skai.SECRET_KEY }}
DATABASE_URL=postgresql://skai:{{ skai.DB_PASSWORD }}@db:5432/skai
VECTOR_DB=pgvector
PGVECTOR_DB_URL=postgresql://skai:{{ skai.DB_PASSWORD }}@db:5432/skai
ENABLE_VERSION_UPDATE_CHECK=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE={{ skai.DEFAULT_USER_ROLE | default('user', true) }}
# Provisioner admin: created on the FIRST start only (when the database has no
# users); the deploy signs in as it to manage the corpus presets.
WEBUI_ADMIN_EMAIL={{ ska_provisioner_email }}
WEBUI_ADMIN_PASSWORD={{ skai.PROVISIONER_PASSWORD }}
WEBUI_ADMIN_NAME=skai provisioner
# Models: one OpenAI-compatible gateway; no Ollama.
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL={{ ska_gateway_url }}
OPENAI_API_KEY={{ skai.GATEWAY_API_KEY }}
{% if ska_default_model | length > 0 %}
DEFAULT_MODELS={{ ska_default_model }}
{% endif %}
{% if ska_task_model | length > 0 %}
TASK_MODEL_EXTERNAL={{ ska_task_model }}
TASK_MODEL={{ ska_task_model }}
{% endif %}
ENABLE_TITLE_GENERATION=true
ENABLE_TAGS_GENERATION=true
ENABLE_FOLLOW_UP_GENERATION=true
# Web search (SearXNG): the model writes its own queries, results are fetched,
# embedded and reranked (hybrid search) before they reach the answer.
ENABLE_WEB_SEARCH={{ 'true' if ska_web_search else 'false' }}
{% if ska_web_search %}
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL={{ ska_searxng_url }}
ENABLE_SEARCH_QUERY_GENERATION=true
WEB_SEARCH_RESULT_COUNT={{ skai.WEB_SEARCH_RESULT_COUNT | default(6, true) }}
WEB_SEARCH_CONCURRENT_REQUESTS={{ skai.WEB_SEARCH_CONCURRENT_REQUESTS | default(4, true) }}
WEB_LOADER_CONCURRENT_REQUESTS={{ skai.WEB_LOADER_CONCURRENT_REQUESTS | default(6, true) }}
BYPASS_WEB_SEARCH_EMBEDDING_AND_RETRIEVAL=false
{% endif %}
# RAG: embeddings through skembed (OpenAI-compatible), vectors in pgvector.
RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL={{ ska_embed_url }}
RAG_OPENAI_API_KEY={{ skai.EMBED_API_KEY | default('no-key', true) }}
RAG_EMBEDDING_MODEL={{ ska_embed_model }}
ENABLE_RETRIEVAL_QUERY_GENERATION=true
ENABLE_RAG_HYBRID_SEARCH=true
RAG_TOP_K={{ skai.RAG_TOP_K | default(8, true) }}
RAG_TOP_K_RERANKER={{ skai.RAG_TOP_K_RERANKER | default(5, true) }}
{% if skai.RERANK_URL | default('', true) | string | length > 0 %}
RAG_RERANKING_ENGINE=external
RAG_EXTERNAL_RERANKER_URL={{ skai.RERANK_URL }}
{% if skai.RERANK_API_KEY | default('', true) | string | length > 0 %}
RAG_EXTERNAL_RERANKER_API_KEY={{ skai.RERANK_API_KEY }}
{% endif %}
{% endif %}
RAG_RERANKING_MODEL={{ skai.RERANK_MODEL | default('BAAI/bge-reranker-v2-m3', true) }}
{% if ska_corpus_enabled | bool %}
# Tool server: skcorpus (read-only corpus search), referenced as server:skcorpus.
ENABLE_TOOL_SERVERS=true
TOOL_SERVER_CONNECTIONS={{ ska_tool_servers | to_json }}
{% endif %}
{% if ska_auth_mode == 'oidc' %}
# Authentik OIDC. Admin by group: members of ADMIN_GROUP become admins on every
# login; USER_GROUPS may sign in (["*"]: anyone the Authentik binding lets in).
# The password login form is hidden; password sign-in stays on for the
# provisioner only (Traefik refuses /api/v1/auths/signin from outside).
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
OAUTH_CLIENT_ID={{ ska_oidc_client_id }}
OAUTH_CLIENT_SECRET={{ skai.OIDC_CLIENT_SECRET }}
OPENID_PROVIDER_URL={{ ska_oidc_discovery_url }}
OPENID_REDIRECT_URI=https://{{ ska_host }}/oauth/oidc/login/callback
OAUTH_PROVIDER_NAME={{ skai.OIDC_PROVIDER_NAME | default('SKStack SSO', true) }}
OAUTH_SCOPES=openid email profile
ENABLE_OAUTH_ROLE_MANAGEMENT=true
OAUTH_ROLES_CLAIM=groups
OAUTH_ADMIN_ROLES={{ ska_admin_group }}
OAUTH_ALLOWED_ROLES={{ (ska_user_groups + [ska_admin_group]) | unique | join(',') }}
ENABLE_LOGIN_FORM=false
ENABLE_PASSWORD_AUTH=true
{% else %}
ENABLE_LOGIN_FORM=true
ENABLE_PASSWORD_AUTH=true
{% endif %}
{% if ska_voice | bool %}
# Voice: speaches (faster-whisper STT, Piper TTS), OpenAI-compatible.
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://voice:8000/v1
AUDIO_STT_OPENAI_API_KEY={{ skai.VOICE_API_KEY }}
AUDIO_STT_MODEL={{ skai.VOICE_STT_MODEL | default('Systran/faster-whisper-small', true) }}
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://voice:8000/v1
AUDIO_TTS_OPENAI_API_KEY={{ skai.VOICE_API_KEY }}
AUDIO_TTS_MODEL={{ skai.VOICE_TTS_MODEL | default('speaches-ai/piper-en_US-amy-medium', true) }}
AUDIO_TTS_VOICE={{ skai.VOICE_TTS_VOICE | default('amy', true) }}
{% endif %}
