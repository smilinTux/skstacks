#!/bin/bash
set -e

# Never force-restart a service on its FIRST install (first-boot init must
# finish); a redeploy restarts the server when the play changed config.json,
# and the backup sidecar when it changed the backup script, which the
# stack spec cannot see (bind mounts).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

# skrac (MeshCentral) Deploy Script
# Environment: {{ env }}
APPNAME=skrac
STACK_NAME=skrac-{{ env }}
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skrac.yml"
SERVER="${STACK_NAME}_server"
BACKUP="${STACK_NAME}_backup"

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo "Error: Compose file not found: ${COMPOSE_FILE}"
    exit 1
fi

cd "${CONFIG_DIR}"

record_preexisting "${SERVER}" "${BACKUP}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

if [ "${RESTART_SERVER:-0}" = 1 ]; then
    echo "The play changed config.json of ${SERVER}"
    preexisted "${SERVER}" && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=true "${SERVER}" || true
fi
if [ "${RESTART_BACKUP:-0}" = 1 ]; then
    echo "The play changed the backup script of ${BACKUP}"
    preexisted "${BACKUP}" && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=true "${BACKUP}" || true
fi

echo "Waiting for ${SERVER} to converge..."
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${SERVER}" --format "{% raw %}{{.Replicas}}{% endraw %}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$REPLICAS" == "1/1" ]]; then
    echo "${SERVER} is running"
else
    echo "${SERVER} not converged: ${REPLICAS}"
    docker service logs --tail 20 "${SERVER}" || true
fi
echo "Web UI / agents: https://{{ skr_host }}/"
echo "Deployment complete!"
