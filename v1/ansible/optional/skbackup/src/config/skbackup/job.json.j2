{#
Generated by Ansible - DO NOT EDIT MANUALLY
skbackup ({{ env }}): one declarative backup job, rendered from an entry in
skbackup.jobs, in Duplicati's own export/import JSON schema (the same shape
"Export -> As file" produces from the web UI, per
https://docs.duplicati.com/configuration-and-management/import-and-export-backup-configurations).

This file is rendered at deploy time so it exists on disk, ready to import,
but it is NOT imported automatically: Duplicati's own non-interactive
importer (ConfigurationImporter, see duplicati/duplicati#3595) writes
directly into Duplicati-server.sqlite and expects the server to be stopped
while it runs, and we cannot confirm it ships (or its exact invocation --
mono vs dotnet, install path) inside every pinned linuxserver/duplicati
release without a live container to check, which this framework's build
process does not have. Driving it blind against a *running* server's
database is a real corruption risk, so this stays a documented one-time
manual step instead of a scripted one. See this service's README.md
("Declarative jobs" section) for the exact UI steps, and for a possible
future skbackup.jobs_auto_import var once that importer's presence has
been verified against the pinned image.
#}
{% set passphrase = job.passphrase | default(skbackup.passphrase | default('')) %}
{
  "CreatedByVersion": "{{ skbackup.DUPLICATI_VERSION | default('v2.4.0.0_stable_2026-09-03-ls309') }}",
  "Backup": {
    "ID": null,
    "Name": {{ job.name | tojson }},
    "Description": {{ (job.description | default('Rendered by skstacks skbackup at deploy time.')) | tojson }},
    "Tags": [],
    "TargetURL": {{ job.destination_url | tojson }},
    "DBPath": null,
    "Sources": [
{% for src in job.sources %}
      {{ ('/source' + src) | tojson }}{{ "," if not loop.last }}
{% endfor %}
    ],
    "Settings": [
      { "Filter": "", "Name": "encryption-module", "Value": "aes", "Argument": null },
      { "Filter": "", "Name": "compression-module", "Value": "zip", "Argument": null },
      { "Filter": "", "Name": "passphrase", "Value": {{ passphrase | tojson }}, "Argument": null },
      { "Filter": "", "Name": "filter-file", "Value": "/config/exclude.filter", "Argument": null },
      { "Filter": "", "Name": "keep-time", "Value": {{ (job.retention | default('30D')) | tojson }}, "Argument": null }
    ],
    "Filters": [],
    "Metadata": {}
  },
  "Schedule": {
    "ID": null,
    "Tags": [],
    "Time": {{ (job.schedule_time | default('23:00')) | tojson }},
    "Repeat": {{ (job.schedule_repeat | default('1D')) | tojson }},
    "LastRun": null,
    "Rule": "",
    "AllowedDays": []
  }
}
