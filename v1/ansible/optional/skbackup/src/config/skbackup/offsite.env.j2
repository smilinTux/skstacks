# restic environment for {{ skb.branding.product_name }}, rendered by the deploy (mode 0600).
RESTIC_REPOSITORY={{ skb.offsite.repository | string | quote }}
RESTIC_PASSWORD_FILE={{ (skb_confdir ~ '/offsite.pass') | quote }}
{% for k in skb.offsite.env | sort %}
{{ k }}={{ skb.offsite.env[k] | string | quote }}
{% endfor %}
