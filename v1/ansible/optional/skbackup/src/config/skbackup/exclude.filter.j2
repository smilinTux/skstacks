# Generated by Ansible - DO NOT EDIT MANUALLY
# skbackup ({{ env }}): Duplicati filter file, one pattern per line ("-"
# excludes, "+" includes; glob syntax). Paths are container-side, relative
# to /source (the read-only bind mount of skbackup.source_path, default
# /var/data -- see skbackup.yml.j2). Reference:
# https://docs.duplicati.com/detailed-descriptions/filters-and-paths
#
# Any declaratively-rendered job (job.json.j2) references this file via
# --filter-file=/config/exclude.filter. A job created by hand in the web UI
# does not pick this up automatically -- add the same option under
# Settings -> Default options (applies to every backup) or per-job under
# Options -> "--filter-file" to get the same behaviour. See this service's
# README.md.
#
# Defaults, in order:
#   1. skbackup's own data and config dirs (never back up the backup app
#      itself -- recursive and pointless).
#   2. every service's live DB/cache runtime datadir under
#      /var/data/runtime/<svc>-<env>/* (postgres, redis, mariadb "db",
#      clamav, sessions, ...) -- these are covered by each stack's own
#      dump-to-disk backup sidecar (e.g. skorch's postgres-backup,
#      skgallery's postgres-backup), so backing up the live engine files
#      here would be both redundant and unsafe (a live datadir copied
#      mid-write is not a consistent backup).
#   3. generic cache directories by name, wherever they live.
# Override entirely with skbackup.exclude (a list of raw filter lines) if
# this instance's estate uses a different layout.
{% for pattern in skbackup.exclude | default([
  '-/source/' + app + '-' + env + '/*',
  '-/source/config/' + app + '-' + env + '/*',
  '-/source/runtime/*',
  '-*/.cache/*',
  '-*/cache/*',
]) %}
{{ pattern }}
{% endfor %}
