# Generated by Ansible - DO NOT EDIT MANUALLY
# skbackup ({{ env }}): Duplicati container environment. See this service's
# README.md for the vault contract. SETTINGS_ENCRYPTION_KEY and
# DUPLICATI__WEBSERVICE_PASSWORD have no default here on purpose (the
# linuxserver image itself defaults DUPLICATI__WEBSERVICE_PASSWORD to the
# literal "changeme" when unset -- this template never falls back to that):
# an instance that forgets to set them fails to render rather than shipping
# a public backup UI with no real password. The deploy playbook also
# asserts both are non-empty before it will deploy (a vault value of "" is
# caught there; an unset vault key is caught here by Jinja's undefined
# lookup).

TZ={{ skbackup.TZ | default('UTC') }}
PUID={{ skbackup.PUID | default(1000) }}
PGID={{ skbackup.PGID | default(1000) }}
SETTINGS_ENCRYPTION_KEY={{ skbackup.settings_encryption_key }}
DUPLICATI__WEBSERVICE_PASSWORD={{ skbackup.ui_password }}
{% if skbackup.CLI_ARGS is defined and skbackup.CLI_ARGS %}
CLI_ARGS={{ skbackup.CLI_ARGS }}
{% endif %}
