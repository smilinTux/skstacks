#!/bin/bash
# =============================================================================
# SKBackup Deploy Script
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKBackup (Duplicati)
# Environment: {{ env }}
# =============================================================================
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

APP="skbackup"
ENV_NAME="{{ env }}"
CONFIG_DIR="/var/data/config/${APP}-${ENV_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"
STACK_NAME="${APP}-${ENV_NAME}"

if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi
export CLUSTERNAME DOMAIN INSTANCE APP_ENV BASE_DOMAIN

echo -e "${GREEN}Deploying ${STACK_NAME} stack (Duplicati)...${NC}"

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 10

echo -e "${YELLOW}Checking service health...${NC}"
REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_duplicati" --format "{{ '{{.Replicas}}' }}")
if [[ "$REPLICAS" != "1/1" ]]; then
    echo -e "${RED}${STACK_NAME} Duplicati health check: ${REPLICAS}${NC}"
    docker service logs --tail 20 "${STACK_NAME}_duplicati" || true
    exit 1
fi
echo -e "${GREEN}${STACK_NAME} Duplicati is healthy and running.${NC}"

JOBS_DIR="${CONFIG_DIR}/jobs"
if [ -d "${JOBS_DIR}" ] && [ -n "$(ls -A "${JOBS_DIR}" 2>/dev/null)" ]; then
    echo -e "${YELLOW}Declarative job configs are rendered under ${JOBS_DIR}.${NC}"
    echo -e "${YELLOW}They are NOT imported automatically -- see this service's${NC}"
    echo -e "${YELLOW}README.md ('Declarative jobs') for the one-time UI import step.${NC}"
fi

echo -e "${GREEN}Deployment complete!${NC}"
