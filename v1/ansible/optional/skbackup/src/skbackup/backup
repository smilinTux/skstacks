#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Host-level backup engine for a storage host that serves a cluster's data:
#   tier 1  snapshots of the data (sanoid on ZFS, or builtin) + pre-deploy helper
#   tier 2  per-app copy from a frozen snapshot into a second pool or disk
#   tier 3  DB dump hooks and dump freshness gates, before the snapshot
#   tier 4  restic to an offsite repository (S3, B2, rest-server, local)
#   tier 5  restore test: sampled restore vs the frozen source + restic check
#   tier 6  staleness and capacity checks with alerts
#
# All behaviour and every name it prints come from one config file, passed
# with --conf (the deploy installs a wrapper that does this). See the app's
# README for the config and the procedures.
set -euo pipefail
umask 077

ENGINE_VERSION=1.0.0
LIB="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)/lib"
# shellcheck source=lib/core.sh
. "$LIB/core.sh"
# shellcheck source=lib/snap.sh
. "$LIB/snap.sh"
# shellcheck source=lib/local.sh
. "$LIB/local.sh"
# shellcheck source=lib/offsite.sh
. "$LIB/offsite.sh"
# shellcheck source=lib/check.sh
. "$LIB/check.sh"

usage() {
  banner
  cat <<EOF

usage: $BRAND_SHORT [--conf FILE] <command> [args]

commands:
  run                 nightly: dump hooks and checks, frozen snapshot, per-app copy, offsite
  snapshot            tier 1 (builtin engine): snapshot the data and prune to the newest N
  predeploy PURPOSE   snapshot the data before a deploy (pre-PURPOSE-<time>), prune old ones
  copy                tier 2 alone: per-app copy from a fresh frozen snapshot
  offsite             tier 4 alone: restic backup of every set
  prune               restic forget (per set and app) and prune
  restore-test        tier 5: sampled restore vs the frozen source, then restic check
  restore             copy APP SNAPSHOT DIR | snapshot APP SNAPSHOT DIR | offsite SET APP DIR [ID]
  check               tier 6: staleness and capacity checks, one alert per finding
  status              what is configured and how old every tier is
  snapshots           the offsite snapshots of this host
  init-offsite        create the restic repository if it does not exist yet
  help                this text
EOF
  printf '\n'
  footer
}

cmd_run() {
  take_lock
  local failures=0
  if [ "$DUMPS_ENABLED" = 1 ]; then
    run_dump_hooks
    run_dump_checks
    failures=$((HOOK_FAILURES + DUMP_FAILURES))
    if [ "$failures" != 0 ] && [ "$DUMPS_REQUIRED" = 1 ]; then
      notify crit "$BRAND_SHORT-run" "run aborted on $HOST_LABEL: $failures dump problem(s)" \
        "No snapshot, copy or offsite upload was made, so no backup holds a stale or partial dump. Fix the dumps, then run again."
      return 1
    fi
  fi
  local need_snap=0
  [ "$COPY_ENABLED" != 1 ] || need_snap=1
  if [ "$OFFSITE_ENABLED" = 1 ] && sets_need_data_snapshot; then need_snap=1; fi
  [ "$need_snap" = 0 ] || run_snapshot_begin
  if [ "$COPY_ENABLED" = 1 ]; then
    copy_apps "$RUN_SNAP"
    failures=$((failures + COPY_FAILURES))
  fi
  if [ "$OFFSITE_ENABLED" = 1 ]; then
    offsite_sets
    failures=$((failures + OFFSITE_FAILURES))
  fi
  run_snapshot_end
  if [ "$failures" != 0 ]; then
    notify crit "$BRAND_SHORT-run" "run finished on $HOST_LABEL with $failures failure(s)" \
      "See the alerts before this one and the run log for details."
    return 1
  fi
  stamp run
  log "run complete"
}

main() {
  local conf=${BACKUP_CONF:-}
  while [ $# -gt 0 ]; do
    case "$1" in
      --conf) [ $# -ge 2 ] || { echo "--conf needs a file" >&2; exit 2; }; conf=$2; shift 2 ;;
      --conf=*) conf=${1#--conf=}; shift ;;
      *) break ;;
    esac
  done
  load_config "$conf"
  local cmd=${1:-help}
  [ $# -eq 0 ] || shift
  case "$cmd" in
    help | -h | --help) usage ;;
    --version | version) printf '%s %s\n' "$BRAND_PRODUCT" "$ENGINE_VERSION" ;;
    run) cmd_run "$@" ;;
    snapshot) cmd_snapshot "$@" ;;
    predeploy) cmd_predeploy "$@" ;;
    copy) cmd_copy "$@" ;;
    offsite) cmd_offsite "$@" ;;
    prune) cmd_prune "$@" ;;
    restore-test) cmd_restore_test "$@" ;;
    restore) cmd_restore "$@" ;;
    check) cmd_check "$@" ;;
    status) cmd_status "$@" ;;
    snapshots) cmd_snapshots "$@" ;;
    init-offsite) cmd_init_offsite "$@" ;;
    *) usage_die "unknown command '$cmd' (see: $BRAND_SHORT help)" ;;
  esac
}

main "$@"
