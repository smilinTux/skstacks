# n8n Configuration
N8N_HOST={{ skorch_cfg.N8N_HOST if (skorch_cfg.N8N_HOST is defined and skorch_cfg.N8N_HOST != '') else ('skorch.' + (cluster_name | default('cluster1')) + '.' + (domain | default('example.com'))) }}
N8N_PORT={{ skorch_cfg.N8N_PORT if (skorch_cfg.N8N_PORT is defined and skorch_cfg.N8N_PORT != '') else '5678' }}
N8N_PROTOCOL={{ skorch_cfg.N8N_PROTOCOL if (skorch_cfg.N8N_PROTOCOL is defined and skorch_cfg.N8N_PROTOCOL != '') else 'https' }}
N8N_ENCRYPTION_KEY={{ skorch_cfg.N8N_ENCRYPTION_KEY if (skorch_cfg.N8N_ENCRYPTION_KEY is defined and skorch_cfg.N8N_ENCRYPTION_KEY != '' and skorch_cfg.N8N_ENCRYPTION_KEY != 'CHANGE_ME') else '' }}
{% if skorch_cfg.N8N_BASIC_AUTH_USER | default('') %}
N8N_BASIC_AUTH_USER={{ skorch_cfg.N8N_BASIC_AUTH_USER if (skorch_cfg.N8N_BASIC_AUTH_USER is defined and skorch_cfg.N8N_BASIC_AUTH_USER != '') else '' }}
{% endif %}
{% if skorch_cfg.N8N_BASIC_AUTH_PASSWORD | default('') %}
N8N_BASIC_AUTH_PASSWORD={{ skorch_cfg.N8N_BASIC_AUTH_PASSWORD if (skorch_cfg.N8N_BASIC_AUTH_PASSWORD is defined and skorch_cfg.N8N_BASIC_AUTH_PASSWORD != '' and skorch_cfg.N8N_BASIC_AUTH_PASSWORD != 'CHANGE_ME') else '' }}
{% endif %}
WEBHOOK_URL={{ skorch_cfg.WEBHOOK_URL if (skorch_cfg.WEBHOOK_URL is defined and skorch_cfg.WEBHOOK_URL != '') else ('https://skorch.' + (cluster_name | default('cluster1')) + '.' + (domain | default('example.com')) + '/') }}

# Editor Base URL for proper static asset loading and metadata generation
# This ensures icons, favicons, and Open Graph tags work correctly
# When behind a reverse proxy (Traefik), use the full public URL without port
N8N_EDITOR_BASE_URL={{ (skorch_cfg.N8N_PROTOCOL if (skorch_cfg.N8N_PROTOCOL is defined and skorch_cfg.N8N_PROTOCOL != '') else 'https') }}://{{ skorch_cfg.N8N_HOST if (skorch_cfg.N8N_HOST is defined and skorch_cfg.N8N_HOST != '') else ('skorch.' + (cluster_name | default('cluster1')) + '.' + (domain | default('example.com'))) }}
VUE_APP_URL_BASE_API={{ (skorch_cfg.N8N_PROTOCOL if (skorch_cfg.N8N_PROTOCOL is defined and skorch_cfg.N8N_PROTOCOL != '') else 'https') }}://{{ skorch_cfg.N8N_HOST if (skorch_cfg.N8N_HOST is defined and skorch_cfg.N8N_HOST != '') else ('skorch.' + (cluster_name | default('cluster1')) + '.' + (domain | default('example.com'))) }}

# Database Configuration
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE={{ skorch_cfg.POSTGRES_DB }}
DB_POSTGRESDB_USER={{ skorch_cfg.POSTGRES_USER }}
DB_POSTGRESDB_PASSWORD={{ skorch_cfg.POSTGRES_PASSWORD }}

# Redis Configuration for Queue Mode
QUEUE_BULL_REDIS_HOST=redis
QUEUE_BULL_REDIS_PORT=6379
QUEUE_BULL_REDIS_DB=0
QUEUE_BULL_REDIS_PASSWORD={{ skorch_cfg.REDIS_PASSWORD }}

# n8n Settings
N8N_RUNNERS_ENABLED={{ skorch_cfg.N8N_RUNNERS_ENABLED if (skorch_cfg.N8N_RUNNERS_ENABLED is defined and skorch_cfg.N8N_RUNNERS_ENABLED != '') else 'true' }}
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE={{ skorch_cfg.N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE if (skorch_cfg.N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE is defined and skorch_cfg.N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE != '') else 'true' }}
N8N_REINSTALL_MISSING_PACKAGES={{ skorch_cfg.N8N_REINSTALL_MISSING_PACKAGES if (skorch_cfg.N8N_REINSTALL_MISSING_PACKAGES is defined and skorch_cfg.N8N_REINSTALL_MISSING_PACKAGES != '') else 'true' }}
GENERIC_TIMEZONE={{ skorch_cfg.GENERIC_TIMEZONE if (skorch_cfg.GENERIC_TIMEZONE is defined and skorch_cfg.GENERIC_TIMEZONE != '') else 'UTC' }}
NODE_ENV=production

# Execution Mode - Regular mode for single-node deployments
# Use 'queue' only if you have a separate worker process running
EXECUTIONS_MODE={{ skorch_cfg.EXECUTIONS_MODE | default('regular') }}

# Trust proxy for Traefik (fixes X-Forwarded-For warnings)
N8N_TRUST_PROXY=true

# File permissions enforcement
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Security settings
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# Scaling settings - Only relevant in queue mode
# OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

# Python Execution - Enable Python in Code nodes
N8N_PYTHON_ENABLED={{ skorch_cfg.N8N_PYTHON_ENABLED | default('true') }}

# Code Node Module Imports - Allow all built-in and external modules
NODE_FUNCTION_ALLOW_BUILTIN={{ skorch_cfg.NODE_FUNCTION_ALLOW_BUILTIN | default('*') }}
NODE_FUNCTION_ALLOW_EXTERNAL={{ skorch_cfg.NODE_FUNCTION_ALLOW_EXTERNAL | default('*') }}

# Community Packages - Enable all community packages (verified and unverified)
N8N_COMMUNITY_PACKAGES_ENABLED={{ skorch_cfg.N8N_COMMUNITY_PACKAGES_ENABLED | default('true') }}
N8N_VERIFIED_PACKAGES_ENABLED={{ skorch_cfg.N8N_VERIFIED_PACKAGES_ENABLED | default('true') }}
N8N_UNVERIFIED_PACKAGES_ENABLED={{ skorch_cfg.N8N_UNVERIFIED_PACKAGES_ENABLED | default('true') }}

# Execution Data Pruning - Automatically clean up old execution data
EXECUTIONS_DATA_PRUNE={{ skorch_cfg.EXECUTIONS_DATA_PRUNE | default('true') }}
EXECUTIONS_DATA_MAX_AGE={{ skorch_cfg.EXECUTIONS_DATA_MAX_AGE | default('168') }}

# Metrics Endpoint - Enable Prometheus metrics for monitoring
N8N_METRICS={{ skorch_cfg.N8N_METRICS | default('true') }}

# MCP Server - Enable Model Context Protocol server for AI integrations
# This enables the MCP Server Trigger node in workflows
N8N_FEATURE_FLAG_MCP={{ skorch_cfg.N8N_FEATURE_FLAG_MCP | default('true') }}

{% if skorch_cfg.email_enabled is defined and skorch_cfg.email_enabled %}
# Email Configuration (SMTP for n8n notifications)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST={{ skorch_cfg.email_smtp_host }}
N8N_SMTP_PORT={{ skorch_cfg.email_smtp_port }}
N8N_SMTP_USER={{ skorch_cfg.email_smtp_user }}
N8N_SMTP_PASS={{ skorch_cfg.email_smtp_password }}
{% if skorch_cfg.email_smtp_secure == 'ssl' %}
N8N_SMTP_SSL=true
{% else %}
N8N_SMTP_SECURE=false
{% endif %}
{% if skorch_cfg.email_from_address is defined %}
N8N_SMTP_SENDER={{ skorch_cfg.email_from_address }}
{% endif %}
{% endif %}


