# PostgreSQL Backup Configuration for skorch
# Daily backups with 7-day retention

# PostgreSQL connection
# The postgres-backup-local image requires POSTGRES_PASSWORD (not PGPASSWORD)
POSTGRES_PASSWORD={{ skorch.POSTGRES_PASSWORD }}
POSTGRES_DB={{ skorch.POSTGRES_DB }}
POSTGRES_USER={{ skorch.POSTGRES_USER }}

# Backup schedule (in seconds)
BACKUP_FREQUENCY={{ skorch.BACKUP_FREQUENCY | default('86400') }}

# Number of backup files to keep
BACKUP_NUM_KEEP={{ skorch.BACKUP_NUM_KEEP | default('7') }}


