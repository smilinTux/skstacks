version: '3.8'

services:
  n8n:
    image: "{{ skorch_cfg.N8N_VERSION | default('n8nio/n8n:2.47.2@sha256:83ec9349e09a8efdb51f7e2729f1f83503c038475747a351772ff6b78838f02a') }}"
    env_file: /var/data/config/skorch-{{ env }}/skorch.env
    logging:
      driver: json-file
      options:
        max-size: 4m
        max-file: "1"
    volumes:
      # N8n data directory (direct host bind mount - env aware)
      - /var/data/skorch-{{ env }}/n8n_data:/home/node/.n8n
      # Local files directory (direct host bind mount - env aware)
      - /var/data/skorch-{{ env }}/local-files:/files
    depends_on:
      - postgres
      - redis
    networks:
      - skorch-{{ env }}
      - cloud-public-{{ env }}
    deploy:
      placement:
        constraints: {{ (skorch_cfg.placement_constraints | default([])) | tojson }}
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
      restart_policy:
        condition: on-failure
        delay: 10s
      mode: replicated
      replicas: 1
      labels:
        # === TRAEFIK: HTTP ===
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        # === TRAEFIK: ROUTERS ===
        - "traefik.http.routers.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.rule=Host(`skorch{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skorch_cfg.CLUSTERNAME | default(cluster_name) }}.{{ skorch_cfg.DOMAIN | default(domain) }}`)"
        - "traefik.http.routers.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.entrypoints=websecure"
        - "traefik.http.routers.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.tls=true"
        - "traefik.http.routers.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.tls.certresolver=main"
        - "traefik.http.routers.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.tls.options=intermediate@file"
        - "traefik.http.routers.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.middlewares={{ skorch_cfg.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file', true) }}"
        - "traefik.http.routers.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.service=skorch{% if env != 'prod' %}-{{ env }}{% endif %}"
        # === TRAEFIK: SERVICES ===
        - "traefik.http.services.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.server.port=5678"
        # === STICKY SESSIONS: Required for stateful n8n application ===
        # Even with replicas: 1, multiple Traefik workers can cause requests to be routed
        # through different workers during updates, leading to session issues
        # Sticky sessions ensure all requests from the same client use the same Traefik worker
        - "traefik.http.services.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky=true"
        - "traefik.http.services.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie=true"
        - "traefik.http.services.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie.name=skorch_session"
        - "traefik.http.services.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie.secure=true"
        - "traefik.http.services.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie.httpOnly=true"
        - "traefik.http.services.skorch{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.sticky.cookie.sameSite=lax"

{# Postgres 18+ images moved PGDATA to /var/lib/postgresql/<major>/docker and declare VOLUME
   /var/lib/postgresql, so the data bind mount targets the PARENT for major 18 and up. A pinned
   older image keeps the old target. Mounting /var/lib/postgresql/data under an 18 image would
   leave the real data dir on an anonymous volume. The default here must stay in step with the
   image default below (test_postgres18_guard.py). #}
{% set _pg_data_mount = '/var/lib/postgresql' if ((skorch_cfg.POSTGRES_IMAGE | default('pgvector/pgvector:pg18')).split('@')[0].split('/')[-1].split(':')[-1].lstrip('pg').split('.')[0].split('-')[0] | int(0)) >= 18 else '/var/lib/postgresql/data' %}
  postgres:
    image: {{ skorch_cfg.POSTGRES_IMAGE | default('pgvector/pgvector:pg18@sha256:c29f30688a9ad961691bdf0ec1650717cc132a5814619d80f80463d6e4c42e47') }}
    env_file: /var/data/config/skorch-{{ env }}/postgres.env
    environment:
      - PGTEMP=/var/lib/postgresql/data/tmp
    networks:
      - skorch-{{ env }}
    volumes:
      - /var/data/runtime/skorch-{{ env }}/postgres:{{ _pg_data_mount }}
      - /var/data/skorch-{{ env }}/postgres-init:/docker-entrypoint-initdb.d
{# $$ = the container's own env (postgres.env). A single $ is interpolated by docker stack
   deploy from the deployer's shell, where these are unset, so the probe ran as
   `pg_isready -U  -d ` and the server logged FATAL: role "-d" does not exist on every
   probe (test_pg_isready_healthchecks.py). #}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 10
    deploy:
      placement:
        constraints: {{ (skorch_cfg.placement_constraints | default([])) | tojson }}
      restart_policy:
        condition: any
        delay: 5s

  redis:
    image: {{ skorch_cfg.REDIS_IMAGE | default('redis:8.10.3-alpine@sha256:71885d8cc6e42f2bc0aa2eb853bfc4be200b5108a46ac50e117ae1df0531fb80') }}
    command: redis-server /usr/local/etc/redis/redis.conf
    networks:
      - skorch-{{ env }}
    volumes:
      - /var/data/runtime/skorch-{{ env }}/redis:/data
      - /var/data/config/skorch-{{ env }}/redis.conf:/usr/local/etc/redis/redis.conf:ro
    deploy:
      placement:
        constraints: {{ (skorch_cfg.placement_constraints | default([])) | tojson }}
      restart_policy:
        condition: any
        delay: 5s

  postgres-backup:
    image: {{ skorch_cfg.POSTGRES_BACKUP_IMAGE | default('prodrigestivill/postgres-backup-local:18-debian-d257e5d@sha256:f70742ebe42b2277689b028d1fd15aa80f77cffa01da163cc9f85a6ff1866e7f') }}
    env_file: /var/data/config/skorch-{{ env }}/postgres-backup.env
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_EXTRA_OPTS: "-Z9 --schema=public --blobs"
      SCHEDULE: "@daily"
      BACKUP_KEEP_DAYS: 7
      BACKUP_KEEP_WEEKS: 4
      BACKUP_KEEP_MONTHS: 6
      HEALTHCHECK_PORT: 8080
    volumes:
      # Database backup directory (direct host bind mount - env aware)
      - /var/data/skorch-{{ env }}/database-backup:/backups
    networks:
      - skorch-{{ env }}
    depends_on:
      - postgres
    deploy:
      placement:
        constraints: {{ (skorch_cfg.placement_constraints | default([])) | tojson }}
      restart_policy:
        condition: on-failure

{% if skorch_cfg.enable_gpg_signer | default(false) %}
  # GPG Signer sidecar: REST API for detached PGP signing with pre-provisioned
  # "trustee" keys. Opt-in (skorch_cfg.enable_gpg_signer) because it needs real
  # keys provisioned into the gpg-keys volume before it does anything useful;
  # see src/gpg-signer/README.md for key provisioning and the auth model.
  gpg-signer:
    image: "{{ skorch_cfg.GPG_SIGNER_IMAGE | default('ghcr.io/smilintux/skstacks-gpg-signer:skstacks-v2.18.0') }}"
    environment:
      - GNUPGHOME=/keys
      - GPG_SIGNER_API_SECRET={{ skorch_cfg.GPG_SIGNER_API_SECRET }}
      - GPG_SIGNER_ALLOW_KEY_IMPORT={{ skorch_cfg.GPG_SIGNER_ALLOW_KEY_IMPORT | default('false') }}
      - GPG_SIGNER_MAX_UPLOAD_BYTES={{ skorch_cfg.GPG_SIGNER_MAX_UPLOAD_BYTES | default('26214400') }}
      - TRUSTEE_A_KEY_ID={{ skorch_cfg.TRUSTEE_A_KEY_ID | default('') }}
      - TRUSTEE_B_KEY_ID={{ skorch_cfg.TRUSTEE_B_KEY_ID | default('') }}
      - TRUSTEE_C_KEY_ID={{ skorch_cfg.TRUSTEE_C_KEY_ID | default('') }}
      - LOG_LEVEL=INFO
    volumes:
      # GPG keys directory - contains private keys for trustees
      - /var/data/skorch-{{ env }}/gpg-keys:/keys
    networks:
      - skorch-{{ env }}
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:8080/health"]
      interval: 30s
      timeout: 10s
      start_period: 10s
      retries: 3
    deploy:
      placement:
        constraints: {{ (skorch_cfg.placement_constraints | default([])) | tojson }}
      restart_policy:
        # any, not on-failure: an unhealthy kill makes gunicorn exit 0, and
        # Swarm never restarts a clean exit under on-failure (service stuck 0/1).
        condition: any
        delay: 5s
      resources:
        limits:
          memory: 256M
        reservations:
          memory: 64M
{% endif %}

networks:
  cloud-public-{{ env }}:
    external: true
  skorch-{{ env }}:
    external: true
