version: '3.8'

# skseek: Perplexica, an AI-powered search UI that answers from live search
# results (via SearXNG/skpeek as its backend) instead of just a model's
# training data. Depends on skpeek being deployed on the same instance;
# reaches it as skpeek-{{ env }}_skpeek over the shared skpeek-{{ env }}
# overlay network rather than a public URL.

services:
  skseek:
    image: {{ skseek_image | default('itzcrazykns1337/perplexica:latest@sha256:343d2a02858cc3c15bb35bf94b3249923f4eb5de16eb80d266eddfef6d84951d') }}
    env_file: /var/data/config/skseek-{{ env }}/skseek.env
    logging:
      driver: json-file
      options:
        max-size: 4m
        max-file: "1"

    volumes:
      - /var/data/skseek-{{ env }}/data:/home/perplexica/data:rw
      - {{ skseek.CONFIG_TOML_PATH | default('/var/data/config/skseek-' ~ env ~ '/config.toml') }}:/home/perplexica/config.toml:ro

    networks:
      - cloud-public-{{ env }}
      - skseek-{{ env }}
      - skpeek-{{ env }}

    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:{{ skseek.PORT | default('3000') }}/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

    deploy:
      mode: replicated
      replicas: 1
      resources:
        limits:
          memory: {{ skseek.MEMORY_LIMIT | default('2G') }}
        reservations:
          memory: {{ skseek.MEMORY_RESERVATION | default('512M') }}
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any
        delay: 5s
      labels:
        # === TRAEFIK: HTTP ===
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        # === TRAEFIK: ROUTERS ===
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}.rule=Host(`skseek{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skseek.CLUSTERNAME | default(cluster_name) }}.{{ skseek.DOMAIN | default(domain) }}`)"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}.entrypoints=websecure"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}.tls=true"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}.tls.certresolver=main"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}.tls.options=intermediate@file"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}.middlewares={{ skseek.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file', true) }}"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}.service=skseek{% if env != 'prod' %}-{{ env }}{% endif %}"
{# === API ROUTER (raw upstream status codes) ===
    Perplexica's Next.js API routes (`/api/search`, `/api/chat`, `/api/config`...).
    The main router's chain carries error-pages@file, which swaps every 4xx/5xx for an
    HTML page from the error-pages service and replays the ORIGINAL method there, so API
    clients never saw the app's real status or JSON error. This router sends the machine
    paths through the main chain with each error-pages-bearing chain swapped for its
    no-error-pages form (rate limit and security headers stay; the upload chains keep their
    buffering). skseek.API_MIDDLEWARES replaces the derived chain. #}
{% set _api_swap = {'default@file': 'default-no-error-pages@file', 'default-no-crowdsec@file': 'default-no-error-pages@file', 'upload-chain@file': 'large-upload-buffering@file,default-security-headers@file', 'upload-chain-no-crowdsec@file': 'large-upload-buffering@file,default-security-headers@file', 'skai-chain@file': 'skai-headers@file,gzip@file', 'error-pages@file': '', 'error-pages-all@file': ''} %}
{% set _api_mw = [] %}
{% for _m in (skseek.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file', true)).split(',') %}
{% set _s = _api_swap.get(_m | trim, _m | trim) %}
{% if _s %}
{% set _ = _api_mw.append(_s) %}
{% endif %}
{% endfor %}
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}-api.rule=Host(`skseek{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skseek.CLUSTERNAME | default(cluster_name) }}.{{ skseek.DOMAIN | default(domain) }}`) && (PathPrefix(`/api/`))"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}-api.entrypoints=websecure"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls=true"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.certresolver=main"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.options=intermediate@file"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}-api.priority=150"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}-api.middlewares={{ skseek.API_MIDDLEWARES | default(_api_mw | unique | join(','), true) }}"
        - "traefik.http.routers.skseek{% if env != 'prod' %}-{{ env }}{% endif %}-api.service=skseek{% if env != 'prod' %}-{{ env }}{% endif %}"
        # === TRAEFIK: SERVICES ===
        - "traefik.http.services.skseek{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.server.port={{ skseek.PORT | default('3000') }}"

networks:
  cloud-public-{{ env }}:
    external: true
  skseek-{{ env }}:
    external: true
  skpeek-{{ env }}:
    external: true
