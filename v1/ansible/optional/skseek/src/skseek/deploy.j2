#!/bin/bash
set -e

# Never force-restart a service on its FIRST install: a restart in the middle
# of first-boot init (schema migrations, initial setup) can leave it corrupt.
# record_preexisting runs before the stack deploy; only services that already
# existed then are force-updated afterwards (a redeploy still restarts them to
# pick up changed bind-mounted config files).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

# SKSeek{% if env == 'prod' %}-Prod{% elif env == 'staging' %}-Staging{% else %}-Dev{% endif %} Deployment Script
APP="skseek"
STACK_NAME=skseek{% if env == 'prod' %}-prod{% elif env == 'staging' %}-staging{% else %}-dev{% endif %}

SKSEEK_CONFIG_DIR="/var/data/config/${STACK_NAME}"
SKSEEK_COMPOSE_FILE="${SKSEEK_CONFIG_DIR}/docker-compose.yml"
CONFIG_DIR="${SKSEEK_CONFIG_DIR}"
COMPOSE_FILE="${SKSEEK_COMPOSE_FILE}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}Deploying ${STACK_NAME} stack (Perplexica AI search)...${NC}"

# Source environment variables (preserve CONFIG_DIR and COMPOSE_FILE)
if [ -f "${SKSEEK_CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    set -a
    unset CONFIG_DIR COMPOSE_FILE 2>/dev/null || true
    . "${SKSEEK_CONFIG_DIR}/${APP}.sh.env"
    set +a
    CONFIG_DIR="${SKSEEK_CONFIG_DIR}"
    COMPOSE_FILE="${SKSEEK_COMPOSE_FILE}"
fi

export CLUSTER_NAME DOMAIN INSTANCE APP_ENV

echo -e "${BLUE}Debug info:${NC}"
echo "STACK_NAME: ${STACK_NAME}"
echo "CONFIG_DIR: ${CONFIG_DIR}"
echo "COMPOSE_FILE: ${COMPOSE_FILE}"
echo "PWD: $(pwd)"

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# Define networks with their subnets (idempotent network creation).
# skpeek-{{ env }} must match the subnet skpeek's own playbook uses, so
# whichever service deploys first creates it correctly for both.
{% if env == 'prod' %}{% set default_networks = [{'name': 'skseek-prod', 'subnet': '172.16.190.0/24'}, {'name': 'cloud-public-prod', 'subnet': '172.16.200.0/24'}, {'name': 'skpeek-prod', 'subnet': '172.16.63.0/24'}] %}
{% elif env == 'staging' %}{% set default_networks = [{'name': 'skseek-staging', 'subnet': '172.16.191.0/24'}, {'name': 'cloud-public-staging', 'subnet': '172.16.201.0/24'}, {'name': 'skpeek-staging', 'subnet': '172.16.148.0/24'}] %}
{% else %}{% set default_networks = [{'name': 'skseek-dev', 'subnet': '172.16.192.0/24'}, {'name': 'cloud-public-dev', 'subnet': '172.16.202.0/24'}, {'name': 'skpeek-dev', 'subnet': '172.16.149.0/24'}] %}
{% endif %}
declare -A NETWORKS
{% for network in app_networks | default(default_networks) %}
NETWORKS["{{ network.name }}"]="{{ network.subnet }}"
{% endfor %}

# -----------------------------------------------------------------------------
# Network safety: a deploy never deletes an existing network (same pattern in
# every deploy.j2 and in shared/tasks/create_networks.yml).
#   exists, same subnet      -> reused
#   exists, other subnet     -> deploy stops; set the vault to the live subnet
#   missing                  -> created
# NETWORK_RECREATE_ON_MISMATCH=true (env, or vault network_recreate_on_mismatch)
# may recreate only this service's own network; shared cloud-* never.
# -----------------------------------------------------------------------------
NETWORK_VAULT_KEY="skseek_{{ env }}_networks"
NETWORK_OWNED="{{ app }}-{{ env }}"
NETWORK_RECREATE_ON_MISMATCH="${NETWORK_RECREATE_ON_MISMATCH:-{{ network_recreate_on_mismatch | default(false) | string | lower }}}"

ensure_network() {
    local name="$1" subnet="$2" live
    if ! docker network ls --format '{% raw %}{{.Name}}{% endraw %}' | grep -qx "${name}"; then
        echo "Creating overlay network ${name} (${subnet})"
        docker network create --driver overlay --attachable --subnet "${subnet}" "${name}" || return 1
        sleep 2
        return 0
    fi
    live=$(docker network inspect "${name}" --format '{% raw %}{{range .IPAM.Config}}{{.Subnet}} {{end}}{% endraw %}' 2>/dev/null | awk '{print $1}')
    if [ -z "${live}" ] || [ "${live}" = "${subnet}" ]; then
        echo "Network ${name} exists (subnet ${live:-unknown}), reusing it"
        return 0
    fi
    if [ "${NETWORK_RECREATE_ON_MISMATCH}" = "true" ] && [ "${name}" = "${NETWORK_OWNED}" ] && [ "${name#cloud-}" = "${name}" ]; then
        echo "NETWORK_RECREATE_ON_MISMATCH=true: recreating ${name} (${live} -> ${subnet})"
        docker network rm "${name}" || return 1
        sleep 2
        docker network create --driver overlay --attachable --subnet "${subnet}" "${name}" || return 1
        sleep 2
        return 0
    fi
    echo "ERROR: network ${name} exists with subnet ${live}, but the configured subnet is ${subnet}." >&2
    echo "ERROR: refusing to delete it (other stacks may be attached). To adopt the live network, set the ${name} subnet to ${live} in the vault (${NETWORK_VAULT_KEY})." >&2
    if [ "${name}" = "${NETWORK_OWNED}" ] && [ "${name#cloud-}" = "${name}" ]; then
        echo "ERROR: or, to recreate this service's own network with ${subnet}, remove the stack and rerun with NETWORK_RECREATE_ON_MISMATCH=true." >&2
    fi
    return 1
}

for network_name in "${!NETWORKS[@]}"; do
    ensure_network "${network_name}" "${NETWORKS[$network_name]}" || { echo "ERROR: network setup failed for ${network_name}" >&2; exit 1; }
done

echo -e "${GREEN}All networks verified/created${NC}"

echo -e "${YELLOW}Deploying stack configuration...${NC}"
record_preexisting "${STACK_NAME}_skseek"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 5

echo -e "${YELLOW}Forcing service update...${NC}"
preexisted ${STACK_NAME}_skseek && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_skseek || true

echo -e "${YELLOW}Waiting for service to stabilize...${NC}"
sleep 10

echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

for _ in $(seq 1 36); do
    SKSEEK_REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_skseek" --format "{{ '{{.Replicas}}' }}")
    [[ "$SKSEEK_REPLICAS" == "1/1" ]] && break
    sleep 5
done

if [[ "$SKSEEK_REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} is healthy and running!${NC}"
    echo -e "${GREEN}skseek service: ${STACK_NAME}_skseek${NC}"
else
    echo -e "${RED}${STACK_NAME} health check issues:${NC}"
    echo -e "${YELLOW}skseek: ${SKSEEK_REPLICAS}${NC}"
    docker service logs --tail 10 ${STACK_NAME}_skseek
fi

echo -e "${GREEN}Deployment complete!${NC}"
