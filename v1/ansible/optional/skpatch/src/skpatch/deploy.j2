#!/bin/bash
set -e

# Never force-restart a service on its FIRST install (first-boot init must
# finish); a redeploy restarts dashboard when the play changed its env file,
# which the stack spec cannot see (env_file is a bind mount).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

# skpatch (linux-update-dashboard) Deploy Script
# Environment: {{ env }}
APPNAME=skpatch
STACK_NAME=skpatch-{{ env }}
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skpatch.yml"
DASHBOARD="${STACK_NAME}_dashboard"

if [ -f "${CONFIG_DIR}/${APPNAME}.sh.env" ]; then
    source "${CONFIG_DIR}/${APPNAME}.sh.env"
fi

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo "Error: Compose file not found: ${COMPOSE_FILE}"
    exit 1
fi

cd "${CONFIG_DIR}"

record_preexisting "${DASHBOARD}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

if [ "${RESTART_DASHBOARD:-0}" = 1 ]; then
    echo "The play changed the env file of ${DASHBOARD}"
    preexisted "${DASHBOARD}" && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=true "${DASHBOARD}" || true
fi

echo "Waiting for ${DASHBOARD} to converge..."
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${DASHBOARD}" --format "{% raw %}{{.Replicas}}{% endraw %}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$REPLICAS" == "1/1" ]]; then
    echo "${DASHBOARD} is running"
else
    echo "${DASHBOARD} not converged: ${REPLICAS}"
    docker service logs --tail 20 "${DASHBOARD}" || true
fi
echo "Web UI: https://${SKPATCH_HOST:-unknown}/"
echo "Deployment complete!"
