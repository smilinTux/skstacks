# skpatch (linux-update-dashboard) runtime environment ({{ env }}). Root only (0600).
# LUDASH_ENCRYPTION_KEY decrypts every stored SSH credential: changing it
# makes them all unreadable and they must be re-entered.
LUDASH_ENCRYPTION_KEY={{ skpatch.LUDASH_ENCRYPTION_KEY }}
LUDASH_DB_PATH=/data/dashboard.db
LUDASH_BASE_URL=https://{{ skp_host }}
LUDASH_PORT=3001
LUDASH_HOST=0.0.0.0
# Behind Traefik: trust its X-Forwarded-* headers.
LUDASH_TRUST_PROXY=true
LUDASH_LOG_LEVEL={{ skpatch.LUDASH_LOG_LEVEL | default('info', true) }}
TZ={{ skpatch.TZ | default('UTC', true) }}
NODE_ENV=production
{% for k, v in (skpatch.extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
