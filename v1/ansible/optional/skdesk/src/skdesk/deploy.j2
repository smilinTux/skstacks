#!/bin/bash
set -e

# SKDesk{% if env == 'prod' %}-Prod{% elif env == 'staging' %}-Staging{% else %}-Dev{% endif %} Deployment Script
APP="skdesk"
STACK_NAME=skdesk{% if env == 'prod' %}-prod{% elif env == 'staging' %}-staging{% else %}-dev{% endif %}

SKDESK_CONFIG_DIR="/var/data/config/${STACK_NAME}"
SKDESK_COMPOSE_FILE="${SKDESK_CONFIG_DIR}/docker-compose.yml"
CONFIG_DIR="${SKDESK_CONFIG_DIR}"
COMPOSE_FILE="${SKDESK_COMPOSE_FILE}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}Deploying ${STACK_NAME} stack (RustDesk relay server)...${NC}"

# Source environment variables (preserve CONFIG_DIR and COMPOSE_FILE)
if [ -f "${SKDESK_CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    set -a
    unset CONFIG_DIR COMPOSE_FILE 2>/dev/null || true
    . "${SKDESK_CONFIG_DIR}/${APP}.sh.env"
    set +a
    CONFIG_DIR="${SKDESK_CONFIG_DIR}"
    COMPOSE_FILE="${SKDESK_COMPOSE_FILE}"
fi

export CLUSTER_NAME DOMAIN INSTANCE APP_ENV

echo -e "${BLUE}Debug info:${NC}"
echo "STACK_NAME: ${STACK_NAME}"
echo "CONFIG_DIR: ${CONFIG_DIR}"
echo "COMPOSE_FILE: ${COMPOSE_FILE}"
echo "PWD: $(pwd)"

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# hbbs/hbbr run in network_mode: host (raw relay TCP/UDP ports, never
# routed through Traefik), so there is no overlay network to create here.

echo -e "${YELLOW}Deploying stack configuration...${NC}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 5

echo -e "${YELLOW}Forcing service updates...${NC}"
docker service update --force --detach=false ${STACK_NAME}_hbbs || true
docker service update --force --detach=false ${STACK_NAME}_hbbr || true

echo -e "${YELLOW}Waiting for services to stabilize...${NC}"
sleep 10

echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

HBBS_REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_hbbs" --format "{{ '{{.Replicas}}' }}")
HBBR_REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_hbbr" --format "{{ '{{.Replicas}}' }}")

if [[ "$HBBS_REPLICAS" == "1/1" && "$HBBR_REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} is healthy and running!${NC}"
    echo -e "${GREEN}hbbs service: ${STACK_NAME}_hbbs${NC}"
    echo -e "${GREEN}hbbr service: ${STACK_NAME}_hbbr${NC}"
else
    echo -e "${RED}${STACK_NAME} health check issues:${NC}"
    echo -e "${YELLOW}hbbs: ${HBBS_REPLICAS}${NC}"
    echo -e "${YELLOW}hbbr: ${HBBR_REPLICAS}${NC}"
    echo -e "${YELLOW}Recent hbbs logs:${NC}"
    docker service logs --tail 10 ${STACK_NAME}_hbbs
    echo -e "${YELLOW}Recent hbbr logs:${NC}"
    docker service logs --tail 10 ${STACK_NAME}_hbbr
fi

echo -e "${GREEN}Deployment complete!${NC}"
