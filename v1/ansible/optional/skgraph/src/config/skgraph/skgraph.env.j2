# =============================================================================
# SKGraph (FalkorDB) Environment Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKGraph (FalkorDB Graph Database)
# Environment: {{ env }}
# Cluster: {{ skgraph.CLUSTERNAME }}
# Domain: {{ skgraph.DOMAIN }}
# =============================================================================

{% if skgraph.FALKORDB_PASSWORD is defined and skgraph.FALKORDB_PASSWORD %}
# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
REDIS_ARGS=--requirepass {{ skgraph.FALKORDB_PASSWORD }}
{% endif %}

# ---------------------------------------------------------------------------
# FalkorDB Configuration
# ---------------------------------------------------------------------------
# Max queued queries (default: 25)
FALKORDB_MAX_QUEUED_QUERIES={{ skgraph.FALKORDB_MAX_QUEUED_QUERIES | default('25') }}

# Query timeout in milliseconds (0 = no timeout)
FALKORDB_TIMEOUT={{ skgraph.FALKORDB_TIMEOUT | default('0') }}

# Result set size limit (-1 = unlimited)
FALKORDB_RESULT_SET_SIZE={{ skgraph.FALKORDB_RESULT_SET_SIZE | default('-1') }}

# Cache size (number of queries to cache)
FALKORDB_CACHE_SIZE={{ skgraph.FALKORDB_CACHE_SIZE | default('25') }}
