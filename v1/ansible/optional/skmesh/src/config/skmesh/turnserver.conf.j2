{%- if skmesh.CLOUDFLARED | default(false) -%}
  {%- set _base_domain = skmesh.DOMAIN -%}
{%- else -%}
  {%- set _base_domain = skmesh.CLUSTERNAME ~ '.' ~ skmesh.DOMAIN -%}
{%- endif -%}
{%- set _turn_domain = skmesh.TURN_DOMAIN | default('turn.' ~ _base_domain, true) -%}
{%- set _tls = (skmesh.TURN_TLS | default(false) | string | lower) in ['true', 'yes', '1'] -%}
{%- set _ext = skmesh.COTURN_EXTERNAL_IP | default('', true) | string -%}
{%- set _relay_ip = skmesh.COTURN_RELAY_IP | default('', true) | string -%}
# coturn for skmesh (and any other client of the same shared secret, such as
# Nextcloud Talk). Rendered by the skmesh deploy; read once at start by
# turnserver running as root, which then drops to nobody (proc-user). Holds
# the shared secret: owner-only on the host, never on the command line.
listening-port=3478
{% if _tls %}
tls-listening-port=5349
cert=/certs-dump/{{ _turn_domain }}/certificate.crt
pkey=/certs-dump/{{ _turn_domain }}/privatekey.key
{% else %}
no-tls
no-dtls
{% endif %}
realm={{ skmesh.TURN_REALM | default(_turn_domain, true) }}
server-name={{ skmesh.TURN_SERVER_NAME | default(_turn_domain, true) }}
{% if _relay_ip %}
relay-ip={{ _relay_ip }}
{% endif %}
{% if _ext %}
external-ip={{ _ext }}{% if _relay_ip and '/' not in _ext %}/{{ _relay_ip }}{% endif %}

{% endif %}
min-port={{ skmesh.TURN_MIN_PORT | default(49152) }}
max-port={{ skmesh.TURN_MAX_PORT | default(65535) }}

# TURN REST credentials (user "<expiry>:<name>", password base64
# HMAC-SHA1 of it under this secret): NetBird management with
# TimeBasedCredentials, Nextcloud Talk's turn_servers "secret".
use-auth-secret
static-auth-secret={{ skmesh.TURN_SECRET }}
stale-nonce=600

fingerprint
log-file=stdout
simple-log
no-cli
no-multicast-peers
no-tlsv1
no-tlsv1_1
proc-user=nobody
proc-group=nogroup

# coturn runs on the host network: never relay into private, loopback,
# link-local, CGNAT (mesh) or other special ranges, or a TURN client could
# reach this host's and the LAN's internal services through the relay.
no-loopback-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
{% for _r in skmesh.TURN_ALLOWED_PEER_IPS | default([], true) %}
allowed-peer-ip={{ _r }}
{% endfor %}
