{%- if skmesh.CLOUDFLARED | default(false) -%}
  {%- set _base_domain = skmesh.DOMAIN -%}
{%- else -%}
  {%- set _base_domain = skmesh.CLUSTERNAME ~ '.' ~ skmesh.DOMAIN -%}
{%- endif -%}
{%- set _mode = skmesh.AUTH_MODE | default('standalone') | string | lower -%}
{%- set _host = 'skmesh' ~ ('' if env == 'prod' else '-' ~ env) ~ '.' ~ _base_domain -%}
{%- set _sso = skmesh.SSO_HOST | default('sso' ~ ('' if env == 'prod' else '-' ~ env) ~ '.' ~ _base_domain) -%}
{%- set _cid = skmesh.NETBIRD_AUTH_CLIENT_ID | default('skmesh') -%}
# NetBird environment (AUTH_MODE: {{ _mode }}). Management reads its auth
# settings from management.json; the AUTH_* keys below are the dashboard's
# (init_react_envs.sh), and must match the IdP management.json points at.

NETBIRD_STORE_ENGINE_POSTGRES_DSN=postgres://netbird:{{ skmesh.POSTGRES_PASSWORD }}@postgres:5432/netbird?sslmode=disable

NETBIRD_DOMAIN={{ _host }}

NETBIRD_MGMT_API_ENDPOINT=https://{{ _host }}
NETBIRD_MGMT_GRPC_API_ENDPOINT=https://{{ _host }}
NETBIRD_SIGNAL_ENDPOINT=https://{{ _host }}

# Dashboard OIDC client
USE_AUTH0=false
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
{% if _mode == 'authentik' %}
# sksso (Authentik) application {{ skmesh.AUTHENTIK_APP_SLUG | default('skmesh') }}: public client, PKCE
AUTH_AUTHORITY=https://{{ _sso }}/application/o/{{ skmesh.AUTHENTIK_APP_SLUG | default('skmesh') }}/
AUTH_CLIENT_ID={{ _cid }}
AUTH_AUDIENCE={{ _cid }}
AUTH_SUPPORTED_SCOPES=openid profile email offline_access
{% else %}
# NetBird embedded IdP (Dex) served by management at /oauth2
AUTH_AUTHORITY=https://{{ _host }}/oauth2
AUTH_CLIENT_ID=netbird-dashboard
AUTH_AUDIENCE=netbird-dashboard
AUTH_SUPPORTED_SCOPES=openid profile email groups
{% endif %}

TURN_DOMAIN=turn.{{ _base_domain }}
TURN_USER={{ skmesh.TURN_USER }}
TURN_PASSWORD={{ skmesh.TURN_PASSWORD }}

NETBIRD_RELAY_ENDPOINT={{ skmesh.NETBIRD_RELAY_ENDPOINT }}
NETBIRD_RELAY_AUTH_SECRET={{ skmesh.NETBIRD_RELAY_AUTH_SECRET }}

# NetBird Relay server specific env vars
# Keep the scheme: without it the relay announces rel:// (plain), but peers
# reach it through the TLS-terminating proxy on :443, i.e. rels://.
NB_EXPOSED_ADDRESS={{ skmesh.NETBIRD_RELAY_ENDPOINT }}
NB_AUTH_SECRET={{ skmesh.NETBIRD_RELAY_AUTH_SECRET }}
NB_LOG_LEVEL=info

NETBIRD_DATASTORE_ENC_KEY={{ skmesh.NETBIRD_DATASTORE_ENC_KEY }}

NETBIRD_DISABLE_ANONYMOUS_METRICS=true
