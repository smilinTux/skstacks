# PostgreSQL Backup Configuration for skmesh
# Daily backups with 7-day retention

# PostgreSQL connection
PGPASSWORD={{ skmesh.POSTGRES_PASSWORD }}

# Backup schedule (in seconds)
# 86400 = 24 hours (daily)
BACKUP_FREQUENCY=86400

# Number of backup files to keep
BACKUP_NUM_KEEP=7

PGDATABASE=netbird
PGUSER=netbird








