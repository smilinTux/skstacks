# PostgreSQL Backup Configuration for skmesh
# Daily backups with 7-day retention

# PostgreSQL connection
PGPASSWORD={{ skmesh.POSTGRES_PASSWORD }}

# Backup schedule (sleep(1) duration: seconds, or 1d)
BACKUP_FREQUENCY={{ skmesh.BACKUP_FREQUENCY | default('86400') }}

# Days of dumps kept (pruned only after a good dump)
BACKUP_KEEP_DAYS={{ skmesh.BACKUP_KEEP_DAYS | default(skmesh.BACKUP_NUM_KEEP | default('7')) }}

PGDATABASE=netbird
PGUSER=netbird








