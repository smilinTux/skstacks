# SKForm (OpenTofu) Environment Configuration
# Generated from vault variables

# OpenTofu Configuration
TOFU_VERSION={{ skform.TOFU_VERSION }}
TOFU_LOG_LEVEL={{ skform.TOFU_LOG_LEVEL }}

# State Backend Configuration
STATE_BACKEND_TYPE={{ skform.STATE_BACKEND_TYPE }}
STATE_BACKEND_PATH={{ skform.STATE_BACKEND_PATH }}

# SKStor Integration (if using remote state)
{% if skform.SKSTOR_ENABLED %}
SKSTOR_ENABLED=true
SKSTOR_ENDPOINT={{ skform.SKSTOR_ENDPOINT }}
SKSTOR_BUCKET={{ skform.SKSTOR_BUCKET }}
SKSTOR_REGION={{ skform.SKSTOR_REGION }}
{% else %}
SKSTOR_ENABLED=false
{% endif %}

# Provider Configuration Flags
PROVIDER_AWS_ENABLED={{ skform.PROVIDER_AWS_ENABLED | lower }}
PROVIDER_AZURE_ENABLED={{ skform.PROVIDER_AZURE_ENABLED | lower }}
PROVIDER_GCP_ENABLED={{ skform.PROVIDER_GCP_ENABLED | lower }}
PROVIDER_DIGITALOCEAN_ENABLED={{ skform.PROVIDER_DIGITALOCEAN_ENABLED | lower }}
PROVIDER_HETZNER_ENABLED={{ skform.PROVIDER_HETZNER_ENABLED | lower }}
PROVIDER_PROXMOX_ENABLED={{ skform.PROVIDER_PROXMOX_ENABLED | lower }}
PROVIDER_VIRTUALBOX_ENABLED={{ skform.PROVIDER_VIRTUALBOX_ENABLED | lower }}
PROVIDER_VSPHERE_ENABLED={{ skform.PROVIDER_VSPHERE_ENABLED | lower }}
PROVIDER_CLOUDFLARE_ENABLED={{ skform.PROVIDER_CLOUDFLARE_ENABLED | lower }}
PROVIDER_LINODE_ENABLED={{ skform.PROVIDER_LINODE_ENABLED | lower }}
PROVIDER_SCALEWAY_ENABLED={{ skform.PROVIDER_SCALEWAY_ENABLED | lower }}

# Provider Credentials (from vault)
{% if skform.PROVIDER_AWS_ENABLED %}
AWS_ACCESS_KEY_ID={{ vault_skform_aws_access_key }}
AWS_SECRET_ACCESS_KEY={{ vault_skform_aws_secret_key }}
AWS_DEFAULT_REGION={{ vault_skform_aws_region }}
{% endif %}

{% if skform.PROVIDER_AZURE_ENABLED %}
ARM_SUBSCRIPTION_ID={{ vault_skform_azure_subscription_id }}
ARM_CLIENT_ID={{ vault_skform_azure_client_id }}
ARM_CLIENT_SECRET={{ vault_skform_azure_client_secret }}
ARM_TENANT_ID={{ vault_skform_azure_tenant_id }}
{% endif %}

{% if skform.PROVIDER_GCP_ENABLED %}
GOOGLE_PROJECT={{ vault_skform_gcp_project }}
GOOGLE_APPLICATION_CREDENTIALS=/tofu/credentials/gcp-credentials.json
{% endif %}

{% if skform.PROVIDER_DIGITALOCEAN_ENABLED %}
DIGITALOCEAN_TOKEN={{ vault_skform_digitalocean_token }}
{% endif %}

{% if skform.PROVIDER_HETZNER_ENABLED %}
HCLOUD_TOKEN={{ vault_skform_hetzner_token }}
{% endif %}

{% if skform.PROVIDER_CLOUDFLARE_ENABLED %}
CLOUDFLARE_API_TOKEN={{ vault_skform_cloudflare_api_token }}
CLOUDFLARE_EMAIL={{ vault_skform_cloudflare_email }}
{% endif %}

{% if skform.PROVIDER_LINODE_ENABLED %}
LINODE_TOKEN={{ vault_skform_linode_token }}
{% endif %}

{% if skform.PROVIDER_SCALEWAY_ENABLED %}
SCW_ACCESS_KEY={{ vault_skform_scaleway_access_key }}
SCW_SECRET_KEY={{ vault_skform_scaleway_secret_key }}
{% endif %}

{% if skform.PROVIDER_PROXMOX_ENABLED %}
PROXMOX_API_URL={{ vault_skform_proxmox_api_url }}
PROXMOX_API_TOKEN_ID={{ vault_skform_proxmox_api_token_id }}
PROXMOX_API_TOKEN_SECRET={{ vault_skform_proxmox_api_token_secret }}
PROXMOX_INSECURE={{ vault_skform_proxmox_insecure }}
{% endif %}

{% if skform.PROVIDER_VSPHERE_ENABLED %}
VSPHERE_SERVER={{ vault_skform_vsphere_server }}
VSPHERE_USER={{ vault_skform_vsphere_user }}
VSPHERE_PASSWORD={{ vault_skform_vsphere_password }}
VSPHERE_ALLOW_UNVERIFIED_SSL={{ vault_skform_vsphere_insecure }}
{% endif %}

{% if skform.PROVIDER_VIRTUALBOX_ENABLED %}
VBOX_HOST={{ vault_skform_virtualbox_host }}
VBOX_USER={{ vault_skform_virtualbox_user }}
VBOX_PASSWORD={{ vault_skform_virtualbox_password }}
{% endif %}
