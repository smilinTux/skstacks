#!/bin/bash
# =============================================================================
# SKForm Deploy Script
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKForm (OpenTofu Infrastructure-as-Code, on-demand CLI container)
# Environment: {{ env }}
# =============================================================================
set -e

APP="skform"
STACK_NAME="{{ app }}-{{ env }}"
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Deploying ${STACK_NAME} stack (OpenTofu Infrastructure-as-Code)...${NC}"

# Source environment variables
if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi

# Export environment for docker
export CLUSTER_NAME DOMAIN INSTANCE APP_ENV

# Check if compose file exists
if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# Deploy stack with prune and registry auth
echo -e "${YELLOW}Deploying stack configuration...${NC}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

# Wait a moment for services to register
sleep 5

# Force update services to pull latest images
echo -e "${YELLOW}Forcing service updates to pull latest images...${NC}"
docker service update --force --detach=false ${STACK_NAME}_opentofu || true

# Wait for services to stabilize
echo -e "${YELLOW}Waiting for services to stabilize...${NC}"
sleep 10

# Show service status
echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

# Health check
echo -e "${YELLOW}Checking service health...${NC}"
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_opentofu" --format "{% raw %}{{.Replicas}}{% endraw %}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} is healthy and running!${NC}"

    # Verify OpenTofu is available
    echo -e "${YELLOW}Verifying OpenTofu installation...${NC}"
    TOFU_VERSION=$(docker exec ${STACK_NAME}_opentofu tofu version 2>/dev/null | head -1 || echo "unknown")
    if [ "$TOFU_VERSION" != "unknown" ]; then
        echo -e "${GREEN}OpenTofu version: ${TOFU_VERSION}${NC}"
    else
        echo -e "${YELLOW}Could not verify OpenTofu version${NC}"
    fi
else
    echo -e "${RED}${STACK_NAME} health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_opentofu
fi

echo -e "${GREEN}Deployment complete!${NC}"
echo -e "${GREEN}Usage:${NC}"
echo -e "  ${YELLOW}docker exec -it ${STACK_NAME}_opentofu tofu --help${NC}"
echo -e "  ${YELLOW}cd /var/data/${STACK_NAME}/workspaces && ./tofu-init${NC}"
