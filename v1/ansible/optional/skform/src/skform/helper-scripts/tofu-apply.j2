#!/bin/bash
# OpenTofu Apply Helper Script
# Applies infrastructure changes with confirmation

set -e

WORKSPACE_DIR="${1:-/tofu/workspaces/default}"
STACK_NAME="skform-{{ env }}"
AUTO_APPROVE="${2:-false}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Applying OpenTofu changes...${NC}"

if [ ! -d "${WORKSPACE_DIR}" ]; then
    echo -e "${RED}Workspace directory not found: ${WORKSPACE_DIR}${NC}"
    exit 1
fi

cd "${WORKSPACE_DIR}"

# Check if plan exists
if [ ! -f "tfplan" ]; then
    echo -e "${YELLOW}No plan file found. Running 'tofu plan' first...${NC}"
    docker exec -i -w "${WORKSPACE_DIR}" ${STACK_NAME}_opentofu tofu plan -out=tfplan
fi

# Confirm before applying (unless auto-approve)
if [ "${AUTO_APPROVE}" != "true" ]; then
    echo -e "${YELLOW}WARNING: This will apply infrastructure changes!${NC}"
    read -p "Type 'yes' to continue: " confirmation
    if [ "${confirmation}" != "yes" ]; then
        echo -e "${RED}Apply cancelled${NC}"
        exit 1
    fi
fi

# Apply the plan
echo -e "${YELLOW}Running 'tofu apply'...${NC}"
if [ "${AUTO_APPROVE}" == "true" ]; then
    docker exec -i -w "${WORKSPACE_DIR}" ${STACK_NAME}_opentofu tofu apply -auto-approve tfplan
else
    docker exec -i -w "${WORKSPACE_DIR}" ${STACK_NAME}_opentofu tofu apply tfplan
fi

if [ $? -eq 0 ]; then
    echo -e "${GREEN}Infrastructure changes applied successfully!${NC}"
    # Clean up plan file
    rm -f "${WORKSPACE_DIR}/tfplan"
else
    echo -e "${RED}Apply failed${NC}"
    exit 1
fi
