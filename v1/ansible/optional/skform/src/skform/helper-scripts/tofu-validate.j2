#!/bin/bash
# OpenTofu Validate Helper Script
# Validates OpenTofu configuration syntax

set -e

WORKSPACE_DIR="${1:-/tofu/workspaces/default}"
STACK_NAME="skform-{{ env }}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Validating OpenTofu configuration...${NC}"

if [ ! -d "${WORKSPACE_DIR}" ]; then
    echo -e "${RED}Workspace directory not found: ${WORKSPACE_DIR}${NC}"
    exit 1
fi

cd "${WORKSPACE_DIR}"

# Check if configuration files exist
if [ ! -f "terraform.tf" ] && [ ! -f "main.tf" ]; then
    echo -e "${RED}No OpenTofu configuration files found${NC}"
    exit 1
fi

# Run tofu validate
echo -e "${YELLOW}Running 'tofu validate'...${NC}"
docker exec -i -w "${WORKSPACE_DIR}" ${STACK_NAME}_opentofu tofu validate

if [ $? -eq 0 ]; then
    echo -e "${GREEN}Configuration is valid!${NC}"
else
    echo -e "${RED}Configuration validation failed${NC}"
fi

# Also run tofu fmt check
echo -e "${YELLOW}Checking formatting...${NC}"
docker exec -i -w "${WORKSPACE_DIR}" ${STACK_NAME}_opentofu tofu fmt -check -diff

if [ $? -eq 0 ]; then
    echo -e "${GREEN}Formatting is correct!${NC}"
else
    echo -e "${YELLOW}Formatting issues found. Run 'tofu fmt' to fix${NC}"
fi
