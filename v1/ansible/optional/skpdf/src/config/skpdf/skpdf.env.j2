# =============================================================================
# SKPdf (Stirling-PDF) Environment Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKPdf (Stirling-PDF)
# Environment: {{ env }}
# Cluster: {{ skpdf.CLUSTERNAME }}
# Domain: {{ skpdf.DOMAIN }}
# =============================================================================

# ---------------------------------------------------------------------------
# Core Configuration
# ---------------------------------------------------------------------------
# Enable/disable Docker security features
DOCKER_ENABLE_SECURITY={{ skpdf.DOCKER_ENABLE_SECURITY | default('false') }}

# Install additional book and HTML operations (LibreOffice required)
INSTALL_BOOK_AND_ADVANCED_HTML_OPS={{ skpdf.INSTALL_BOOK_AND_ADVANCED_HTML_OPS | default('false') }}

# OCR Languages (comma-separated list: en_GB,fr_FR,de_DE,etc.)
LANGS={{ skpdf.LANGS | default('en_GB') }}

# ---------------------------------------------------------------------------
# System Configuration
# ---------------------------------------------------------------------------
# Default locale for the application
SYSTEM_DEFAULTLOCALE={{ skpdf.SYSTEM_DEFAULTLOCALE | default('en-US') }}

# Allow Google visibility (robots.txt)
SYSTEM_GOOGLEVISIBILITY={{ skpdf.SYSTEM_GOOGLEVISIBILITY | default('false') }}

# Show update notifications
SYSTEM_SHOWUPDATE={{ skpdf.SYSTEM_SHOWUPDATE | default('false') }}

# Show update only to admins
SYSTEM_SHOWUPDATEONLYADMIN={{ skpdf.SYSTEM_SHOWUPDATEONLYADMIN | default('false') }}

# Enable alpha functionality
SYSTEM_ENABLEALPHAFUNCTIONALITY={{ skpdf.SYSTEM_ENABLEALPHAFUNCTIONALITY | default('false') }}

# Enable custom HTML files
SYSTEM_CUSTOMHTMLFILES={{ skpdf.SYSTEM_CUSTOMHTMLFILES | default('false') }}

# ---------------------------------------------------------------------------
# Security Configuration
# ---------------------------------------------------------------------------
# Enable login functionality
SECURITY_ENABLELOGIN={{ skpdf.SECURITY_ENABLELOGIN | default('false') }}

# Disable CSRF protection (not recommended for production with auth)
SECURITY_CSRFDISABLED={{ skpdf.SECURITY_CSRFDISABLED | default('true') }}

# Login attempt limits
SECURITY_LOGINATTEMPTCOUNT={{ skpdf.SECURITY_LOGINATTEMPTCOUNT | default('5') }}
SECURITY_LOGINRESETTIMEMINUTES={{ skpdf.SECURITY_LOGINRESETTIMEMINUTES | default('120') }}

{% if skpdf.SECURITY_ENABLELOGIN | default('false') | lower == 'true' %}
# Initial admin credentials (only used on first startup)
SECURITY_INITIALLOGIN_USERNAME={{ skpdf.SECURITY_INITIAL_USERNAME | default('admin') }}
SECURITY_INITIALLOGIN_PASSWORD={{ skpdf.SECURITY_INITIAL_PASSWORD }}
{% endif %}

# ---------------------------------------------------------------------------
# OAuth2 Configuration (Optional)
# ---------------------------------------------------------------------------
{% if skpdf.OAUTH2_ENABLED | default(false) %}
SECURITY_OAUTH2_ENABLED=true
SECURITY_OAUTH2_ISSUER={{ skpdf.OAUTH2_ISSUER | default('') }}
SECURITY_OAUTH2_CLIENTID={{ skpdf.OAUTH2_CLIENT_ID | default('') }}
SECURITY_OAUTH2_CLIENTSECRET={{ skpdf.OAUTH2_CLIENT_SECRET | default('') }}
SECURITY_OAUTH2_AUTOCREATEUSER={{ skpdf.OAUTH2_AUTO_CREATE_USER | default('false') }}
SECURITY_OAUTH2_USEASUSERNAME={{ skpdf.OAUTH2_USE_AS_USERNAME | default('email') }}
SECURITY_OAUTH2_SCOPES={{ skpdf.OAUTH2_SCOPES | default('openid, profile, email') }}
SECURITY_OAUTH2_PROVIDER={{ skpdf.OAUTH2_PROVIDER | default('keycloak') }}
{% endif %}

# ---------------------------------------------------------------------------
# UI Configuration
# ---------------------------------------------------------------------------
{% if skpdf.UI_APPNAME is defined and skpdf.UI_APPNAME %}
UI_APPNAME={{ skpdf.UI_APPNAME }}
{% endif %}
{% if skpdf.UI_HOMEDESCRIPTION is defined and skpdf.UI_HOMEDESCRIPTION %}
UI_HOMEDESCRIPTION={{ skpdf.UI_HOMEDESCRIPTION }}
{% endif %}
{% if skpdf.UI_APPNAMENAVBAR is defined and skpdf.UI_APPNAMENAVBAR %}
UI_APPNAMENAVBAR={{ skpdf.UI_APPNAMENAVBAR }}
{% endif %}

# ---------------------------------------------------------------------------
# Metrics Configuration
# ---------------------------------------------------------------------------
# Enable Prometheus metrics endpoint at /api/*
METRICS_ENABLED={{ skpdf.METRICS_ENABLED | default('true') }}

# ---------------------------------------------------------------------------
# Endpoints Configuration
# ---------------------------------------------------------------------------
{% if skpdf.ENDPOINTS_TOREMOVE is defined and skpdf.ENDPOINTS_TOREMOVE %}
# Endpoints to disable (comma-separated)
ENDPOINTS_TOREMOVE={{ skpdf.ENDPOINTS_TOREMOVE }}
{% endif %}
{% if skpdf.ENDPOINTS_GROUPSTOREMOVE is defined and skpdf.ENDPOINTS_GROUPSTOREMOVE %}
# Groups to disable (e.g., LibreOffice)
ENDPOINTS_GROUPSTOREMOVE={{ skpdf.ENDPOINTS_GROUPSTOREMOVE }}
{% endif %}
