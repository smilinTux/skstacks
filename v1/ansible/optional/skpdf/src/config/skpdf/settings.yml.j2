# =============================================================================
# Stirling-PDF Settings Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKPdf (Stirling-PDF)
# Environment: {{ env }}
# =============================================================================
# Note: Environment variables take precedence over this file
# Remove comment marker # at start of line to enable configuration
#
# NO SECRETS IN THIS FILE. The Stirling-PDF image runs `chmod -R 755 /configs`
# on every container start, so this file is world-readable on the host no
# matter what mode the deploy writes. The initial admin password, the OAuth2
# client secret and AutomaticallyGenerated.key are passed through skpdf.env
# (0600, outside the /configs mount) as SECURITY_INITIALLOGIN_PASSWORD,
# SECURITY_OAUTH2_CLIENTSECRET and AUTOMATICALLYGENERATED_KEY; Stirling's
# settings binding lets an environment variable override this file.

security:
  enableLogin: {{ skpdf.SECURITY_ENABLELOGIN | default('false') | lower }}
  csrfDisabled: {{ skpdf.SECURITY_CSRFDISABLED | default('true') | lower }}
  loginAttemptCount: {{ skpdf.SECURITY_LOGINATTEMPTCOUNT | default('5') }}
  loginResetTimeMinutes: {{ skpdf.SECURITY_LOGINRESETTIMEMINUTES | default('120') }}
{% if skpdf.SECURITY_ENABLELOGIN | default('false') | lower == 'true' %}
  initialLogin:
    username: "{{ skpdf.SECURITY_INITIAL_USERNAME | default('admin') }}"
    # password: from skpdf.env (SECURITY_INITIALLOGIN_PASSWORD)
{% endif %}
{% if skpdf.OAUTH2_ENABLED | default(false) %}
  oauth2:
    enabled: true
    issuer: "{{ skpdf.OAUTH2_ISSUER | default('') }}"
    clientId: "{{ skpdf.OAUTH2_CLIENT_ID | default('') }}"
    # clientSecret: from skpdf.env (SECURITY_OAUTH2_CLIENTSECRET)
    autoCreateUser: {{ skpdf.OAUTH2_AUTO_CREATE_USER | default('false') | lower }}
    useAsUsername: "{{ skpdf.OAUTH2_USE_AS_USERNAME | default('email') }}"
    scopes: "{{ skpdf.OAUTH2_SCOPES | default('openid, profile, email') }}"
    provider: "{{ skpdf.OAUTH2_PROVIDER | default('keycloak') }}"
{% endif %}

system:
  defaultLocale: '{{ skpdf.SYSTEM_DEFAULTLOCALE | default('en-US') }}'
  googlevisibility: {{ skpdf.SYSTEM_GOOGLEVISIBILITY | default('false') | lower }}
  enableAlphaFunctionality: {{ skpdf.SYSTEM_ENABLEALPHAFUNCTIONALITY | default('false') | lower }}
  showUpdate: {{ skpdf.SYSTEM_SHOWUPDATE | default('false') | lower }}
  showUpdateOnlyAdmin: {{ skpdf.SYSTEM_SHOWUPDATEONLYADMIN | default('false') | lower }}
  customHTMLFiles: {{ skpdf.SYSTEM_CUSTOMHTMLFILES | default('false') | lower }}

ui:
{% if skpdf.UI_APPNAME is defined and skpdf.UI_APPNAME %}
  appName: "{{ skpdf.UI_APPNAME }}"
{% else %}
  appName: null
{% endif %}
{% if skpdf.UI_HOMEDESCRIPTION is defined and skpdf.UI_HOMEDESCRIPTION %}
  homeDescription: "{{ skpdf.UI_HOMEDESCRIPTION }}"
{% else %}
  homeDescription: null
{% endif %}
{% if skpdf.UI_APPNAMENAVBAR is defined and skpdf.UI_APPNAMENAVBAR %}
  appNameNavbar: "{{ skpdf.UI_APPNAMENAVBAR }}"
{% else %}
  appNameNavbar: null
{% endif %}

endpoints:
{% if skpdf.ENDPOINTS_TOREMOVE is defined and skpdf.ENDPOINTS_TOREMOVE %}
  toRemove: [{{ skpdf.ENDPOINTS_TOREMOVE }}]
{% else %}
  toRemove: []
{% endif %}
{% if skpdf.ENDPOINTS_GROUPSTOREMOVE is defined and skpdf.ENDPOINTS_GROUPSTOREMOVE %}
  groupsToRemove: [{{ skpdf.ENDPOINTS_GROUPSTOREMOVE }}]
{% else %}
  groupsToRemove: []
{% endif %}

metrics:
  enabled: {{ skpdf.METRICS_ENABLED | default('true') | lower }}

# AutomaticallyGenerated.key: from skpdf.env (AUTOMATICALLYGENERATED_KEY) when
# skpdf.AUTO_KEY is set (must be a UUID); otherwise Stirling generates one.
