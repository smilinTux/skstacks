version: '3.8'

services:
  stirling-pdf:
    image: frooodle/s-pdf:{{ skpdf.IMAGE_TAG | default('3.3.0@sha256:ed7b1775c6706b5e5ea24fa6155f078eff1027bd35a17d21834e4407036025e6') }}
    env_file: /var/data/config/skpdf-{{ env }}/skpdf.env
    logging:
      driver: json-file
      options:
        max-size: 4m
        max-file: "1"
    volumes:
      # OCR training data (Tesseract language files)
      - /var/data/skpdf-{{ env }}/trainingData:/usr/share/tessdata
      # Stirling-PDF configuration files
      - /var/data/skpdf-{{ env }}/extraConfigs:/configs
      # Custom files (templates, fonts, etc.)
      - /var/data/skpdf-{{ env }}/customFiles:/customFiles
      # Pipeline configurations
      - /var/data/skpdf-{{ env }}/pipeline:/pipeline
      # Logs directory
      - /var/data/skpdf-{{ env }}/logs:/logs
    networks:
      - skpdf-{{ env }}
      - cloud-public-{{ env }}
    deploy:
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
      restart_policy:
        condition: on-failure
        delay: 10s
      mode: replicated
      replicas: 1
      placement:
        constraints: {{ (skpdf.placement_constraints | default([])) | tojson }}
      resources:
        limits:
          memory: {{ skpdf.MEMORY_LIMIT | default('2G') }}
        reservations:
          memory: {{ skpdf.MEMORY_RESERVATION | default('512M') }}
      labels:
        # === TRAEFIK: HTTP ===
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        # === TRAEFIK: ROUTERS ===
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.rule=Host(`skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skpdf.CLUSTERNAME }}.{{ skpdf.DOMAIN }}`)"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.entrypoints=websecure"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.tls=true"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.tls.certresolver=main"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.tls.options=intermediate@file"
        # 2026-08-16: the skpdf-*-upload buffering middleware below was DEFINED but
        # never attached to this router, so MAX_UPLOAD_SIZE / MAX_RESPONSE_SIZE had
        # no effect and large PDFs hit Traefik's defaults. Appended to the chain.
        # Bare name resolves within the same (swarm) provider, i.e. ...-upload@swarm.
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.middlewares={{ skpdf.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file,skpdf' ~ ('' if env == 'prod' else '-' ~ env) ~ '-upload', true) }}"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.service=skpdf{% if env != 'prod' %}-{{ env }}{% endif %}"
{# === API ROUTER (raw upstream status codes) ===
    Stirling-PDF's REST API (`/api/v1/...`) and its OpenAPI document.
    The main router's chain carries error-pages@file, which swaps every 4xx/5xx for an
    HTML page from the error-pages service and replays the ORIGINAL method there, so API
    clients never saw the app's real status or JSON error. This router sends the machine
    paths through the main chain with each error-pages-bearing chain swapped for its
    no-error-pages form (rate limit and security headers stay; the upload chains keep their
    buffering). skpdf.API_MIDDLEWARES replaces the derived chain. #}
{% set _api_swap = {'default@file': 'default-no-error-pages@file', 'default-no-crowdsec@file': 'default-no-error-pages@file', 'upload-chain@file': 'large-upload-buffering@file,default-security-headers@file', 'upload-chain-no-crowdsec@file': 'large-upload-buffering@file,default-security-headers@file', 'skai-chain@file': 'skai-headers@file,gzip@file', 'error-pages@file': '', 'error-pages-all@file': ''} %}
{% set _api_mw = [] %}
{% for _m in (skpdf.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file,skpdf' ~ ('' if env == 'prod' else '-' ~ env) ~ '-upload', true)).split(',') %}
{% set _s = _api_swap.get(_m | trim, _m | trim) %}
{% if _s %}
{% set _ = _api_mw.append(_s) %}
{% endif %}
{% endfor %}
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-api.rule=Host(`skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skpdf.CLUSTERNAME }}.{{ skpdf.DOMAIN }}`) && (PathPrefix(`/api/`) || PathPrefix(`/v3/api-docs`))"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-api.entrypoints=websecure"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls=true"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.certresolver=main"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.options=intermediate@file"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-api.priority=150"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-api.middlewares={{ skpdf.API_MIDDLEWARES | default(_api_mw | unique | join(','), true) }}"
        - "traefik.http.routers.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-api.service=skpdf{% if env != 'prod' %}-{{ env }}{% endif %}"
        # === TRAEFIK: SERVICES ===
        - "traefik.http.services.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.server.port=8080"
{% if skpdf.LARGE_FILE_UPLOAD | default(true) %}
        # === LARGE FILE UPLOAD: Enable for PDF processing ===
        # PDF files can be large, increase upload limits
        - "traefik.http.middlewares.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-upload.buffering.maxRequestBodyBytes={{ skpdf.MAX_UPLOAD_SIZE | default('500000000') }}"
        - "traefik.http.middlewares.skpdf{% if env != 'prod' %}-{{ env }}{% endif %}-upload.buffering.maxResponseBodyBytes={{ skpdf.MAX_RESPONSE_SIZE | default('500000000') }}"
{% endif %}

networks:
  cloud-public-{{ env }}:
    external: true
  skpdf-{{ env }}:
    external: true
