# Generated by Ansible - DO NOT EDIT MANUALLY. Root-only (0600).
# skpods ({{ env }}) Nextcloud engine environment. The official image's
# config/*.config.php files read these, so the public host and protocol are
# right from the very first start (before the Solid app is ever used).

POSTGRES_HOST=postgres
POSTGRES_DB={{ skpods.DB_NAME | default('nextcloud', true) }}
POSTGRES_USER={{ skpods.DB_USER | default('nextcloud', true) }}
POSTGRES_PASSWORD={{ skpods.DB_PASSWORD | default('', true) }}

REDIS_HOST=redis
REDIS_HOST_PORT=6379

NEXTCLOUD_ADMIN_USER={{ skp_admin_user }}
NEXTCLOUD_ADMIN_PASSWORD={{ skpods.ADMIN_PASSWORD | default('', true) }}
NEXTCLOUD_TRUSTED_DOMAINS={{ skp_host }}

OVERWRITEHOST={{ skp_host }}
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=https://{{ skp_host }}
TRUSTED_PROXIES={{ skp_trusted_proxies }}
{% if skp_identity_domain %}
# WebIDs at https://<user>.<domain>/profile/card#me. The image's start hook
# sets solid identityDomain and adds *.<domain> to trusted_domains.
SKPODS_IDENTITY_DOMAIN={{ skp_identity_domain }}
{% endif %}
# Trust the proxy's X-Forwarded-* instead of the image rewriting the remote
# address from X-Real-IP.
APACHE_DISABLE_REWRITE_IP=1

PHP_MEMORY_LIMIT={{ skpods.PHP_MEMORY_LIMIT | default('512M', true) }}
PHP_UPLOAD_LIMIT={{ skpods.PHP_UPLOAD_LIMIT | default('1G', true) }}
TZ={{ skpods.TZ | default('UTC', true) }}
