#!/bin/bash
set -e

# Never force-restart a service on its FIRST install: a restart in the middle
# of first-boot init (Nextcloud's code copy and database install, Postgres
# initdb) can leave it corrupt. record_preexisting runs before the stack
# deploy; only services that already existed then are force-updated
# afterwards (a redeploy still restarts them to pick up changed env files).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

# SKPods deploy script (Solid pod server, engine: {{ skp_engine }})
# Environment: {{ env }}
APPNAME=skpods
STACK_NAME=skpods-{{ env }}

CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skpods.yml"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}Deploying ${STACK_NAME} stack (Solid pods)...${NC}"

if [ -f "${CONFIG_DIR}/${APPNAME}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APPNAME}.sh.env"
fi

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

echo -e "${BLUE}Stack name: ${STACK_NAME}${NC}"
echo -e "${BLUE}Compose file: ${COMPOSE_FILE}${NC}"

cd "${CONFIG_DIR}"

SERVICES="postgres redis nextcloud cron"
for s in $SERVICES; do record_preexisting "${STACK_NAME}_${s}"; done

docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 5

echo -e "${YELLOW}Forcing service updates to pick up changed config...${NC}"
for s in nextcloud cron; do
    preexisted "${STACK_NAME}_${s}" && docker service update --force --detach=true --with-registry-auth "${STACK_NAME}_${s}" || true
done

echo -e "${YELLOW}Checking service replicas...${NC}"
for s in $SERVICES; do
    REPLICAS="0/1"
    for _ in $(seq 1 60); do
        REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_${s}" --format "{% raw %}{{.Replicas}}{% endraw %}" 2>/dev/null | head -1)
        [[ "$REPLICAS" == "1/1" ]] && break
        sleep 5
    done
    if [[ "$REPLICAS" == "1/1" ]]; then
        echo -e "${GREEN}${STACK_NAME}_${s}: ${REPLICAS}${NC}"
    else
        echo -e "${YELLOW}${STACK_NAME}_${s}: ${REPLICAS} (still starting; the playbook waits for the install)${NC}"
        docker service ps --no-trunc "${STACK_NAME}_${s}" | head -5 || true
    fi
done

echo -e "${GREEN}Deployment submitted: https://${SKPODS_HOST:-{{ skp_host }}}${NC}"
