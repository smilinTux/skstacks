#!/bin/bash
set -e

# SKWhoami Deploy Script (Traefik whoami echo/test service)
# Environment: {{ env }}
APPNAME=skwhoami
STACK_NAME=skwhoami{% if env == 'prod' %}-prod{% elif env == 'staging' %}-staging{% else %}-dev{% endif %}

CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skwhoami.yml"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}Deploying ${STACK_NAME} stack (Traefik whoami test service)...${NC}"

if [ -f "${CONFIG_DIR}/${APPNAME}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APPNAME}.sh.env"
fi

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

echo -e "${YELLOW}Deploying stack configuration...${NC}"
echo -e "${BLUE}Stack name: ${STACK_NAME}${NC}"
echo -e "${BLUE}Compose file: ${COMPOSE_FILE}${NC}"

cd "${CONFIG_DIR}"

docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 5

echo -e "${YELLOW}Forcing service updates to pull the pinned image...${NC}"
for i in 01 02 03; do
    docker service update --force --detach=true "${STACK_NAME}_whoami${i}" || true
done

sleep 10

echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

echo -e "${YELLOW}Checking service health...${NC}"
HEALTHY=0
for i in 01 02 03; do
    for _ in $(seq 1 36); do
        REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_whoami${i}" --format "{% raw %}{{.Replicas}}{% endraw %}" 2>/dev/null || echo "0/0")
        [[ "$REPLICAS" == "1/1" ]] && break
        sleep 5
    done
    if [[ "$REPLICAS" == "1/1" ]]; then
        echo -e "${GREEN}${STACK_NAME} whoami${i} is healthy: https://skwhoami${i}{% if env != 'prod' %}-{{ env }}{% endif %}.${CLUSTERNAME:-skstack01}.${DOMAIN:-example.com}${NC}"
        HEALTHY=$((HEALTHY + 1))
    else
        echo -e "${RED}${STACK_NAME} whoami${i} health check: ${REPLICAS}${NC}"
        docker service logs --tail 10 "${STACK_NAME}_whoami${i}" || true
    fi
done

if [ "$HEALTHY" -eq 3 ]; then
    echo -e "${GREEN}All 3 whoami instances are healthy!${NC}"
else
    echo -e "${YELLOW}${HEALTHY}/3 instances are healthy${NC}"
fi

echo -e "${GREEN}Deployment complete!${NC}"
