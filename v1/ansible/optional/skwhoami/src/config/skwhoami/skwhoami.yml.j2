        - "traefik.http.routers.skwhoami02{% if env != 'prod' %}-{{ env }}{% endif %}.entrypoints=websecure"
        - "traefik.http.routers.skwhoami02{% if env != 'prod' %}-{{ env }}{% endif %}.tls=true"
        - "traefik.http.routers.skwhoami02{% if env != 'prod' %}-{{ env }}{% endif %}.tls.certresolver=main"
        - "traefik.http.routers.skwhoami02{% if env != 'prod' %}-{{ env }}{% endif %}.middlewares=default-no-crowdsec@file"
        - "traefik.http.services.skwhoami02{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.server.port=80"

