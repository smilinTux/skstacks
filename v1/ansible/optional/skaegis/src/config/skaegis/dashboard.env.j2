# skaegis dashboard environment (root only, 0600). DASHBOARD_* is the
# kibanaserver account the dashboard talks to the indexer as; API_* is the
# Wazuh API user; RUN_AS=false keeps every signed-in admin on that API user
# (admin-only access mode). SKAEGIS_OIDC_CLIENT_SECRET is expanded by
# opensearch_dashboards.yml, so the secret is never written into that file.
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD={{ skaegis.DASHBOARD_PASSWORD }}
WAZUH_API_URL=https://wazuh.manager
API_USERNAME=wazuh-wui
API_PASSWORD={{ skaegis.API_PASSWORD }}
RUN_AS=false
{% if ska_auth_mode == 'oidc' %}
SKAEGIS_OIDC_CLIENT_SECRET={{ skaegis.OIDC_CLIENT_SECRET }}
{% endif %}
