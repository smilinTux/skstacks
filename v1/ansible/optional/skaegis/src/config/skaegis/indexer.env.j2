# skaegis indexer environment (root only, 0600). Read by
# bin/indexer-entrypoint, which hashes these into internal_users.yml with the
# image's own hash.sh at every start. Never commit a rendered copy.
OPENSEARCH_JAVA_OPTS=-Xms{{ ska_indexer_heap }} -Xmx{{ ska_indexer_heap }}
SKAEGIS_ADMIN_PASSWORD={{ skaegis.INDEXER_PASSWORD }}
SKAEGIS_KIBANASERVER_PASSWORD={{ skaegis.DASHBOARD_PASSWORD }}
SKAEGIS_SECURITYADMIN={{ '1' if ska_apply_security else '0' }}
