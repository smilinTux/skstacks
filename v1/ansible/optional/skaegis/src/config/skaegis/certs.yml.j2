{# skaegis: wazuh-certs-generator input, the standard wazuh-docker way to
   issue the stack's internal TLS (one root CA, a node certificate per
   component, the admin client certificate). The names are the network aliases
   every service uses, so hostname verification holds. #}
nodes:
  indexer:
    - name: wazuh.indexer
      ip: wazuh.indexer
  server:
    - name: wazuh.manager
      ip: wazuh.manager
  dashboard:
    - name: wazuh.dashboard
      ip: wazuh.dashboard
