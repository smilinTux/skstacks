#!/bin/bash
set -e

# Never force-restart a service on its FIRST install (first-boot init must
# finish: the indexer initializes its security index, the manager seeds its
# data dirs); a redeploy restarts exactly the services whose bind-mounted
# config, env file or script the play changed, which the stack spec cannot
# see.
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

# skaegis (Wazuh) Deploy Script
# Environment: {{ env }}
APPNAME=skaegis
STACK_NAME=skaegis-{{ env }}
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skaegis.yml"
INDEXER="${STACK_NAME}_indexer"
MANAGER="${STACK_NAME}_manager"
DASHBOARD="${STACK_NAME}_dashboard"
BACKUP="${STACK_NAME}_backup"

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo "Error: Compose file not found: ${COMPOSE_FILE}"
    exit 1
fi

cd "${CONFIG_DIR}"

record_preexisting "${INDEXER}" "${MANAGER}" "${DASHBOARD}" "${BACKUP}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

restart_if() {  # restart_if <flag> <service> <reason>
    if [ "$1" = 1 ]; then
        echo "The play changed $3 of $2"
        preexisted "$2" && timeout "${SERVICE_UPDATE_TIMEOUT:-600}" docker service update --force --detach=true "$2" || true
    fi
}
restart_if "${RESTART_INDEXER:-0}" "${INDEXER}" "the indexer config, env or entrypoint"
restart_if "${RESTART_MANAGER:-0}" "${MANAGER}" "ossec.conf, authd.pass or the manager env"
restart_if "${RESTART_DASHBOARD:-0}" "${DASHBOARD}" "the dashboard config or env"
restart_if "${RESTART_BACKUP:-0}" "${BACKUP}" "the backup script"

# The indexer needs a few minutes on first start (security index init); the
# manager waits for it.
for svc in "${INDEXER}" "${MANAGER}" "${DASHBOARD}"; do
    echo "Waiting for ${svc} to converge..."
    REPLICAS=""
    for _ in $(seq 1 72); do
        REPLICAS=$(docker service ls --filter "name=${svc}" --format "{% raw %}{{.Replicas}}{% endraw %}")
        [[ "$REPLICAS" == "1/1" ]] && break
        sleep 5
    done
    if [[ "$REPLICAS" == "1/1" ]]; then
        echo "${svc} is running"
    else
        echo "${svc} not converged: ${REPLICAS}"
        docker service ps --no-trunc --format '{% raw %}{{.Name}} {{.CurrentState}} {{.Error}}{% endraw %}' "${svc}" | head -5 || true
    fi
done
echo "Dashboard: https://{{ ska_host }}/"
echo "Deployment complete!"
