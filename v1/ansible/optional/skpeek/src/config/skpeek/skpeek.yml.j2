version: '3.8'

services:
  skpeek:
    image: {{ skpeek_image | default('docker.io/searxng/searxng@sha256:a31763b7af3caf6ae9aac1816ba774214eb550252e06a4998f276ded8d60461b') }}
    env_file: /var/data/config/skpeek-{{ env }}/skpeek.env

    logging:
      driver: json-file
      options:
        max-size: 4m
        max-file: "1"

    volumes:
      - /var/data/skpeek-{{ env }}/etc:/etc/searxng:rw
      - /var/data/skpeek-{{ env }}/img/skpeek.png:/usr/local/searxng/searx/static/themes/simple/img/searxng.png:rw

    networks:
      - cloud-public-{{ env }}
      - skpeek-{{ env }}

    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:8080/"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      labels:
        # === TRAEFIK: HTTP ===
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        # === TRAEFIK: ROUTERS ===
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.rule=Host(`skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skpeek.CLUSTERNAME | default(cluster_name) }}.{{ skpeek.DOMAIN | default(domain) }}`)"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.entrypoints=websecure"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.tls=true"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.tls.certresolver=main"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.tls.options=intermediate@file"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.middlewares={{ skpeek.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file', true) }}"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.service=skpeek{% if env != 'prod' %}-{{ env }}{% endif %}"
{# === API ROUTER (raw upstream status codes) ===
    SearXNG's machine endpoints: `/search` (format=json|csv|rss, used by skseek and scripts),
    `/healthz`, `/autocompleter` and `/config`.
    The main router's chain carries error-pages@file, which swaps every 4xx/5xx for an
    HTML page from the error-pages service and replays the ORIGINAL method there, so API
    clients never saw the app's real status or JSON error. This router sends the machine
    paths through the main chain with each error-pages-bearing chain swapped for its
    no-error-pages form (rate limit and security headers stay; the upload chains keep their
    buffering). skpeek.API_MIDDLEWARES replaces the derived chain. #}
{% set _api_swap = {'default@file': 'default-no-error-pages@file', 'default-no-crowdsec@file': 'default-no-error-pages@file', 'upload-chain@file': 'large-upload-buffering@file,default-security-headers@file', 'upload-chain-no-crowdsec@file': 'large-upload-buffering@file,default-security-headers@file', 'skai-chain@file': 'skai-headers@file,gzip@file', 'error-pages@file': '', 'error-pages-all@file': ''} %}
{% set _api_mw = [] %}
{% for _m in (skpeek.TRAEFIK_MIDDLEWARES | default('default-no-crowdsec@file', true)).split(',') %}
{% set _s = _api_swap.get(_m | trim, _m | trim) %}
{% if _s %}
{% set _ = _api_mw.append(_s) %}
{% endif %}
{% endfor %}
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}-api.rule=Host(`skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skpeek.CLUSTERNAME | default(cluster_name) }}.{{ skpeek.DOMAIN | default(domain) }}`) && (PathPrefix(`/search`) || PathPrefix(`/healthz`) || PathPrefix(`/autocompleter`) || PathPrefix(`/config`))"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}-api.entrypoints=websecure"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls=true"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.certresolver=main"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}-api.tls.options=intermediate@file"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}-api.priority=150"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}-api.middlewares={{ skpeek.API_MIDDLEWARES | default(_api_mw | unique | join(','), true) }}"
        - "traefik.http.routers.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}-api.service=skpeek{% if env != 'prod' %}-{{ env }}{% endif %}"
        # === TRAEFIK: SERVICES ===
        - "traefik.http.services.skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.loadbalancer.server.port=8080"

  redis:
    image: {{ redis_image | default('docker.io/valkey/valkey:9.1.3-alpine@sha256:bf09d58e96d6b4524a15396b65b242bbe18beebbcc15a04d8ee75ddac62fae0b') }}
    command: valkey-server --save 30 1 --loglevel warning
    logging:
      driver: json-file
      options:
        max-size: 4m
        max-file: "1"

    networks:
      - skpeek-{{ env }}
    volumes:
      - /var/data/runtime/skpeek-{{ env }}/redis:/data

    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager

networks:
  cloud-public-{{ env }}:
    external: true
  skpeek-{{ env }}:
    external: true

