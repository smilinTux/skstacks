# SKPeek Environment Configuration
# Environment: {{ env }}

SEARXNG_BASE_URL=https://skpeek{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skpeek.CLUSTERNAME | default(cluster_name) }}.{{ skpeek.DOMAIN | default(domain) }}/
UWSGI_WORKERS={{ uwsgi_workers | default('2') }}
UWSGI_THREADS={{ uwsgi_threads | default('2') }}
SEARXNG_HOSTNAME=0.0.0.0:8080/


# Extra environment overrides for this instance (e.g. SEARXNG_PRIVACY, or
# anything else the upstream searxng image's entrypoint reads directly and
# this framework has no settings.yml field for). Generic passthrough: any
# key/value in skpeek.extra_env is emitted verbatim.
{% for k, v in (skpeek.extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
