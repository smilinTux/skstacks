#!/bin/bash
set -e

# Never force-restart a service on its FIRST install: a restart in the middle
# of first-boot init (schema migrations, initial setup) can leave it corrupt.
# record_preexisting runs before the stack deploy; only services that already
# existed then are force-updated afterwards (a redeploy still restarts them to
# pick up changed bind-mounted config files).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

# SKSync{% if env == 'prod' %}-Prod{% elif env == 'staging' %}-Staging{% else %}-Dev{% endif %} Deployment Script
APP="sksync"
STACK_NAME="sksync{% if env == 'prod' %}-prod{% elif env == 'staging' %}-staging{% else %}-dev{% endif %}"
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${GREEN}🚀 Deploying ${STACK_NAME} stack (Syncthing File Sync)...${NC}"

# Source environment variables
if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}📦 Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi

# Export environment for docker
export CLUSTERNAME DOMAIN INSTANCE APP_ENV INSTANCENAME

echo -e "${YELLOW}🔍 Debug: INSTANCENAME='${INSTANCENAME}'${NC}"

# ============================================================================
# NETWORK CREATION (Idempotent)
# Networks are defined in vault and templated here for standalone deployment
# ============================================================================
echo -e "${YELLOW}🌐 Ensuring required overlay networks exist...${NC}"

# Function to create network idempotently
create_network_if_not_exists() {
    local NETWORK_NAME="$1"
    local SUBNET="$2"
    
    # Check if network exists
    if docker network ls --format "{{ '{{.Name}}' }}" | grep -q "^${NETWORK_NAME}$"; then
        echo -e "${GREEN}  ✓ Network ${NETWORK_NAME} already exists${NC}"
    else
        echo -e "${YELLOW}  → Creating network ${NETWORK_NAME} (${SUBNET})...${NC}"
        docker network create \
            --driver overlay \
            --attachable \
            --subnet "${SUBNET}" \
            "${NETWORK_NAME}" && \
        echo -e "${GREEN}  ✓ Network ${NETWORK_NAME} created successfully${NC}" || \
        echo -e "${RED}  ✗ Failed to create network ${NETWORK_NAME}${NC}"
    fi
}

# Create required networks from vault configuration
{% for network in app_networks | default([{'name': 'sksync-' ~ env, 'subnet': '172.16.70.0/24'}, {'name': 'cloud-public-' ~ env, 'subnet': '172.16.200.0/24'}]) %}
create_network_if_not_exists "{{ network.name }}" "{{ network.subnet }}"
{% endfor %}

echo -e "${GREEN}✓ Network setup complete${NC}"

# ============================================================================
# DIRECTORY & PERMISSIONS SETUP (Idempotent)
# Best Practice: UID 1000 (jz user) - non-root for security
# sync-data is the main Syncthing home where all shared folders are created
# ============================================================================
echo -e "${YELLOW}📁 Ensuring directories exist with correct permissions...${NC}"

DATA_DIR="/var/data/${STACK_NAME}"
DIRS=(
    "${DATA_DIR}"
    "${DATA_DIR}/sync-data"          # Main data dir - maps to /var/syncthing in container
    "${DATA_DIR}/syncthing_config"   # Config dir - separate for clean backups
)

for DIR in "${DIRS[@]}"; do
    if [ ! -d "$DIR" ]; then
        echo -e "${YELLOW}  → Creating ${DIR}${NC}"
        mkdir -p "$DIR"
    fi
    # Ensure correct ownership (UID 1000 = jz user on host, syncthing in container)
    # of the directory itself, only if wrong. Never -R: sync-data holds every
    # synced file, and the playbook already fixes syncthing_config.
    find "$DIR" -maxdepth 0 \( ! -user 1000 -o ! -group 1000 \) -exec chown 1000:1000 {} +
    chmod 755 "$DIR"
done
echo -e "${GREEN}✓ Directory setup complete${NC}"

# Check if compose file exists
if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}❌ Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

# Deploy stack
echo -e "${YELLOW}📝 Deploying stack configuration...${NC}"
record_preexisting "${STACK_NAME}_syncthing"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

# Wait for services to register
sleep 5

# Force update services
echo -e "${YELLOW}🔄 Forcing service updates...${NC}"
preexisted ${STACK_NAME}_syncthing && timeout "${SERVICE_UPDATE_TIMEOUT:-300}" docker service update --force --detach=false ${STACK_NAME}_syncthing || true

# Wait for stabilization
echo -e "${YELLOW}⏳ Waiting for services to stabilize...${NC}"
sleep 10

# Show service status
echo -e "${GREEN}📊 Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

# Health check
echo -e "${YELLOW}🏥 Checking service health...${NC}"
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_syncthing" --format "{{ '{{.Replicas}}' }}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}✅ ${STACK_NAME} is healthy and running!${NC}"
    echo -e "${GREEN}🌐 Access at: https://sksync{% if env == 'staging' %}-staging{% elif env == 'dev' %}-dev{% endif %}.${CLUSTERNAME:-cluster1}.${DOMAIN:-example.com}${NC}"
else
    echo -e "${RED}⚠️  ${STACK_NAME} health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}📋 Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_syncthing
fi

echo -e "${GREEN}✨ Deployment complete!${NC}"
echo -e "${YELLOW}📋 Remember to configure folder synchronization and device connections in the Syncthing web interface${NC}"

