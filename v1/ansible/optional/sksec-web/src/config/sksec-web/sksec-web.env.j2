# sksec-web (crowdsec-web-ui) runtime environment ({{ env }}). Root only
# (0600): LAPI_PASSWORD is the CrowdSec machine credential this role
# registers (see README "Machine registration"); it can read every alert
# and decision in the cluster's CrowdSec.
CONFIG_INSTANCE_LAPI_URL={{ sksw_lapi_url }}
CONFIG_INSTANCE_LAPI_AUTH_USERNAME={{ sksec_web.LAPI_USERNAME | default('sksec-web', true) }}
CONFIG_INSTANCE_LAPI_AUTH_PASSWORD={{ sksec_web.LAPI_PASSWORD }}
# Instance-wide read-only mode (default true): decisions/alerts are
# visible, nothing can be changed or deleted from the UI. See README
# "Decision deletion" -- this is one of two independent safety layers.
CONFIG_UI_READ_ONLY={{ sksec_web.READ_ONLY | default(true) | bool | lower }}
CONFIG_CROWDSEC_SYNC_LOOKBACK={{ sksec_web.SYNC_LOOKBACK | default('168h', true) }}
{% if sksec_web.SESSION_SECRET | default('', true) %}
# Set explicitly so the dashboard's OWN sessions survive a restart; left
# unset upstream auto-generates one (ephemeral: a restart signs everyone
# out of this layer, not the Authentik layer in front of it).
CONFIG_AUTH_SESSION_SECRET={{ sksec_web.SESSION_SECRET }}
{% endif %}
TZ={{ sksec_web.TZ | default('UTC', true) }}
{% for k, v in (sksec_web.extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
