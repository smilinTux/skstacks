# sksec-web (crowdsec-web-ui) runtime environment ({{ env }}). Root only
# (0600): CROWDSEC_PASSWORD is the CrowdSec machine credential this role
# registers (see README "Machine registration"); it can read every alert
# and decision in the cluster's CrowdSec. Env var names verified against
# the upstream source (server/auth.ts, server/config.ts), not just its
# README/docs -- those documented an older, now-wrong naming scheme.
CROWDSEC_URL={{ sksw_lapi_url }}
CROWDSEC_USER={{ sksec_web.LAPI_USERNAME | default('sksec-web', true) }}
CROWDSEC_PASSWORD={{ sksec_web.LAPI_PASSWORD }}
# Instance-wide read-only mode (default true): decisions/alerts are
# visible, nothing can be changed or deleted from the UI (server-side
# gate, ensureCanManageEnforcement in server/app/api-routes.ts). See
# README "Decision deletion" -- this is one of two independent safety
# layers (the other is CrowdSec's own LAPI trusted_ips, which this role
# never touches).
PERMISSION_READ_ONLY={{ sksec_web.READ_ONLY | default(true) | bool | lower }}
CROWDSEC_LOOKBACK_PERIOD={{ sksec_web.SYNC_LOOKBACK | default('168h', true) }}
{% if sksec_web.INSTANCE_NAME | default('', true) %}
CROWDSEC_INSTANCE_NAME={{ sksec_web.INSTANCE_NAME }}
{% endif %}
{% if sksec_web.SESSION_SECRET | default('', true) %}
# Set explicitly so the dashboard's OWN sessions survive a restart; left
# unset upstream auto-generates one (ephemeral: a restart signs everyone
# out of this layer, not the Authentik layer in front of it).
AUTH_SECRET={{ sksec_web.SESSION_SECRET }}
{% endif %}
TZ={{ sksec_web.TZ | default('UTC', true) }}
{% for k, v in (sksec_web.extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
