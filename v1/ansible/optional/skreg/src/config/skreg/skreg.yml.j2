version: "3.7"

services:
  registry:
    image: {{ skreg_image | default('registry:3.1.2@sha256:38907510915c3f1604c7e83d6ab602ab3020d092f73bdaed8696773693ff768c') }}
    ports:
      - "5000:5000"
    environment:
      - REGISTRY_HTTP_SECRET={{ vault_skreg_registry_http_secret }}
      - REGISTRY_HTTP_ADDR={{ vault_skreg_registry_http_addr | default('0.0.0.0:5000') }}
    volumes:
      - /var/data/skreg-{{ env }}/data:/var/lib/registry
    networks:
      - skreg-{{ env }}
    deploy:
      mode: global
      resources:
        reservations:
          memory: 64M
        limits:
          memory: 128M

networks:
  skreg-{{ env }}:
    external: true
