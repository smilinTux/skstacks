# =============================================================================
# SKVector (Qdrant) Environment Configuration
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKVector (Qdrant Vector Database)
# Environment: {{ env }}
# Cluster: {{ skvector.CLUSTERNAME }}
# Domain: {{ skvector.DOMAIN }}
# =============================================================================

# ---------------------------------------------------------------------------
# Port Configuration
# ---------------------------------------------------------------------------
QDRANT__SERVICE__GRPC_PORT={{ skvector.QDRANT_GRPC_PORT | default('6334') }}
QDRANT__SERVICE__HTTP_PORT={{ skvector.QDRANT_HTTP_PORT | default('6333') }}

{% if skvector.QDRANT_API_KEY %}
# ---------------------------------------------------------------------------
# API Key Authentication
# ---------------------------------------------------------------------------
QDRANT__SERVICE__API_KEY={{ skvector.QDRANT_API_KEY }}
{% endif %}

# ---------------------------------------------------------------------------
# Storage Paths (NFS-backed for persistence)
# ---------------------------------------------------------------------------
QDRANT__STORAGE__STORAGE_PATH={{ skvector.QDRANT_STORAGE | default('/qdrant/storage') }}
QDRANT__STORAGE__SNAPSHOTS_PATH={{ skvector.QDRANT_SNAPSHOTS | default('/qdrant/snapshots') }}

# ---------------------------------------------------------------------------
# Performance Settings - Optimized for Large Document Ingestion
# ---------------------------------------------------------------------------
# Max concurrent requests (increased for batch embedding uploads from SKAid)
QDRANT__SERVICE__MAX_CONCURRENT_REQUESTS={{ skvector.QDRANT_MAX_CONCURRENT_REQUESTS | default('100') }}

# Indexing threshold - delay indexing during batch uploads for better performance
QDRANT__OPTIMIZERS__INDEXING_THRESHOLD={{ skvector.QDRANT_INDEXING_THRESHOLD | default('20000') }}

# Default segment size (points per segment)
QDRANT__OPTIMIZERS__DEFAULT_SEGMENT_NUMBER={{ skvector.QDRANT_DEFAULT_SEGMENT_NUMBER | default('2') }}

# Max segment size before automatic optimization
QDRANT__OPTIMIZERS__MAX_SEGMENT_SIZE={{ skvector.QDRANT_MAX_SEGMENT_SIZE | default('100000') }}

# Memory map threshold - use mmap for large segments (memory efficient)
QDRANT__OPTIMIZERS__MEMMAP_THRESHOLD={{ skvector.QDRANT_MEMMAP_THRESHOLD | default('50000') }}

# ---------------------------------------------------------------------------
# Collection Settings for Knowledge Base
# ---------------------------------------------------------------------------
# Default vector size (all-MiniLM-L6-v2 produces 384-dim embeddings)
# This is set per-collection, not globally, but documented here for reference

# ---------------------------------------------------------------------------
# Memory Management
# ---------------------------------------------------------------------------
# Max memory for payload index (MB) - prevents OOM on limited cluster
QDRANT__STORAGE__PAYLOAD_INDEXING_THRESHOLD={{ skvector.QDRANT_PAYLOAD_INDEXING_THRESHOLD | default('100000') }}

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
QDRANT__LOG_LEVEL={{ skvector.QDRANT_LOG_LEVEL | default('INFO') }}
