{%- if skvector.CLOUDFLARED | default(false) -%}
  {%- set _base_domain = skvector.DOMAIN -%}
{%- else -%}
  {%- set _base_domain = skvector.CLUSTERNAME ~ '.' ~ skvector.DOMAIN -%}
{%- endif -%}
