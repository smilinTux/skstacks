{%- if skvector.CLOUDFLARED | default(false) -%}
  {%- set _base_domain = skvector.DOMAIN -%}
{%- else -%}
  {%- set _base_domain = skvector.CLUSTERNAME ~ '.' ~ skvector.DOMAIN -%}
{%- endif -%}
{#- Qdrant storage/snapshots on local disk on DATA_NODE: see README "Local
    data on a pinned node". Unset keys render exactly as before. -#}
{%- set _storage_path = skvector.STORAGE_PATH | default('/var/data/skvector-' ~ env ~ '/storage', true) | string -%}
{%- set _snapshots_path = skvector.SNAPSHOTS_PATH | default('/var/data/skvector-' ~ env ~ '/snapshots', true) | string -%}
{%- set _data_node = skvector.DATA_NODE | default('', true) | string -%}
{%- set _constraints = skvector.placement_constraints | default([]) | list -%}
{%- set _pin = 'node.hostname == ' ~ _data_node -%}
{%- set _constraints = _constraints + ([_pin] if (_data_node and _pin not in _constraints) else []) -%}
{#- Optional SSO web UI host (README "Web UI behind SSO"). Off by default, and
    off renders exactly as before. When on, a second router on
    skvector-ui[-env].<domain> sends every request through forward auth and
    then injects the Qdrant api-key, so the dashboard opens signed in. -#}
{%- set _sfx = '' if env == 'prod' else '-' ~ env -%}
{%- set _ui_enabled = (skvector.UI_HOST_ENABLED | default(false) | string | lower) in ('true', 'yes', '1', 'on') -%}
{%- if _ui_enabled -%}
  {%- set _ui_mode = skvector.UI_KEY_MODE | default('read_only', true) | string | trim | lower -%}
  {%- if _ui_mode not in ('read_only', 'full') -%}
    {{- _skvector_ui_fail | mandatory("skvector.UI_KEY_MODE must be read_only or full, got '" ~ _ui_mode ~ "'") -}}
  {%- endif -%}
  {%- set _ui_key_var = 'QDRANT_READ_ONLY_API_KEY' if _ui_mode == 'read_only' else 'QDRANT_API_KEY' -%}
  {%- set _ui_key = skvector[_ui_key_var] | default('', true) | string | trim -%}
  {%- if not _ui_key -%}
    {{- _skvector_ui_fail | mandatory("skvector.UI_HOST_ENABLED with UI_KEY_MODE " ~ _ui_mode ~ " needs skvector." ~ _ui_key_var ~ " set in the vault") -}}
  {%- endif -%}
  {%- set _ui_sso = skvector.UI_SSO_MIDDLEWARE | default('authentik@file', true) | string | trim -%}
  {%- if (_ui_sso | lower) in ('none', 'false') -%}
    {{- _skvector_ui_fail | mandatory("skvector.UI_SSO_MIDDLEWARE cannot be turned off: the UI host injects an API key and must stay behind SSO") -}}
  {%- endif -%}
  {%- set _ui_chain = [_ui_sso, 'skvector' ~ _sfx ~ '-ui-apikey', 'skvector' ~ _sfx ~ '-buffering', 'default-no-error-pages@file'] | join(',') -%}
{%- endif -%}
