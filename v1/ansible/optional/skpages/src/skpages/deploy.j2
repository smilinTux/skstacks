#!/bin/bash
set -euo pipefail

# SKPages ({{ env }}) deployment script
APPNAME=skpages
STACK_NAME=skpages-{{ env }}
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/skpages.yml"

if [ -f "${CONFIG_DIR}/${APPNAME}.sh.env" ]; then
    set -a; . "${CONFIG_DIR}/${APPNAME}.sh.env"; set +a
fi

[ -f "${COMPOSE_FILE}" ] || { echo "Compose file not found: ${COMPOSE_FILE}" >&2; exit 1; }
[ -d "${SKPAGES_DOCROOT}" ] || { echo "Docroot missing: ${SKPAGES_DOCROOT}" >&2; exit 1; }

echo "Deploying ${STACK_NAME} (docroot ${SKPAGES_DOCROOT})"
cd "${CONFIG_DIR}"
docker stack deploy --detach=true -c "${COMPOSE_FILE}" "${STACK_NAME}"

# Caddy reads its Caddyfile only at start; force a restart so a changed
# Caddyfile (same compose spec) actually takes effect.
docker service update --force --detach=true "${STACK_NAME}_caddy" >/dev/null

for _ in $(seq 1 30); do
    REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_caddy" --format '{{ '{{' }}.Replicas{{ '}}' }}')
    [ "${REPLICAS}" = "1/1" ] && break
    sleep 2
done

docker service ls --filter "name=${STACK_NAME}"
if [ "${REPLICAS:-}" = "1/1" ]; then
    echo "OK: https://${SKPAGES_FQDN}/"
else
    echo "WARN: ${STACK_NAME}_caddy is ${REPLICAS:-unknown}" >&2
    docker service logs --tail 20 "${STACK_NAME}_caddy" 2>&1 || true
    exit 1
fi
