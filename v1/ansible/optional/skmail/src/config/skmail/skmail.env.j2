# Docker Mailserver Environment Variables
# SSL Configuration - Using Traefik's acme.json directly (native DMS support)
# 
# DMS natively supports Traefik's acme.json format when mounted at /etc/letsencrypt/acme.json
# DMS auto-extracts the wildcard certificate *.example.com for mail.example.com
# The acme.json file is monitored for changes - auto-reloads on certificate renewal
#
# Certificate Selection Priority (per DMS docs):
# 1. Exact match for DMS FQDN (hostname) - e.g., mail.example.com
# 2. One DNS level up - e.g., example.com
# 3. Wildcard match - e.g., *.example.com (our case)
#
# Note: fence_service_name is automatically detected (skfence or skfenceha)

# Core Configuration
SSL_TYPE=letsencrypt
# No SSL_CERT_PATH/SSL_KEY_PATH needed - DMS extracts from acme.json automatically
ONE_DIR=1

# Security Features
ENABLE_RSPAMD={{ skmail.ENABLE_RSPAMD | default('1') }}
ENABLE_CLAMAV={{ skmail.ENABLE_CLAMAV | default('1') }}
ENABLE_FAIL2BAN={{ skmail.ENABLE_FAIL2BAN | default('1') }}

# Network Configuration
POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4
PERMIT_DOCKER=container

# Postfix mailbox ownership behavior
# Reason: allow internal local deliveries (e.g. clamav@mail.example.com) even if
# the /var/mail/clamav mailbox is not owned by the clamav user inside the container.
POSTFIX_STRICT_MAILBOX_OWNERSHIP=no

# PROXY Protocol Support for Real IP Forwarding
# HOST MODE: Disabled - Direct host network, no Traefik TCP proxy
# Enable only if using Traefik TCP routing with PROXY protocol
ENABLE_PROXY_PROTOCOL=0
POSTFIX_PROXY_PROTOCOL=0

# Enable PROXY protocol for Dovecot (IMAP/IMAPS)
# HOST MODE: Disabled - Direct connections
DOVECOT_PROXY_PROTOCOL=0

{% if skmail.RELAY_HOST is defined and skmail.RELAY_HOST %}
# =============================================================================
# SMTP RELAY CONFIGURATION (Mailgun)
# =============================================================================
# Reason: Residential/dynamic IPs are often blocked by Gmail/Google for direct
# mail delivery. Using a trusted SMTP relay (Mailgun) ensures deliverability.
#
# How it works:
# - Outbound mail is sent to Mailgun's SMTP servers instead of directly to recipients
# - Mailgun handles delivery using their trusted IP reputation
# - Inbound mail still comes directly to your server (MX records unchanged)
#
# DNS Requirements (already configured):
# - SPF: include:mailgun.org
# - DKIM: pic._domainkey.{{ skmail.DOMAIN }} (Mailgun's DKIM)
# - CNAME: email.{{ skmail.DOMAIN }} -> mailgun.org (tracking)
# =============================================================================
RELAY_HOST={{ skmail.RELAY_HOST }}
RELAY_PORT={{ skmail.RELAY_PORT | default('587') }}
RELAY_USER={{ skmail.RELAY_USER }}
RELAY_PASSWORD={{ skmail.RELAY_PASSWORD }}
{% endif %}
