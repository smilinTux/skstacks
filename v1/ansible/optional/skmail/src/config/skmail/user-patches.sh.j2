#!/bin/bash
# User patches script for docker-mailserver
# Fixes permissions and configurations for docker-mailserver
#
# SSL certificates are mounted directly from traefik-certs-dumper:
#   /var/data/runtime/{{ fence_service_name }}-{{ env }}/certs/*.{{ skmail.DOMAIN }}/ -> /etc/dms/tls/
#
# Note: If certs go stale after rotation, run: docker service update --force skmail-prod_skmail

echo "Running user-patches.sh..."

# /etc/dms/tls is the traefik-certs-dumper bind used by SSL_TYPE=manual only;
# letsencrypt/self-signed certs are managed by docker-mailserver itself, and
# waiting here outlasted the healthcheck (container killed as unhealthy).
{% if (skmail.SSL_TYPE | default('letsencrypt')) == 'manual' %}
# Wait for SSL certificates to be available (with timeout)
CERT_WAIT_MAX=300  # 5 minutes
CERT_WAIT_INTERVAL=10  # Check every 10 seconds
CERT_WAIT_ELAPSED=0

echo "Checking for SSL certificates at /etc/dms/tls/..."

while [ $CERT_WAIT_ELAPSED -lt $CERT_WAIT_MAX ]; do
    if [ -f "/etc/dms/tls/certificate.crt" ] && [ -f "/etc/dms/tls/privatekey.key" ]; then
        echo "✓ SSL certificates found at /etc/dms/tls/"
        ls -la /etc/dms/tls/
        break
    else
        echo "⏳ Waiting for SSL certificates... (${CERT_WAIT_ELAPSED}s/${CERT_WAIT_MAX}s)"
        sleep $CERT_WAIT_INTERVAL
        CERT_WAIT_ELAPSED=$((CERT_WAIT_ELAPSED + CERT_WAIT_INTERVAL))
    fi
done

if [ ! -f "/etc/dms/tls/certificate.crt" ] || [ ! -f "/etc/dms/tls/privatekey.key" ]; then
    echo "⚠ WARNING: SSL certificates not found at /etc/dms/tls/ after ${CERT_WAIT_MAX}s"
    echo "  Check that traefik-certs-dumper is running and certs are generated"
    echo "  Expected: mail.example.com or *.example.com certificate"
    echo "  Current contents:"
    ls -la /etc/dms/tls/ 2>/dev/null || echo "    (directory does not exist)"
fi
{% endif %}

# Fix ownership and permissions for amavis directory structure, only where
# they are wrong: dirs 2775 (setgid, so new dirs inherit the group), files
# 0664. This runs at every container start, inside the window the healthcheck
# waits on, and /var/lib/amavis lives on the mail-state bind mount (NFS): a
# plain chown -R / chmod over it is one SETATTR per entry at every start. The
# quarantine (virusmails) is written by amavis itself and grows without
# bound, so it is not walked.
find /var/lib/amavis/ -path /var/lib/amavis/virusmails -prune -o \( ! -user amavis -o ! -group clamav \) -exec chown -h amavis:clamav {} +
find /var/lib/amavis/ -path /var/lib/amavis/virusmails -prune -o -type d ! -perm 2775 -exec chmod 2775 {} +
find /var/lib/amavis/ -path /var/lib/amavis/virusmails -prune -o -type f ! -perm 0664 -exec chmod 0664 {} +

# Fix Postfix mailbox ownership issues
# Ensure strict_mailbox_ownership is set to no in Postfix main.cf
if [ -f /etc/postfix/main.cf ]; then
    echo "Configuring Postfix strict_mailbox_ownership=no..."
    # Add or update strict_mailbox_ownership setting
    if grep -q "^strict_mailbox_ownership" /etc/postfix/main.cf; then
        sed -i 's/^strict_mailbox_ownership.*/strict_mailbox_ownership = no/' /etc/postfix/main.cf
    else
        echo "strict_mailbox_ownership = no" >> /etc/postfix/main.cf
    fi
fi

# Fix mailbox permissions for system users
# Ensure clamav user owns its mailbox if it exists
if id clamav >/dev/null 2>&1; then
    echo "Setting up clamav mailbox permissions..."
    mkdir -p /var/mail
    touch /var/mail/clamav
    chown clamav:clamav /var/mail/clamav
    chmod 660 /var/mail/clamav
    echo "Fixed clamav mailbox permissions"
fi

# Ensure other system mailboxes have correct permissions
for user in root postfix dovecot; do
    if id "$user" >/dev/null 2>&1; then
        echo "Setting up $user mailbox permissions..."
        touch "/var/mail/$user" 2>/dev/null || true
        chown "$user:$user" "/var/mail/$user" 2>/dev/null || true
        chmod 660 "/var/mail/$user" 2>/dev/null || true
    fi
done

{% if (skmail.SSL_TYPE | default('letsencrypt')) == 'manual' %}
# Fix Dovecot SSL configuration to use actual certificate files
if [ -f /etc/dovecot/conf.d/10-ssl.conf ]; then
    echo "Updating Dovecot SSL configuration..."
    # Update SSL certificate paths to use actual files instead of symlinks
    sed -i 's|ssl_cert = </etc/dms/tls/cert|ssl_cert = </etc/dms/tls/certificate.crt|g' /etc/dovecot/conf.d/10-ssl.conf
    sed -i 's|ssl_key = </etc/dms/tls/key|ssl_key = </etc/dms/tls/privatekey.key|g' /etc/dovecot/conf.d/10-ssl.conf
    echo "Updated Dovecot SSL certificate paths"
fi
{% endif %}

{% if skmail.RELAY_HOST is defined and skmail.RELAY_HOST %}
# =============================================================================
# SMTP RELAY CONFIGURATION (Mailgun)
# =============================================================================
# Configure Postfix to relay outbound mail through Mailgun
# This is needed because residential IPs are often blocked by Gmail/Google
# The relay credentials come from the container environment (skmail.env is the
# service's env_file, rendered 0600). They are never templated into this file,
# which lives world-readable on the shared /var/data.
if [ -z "${RELAY_HOST:-}" ] || [ -z "${RELAY_USER:-}" ] || [ -z "${RELAY_PASSWORD:-}" ]; then
    echo "WARNING: RELAY_HOST, RELAY_USER or RELAY_PASSWORD not set in the container environment; skipping SMTP relay setup"
else
RELAY_HOSTPORT="[${RELAY_HOST}]:${RELAY_PORT:-587}"
echo "Configuring SMTP relay through ${RELAY_HOST}..."

# Add relay domain mapping
if [ ! -f /tmp/docker-mailserver/postfix-relaymap.cf ] || ! grep -q "@{{ skmail.DOMAIN }}" /tmp/docker-mailserver/postfix-relaymap.cf; then
    echo "@{{ skmail.DOMAIN }} ${RELAY_HOSTPORT}" >> /tmp/docker-mailserver/postfix-relaymap.cf
    echo "✓ Added relay mapping for @{{ skmail.DOMAIN }}"
fi

# Add SASL authentication credentials
if [ ! -f /tmp/docker-mailserver/postfix-sasl-password.cf ] || ! grep -q "@{{ skmail.DOMAIN }}" /tmp/docker-mailserver/postfix-sasl-password.cf; then
    (umask 077; printf '%s\n' "@{{ skmail.DOMAIN }} ${RELAY_USER}:${RELAY_PASSWORD}" "${RELAY_HOSTPORT} ${RELAY_USER}:${RELAY_PASSWORD}" >> /tmp/docker-mailserver/postfix-sasl-password.cf)
    chmod 600 /tmp/docker-mailserver/postfix-sasl-password.cf
    echo "✓ Added SASL credentials for relay"
fi
fi

# Ensure Postfix is configured for SASL authentication
if [ -f /etc/postfix/main.cf ]; then
    # Enable sender-dependent relay
    if ! grep -q "sender_dependent_relayhost_maps" /etc/postfix/main.cf; then
        postconf -e "sender_dependent_relayhost_maps = texthash:/etc/postfix/relayhost_map"
    fi
    # Enable SASL authentication
    if ! grep -q "smtp_sasl_auth_enable" /etc/postfix/main.cf; then
        postconf -e "smtp_sasl_auth_enable = yes"
        postconf -e "smtp_sasl_password_maps = texthash:/etc/postfix/sasl_passwd"
        postconf -e "smtp_sasl_security_options = noanonymous"
        postconf -e "smtp_tls_security_level = encrypt"
    fi
    echo "✓ Configured Postfix SASL for relay"
fi
{% endif %}

{% set _via_traefik = (skmail.VIA_TRAEFIK | default(false) | string | lower) in ["true", "yes", "1", "on"] %}
{% if _via_traefik %}
{% set _proxy_default_net = {'prod': '172.16.200.0/24', 'staging': '172.16.201.0/24', 'dev': '172.16.202.0/24'} %}
{% set _trusted = skmail.PROXY_TRUSTED_NETWORKS | default([_proxy_default_net.get(env, '172.16.200.0/24')], true) %}
{% set _trusted = [_trusted] if _trusted is string else _trusted %}
# =============================================================================
# PROXY PROTOCOL LISTENERS (skmail.VIA_TRAEFIK)
# =============================================================================
# Traefik's TCP routers forward 25/465/587/143/993 to the proxy-only ports
# below with a PROXY protocol v2 header, so Postfix and Dovecot see the real
# client IP (SPF, RBLs, postscreen, auth logs, Dovecot auth penalties). This
# is docker-mailserver's "separate ports for PROXY protocol" layout
# (examples/tutorials/mailserver-behind-proxy): the standard ports stay
# plain, unpublished, for clients on the overlay that speak no PROXY.
# The port map matches _proxy_ports in skmail.yml.j2.
# Idempotent: a service already in master.cf is left alone.
if [ -z "$(postconf -M 12525/inet 2>/dev/null)" ]; then
    echo "Adding Postfix PROXY protocol listeners 12525, 10587, 10465..."
    postconf -Mf smtp/inet | sed -e 's/^smtp /12525 /' >> /etc/postfix/master.cf
    postconf -Mf submission/inet | sed -e 's/^submission /10587 /' >> /etc/postfix/master.cf
    postconf -Mf submissions/inet | sed -e 's/^submissions /10465 /' >> /etc/postfix/master.cf
    # postscreen on 12525 hands accepted connections to its own smtpd pass
    # service (not the shared "smtpd" one used by port 25), so the relay
    # decision for proxied mail runs with the empty mynetworks below.
    postconf -Mf smtpd/pass | sed -e 's/^smtpd /smtpd-proxyprotocol /' >> /etc/postfix/master.cf
    postconf -P \
        12525/inet/postscreen_upstream_proxy_protocol=haproxy \
        12525/inet/syslog_name=postfix/smtpd-proxyprotocol \
        10587/inet/smtpd_upstream_proxy_protocol=haproxy \
        10587/inet/syslog_name=postfix/submission-proxyprotocol \
        10465/inet/smtpd_upstream_proxy_protocol=haproxy \
        10465/inet/syslog_name=postfix/submissions-proxyprotocol \
        12525/inet/smtpd_service_name=smtpd-proxyprotocol \
        smtpd-proxyprotocol/pass/mynetworks= \
        smtpd-proxyprotocol/pass/syslog_name=postfix/smtpd-proxyprotocol \
        10587/inet/mynetworks= \
        10465/inet/mynetworks=
    # On these listeners the client address comes from the PROXY header,
    # which anything on the Traefik overlay can write. An empty mynetworks
    # means no claimed address (127.0.0.1 included) is trusted to relay:
    # every relay on them needs SASL auth (permit_sasl_authenticated).
    # Tested on docker-mailserver 17.0.0: a PROXY v2 header claiming
    # 127.0.0.1 relayed to an outside domain (250) with only the postscreen
    # -o, and is refused (554 Relay access denied) with the pass service.
    # Two postscreen services (25 and 12525) share one cache through the
    # proxymap service instead of both locking the btree file directly.
    postconf 'postscreen_cache_map = proxy:btree:$data_directory/postscreen_cache'
fi

# Dovecot: proxy-only IMAP listeners. haproxy_trusted_networks is the
# overlay Traefik connects from (skmail.PROXY_TRUSTED_NETWORKS, default the
# framework's cloud-public-{{ env }} subnet). A conf.d file, not dovecot.cf,
# so an instance's own dovecot.cf override is never overwritten.
cat > /etc/dovecot/conf.d/95-skmail-proxy-protocol.conf <<'SKMAIL_DOVECOT_PROXY'
# Managed by skmail user-patches.sh (skmail.VIA_TRAEFIK).
haproxy_trusted_networks = {{ _trusted | join(' ') }}
service imap-login {
  inet_listener imap-proxyprotocol {
    port = 10143
    haproxy = yes
  }
  inet_listener imaps-proxyprotocol {
    port = 10993
    ssl = yes
    haproxy = yes
  }
}
SKMAIL_DOVECOT_PROXY

# The overlay Traefik connects from must never be in mynetworks: a client on
# it would relay without auth on the plain ports. PERMIT_DOCKER=container
# (skmail.env) only adds the container's own /32; this catches an override.
{% for _net in _trusted %}
if postconf -h mynetworks | grep -qF '{{ _net }}'; then
    echo "WARNING: {{ _net }} (PROXY trusted network) is in Postfix mynetworks; remove it (PERMIT_DOCKER, postfix-main.cf)"
fi
{% endfor %}

{% endif %}
# Reload Postfix configuration if running
if pgrep -x "master" >/dev/null 2>&1; then
    echo "Reloading Postfix configuration..."
    postfix reload 2>/dev/null || true
fi

# Reload Dovecot configuration if running
if pgrep -x "dovecot" >/dev/null 2>&1; then
    echo "Reloading Dovecot configuration..."
    dovecot reload 2>/dev/null || true
fi

