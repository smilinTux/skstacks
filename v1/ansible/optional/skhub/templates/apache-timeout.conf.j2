# Apache timeout configuration for Nextcloud large file uploads.
# Mounted into the Nextcloud container at
# /etc/apache2/conf-enabled/timeout-custom.conf

# Increase Timeout to 2 hours (7200s) for large chunked uploads and MOVE
# operations. Desktop clients have a ~30 minute hardcoded timeout for MOVE,
# so this only helps the server side keep up.
Timeout 7200

<IfModule mod_proxy.c>
  ProxyTimeout 7200
</IfModule>

# RequestReadTimeout for slow uploads:
# - header: time to receive complete request headers (20s initial, +40s/500B)
# - body: time to receive the request body (0 = disabled, for unlimited
#   chunked uploads that may take hours)
<IfModule mod_reqtimeout.c>
  RequestReadTimeout header=20-40,MinRate=500 body=0
</IfModule>
