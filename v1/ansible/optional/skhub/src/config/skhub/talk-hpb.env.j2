{%- if skhub.CLOUDFLARED | default(false) -%}
  {%- set _base_domain = skhub.DOMAIN -%}
{%- else -%}
  {%- set _base_domain = skhub.CLUSTERNAME ~ '.' ~ skhub.DOMAIN -%}
{%- endif -%}
# Nextcloud Talk High Performance Backend (signaling + Janus + TURN/STUN).
# Only used when skhub.enable_talk_hpb is true (it needs a real, publicly
# resolvable hostname + TLS certificate, and UDP/TCP 3478 reachable from the
# internet, for calls to work).

NC_DOMAIN=skhub{% if env == 'staging' %}-staging{% elif env == 'dev' %}-dev{% endif %}.{{ _base_domain }}
TALK_HOST=skhub{% if env == 'staging' %}-staging{% elif env == 'dev' %}-dev{% endif %}.{{ _base_domain }}
TALK_PORT=3478

# Generate each with: openssl rand -base64 32
TURN_SECRET={{ skhub.turn_secret }}
SIGNALING_SECRET={{ skhub.signaling_secret }}
INTERNAL_SECRET={{ skhub.internal_secret }}

TZ={{ skhub.TALK_HPB_TZ | default(skhub.TZ | default('UTC')) }}
{% if (skhub.TALK_TURN_RELAY_MIN_PORT | default('') | string | length) > 0 %}

# Bounded TURN relay port range (published udp in host mode on the talk-hpb
# node). eturnal reads these when eturnal.yml sets no range, which aio-talk's
# start.sh never does.
ETURNAL_RELAY_MIN_PORT={{ skhub.TALK_TURN_RELAY_MIN_PORT }}
ETURNAL_RELAY_MAX_PORT={{ skhub.TALK_TURN_RELAY_MAX_PORT }}
{% endif %}
