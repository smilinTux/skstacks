{%- if skhub.CLOUDFLARED | default(false) -%}
  {%- set _base_domain = skhub.DOMAIN -%}
{%- else -%}
  {%- set _base_domain = skhub.CLUSTERNAME ~ '.' ~ skhub.DOMAIN -%}
{%- endif -%}
# Nextcloud Talk recording server (ffmpeg + a headless browser). Only used
# when skhub.TALK_RECORDING_ENABLED is true. See README "Talk recording and
# local AI". NC_DOMAIN/HPB_DOMAIN are the public hostname: the recording
# container calls back out to Nextcloud and the signaling server through it
# (aio-talk-recording's start.sh builds https://NC_DOMAIN and
# https://HPB_DOMAIN/standalone-signaling/).

NC_DOMAIN=skhub{% if env == 'staging' %}-staging{% elif env == 'dev' %}-dev{% endif %}.{{ _base_domain }}
HPB_DOMAIN=skhub{% if env == 'staging' %}-staging{% elif env == 'dev' %}-dev{% endif %}.{{ _base_domain }}

# RECORDING_SECRET also goes into Talk's recording_servers config (occ
# config:app:set spreed recording_servers, tasks/recording_config.yml).
# INTERNAL_SECRET is the same value talk-hpb.env uses.
RECORDING_SECRET={{ skhub.TALK_RECORDING_SECRET | default('', true) }}
INTERNAL_SECRET={{ skhub.internal_secret | default('', true) }}
