# Environment for the Nextcloud notify_push (real-time notifications) sidecar

PORT=7867
NEXTCLOUD_HOST=nextcloud
NEXTCLOUD_URL=http://nextcloud

# Nextcloud database connection (needed to read config.php)
POSTGRES_HOST=db
POSTGRES_DB={{ skhub.mysql_database | default('nextcloud') }}
POSTGRES_USER={{ skhub.mysql_user }}
POSTGRES_PASSWORD={{ skhub.mysql_password }}

# Nextcloud Redis connection
REDIS_HOST={{ app }}-{{ env }}_redis
REDIS_HOST_PORT=6379
REDIS_DBINDEX=0
