{%- if skhub.CLOUDFLARED | default(false) -%}
  {%- set _base_domain = skhub.DOMAIN -%}
{%- else -%}
  {%- set _base_domain = skhub.CLUSTERNAME ~ '.' ~ skhub.DOMAIN -%}
{%- endif -%}
# Collabora Online environment. Only used when skhub.enable_collabora is
# true (it needs a real, publicly resolvable hostname + TLS certificate for
# the WOPI handshake with Nextcloud to work).

server_name=collabora.{{ _base_domain }}

# Allowed WOPI host (the Nextcloud domain)
aliasgroup1=https://skhub{% if env == 'staging' %}-staging{% elif env == 'dev' %}-dev{% endif %}.{{ _base_domain }}:443

extra_params=--o:ssl.enable=false --o:ssl.termination=true --o:net.post_allow.host[0]=skhub{% if env == 'staging' %}-staging{% elif env == 'dev' %}-dev{% endif %}.{{ _base_domain }}
