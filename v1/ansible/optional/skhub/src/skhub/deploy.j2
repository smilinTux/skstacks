#!/bin/bash
# =============================================================================
# SKHub Deploy Script
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: SKHub (Nextcloud)
# Environment: {{ env }}
# =============================================================================
set -e

# Never force-restart a service on its FIRST install: a restart in the middle
# of first-boot init (schema migrations, initial setup) can leave it corrupt.
# record_preexisting runs before the stack deploy; only services that already
# existed then are force-updated afterwards (a redeploy still restarts them to
# pick up changed bind-mounted config files).
PREEXISTING_SERVICES=" "
record_preexisting() {
    local svc
    for svc in "$@"; do
        if docker service inspect "$svc" >/dev/null 2>&1; then
            PREEXISTING_SERVICES+="$svc "
        fi
    done
}
preexisted() {
    case "$PREEXISTING_SERVICES" in *" $1 "*) return 0 ;; esac
    echo "First install of $1: skipping forced restart (first-boot init must finish)"
    return 1
}

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

APP="skhub"
STACK_NAME="skhub{% if env == 'prod' %}-prod{% elif env == 'staging' %}-staging{% else %}-dev{% endif %}"
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi
export CLUSTERNAME DOMAIN INSTANCE APP_ENV BASE_DOMAIN

echo -e "${GREEN}Deploying ${STACK_NAME} stack (Nextcloud)...${NC}"

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

echo -e "${YELLOW}Deploying stack configuration...${NC}"
record_preexisting "${STACK_NAME}_nextcloud" "${STACK_NAME}_collabora"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 10

echo -e "${YELLOW}Forcing service updates to pull latest images...${NC}"
preexisted ${STACK_NAME}_nextcloud && docker service update --force --detach ${STACK_NAME}_nextcloud || true
{% if skhub.enable_collabora | default(false) %}
preexisted ${STACK_NAME}_collabora && docker service update --force --detach ${STACK_NAME}_collabora || true
{% endif %}

sleep 15

echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

echo -e "${YELLOW}Checking service health...${NC}"
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_nextcloud" --format "{{ '{{.Replicas}}' }}")
    [[ "$REPLICAS" == "1/1" ]] && break
    sleep 5
done
if [[ "$REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} Nextcloud is healthy and running!${NC}"
    echo -e "${GREEN}Nextcloud: https://skhub{% if env == 'staging' %}-staging{% elif env == 'dev' %}-dev{% endif %}.${BASE_DOMAIN}${NC}"
{% if skhub.enable_collabora | default(false) %}
    echo -e "${GREEN}Collabora: https://collabora.${BASE_DOMAIN}${NC}"
{% endif %}
else
    echo -e "${RED}${STACK_NAME} Nextcloud health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_nextcloud
fi

echo -e "${GREEN}Deployment complete!${NC}"
