# =============================================================================
# BookStack app environment (rendered to /var/data/config/skbook-{{ env }}/bookstack.env)
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: skbook (BookStack wiki)
# Environment: {{ env }}
# =============================================================================

# ---------------------------------------------------------------------------
# Container identity
# ---------------------------------------------------------------------------
PUID={{ skbook.PUID | default('1000') }}
PGID={{ skbook.PGID | default('1000') }}
TZ={{ skbook.TZ | default('UTC') }}

# ---------------------------------------------------------------------------
# App URL and signing key
# ---------------------------------------------------------------------------
# APP_URL: required to render correct links, uploads and the OIDC redirect.
# Defaults to this instance's own host rule (see skbook.yml.j2), override
# with skbook.APP_URL if fronted by something other than this framework's
# own Traefik router.
{% if skbook.CLOUDFLARED | default(false) %}
{% set _skbook_base_domain = skbook.DOMAIN %}
{% else %}
{% set _skbook_base_domain = skbook.CLUSTERNAME ~ '.' ~ skbook.DOMAIN %}
{% endif %}
APP_URL={{ skbook.APP_URL | default('https://skbook' + ('-staging' if env == 'staging' else '-dev' if env == 'dev' else '') + '.' + _skbook_base_domain) }}

# APP_KEY: Laravel app key (base64:...). REQUIRED, no default - generate one
# with `php artisan key:generate --show` from inside a running container on
# first install, then pin it in the vault so it never regenerates.
APP_KEY={{ skbook.APP_KEY }}

# ---------------------------------------------------------------------------
# Database (same credentials as the skbook-{{ env }}_db container; see
# skbook.env.j2 and skbook-db-backup.env.j2 - one set of vault vars, reused
# everywhere rather than duplicated under a second name)
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT={{ skbook.DB_PORT | default('3306') }}
DB_DATABASE={{ skbook.DB_DATABASE }}
DB_USER={{ skbook.DB_USER }}
DB_PASS={{ skbook.DB_PASSWORD }}

# ---------------------------------------------------------------------------
# Mail (SMTP) - optional, only rendered if skbook.MAIL_HOST is set
# ---------------------------------------------------------------------------
{% if skbook.MAIL_HOST is defined %}
MAIL_DRIVER={{ skbook.MAIL_DRIVER | default('smtp') }}
MAIL_HOST={{ skbook.MAIL_HOST }}
MAIL_PORT={{ skbook.MAIL_PORT | default('587') }}
MAIL_USERNAME={{ skbook.MAIL_USERNAME | default('') }}
MAIL_PASSWORD={{ skbook.MAIL_PASSWORD | default('') }}
MAIL_ENCRYPTION={{ skbook.MAIL_ENCRYPTION | default('tls') }}
MAIL_FROM={{ skbook.MAIL_FROM | default('bookstack@' + _skbook_base_domain) }}
{% endif %}

# ---------------------------------------------------------------------------
# SSO / OIDC - OFF by default. Set skbook.ENABLE_SSO: true and provide the
# OIDC_* vars below (no framework defaults - these are estate-specific and
# secret-shaped) to turn it on.
# ---------------------------------------------------------------------------
{% if skbook.ENABLE_SSO | default(false) | bool %}
AUTH_METHOD=oidc
OIDC_NAME={{ skbook.OIDC_NAME | default('SSO') }}
OIDC_CLIENT_ID={{ skbook.OIDC_CLIENT_ID }}
OIDC_CLIENT_SECRET={{ skbook.OIDC_CLIENT_SECRET }}
OIDC_ISSUER={{ skbook.OIDC_ISSUER }}
OIDC_ISSUER_DISCOVER={{ skbook.OIDC_ISSUER_DISCOVER | default('true') }}
{% endif %}

# ---------------------------------------------------------------------------
# Export defaults
# ---------------------------------------------------------------------------
EXPORT_PAGE_SIZE={{ skbook.EXPORT_PAGE_SIZE | default('letter') }}
