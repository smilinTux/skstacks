# =============================================================================
# skbook MariaDB environment (rendered to /var/data/config/skbook-{{ env }}/skbook.env)
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: skbook (BookStack wiki database)
# Environment: {{ env }}
# =============================================================================
# All values below are REQUIRED, estate-specific vault vars. No literal
# defaults are provided for secrets, so a missing vault key fails the
# render/deploy instead of running with a shared public value.

MYSQL_ROOT_PASSWORD={{ skbook.MYSQL_ROOT_PASSWORD }}
MYSQL_DATABASE={{ skbook.DB_DATABASE }}
MYSQL_USER={{ skbook.DB_USER }}
MYSQL_PASSWORD={{ skbook.DB_PASSWORD }}
# Run mariadb-upgrade on start when the datadir was written by an older MariaDB
# major (the official image skips it otherwise). Upstream supports in-place
# upgrades across majors and the image saves a system-tables backup first. A
# downgrade is not supported: pin skbook.MARIADB_IMAGE to keep a major.
MARIADB_AUTO_UPGRADE=1

# TZ and EXPORT_PAGE_SIZE are also read here: the live skbook-prod instance's
# MariaDB env_file carries them too (harmless for MariaDB itself), so they
# stay for exact key parity rather than only living in bookstack.env.
TZ={{ skbook.TZ | default('UTC') }}
EXPORT_PAGE_SIZE={{ skbook.EXPORT_PAGE_SIZE | default('letter') }}
