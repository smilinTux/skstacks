#!/bin/bash
# =============================================================================
# skbook Deploy Script
# =============================================================================
# Generated by Ansible - DO NOT EDIT MANUALLY
# Service: skbook (BookStack wiki + MariaDB)
# Environment: {{ env }}
# =============================================================================
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

APP="skbook"
STACK_NAME="{{ app }}-{{ env }}"
CONFIG_DIR="/var/data/config/${STACK_NAME}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi

echo -e "${CYAN}skbook - BookStack wiki (MariaDB backed)${NC}"
echo -e "${GREEN}Deploying ${STACK_NAME} stack...${NC}"

export CLUSTER_NAME DOMAIN INSTANCE APP_ENV

# =============================================================================
# Network Configuration (from vault or defaults)
# skbook-prod: 172.16.153.0/24
# skbook-staging: 172.16.221.0/24
# skbook-dev: 172.16.220.0/24
# cloud-public-prod: 172.16.200.0/24
# cloud-public-staging: 172.16.201.0/24
# cloud-public-dev: 172.16.202.0/24
# =============================================================================
declare -A NETWORKS
{% for network in app_networks | default([{'name': 'skbook-' + env, 'subnet': '172.16.153.0/24'}, {'name': 'cloud-public-' + env, 'subnet': '172.16.200.0/24'}]) %}
NETWORKS["{{ network.name }}"]="{{ network.subnet }}"
{% endfor %}

check_and_create_network() {
    local network_name="$1"
    local subnet="$2"

    echo -e "${BLUE}Checking network: ${network_name}${NC}"

    if docker network ls --format "{% raw %}{{.Name}}{% endraw %}" | grep -q "^${network_name}$"; then
        CURRENT_SUBNET=$(docker network inspect "${network_name}" --format '{% raw %}{{range .IPAM.Config}}{{.Subnet}}{{end}}{% endraw %}' 2>/dev/null | head -1)

        if [ "${CURRENT_SUBNET}" = "${subnet}" ]; then
            echo -e "${GREEN}Network ${network_name} exists with correct subnet ${subnet}${NC}"
            return 0
        else
            echo -e "${YELLOW}Network ${network_name} has subnet ${CURRENT_SUBNET}, expected ${subnet}${NC}"
            CONTAINERS=$(docker network inspect "${network_name}" --format '{% raw %}{{range .Containers}}{{.Name}} {{end}}{% endraw %}' 2>/dev/null)
            if [ -n "${CONTAINERS}" ]; then
                echo -e "${RED}Cannot update network ${network_name} - in use by: ${CONTAINERS}${NC}"
                echo -e "${YELLOW}Please stop services using this network first${NC}"
                return 1
            fi

            echo -e "${YELLOW}Recreating network ${network_name} with correct subnet...${NC}"
            docker network rm "${network_name}" 2>/dev/null || true
            sleep 2
        fi
    fi

    echo -e "${YELLOW}Creating overlay network: ${network_name} (${subnet})${NC}"
    if docker network create \
        --driver overlay \
        --attachable \
        --subnet "${subnet}" \
        "${network_name}"; then
        echo -e "${GREEN}Network ${network_name} created successfully${NC}"
        sleep 2
        return 0
    else
        echo -e "${RED}Failed to create network ${network_name}${NC}"
        return 1
    fi
}

echo -e "${CYAN}=============================================================${NC}"
echo -e "${CYAN}Network Configuration${NC}"
echo -e "${CYAN}=============================================================${NC}"

NETWORK_ERRORS=0
for network_name in "${!NETWORKS[@]}"; do
    subnet="${NETWORKS[$network_name]}"
    if ! check_and_create_network "${network_name}" "${subnet}"; then
        NETWORK_ERRORS=$((NETWORK_ERRORS + 1))
    fi
done

if [ ${NETWORK_ERRORS} -gt 0 ]; then
    echo -e "${RED}${NETWORK_ERRORS} network(s) failed to configure${NC}"
    echo -e "${YELLOW}Attempting to continue deployment anyway...${NC}"
fi

echo -e "${CYAN}=============================================================${NC}"

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

echo -e "${YELLOW}Deploying stack configuration...${NC}"
docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}"

sleep 5

echo -e "${YELLOW}Forcing service updates...${NC}"
docker service update --force --detach=false ${STACK_NAME}_bookstack || true
docker service update --force --detach=false ${STACK_NAME}_db || true
docker service update --force --detach=false ${STACK_NAME}_db-backup || true

echo -e "${YELLOW}Waiting for services to stabilize...${NC}"
sleep 10

echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

echo -e "${YELLOW}Checking service health...${NC}"
REPLICAS=$(docker service ls --filter "name=${STACK_NAME}_bookstack" --format "{% raw %}{{.Replicas}}{% endraw %}")
if [[ "$REPLICAS" == "1/1" ]]; then
    echo -e "${GREEN}${STACK_NAME} is healthy and running!${NC}"
else
    echo -e "${RED}${STACK_NAME} health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}Recent logs:${NC}"
    docker service logs --tail 20 ${STACK_NAME}_bookstack
fi

echo ""
echo -e "${GREEN}Deployment complete!${NC}"
echo -e "${CYAN}=============================================================${NC}"
echo -e "${GREEN}BookStack: https://skbook{% if env != 'prod' %}-{{ env }}{% endif %}.<cluster>.<domain>${NC}"
echo -e "${GREEN}Stack: ${STACK_NAME}${NC}"
echo -e "${CYAN}=============================================================${NC}"
echo -e "${CYAN}SK = staycuriousANDkeepsmilin${NC}"
