# Global configuration
global_defs {
    router_id {{ inventory_hostname | upper }}_SKHA
    enable_script_security
    script_user root
    enable_snmp_checker
}

{% set skha_gate = skha.vip_gate_checks | default(['traefik']) %}
{% for check in app_health_checks %}
# Health check script for {{ check.name }}{{ ' (VIP gate: failure = FAULT, the VIP leaves this node)' if check.name in skha_gate else '' }}
vrrp_script chk_{{ check.name }} {
    script "/usr/local/bin/skha_check_{{ check.name }}.sh"
    interval {{ check.interval | default(5) }}
    weight {{ check.weight | default(0 if check.name in skha_gate else -10) }}
    fall {{ check.fall | default(2) }}
    rise {{ check.rise | default(2) }}
    timeout {{ check.timeout | default(5) }}
}

{% endfor %}
{% set skha_vip_locked = (acme_master_node | default(false) | bool) and (skha.lock_vip_to_acme_master | default(false) | bool) %}
# VRRP instance for the HA VIP.
# Every manager is state BACKUP with nopreempt and tracks the health checks,
# so the VIP only ever sits on a node that passes them and moves when it stops
# passing. The ACME master (traefik.acme.master label) gets the highest
# priority, so it is PREFERRED, but it is not exempt: ACME uses the Cloudflare
# DNS-01 challenge (skfenceha), which needs no inbound traffic, so nothing depends on the
# VIP living there. A check with weight 0 is decisive: its failure puts the instance in FAULT
# and the VIP leaves at once. That is the default for the checks named in
# skha.vip_gate_checks (default [traefik]). A negative weight only lowers
# priority, and with nopreempt a lowered master KEEPS the VIP, so a
# weighted check alone never moves it.
# skha.lock_vip_to_acme_master: true restores the old lock (state MASTER,
# priority 150, no health checks), only for an estate whose ACME challenge
# needs inbound traffic to the master. It is NOT HA: the VIP cannot fail over.
vrrp_instance VI_1 {
{% if skha_vip_locked %}
    # ACME master, VIP LOCKED here (skha.lock_vip_to_acme_master): no failover
    state MASTER
    priority 150
{% else %}
    # {{ 'ACME master (preferred)' if (acme_master_node | default(false) | bool) else 'Worker' }} - backup with health checks
    state BACKUP
    priority {{ skha_priority | default(100) }}
{% endif %}
    interface {{ skha.interface | default(primary_interface) }}
    virtual_router_id {{ skha.virtual_router_id | default(51) }}
    advert_int {{ skha.advert_interval | default(1) }}
    nopreempt
    authentication {
        auth_type PASS
        auth_pass {{ skha.auth_pass }}
    }
    # Unicast (not multicast) VRRP: works reliably on cloud/VPS networks.
    unicast_src_ip {{ ansible_facts['default_ipv4']['address'] }}
    unicast_peer {
{% for peer in skha_peers | default([]) %}
        {{ peer }}
{% endfor %}
    }
{% if not skha_vip_locked %}
    # Track health check scripts on every node (only a locked ACME master
    # skips them, see above).
    track_script {
{% for check in app_health_checks %}
        chk_{{ check.name }}
{% endfor %}
    }
{% endif %}
    virtual_ipaddress {
        {{ skha.vip }}
    }
    notify_master "/usr/local/bin/skha_notify.sh master"
    notify_backup "/usr/local/bin/skha_notify.sh backup"
    notify_fault "/usr/local/bin/skha_notify.sh fault"
}
