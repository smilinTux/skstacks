# SKSec Environment Configuration
# Generated from vault variables

# Environment
APP_ENV={{ sksec.APP_ENV }}

# Domain Configuration (for service references and logging)
# Falls back to the inventory's own domain/cluster_name host vars (see the
# framework README's "Instance contract") when not overridden per-service.
DOMAIN={{ sksec.DOMAIN | default(domain) }}
CLUSTERNAME={{ sksec.CLUSTERNAME | default(cluster_name) }}

# CrowdSec Configuration
# Use Docker Swarm service name format: stack-name_service-name (e.g., sksec-prod_crowdsec:8080)
# The bouncer connects to CrowdSec LAPI using this hostname
CROWDSEC_AGENT_HOST={{ sksec.CROWDSEC_AGENT_HOST | default('sksec-' ~ sksec.APP_ENV ~ '_crowdsec:8080') }}
CROWDSEC_BOUNCER_API_KEY={{ sksec.CROWDSEC_BOUNCER_API_KEY }}
# Bouncer timeout configuration (in seconds, default is usually 5s - increase to prevent timeouts)
CROWDSEC_TIMEOUT={{ sksec.CROWDSEC_TIMEOUT | default('10') }}

# Security Settings
GID={{ sksec.GID }}

# Collections (auto-prefixed with crowdsecurity/ if no vendor specified, common aliases applied)
COLLECTIONS={% for c in sksec.COLLECTIONS.replace(',', ' ').split() %}{% set name = 'sshd' if c == 'ssh' else c %}{% if '/' not in name %}crowdsecurity/{{ name }}{% else %}{{ name }}{% endif %}{% if not loop.last %} {% endif %}{% endfor %}

# Logging Configuration
LOG_LEVEL={{ sksec.LOG_LEVEL }}
LOG_FORMAT={{ sksec.LOG_FORMAT }}

# Performance Settings
CROWDSEC_CPU_LIMIT={{ sksec.CROWDSEC_CPU_LIMIT }}
CROWDSEC_MEMORY_LIMIT={{ sksec.CROWDSEC_MEMORY_LIMIT }}
CROWDSEC_CPU_RESERVATION={{ sksec.CROWDSEC_CPU_RESERVATION }}
CROWDSEC_MEMORY_RESERVATION={{ sksec.CROWDSEC_MEMORY_RESERVATION }}

BOUNCER_CPU_LIMIT={{ sksec.BOUNCER_CPU_LIMIT }}
BOUNCER_MEMORY_LIMIT={{ sksec.BOUNCER_MEMORY_LIMIT }}
BOUNCER_CPU_RESERVATION={{ sksec.BOUNCER_CPU_RESERVATION }}
BOUNCER_MEMORY_RESERVATION={{ sksec.BOUNCER_MEMORY_RESERVATION }}

# Health Check Settings
HEALTH_CHECK_INTERVAL={{ sksec.HEALTH_CHECK_INTERVAL }}
HEALTH_CHECK_TIMEOUT={{ sksec.HEALTH_CHECK_TIMEOUT }}
HEALTH_CHECK_RETRIES={{ sksec.HEALTH_CHECK_RETRIES }}
HEALTH_CHECK_START_PERIOD={{ sksec.HEALTH_CHECK_START_PERIOD }}

# Log Rotation
LOG_MAX_SIZE={{ sksec.LOG_MAX_SIZE }}
LOG_MAX_FILES={{ sksec.LOG_MAX_FILES }}

# High Availability Mode Configuration
# Set to true if using SKFenceHA (multi-node HA), false if using SKFence (single-node)
# Default: false (assumes SKFence single-node)
# Note: Must match the Traefik service being used (skfence = false, skfenceha = true)
TRAEFIK_HA_MODE={{ sksec.TRAEFIK_HA_MODE | default(false) | bool | lower }}
