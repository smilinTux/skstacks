{%- set env_suffix = '-prod' if env == 'prod' else ('-staging' if env == 'staging' else '-dev') -%}
# Docker Compose for sksec (CrowdSec Security) - Single & Multi-Node HA Support
#
# UNIFIED CONFIGURATION: Works seamlessly for both single-node and multi-node clusters
# Traefik service auto-detection: Automatically detects skfence or skfenceha during deployment
#
# Single-Node Mode:
#   - CrowdSec runs on any manager node (handles database + log analysis)
#   - Reads Traefik logs from: /var/data/logs/{traefik_service_name}-{env}/traefik/
#   - traefik_service_name is auto-detected (skfence or skfenceha)
#
# Multi-Node HA Mode:
#   - CrowdSec pinned to ACME master node (exclusive database write access)
#   - Reads Traefik logs from: /var/data/logs/{traefik_service_name}-{env}/traefik/acme-node/ (ACME master logs)
#   - traefik_service_name is auto-detected (skfence or skfenceha)
#   - Set TRAEFIK_HA_MODE=true in vault to enable HA mode
#
# Required environment variables (see sksec.env):
#   - TRAEFIK_HA_MODE (optional, defaults to false/auto-detect)
#   - CROWDSEC_BOUNCER_API_KEY
#   - Other CrowdSec configuration variables
#
# LAPI db location (see README.md "Moving the LAPI db off NFS"):
#   - sksec.DATA_NODE (optional): pins the crowdsec service to this node
#   - sksec.CROWDSEC_DB_PATH (optional): default is the legacy NFS path;
#     a path outside /var/data is local disk and REQUIRES DATA_NODE

version: '3.8'

networks:
  sksec{{ env_suffix }}:
    external: true
  cloud-public{{ env_suffix }}:
    external: true

services:
  # CrowdSec Service - Security event analysis and threat detection
  # In HA mode: Pinned to ACME master node (exclusive database write access)
  # In single-node: Runs on any manager node
  crowdsec:
    image: {{ sksec.CROWDSEC_IMAGE | default('crowdsecurity/crowdsec:v1.6.11', true) }}
    env_file: /var/data/config/sksec{{ env_suffix }}/sksec.env
    logging:
      driver: json-file
      options:
        max-size: "{{ sksec.LOG_MAX_SIZE }}"
        max-file: "{{ sksec.LOG_MAX_FILES }}"
    volumes:
      # === NFS DATA - DIRECT BIND (NO NAMED VOLUME) ===
      # CrowdSec needs to write hub data, collections, parsers during initialization
      # acquis.yaml is copied into this directory during deployment
      # The config dir (machine creds, hub data, acquis.yaml) stays on shared
      # storage regardless of sksec.DATA_NODE: it is read-mostly and small.
      - /var/data/runtime/sksec{{ env_suffix }}/crowdsec-config:/etc/crowdsec/
      # The LAPI SQLite db is the hot path: every bouncer request reads it
      # and writes last_pull. On NFS this serializes under load and the
      # bouncer fails CLOSED (403) once a lookup passes CROWDSEC_TIMEOUT.
      # sksec.CROWDSEC_DB_PATH (+ sksec.DATA_NODE) moves it to local disk on
      # one pinned node, same pattern as sksso's DATA_NODE for postgres/redis.
      - {{ sksec.CROWDSEC_DB_PATH | default('/var/data/runtime/sksec' + env_suffix + '/crowdsec-db', true) }}:/var/lib/crowdsec/data/
      # Traefik logs (Node-aware: Mount parent directories to enable wildcard patterns)
      # CrowdSec acquis.yaml uses wildcard patterns to read from all node-specific directories
      # Uses detected traefik_service_name (skfence or skfenceha) - auto-detected during deployment
{% if (traefik_service_name | default('skfence')) == 'skfenceha' or (sksec.TRAEFIK_HA_MODE | default(false) | bool) %}
      # HA mode (skfenceha): entrypoint.sh writes <log_dir>/{worker,acme}/access-<node>.log
      # (see skfenceha logrotate.conf.j2); mount the whole log dir read-only.
      - /var/data/logs/{{ traefik_service_name | default('skfence') }}{{ env_suffix }}/traefik:/var/log/traefik:ro
{% else %}
      # Single-node mode (skfence): Mount traefik log directory directly
      # skfence logs: /var/data/logs/skfence-{env}/traefik/{NODE_HOSTNAME}/access.log
      # Mounted as: /var/log/traefik/{NODE_HOSTNAME}/access.log
      - /var/data/logs/{{ traefik_service_name | default('skfence') }}{{ env_suffix }}/traefik:/var/log/traefik:ro
{% endif %}
    depends_on:
      - bouncer-traefik
    networks:
      - sksec{{ env_suffix }}
      - cloud-public{{ env_suffix }}
    deploy:
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
      restart_policy:
        condition: any
        delay: 10s
      mode: replicated
      replicas: 1
      placement:
        # In HA mode: Pin to ACME master node (exclusive database write access)
        # With sksec.DATA_NODE set: also pin to the node holding the local
        # LAPI db (a path outside /var/data is local disk; moving crowdsec
        # without its db is an empty db, same risk sksso's DATA_NODE guards
        # against for postgres/redis).
        # In single-node, no DATA_NODE: runs on any node.
{% if sksec.TRAEFIK_HA_MODE | default(false) | bool and (sksec.DATA_NODE | default("")) %}
        constraints: {{ (["node.labels.traefik.acme.master == true", "node.hostname == " + sksec.DATA_NODE]) | tojson }}
{% elif sksec.TRAEFIK_HA_MODE | default(false) | bool %}
        constraints:
          - node.labels.traefik.acme.master == true
{% elif sksec.DATA_NODE | default("") %}
        constraints:
          - node.hostname == {{ sksec.DATA_NODE }}
{% endif %}
        preferences:
          - spread: node.labels.zone
      resources:
        limits:
          cpus: '{{ sksec.CROWDSEC_CPU_LIMIT }}'
          memory: {{ sksec.CROWDSEC_MEMORY_LIMIT | default('512M') }}
        reservations:
          cpus: '{{ sksec.CROWDSEC_CPU_RESERVATION }}'
          memory: {{ sksec.CROWDSEC_MEMORY_RESERVATION | default('128M') }}
    healthcheck:
      test: ["CMD", "cscli", "metrics", "--output", "json"]
      interval: {{ sksec.HEALTH_CHECK_INTERVAL | default('30s') }}
      timeout: {{ sksec.HEALTH_CHECK_TIMEOUT | default('5s') }}
      retries: {{ sksec.HEALTH_CHECK_RETRIES | default('3') }}
      start_period: {{ sksec.HEALTH_CHECK_START_PERIOD | default('10s') }}

  bouncer-traefik:
    image: {{ sksec.BOUNCER_IMAGE | default('docker.io/fbonalair/traefik-crowdsec-bouncer:0.5.0', true) }}
    env_file: /var/data/config/sksec{{ env_suffix }}/sksec.env
    logging:
      driver: json-file
      options:
        max-size: "{{ sksec.LOG_MAX_SIZE }}"
        max-file: "{{ sksec.LOG_MAX_FILES }}"
    networks:
      - sksec{{ env_suffix }}
      - cloud-public{{ env_suffix }}
    deploy:
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
      restart_policy:
        condition: any
        delay: 10s
      mode: replicated
      replicas: {{ sksec.BOUNCER_REPLICAS | default(1, true) | int }}
      placement:
{% if (sksec.BOUNCER_REPLICAS | default(1, true) | int) > 1 %}
        # BOUNCER_REPLICAS > 1: one per node, so one node down never takes
        # every forwardAuth answer (fail-closed) with it.
        max_replicas_per_node: 1
{% endif %}
        preferences:
          - spread: node.labels.zone
      resources:
        limits:
          cpus: '{{ sksec.BOUNCER_CPU_LIMIT }}'
          memory: {{ sksec.BOUNCER_MEMORY_LIMIT | default('256M') }}
        reservations:
          cpus: '{{ sksec.BOUNCER_CPU_RESERVATION }}'
          memory: {{ sksec.BOUNCER_MEMORY_RESERVATION | default('64M') }}
{% if sksec.BOUNCER_HEALTHCHECK | default(false) | bool %}
    # The image's own HEALTHCHECK (/healthchecker), made explicit and tunable
    # (sksec.BOUNCER_HEALTH_CHECK_*): an unhealthy bouncer task is replaced.
    healthcheck:
      test: ["CMD", "/healthchecker"]
      interval: {{ sksec.BOUNCER_HEALTH_CHECK_INTERVAL | default('10s', true) }}
      timeout: {{ sksec.BOUNCER_HEALTH_CHECK_TIMEOUT | default('5s', true) }}
      retries: {{ sksec.BOUNCER_HEALTH_CHECK_RETRIES | default(3, true) }}
      start_period: {{ sksec.BOUNCER_HEALTH_CHECK_START_PERIOD | default('20s', true) }}
{% else %}
    # Note: Bouncer healthcheck disabled due to API limitations
    # Consider implementing custom health check if needed
{% endif %}

# No named volumes - all mounts are direct bind mounts
# Simpler, faster, zero-config
