# CrowdSec acquisition configuration
# Traefik v3.6.2 JSON logs - uses custom traefik-v3-logs parser for direct JSON
# Node-aware: Uses wildcard patterns to read from all node-specific log directories
# Supports both single-node and HA mode deployments
# 
# Log paths are mounted from /var/data/logs/{traefik_service_name}-{env}/traefik/ to /var/log/traefik/
# traefik_service_name is auto-detected during deployment (skfence or skfenceha)
# This configuration reads from the mounted paths inside the container
filenames:
{% if (traefik_service_name | default('skfence')) == 'skfenceha' or (sksec.TRAEFIK_HA_MODE | default(false) | bool) %}
  # HA mode (skfenceha): Read from acme-node and worker-base logs
  # ACME master logs: Always read from acme-node
  - /var/log/traefik/acme-node/node-*/traefik-access.log
  # Worker logs: worker-base/worker-*/traefik-access.log (container-specific)
  - /var/log/traefik/worker-base/worker-*/traefik-access.log
  # Worker logs: worker-base/node-*/traefik-access.log (node-specific)
  - /var/log/traefik/worker-base/node-*/traefik-access.log
  # Error logs (optional - uncomment if needed)
  #- /var/log/traefik/acme-node/node-*/traefik-error.log
  #- /var/log/traefik/worker-base/worker-*/traefik-error.log
  #- /var/log/traefik/worker-base/node-*/traefik-error.log
{% else %}
  # Single-node mode (skfence): Read from node-specific directories
  # skfence logs: /var/data/logs/skfence-{env}/traefik/{NODE_HOSTNAME}/access.log
  # Mounted as: /var/log/traefik/{NODE_HOSTNAME}/access.log
  - /var/log/traefik/*/access.log
  # Error logs (optional - uncomment if needed)
  #- /var/log/traefik/*/traefik.log
{% endif %}
labels:
  type: traefik-v3  # Maps to crowdsecurity/traefik-v3-logs parser
