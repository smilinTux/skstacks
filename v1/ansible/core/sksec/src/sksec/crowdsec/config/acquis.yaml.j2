# CrowdSec acquisition configuration (rendered by the sksec playbook).
# Traefik v3 JSON access logs, parsed by the stock crowdsecurity/traefik-logs
# parser from the crowdsecurity/traefik collection (its filter is
# evt.Parsed.program startsWith 'traefik', JSON lines included).
#
# The log dir is on the shared filesystem and every Traefik node appends to
# its own file, so the node running CrowdSec never gets an inotify event for
# another node's writes: poll instead.
filenames:
{% if (traefik_service_name | default('skfence')) == 'skfenceha' or (sksec.TRAEFIK_HA_MODE | default(false) | bool) %}
  # skfenceha: /var/data/logs/skfenceha-<env>/traefik/{worker,acme}/access-<node>.log
  - /var/log/traefik/worker/access-*.log
  - /var/log/traefik/acme/access-*.log
{% else %}
  # skfence: /var/data/logs/skfence-<env>/traefik/<node>/access.log
  - /var/log/traefik/*/access.log
{% endif %}
poll_without_inotify: true
labels:
  type: traefik
