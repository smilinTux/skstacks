# skfence Traefik container environment (loaded via compose env_file).
# This file is rendered by Ansible - do not edit manually.

DOCKER_API_VERSION=1.44
APP_ENV={{ env }}
{% if skfence.ACME_ENABLED | default(false) %}
# Cloudflare DNS-01 ACME challenge. Both are instance vars with no
# defaults; the token is a required secret (vault_skfence_cloudflare_dns_token).
CF_API_EMAIL={{ skfence.CLOUDFLARE_EMAIL }}
CF_DNS_API_TOKEN={{ skfence.CLOUDFLARE_DNS_API_TOKEN }}
{% else %}
# ACME is disabled (skfence.ACME_ENABLED is false/unset): Traefik serves its
# own default self-signed certificate instead. No Cloudflare account or
# public DNS is required in this mode.
{% endif %}
