# Logrotate configuration for skfence Traefik ACCESS log ({{ app }}-{{ env }}).
# Generated by the SKStacks deployment playbook.
#
# Traefik writes {{ log_dir }}/{{ logrotate_node }}/{access,traefik}.log
# (traefik.yml.j2 filePaths, bind-mounted at /var/log/traefik). The postrotate
# can only signal a Traefik container on THIS node: skfence is the single-node
# variant, and this file is installed on the node the playbook deploys from.
#
# ACCESS log only. Never add traefik.log (log.filePath): Traefik v3 rotates
# that one itself and does NOT reopen it on USR1, so an external rename
# strands its write fd on the rotated (then deleted) inode.
{{ log_dir }}/{{ logrotate_node }}/access.log {
    su root root
    daily
    maxsize {{ skfence.LOGROTATE_MAXSIZE | default('200M') }}
    rotate {{ retention_days }}
    dateext
    # %s: several maxsize rotations on one day never collide.
    dateformat -%Y%m%d-%s
    compress
    # USR1 is async: compress on the NEXT run so a late write never lands in a file being gzipped.
    delaycompress
    missingok
    notifempty
    create 0644 root root
    sharedscripts
    postrotate
        # Traefik is PID 1 in its container; USR1 makes it reopen its ACCESS log.
        # Only this node's Traefik container, found by Swarm service name.
        # Never restart it. No container on this node is not an error.
        for c in $(docker ps -q --filter label=com.docker.swarm.service.name={{ app }}-{{ env }}_traefik); do
            docker kill -s USR1 "$c" >/dev/null 2>&1 || true
        done
    endscript
}
