# Logrotate configuration for skfence Traefik logs.
# Generated by the SKStacks deployment playbook.
# Location: /var/data/logs/skfence-{{ env }}/traefik/*/*.log

{{ log_path }} {
    daily
    rotate {{ retention_days }}
    compress
    notifempty
    create 0644 root root
    dateext
    dateformat -%Y%m%d
    delaycompress
    maxsize 100M
    missingok
    postrotate
        # Traefik v3 reopens its log files on its own; USR1 is best-effort.
        if [ -f /var/run/traefik.pid ]; then
            kill -USR1 $(cat /var/run/traefik.pid) || true
        fi
    endscript
}
