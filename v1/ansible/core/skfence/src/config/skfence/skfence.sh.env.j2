# Shell-sourced values for the skfence deploy script.
# domain and cluster_name are supplied by the instance inventory per the
# framework contract (see v1/README.md); skfence.DOMAIN/CLUSTERNAME let an
# instance override them for this service specifically.
APP_ENV={{ env }}
CLUSTERNAME={{ skfence.CLUSTERNAME | default(cluster_name) }}
DOMAIN={{ skfence.DOMAIN | default(domain) }}
