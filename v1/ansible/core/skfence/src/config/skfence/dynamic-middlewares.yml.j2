# Traefik HTTP middlewares (dynamic/middlewares.yml).
# This file is managed by Ansible - do not edit manually.

http:
  middlewares:
{% if skfence.DASHBOARD_AUTH_HASH | default('') != '' %}
    traefikAuth:
      basicAuth:
        users:
          - '{{ skfence.DASHBOARD_AUTH_HASH }}'
        realm: "TraefikDashboard"
{% else %}
    # No dashboard credentials configured (skfence.DASHBOARD_AUTH_HASH is
    # empty): stub middleware so traefikAuth@file references never fail.
    traefikAuth:
      chain:
        middlewares: []
{% endif %}

    # Default middleware chain applied to most routers.
    default:
      chain:
        middlewares:
          - rate-limit@file
          - default-security-headers@file
          - error-pages@file
          - gzip@file

    # Dashboard-specific chain: excludes error-pages so api@internal's own
    # error responses are not intercepted.
    dashboard-chain:
      chain:
        middlewares:
          - default-security-headers@file
          - gzip@file

    rate-limit:
      rateLimit:
        average: {{ skfence.RATE_LIMIT_AVERAGE | default(100) }}
        burst: {{ skfence.RATE_LIMIT_BURST | default(50) }}
        period: 1s

    default-security-headers:
      headers:
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 63072000
        customFrameOptionsValue: "DENY"
        referrerPolicy: "strict-origin-when-cross-origin"
        permissionsPolicy: "camera=(), microphone=(), geolocation=(), payment=(), usb=(), vr=()"
        contentSecurityPolicy: "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' blob: data:; object-src 'self' data: blob:;"
        customResponseHeaders:
          X-Permitted-Cross-Domain-Policies: "none"
          X-Robots-Tag: "none"
          Server: ""

    dashboard-redirect:
      redirectRegex:
        regex: "^/dashboard$"
        replacement: "/dashboard/"
        permanent: true

    error-pages:
      errors:
        status:
          # 401 is excluded so WWW-Authenticate survives (needed by basic
          # auth / git-over-HTTP style flows behind this proxy).
          - "400"
          - "402-599"
        service: error-pages@file
        query: "/error/{status}"

    gzip:
      compress:
        includedContentTypes:
          - "text/html"
          - "text/css"
          - "text/plain"
          - "text/xml"
          - "text/javascript"
          - "application/javascript"
          - "application/json"
          - "application/xml"
          - "application/rss+xml"
          - "image/svg+xml"
        minResponseBodyBytes: 1024
