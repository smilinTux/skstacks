# Traefik static configuration file (/etc/traefik/traefik.yml)
# This file is managed by Ansible - do not edit manually.

api:
  dashboard: true
  insecure: false

# Cheap liveness probe on the metrics entrypoint (already published,
# unauthenticated, no domain/TLS needed): curl http://<host>:8082/ping
ping:
  entryPoint: metrics

# Logging configuration
# Volume mount: /var/data/logs/skfence-{{ env }}/traefik:/var/log/traefik
log:
  level: "{{ skfence.LOG_LEVEL | default('INFO') }}"
  format: json
  filePath: "/var/log/traefik/{{ NODE_HOSTNAME }}/traefik.log"

# Access log. PII scrubbing: sensitive headers and query params are redacted.
accessLog:
  format: json
  bufferingSize: 1
  filePath: "/var/log/traefik/{{ NODE_HOSTNAME }}/access.log"
  filters:
    statusCodes:
      - "200-299"
      - "400-599"
    retryAttempts: true
    minDuration: "10ms"
  fields:
    defaultMode: keep
    names:
      headers:
        defaultMode: keep
        names:
          Authorization: redact
          Cookie: redact
          Set-Cookie: redact
          X-Auth-Token: redact
          X-Access-Token: redact
          X-Api-Key: redact
      query:
        redact:
          - token
          - key
          - password
          - secret
          - api_key
          - apikey
          - access_token
          - auth_token

{% if skfence.ACME_ENABLED | default(false) %}
# Certificate Resolvers retrieve certificates from an ACME server.
# See https://doc.traefik.io/traefik/https/acme/#certificate-resolvers
# CLOUDFLARE_EMAIL and the DNS API token are instance vars (no defaults);
# the token is a required secret set in the instance vault.
certificatesResolvers:
  main:
    acme:
      email: "{{ skfence.CLOUDFLARE_EMAIL }}"
      storage: /acme/acme.json
      caServer: "https://acme-v02.api.letsencrypt.org/directory"
      dnsChallenge:
        provider: cloudflare
        disablePropagationCheck: true
        delayBeforeCheck: 90s
        resolvers:
          - "1.1.1.1:53"
          - "1.0.0.1:53"
      # HTTP-01 is disabled: DNS-01 avoids the deprecated Common-Name-in-SAN
      # issue and works for wildcard names.
      httpChallenge:
        entryPoint: ""
{% endif %}

entryPoints:
  web:
    address: ":80"
{% if skfence.TRUSTED_PROXIES | default([]) | length > 0 %}
    forwardedHeaders:
      trustedIPs:
{% for ip in skfence.TRUSTED_PROXIES %}
        - "{{ ip }}"
{% endfor %}
{% endif %}
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
{% if skfence.TRUSTED_PROXIES | default([]) | length > 0 %}
    forwardedHeaders:
      trustedIPs:
{% for ip in skfence.TRUSTED_PROXIES %}
        - "{{ ip }}"
{% endfor %}
{% endif %}
  metrics:
    address: ":8082"

global:
  checknewversion: false
  sendanonymoususage: false

providers:
  swarm:
    endpoint: "tcp://socket-proxy:2375"
    exposedByDefault: false
    network: "cloud-socket-proxy-{{ env }}"
    watch: true
  file:
    directory: "/etc/traefik/dynamic"
    watch: true

serversTransport:
  forwardingTimeouts:
    responseHeaderTimeout: 30s
    dialTimeout: 10s
    idleConnTimeout: 90s

metrics:
  prometheus:
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true
    entryPoint: metrics
