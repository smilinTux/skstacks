#!/bin/bash
set -e

APP="{{ app }}"
ENV="{{ env }}"
STACK_NAME="{{ app }}-${ENV}"
CONFIG_DIR="/var/data/config/${APP}-${ENV}"
COMPOSE_FILE="${CONFIG_DIR}/docker-compose.yml"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}Deploying ${APP} stack (Traefik)...${NC}"

if [ -f "${CONFIG_DIR}/${APP}.sh.env" ]; then
    echo -e "${YELLOW}Loading environment variables...${NC}"
    source "${CONFIG_DIR}/${APP}.sh.env"
fi

if [ ! -f "${COMPOSE_FILE}" ]; then
    echo -e "${RED}Error: Compose file not found: ${COMPOSE_FILE}${NC}"
    exit 1
fi

echo -e "${YELLOW}Deploying stack configuration...${NC}"
timeout 60 docker stack deploy \
    -c "${COMPOSE_FILE}" \
    --prune \
    --with-registry-auth \
    "${STACK_NAME}" || {
    echo -e "${YELLOW}Stack deploy timed out or had issues, but continuing...${NC}"
}

sleep 5

# Single-node fortress mode: one traefik service holds ACME + routing.
TRAEFIK_SVC="${STACK_NAME}_traefik"

echo -e "${YELLOW}Restarting Traefik with stop-first to avoid host port conflicts...${NC}"
if docker service inspect "$TRAEFIK_SVC" >/dev/null 2>&1; then
    DESIRED=$(docker service inspect --format '{{ '{{.Spec.Mode.Replicated.Replicas}}' }}' "$TRAEFIK_SVC" 2>/dev/null || echo "1")
    if [ -z "$DESIRED" ] || [ "$DESIRED" = "<no value>" ]; then DESIRED=1; fi
    docker service scale "$TRAEFIK_SVC"=0 || true
    sleep 2
    docker service scale "$TRAEFIK_SVC"="$DESIRED" || true
else
    echo "Warning: Traefik service $TRAEFIK_SVC not found, skipping restart"
fi

docker service update --force --detach=false "${STACK_NAME}_socket-proxy" || true
docker service update --force --detach=false "${STACK_NAME}_traefik-certs-dumper" || true

echo -e "${YELLOW}Waiting for services to stabilize...${NC}"
sleep 10

echo -e "${GREEN}Service Status:${NC}"
docker service ls | grep "${STACK_NAME}"

echo -e "${YELLOW}Checking service health...${NC}"
# Poll: an update that restarts the task shows 0/1 for a while.
for _ in $(seq 1 36); do
    REPLICAS=$(docker service ls --filter "name=${TRAEFIK_SVC}" --format "{{ '{{.Replicas}}' }}" 2>/dev/null || echo "0/0")
    [[ "$REPLICAS" == *"1/1"* ]] && break
    sleep 5
done
if [[ "$REPLICAS" == *"1/1"* ]]; then
    echo -e "${GREEN}${APP} is healthy and running!${NC}"
else
    echo -e "${RED}${APP} health check: ${REPLICAS}${NC}"
    echo -e "${YELLOW}Recent logs:${NC}"
    docker service logs --tail 20 "${TRAEFIK_SVC}" 2>/dev/null || echo "Could not retrieve logs for ${TRAEFIK_SVC}"
fi

echo -e "${GREEN}Deployment complete!${NC}"
echo -e "${GREEN}Traefik Dashboard: https://skfence{% if env != 'prod' %}-{{ env }}{% endif %}.{{ skfence.CLUSTERNAME | default(cluster_name) }}.{{ skfence.DOMAIN | default(domain) }}/dashboard/#/${NC}"
