# Docker Compose for skfenceha: the HA (multi-node) Traefik edge.
#
# HA mode: traefik-acme runs a single replica on the node labeled
# traefik.acme.master=true (certificate renewal only); traefik-worker runs
# in global mode on every manager (handles all routing, host-mode ports so
# the real client IP reaches Traefik directly, reads acme.json read-only).
# For a single-node instance, use skfence instead - the two are not
# interchangeable (see v1/ansible/core/skfence/README.md).
#
# CrowdSec: this stack does not run a CrowdSec agent/bouncer itself.
# skfenceha.CROWDSEC_ENABLED (default false) only wires the
# crowdsec-bouncer@file middleware reference into the default chain; a
# separate stack must publish that middleware config and hold the LAPI key.

version: '3.9'

services:

  # ACME master: certificate renewal only. Exactly one replica, pinned to
  # the labeled node, so only one instance ever performs the ACME challenge.
  traefik-acme:
    image: {{ skfenceha.TRAEFIK_IMAGE | default('traefik:v3.7.16@sha256:abb2b9c1b132b5b0be40d09c85bf8d3dab2a59fa0eb3aa955ab8be5efbb73de6', true) }}
    entrypoint: /entrypoint.sh
    environment:
      - NODE_HOSTNAME={{ '{{.Node.Hostname}}' }}
    env_file:
      - /var/data/config/{{ app }}-{{ env }}/{{ app }}.env
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
    ports:
      - target: 8080
        published: 8080
        protocol: tcp
        mode: host
    deploy:
      mode: replicated
      replicas: 1
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        monitor: 30s
        max_failure_ratio: 0.2
      rollback_config:
        parallelism: 1
        delay: 10s
        failure_action: pause
        monitor: 30s
        max_failure_ratio: 0.2
      placement:
        constraints:
          - node.role == manager
          - node.labels.traefik.acme.master == true
      restart_policy:
        condition: any
      resources:
        limits:
          cpus: '0.50'
          memory: 512M
        reservations:
          cpus: '0.10'
          memory: 128M
      labels:
        - com.skt.env={{ env }}
        - com.skt.cluster={{ skfenceha.CLUSTERNAME | default(cluster_name) }}-{{ skfenceha.DOMAIN | default(domain) }}
        - com.skt.app={{ app }}
        - com.skt.role=traefik-acme
    volumes:
      - /var/data/runtime/{{ app }}-{{ env }}/acme:/acme
      - /var/data/logs/{{ app }}-{{ env }}/traefik:/logs
      - /var/data/config/{{ app }}-{{ env }}/entrypoint.sh:/entrypoint.sh:ro
      - /var/data/config/{{ app }}-{{ env }}/dynamic_acme:/etc/traefik/dynamic:ro
      - /var/data/config/{{ app }}-{{ env }}/traefik.yml:/etc/traefik/traefik.yml:ro
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - cloud-edge-{{ env }}
      - cloud-public-{{ env }}
      - cloud-socket-proxy-{{ env }}

  # Worker: handles all routing. Global mode so every manager node runs one;
  # host-mode ports preserve the real client source IP.
  traefik-worker:
    image: {{ skfenceha.TRAEFIK_IMAGE | default('traefik:v3.7.16@sha256:abb2b9c1b132b5b0be40d09c85bf8d3dab2a59fa0eb3aa955ab8be5efbb73de6', true) }}
    entrypoint: /entrypoint.sh
    environment:
      - TRAEFIK_WORKER_MODE=true
      - NODE_HOSTNAME={{ '{{.Node.Hostname}}' }}
    env_file:
      - /var/data/config/{{ app }}-{{ env }}/{{ app }}.env
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
    ports:
      - target: 80
        published: 80
        protocol: tcp
        mode: host
      - target: 443
        published: 443
        protocol: tcp
        mode: host
      - target: 222
        published: 222
        protocol: tcp
        mode: host
      - target: 8082
        published: 8082
        protocol: tcp
        mode: host
    deploy:
      mode: global
      update_config:
        parallelism: 1
        delay: 10s
        failure_action: rollback
        monitor: 30s
        max_failure_ratio: 0.2
      rollback_config:
        parallelism: 1
        delay: 10s
        failure_action: pause
        monitor: 30s
        max_failure_ratio: 0.2
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any
      resources:
        limits:
          cpus: '{{ skfenceha.TRAEFIK_WORKER_CPUS | default("2.00", true) }}'
          memory: {{ skfenceha.TRAEFIK_WORKER_MEMORY_LIMIT | default("384M", true) }}
        reservations:
          cpus: '{{ skfenceha.TRAEFIK_WORKER_CPUS_RESERVATION | default("0.08", true) }}'
          memory: {{ skfenceha.TRAEFIK_WORKER_MEMORY_RESERVATION | default("96M", true) }}
      labels:
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        - "traefik.http.services.traefik-worker-api.loadbalancer.server.port=8080"
        - "com.skt.env={{ env }}"
        - "com.skt.cluster={{ skfenceha.CLUSTERNAME | default(cluster_name) }}-{{ skfenceha.DOMAIN | default(domain) }}"
        - "com.skt.app={{ app }}"
        - "com.skt.role=traefik-worker"
    volumes:
      - /var/data/runtime/{{ app }}-{{ env }}/acme:/acme:ro
      - /var/data/runtime/{{ app }}-{{ env }}/certs:/certs:ro
      - /var/data/logs/{{ app }}-{{ env }}/traefik:/logs
      - /var/data/config/{{ app }}-{{ env }}/entrypoint.sh:/entrypoint.sh:ro
      - /var/data/config/{{ app }}-{{ env }}/dynamic:/etc/traefik/dynamic:ro
      - /var/data/config/{{ app }}-{{ env }}/traefik-worker.yml:/etc/traefik/traefik.yml:ro
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - cloud-edge-{{ env }}
      - cloud-public-{{ env }}
      - cloud-socket-proxy-{{ env }}

  socket-proxy:
    image: tecnativa/docker-socket-proxy:v0.5.0
    deploy:
      mode: global
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: on-failure
      resources:
        limits:
          cpus: '0.25'
          memory: 128M
        reservations:
          cpus: '0.05'
          memory: 32M
    environment:
      API_VERSION: "1.44"
      CONTAINERS: 1
      SERVICES: 1
      TASKS: 1
      NODES: 1
      NETWORKS: 1
      CONFIGS: 1
      SECRETS: 1
      VOLUMES: 1
      SWARM: 1
      INFO: 1
      IMAGES: 1
      POST: 1
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      cloud-socket-proxy-{{ env }}:

  error-pages:
    # Image is built by the deploy playbook before stack deploy (Swarm
    # doesn't support a `build:` context in a stack file), on the SAME
    # node labeled traefik.acme.master=true in this same deploy run (both
    # happen in the playbook's selected_manager_group play). Placement
    # below pins it to that label too: node.role == manager alone let
    # Swarm schedule the task on a manager that never built the image,
    # which rejected it ("failed to resolve reference ... not found")
    # and rescheduled forever -- found 2026-10-03/04 (release-gate run,
    # skfenceha hung 5h+), same class NAM hit 2026-10-01.
    image: {{ app }}-{{ env }}-error-pages:latest
    deploy:
      mode: replicated
      replicas: 1
      update_config:
        parallelism: 1
        delay: 5s
        failure_action: rollback
      rollback_config:
        parallelism: 1
        delay: 5s
        failure_action: pause
      placement:
        constraints:
          - node.role == manager
          - node.labels.traefik.acme.master == true
      restart_policy:
        condition: any
      resources:
        limits:
          cpus: '0.10'
          memory: 128M
        reservations:
          cpus: '0.05'
          memory: 64M
      labels:
        - "traefik.enable=true"
        - "traefik.swarm.network=cloud-public-{{ env }}"
        - "traefik.http.services.error-pages.loadbalancer.server.port=8080"
    environment:
      - PORT=8080
      - APP_ENV={{ env }}
      - CLUSTERNAME={{ skfenceha.CLUSTERNAME | default(cluster_name) }}
      - DOMAIN={{ skfenceha.DOMAIN | default(domain) }}
    networks:
      - cloud-public-{{ env }}
      - cloud-socket-proxy-{{ env }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro

  traefik-certs-dumper:
    # Dumps the ACME master's acme.json into PEM files other services can
    # bind-mount (e.g. a mail server that needs its cert outside Traefik).
    #
    # Live-parity note (skstack01, 2026-09): prod also runs a second
    # traefik-certs-dumper-mail service dumping a separate acme-mail.json
    # into this same output dir. Left instance-only, not modeled here:
    # acme-mail.json comes from a second ACME resolver the framework does
    # not define at all (only one certresolver, "main", exists in this
    # template), and nothing on prod actually mounts that dumper's output
    # (skmail reads the shared acme.json directly, verified via
    # `docker service inspect skmail-prod_skmail`). Adding a generic
    # extra-dumper hook here without also modeling the second resolver
    # would not reproduce real parity, only a component of it, so this is
    # an instance-only addition on top of the framework rather than a
    # framework hook.
    # v2.10.0 panics ("unsupported key type: ''") on acme.json
    # written by Traefik 3.7+ (the account KeyType field was dropped);
    # fixed in v2.11.4. Pin a digest here (skfenceha.DUMPER_IMAGE) to
    # stage a tactical version ahead of or instead of a full framework
    # release, same convention as TRAEFIK_IMAGE.
    image: {{ skfenceha.DUMPER_IMAGE | default('ldez/traefik-certs-dumper:v2.11.4@sha256:a34b27edf8e5e96a215035a6bfba00d769d2638f8444a5dd6dc27299d75f43c5', true) }}
    command:
      - file
      - --version
      - v3
      - --source=/acme/acme.json
      - --watch
      - --clean
      - --domain-subdir
      - --dest=/output
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
          - node.labels.traefik.acme.master == true
      restart_policy:
        condition: any
      resources:
        limits:
          cpus: '0.10'
          memory: 64M
        reservations:
          cpus: '0.05'
          memory: 32M
    healthcheck:
      test: ["CMD", "ls", "/output"]
      interval: 30s
      timeout: 10s
      retries: 3
    volumes:
      - /var/data/runtime/{{ app }}-{{ env }}/acme:/acme:ro
      - /var/data/runtime/{{ app }}-{{ env }}/certs:/output
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - cloud-public-{{ env }}

  # Regenerates a Traefik file-provider TLS config (tls.certificates) from
  # traefik-certs-dumper's PEM output, on every manager node independently
  # (global mode, same placement as traefik-worker). Exists because
  # traefik-worker only ever reads acme.json once at container start (see
  # this role's README, "Cert reload without a restart"): a cert renewed
  # or newly issued by traefik-acme never reaches a running worker without
  # this sidecar.
  #
  # Why every node runs its own copy instead of one shared instance: the
  # dynamic config directory this writes into is shared NFS, and NFS gives
  # no change notification to a DIFFERENT node than the one that wrote the
  # file (confirmed on the NAM estate, 2026-10-24: a write on node A never
  # fired node B's inotify watch, see CHANGELOG). Running this on every
  # node turns that limitation to our advantage instead of fighting it:
  # each node's own write is always a LOCAL write as far as that SAME
  # node's own Traefik file-provider watch is concerned, and a local write
  # always fires fsnotify, backing store notwithstanding. No leader
  # election, no cross-node signaling, no raw Docker socket access (unlike
  # the socket-proxy-fronted swarm/docker providers, this sidecar talks to
  # no API at all): every node redundantly computes and -- only when the
  # result actually changes -- writes the exact same file. See
  # src/config/skfenceha/certs-watch.sh for the full mechanism and why a
  # single shared instance or Traefik's own file-provider watch (fsnotify
  # only, confirmed no polling fallback in Traefik v3.7) could not do this
  # alone.
  traefik-certs-watch:
    image: {{ skfenceha.CERTS_WATCH_IMAGE | default('busybox:1.36.1-musl@sha256:3c6ae8008e2c2eedd141725c30b20d9c36b026eb796688f88205845ef17aa213', true) }}
    entrypoint: /certs-watch.sh
    environment:
      - CERTS_DIR=/certs
      - DEST_FILE=/dynamic-out/certs-generated.yml
      - INTERVAL={{ skfenceha.CERTS_WATCH_INTERVAL_SECONDS | default(15, true) }}
    deploy:
      mode: global
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any
      resources:
        limits:
          cpus: '0.05'
          memory: 32M
        reservations:
          cpus: '0.01'
          memory: 16M
      labels:
        - traefik.enable=false
    healthcheck:
      test: ["CMD", "test", "-f", "/dynamic-out/certs-generated.yml"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    volumes:
      - /var/data/config/{{ app }}-{{ env }}/certs-watch.sh:/certs-watch.sh:ro
      - /var/data/runtime/{{ app }}-{{ env }}/certs:/certs:ro
      - /var/data/config/{{ app }}-{{ env }}/dynamic:/dynamic-out
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro

networks:
  cloud-edge-{{ env }}:
    external: true
  cloud-public-{{ env }}:
    external: true
  cloud-socket-proxy-{{ env }}:
    external: true
