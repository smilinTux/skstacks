# Logrotate configuration for skfenceha Traefik logs.
# Generated by the SKStacks deployment playbook. Covers both the ACME
# master and worker roles' hostname-specific log directories.
# Location: /var/data/logs/skfenceha-{{ env }}/traefik/*/*/*.log

{{ log_path }} {
    daily
    rotate {{ retention_days }}
    compress
    delaycompress
    notifempty
    missingok
    create 0644 root root
    dateext
    dateformat -%Y%m%d
    maxsize 100M
    sharedscripts
    postrotate
        # Traefik v3 reopens its log files on its own; USR1 is best-effort.
        if pgrep -f "traefik" > /dev/null; then
            pkill -USR1 -f "traefik" || true
        fi
    endscript
}
