# Logrotate configuration for skfenceha Traefik ACCESS logs ({{ app }}-{{ env }}).
# Generated by the SKStacks deployment playbook, one file per manager node.
#
# Traefik writes {{ log_dir }}/{worker,acme}/{access,traefik}-<node>.log
# (entrypoint.sh, <node> = Swarm's {{ '{{' }}.Node.Hostname{{ '}}' }}). The directory is shared by
# every node, so each node lists ONLY its own files: the postrotate can only
# signal the Traefik containers on this node, and rotating another node's
# log would leave that node's Traefik writing to the rotated file.
#
# ACCESS logs only. Never add traefik-<node>.log (log.filePath): Traefik v3
# rotates that one itself and does NOT reopen it on USR1, so an external
# rename strands its write fd on the rotated (then deleted) inode.
{{ log_dir }}/worker/access-{{ logrotate_node }}.log
{{ log_dir }}/acme/access-{{ logrotate_node }}.log {
    su root root
    daily
    maxsize {{ skfenceha.LOGROTATE_MAXSIZE | default('200M') }}
    rotate {{ retention_days }}
    dateext
    # %s: several maxsize rotations on one day never collide.
    dateformat -%Y%m%d-%s
    compress
    # USR1 is async: compress on the NEXT run so a late write never lands in a file being gzipped.
    delaycompress
    missingok
    notifempty
    create 0644 root root
    sharedscripts
    postrotate
        # Traefik is PID 1 in its container; USR1 makes it reopen its ACCESS log.
        # Only this node's Traefik containers, found by Swarm service name.
        # Never restart them. No container on this node is not an error.
        for c in $(docker ps -q --filter label=com.docker.swarm.service.name={{ app }}-{{ env }}_traefik-worker; docker ps -q --filter label=com.docker.swarm.service.name={{ app }}-{{ env }}_traefik-acme); do
            docker kill -s USR1 "$c" >/dev/null 2>&1 || true
        done
    endscript
}
