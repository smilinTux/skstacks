# skfenceha Traefik container environment (loaded via compose env_file).
# This file is rendered by Ansible - do not edit manually.

DOCKER_API_VERSION=1.44
APP_ENV={{ env }}
{% if skfenceha.ACME_ENABLED | default(false) %}
# Cloudflare DNS-01 ACME challenge. Both are instance vars with no
# defaults; the token is a required secret (vault_skfenceha_cloudflare_dns_token).
CF_API_EMAIL={{ skfenceha.CLOUDFLARE_EMAIL }}
CF_DNS_API_TOKEN={{ skfenceha.CLOUDFLARE_DNS_API_TOKEN }}
CF_API_TOKEN={{ skfenceha.CLOUDFLARE_DNS_API_TOKEN }}
{% else %}
# ACME is disabled (skfenceha.ACME_ENABLED is false/unset): Traefik serves
# its own default self-signed certificate instead. No Cloudflare account
# or public DNS is required in this mode.
{% endif %}

# Security settings. WHITELIST_IPS is an instance var (list, empty
# default); see dynamic-middlewares.yml.j2 for how it becomes an
# ipAllowList middleware. CrowdSec is opt-in via CROWDSEC_ENABLED and
# expects an external bouncer/LAPI already reachable as crowdsec-bouncer@file
# (e.g. deployed by a separate sksec-style stack) plus its own LAPI key.
LOG_LEVEL={{ skfenceha.LOG_LEVEL | default("INFO") }}
RATE_LIMIT_AVERAGE={{ skfenceha.RATE_LIMIT_AVERAGE | default(100) }}
RATE_LIMIT_BURST={{ skfenceha.RATE_LIMIT_BURST | default(50) }}
