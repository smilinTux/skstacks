# Shell-sourced values for the skfenceha deploy script.
# domain and cluster_name are supplied by the instance inventory per the
# framework contract (see v1/README.md); skfenceha.DOMAIN/CLUSTERNAME let an
# instance override them for this service specifically.
APP_ENV={{ env }}
CLUSTERNAME={{ skfenceha.CLUSTERNAME | default(cluster_name) }}
DOMAIN={{ skfenceha.DOMAIN | default(domain) }}
