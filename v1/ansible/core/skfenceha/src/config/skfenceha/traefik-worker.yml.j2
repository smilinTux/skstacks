# Traefik static configuration for the worker/routing role (/etc/traefik/traefik.yml
# on every node running traefik-worker). This file is managed by Ansible -
# do not edit manually.
#
# Workers handle all real traffic (mode: global, host-mode published ports,
# so the client's real source IP reaches Traefik directly). They read the
# ACME master's acme.json read-only (see traefik.yml.j2) and never perform a
# certificate challenge themselves. log:/accessLog: file paths are injected
# per-node at container start by entrypoint.sh.
{% set _default_access_log_headers = {'defaultMode': 'keep', 'names': {'Authorization': 'redact', 'Cookie': 'redact', 'Set-Cookie': 'redact', 'X-Api-Key': 'redact', 'Proxy-Authorization': 'redact'}} %}
{% set access_log_headers = skfenceha.ACCESS_LOG_HEADERS | default(_default_access_log_headers) %}

# Access-log header redaction (skfenceha.ACCESS_LOG_HEADERS instance var,
# {defaultMode: keep|drop|redact, names: {<Header>: keep|drop|redact, ...}}).
# Unset, the framework default below redacts common credential-bearing
# headers - a safe improvement over Traefik's own built-in default (see
# CHANGELOG). The accessLog: key must stay present (even with no fields:)
# so entrypoint.sh injects this node's filePath into it rather than
# appending a second, bare accessLog: block.
{% if skfenceha.WORKER_LOG is defined and skfenceha.WORKER_LOG is mapping %}
{# skfenceha.WORKER_LOG instance var (map, e.g. {level: INFO, format: json}),
   rendered block-style so entrypoint.sh can inject filePath under a bare
   `log:` line and replace `level:` in place with LOG_LEVEL. Unset: no log:
   block here; entrypoint.sh appends one. #}
log:
{% for _log_name, _log_value in skfenceha.WORKER_LOG.items() %}
  {{ _log_name }}: {{ _log_value | tojson }}
{% endfor %}

{% endif %}
accessLog:
  format: json
{% if skfenceha.ACCESS_LOG_FILTERS is defined and skfenceha.ACCESS_LOG_FILTERS is mapping %}
  # skfenceha.ACCESS_LOG_FILTERS instance var (map, rendered verbatim).
  filters: {{ skfenceha.ACCESS_LOG_FILTERS | tojson }}
{% endif %}
{% if skfenceha.ACCESS_LOG_FIELDS is defined and skfenceha.ACCESS_LOG_FIELDS is mapping %}
  # skfenceha.ACCESS_LOG_FIELDS instance var (map) replaces the whole
  # fields: block, ACCESS_LOG_HEADERS included.
  fields: {{ skfenceha.ACCESS_LOG_FIELDS | tojson }}
{% else %}
  fields:
    headers:
      defaultMode: {{ access_log_headers.defaultMode | default('keep') }}
{% if access_log_headers.names | default({}) %}
      names:
{% for _header_name, _header_mode in access_log_headers.names.items() %}
        {{ _header_name }}: {{ _header_mode }}
{% endfor %}
{% endif %}
{% endif %}

api:
  dashboard: true
  insecure: false

certificatesResolvers:
  main:
    acme:
      storage: /acme/acme.json

entryPoints:
  web:
    address: ":80"
{% if skfenceha.TRUSTED_PROXIES | default([]) | length > 0 %}
    forwardedHeaders:
      trustedIPs:
{% for ip in skfenceha.TRUSTED_PROXIES %}
        - "{{ ip }}"
{% endfor %}
{% endif %}
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
      # Traefik v3.7 added per-entrypoint control over encoded characters
      # in the request path (RFC 3986); explicit here (matching the
      # documented default, so this is not a behavior change) rather than
      # left implicit, since it silences the startup warning and is a
      # production-breaking footgun if a later Traefik release ever
      # changes the implicit default: Forgejo API/web branch paths and
      # compare URLs use %2F for slashes in branch names, and Nextcloud
      # WebDAV file names can contain %2F, %25, %3F or %23. Proven live in
      # the v2.26.16 Traefik lab proof (Forgejo branch-with-slash API GET,
      # Nextcloud WebDAV PUT+GET of a %2F/%25/%3F/%23 file name).
      encodedCharacters:
        allowEncodedSlash: true
        allowEncodedBackSlash: true
        allowEncodedNullCharacter: true
        allowEncodedSemicolon: true
        allowEncodedPercent: true
        allowEncodedQuestionMark: true
        allowEncodedHash: true
  websecure:
    address: ":443"
{% if skfenceha.TRUSTED_PROXIES | default([]) | length > 0 %}
    forwardedHeaders:
      trustedIPs:
{% for ip in skfenceha.TRUSTED_PROXIES %}
        - "{{ ip }}"
{% endfor %}
{% endif %}
    http:
      encodedCharacters:
        allowEncodedSlash: true
        allowEncodedBackSlash: true
        allowEncodedNullCharacter: true
        allowEncodedSemicolon: true
        allowEncodedPercent: true
        allowEncodedQuestionMark: true
        allowEncodedHash: true
{% if skfenceha.DROP_FORWARDED_HEADERS | default([]) | length > 0 %}
      # skfenceha.DROP_FORWARDED_HEADERS instance var: removed before any
      # router sees the request (middleware in dynamic/middlewares.yml). With
      # TRUSTED_PROXIES behind a tunnel/CDN, a client-sent X-Forwarded-Host
      # would otherwise reach the apps as trusted.
      middlewares:
        - drop-forwarded-headers@file
{% endif %}
{% if skfenceha.WORKER_RESPONDING_TIMEOUTS | default({}) %}
    # skfenceha.WORKER_RESPONDING_TIMEOUTS instance var (map, rendered
    # verbatim). Long read/write timeouts keep multi-GB uploads/downloads
    # (e.g. skhub/Nextcloud chunk assembly) from being cut off. Unset: no
    # transport block (Traefik's own defaults).
    transport:
      respondingTimeouts:
{% for _timeout_name, _timeout_value in skfenceha.WORKER_RESPONDING_TIMEOUTS.items() %}
        {{ _timeout_name }}: {{ _timeout_value }}
{% endfor %}
{% endif %}
  # TCP passthrough entrypoint for git-over-SSH style services behind this
  # edge (e.g. traefik.tcp labels routing to a git service's SSH port). Port
  # 222 avoids colliding with the host's own SSH on 22.
  ssh:
    address: ":222"
  metrics:
    address: ":8082"

{% if skfenceha.WORKER_GLOBAL is defined and skfenceha.WORKER_GLOBAL is mapping %}
{# skfenceha.WORKER_GLOBAL instance var (map) replaces the defaults below;
   {} omits the global: block (Traefik's own defaults). #}
{% if skfenceha.WORKER_GLOBAL %}
global:
{% endif %}
{% for _global_name, _global_value in skfenceha.WORKER_GLOBAL.items() %}
  {{ _global_name }}: {{ _global_value | tojson }}
{% endfor %}
{% else %}
global:
  checknewversion: false
  sendanonymoususage: false
{% endif %}

providers:
  swarm:
    endpoint: "tcp://tasks.{{ app }}-{{ env }}_socket-proxy:2375"
    network: "cloud-socket-proxy-{{ env }}"
    exposedByDefault: false
    watch: true
  docker:
    # Standalone-container label discovery alongside swarm (some services
    # attach Traefik labels as plain containers, not swarm services).
    endpoint: "tcp://tasks.{{ app }}-{{ env }}_socket-proxy:2375"
    network: "cloud-socket-proxy-{{ env }}"
    exposedByDefault: false
    watch: true
  file:
    directory: "/etc/traefik/dynamic"
    watch: true

serversTransport:
  insecureSkipVerify: true
  forwardingTimeouts:
{% if skfenceha.WORKER_FORWARDING_TIMEOUTS | default({}) %}
{# skfenceha.WORKER_FORWARDING_TIMEOUTS instance var (map) replaces the
   framework defaults below entirely; no per-key merge. #}
{% for _timeout_name, _timeout_value in skfenceha.WORKER_FORWARDING_TIMEOUTS.items() %}
    {{ _timeout_name }}: {{ _timeout_value }}
{% endfor %}
{% else %}
    responseHeaderTimeout: 30s
    dialTimeout: 10s
    idleConnTimeout: 90s
{% endif %}

{% if skfenceha.WORKER_TLS is defined and skfenceha.WORKER_TLS is mapping %}
# skfenceha.WORKER_TLS instance var (map, rendered verbatim). INERT: Traefik
# ignores a top-level tls: block in static config (it silently drops unknown
# keys), so this changes nothing at runtime. Kept only as a byte-parity
# passthrough for a deploy whose static file already carries one. TLS options
# and stores belong in the dynamic tls config (dynamic-tls.yml.j2, deployed as
# tls.yml). Unset: none.
tls: {{ skfenceha.WORKER_TLS | tojson }}

{% endif %}
metrics:
  prometheus:
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true
    entryPoint: metrics
