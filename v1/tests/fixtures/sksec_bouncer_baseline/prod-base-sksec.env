# SKSec Environment Configuration
# Generated from vault variables

# Environment
APP_ENV=dev

# Domain Configuration (for service references and logging)
# Falls back to the inventory's own domain/cluster_name host vars (see the
# framework README's "Instance contract") when not overridden per-service.
DOMAIN=example.test
CLUSTERNAME=render

# CrowdSec Configuration
# Use Docker Swarm service name format: stack-name_service-name (e.g., sksec-prod_crowdsec:8080)
# The bouncer connects to CrowdSec LAPI using this hostname
CROWDSEC_AGENT_HOST=sksec-dev_crowdsec:8080
# computed_bouncer_key: the vault value if set, else the key the playbook
# generated and persisted under secret/bouncer.key.
CROWDSEC_BOUNCER_API_KEY=example-crowdsec-bouncer-api-key-not-a-secret
# CrowdSec registers bouncer 'traefik' with this key at container start
# (docker_start.sh BOUNCER_KEY_<name>); it never re-keys an existing one.
BOUNCER_KEY_traefik=example-crowdsec-bouncer-api-key-not-a-secret
# Bouncer timeout configuration (in seconds, default is usually 5s - increase to prevent timeouts)
CROWDSEC_TIMEOUT=10

# Security Settings
GID=1000

# Collections (auto-prefixed with crowdsecurity/ if no vendor specified, common aliases applied)
COLLECTIONS=crowdsecurity/traefik crowdsecurity/linux
# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Performance Settings
CROWDSEC_CPU_LIMIT=0.5
CROWDSEC_MEMORY_LIMIT=512M
CROWDSEC_CPU_RESERVATION=0.1
CROWDSEC_MEMORY_RESERVATION=128M

BOUNCER_CPU_LIMIT=0.25
BOUNCER_MEMORY_LIMIT=128M
BOUNCER_CPU_RESERVATION=0.05
BOUNCER_MEMORY_RESERVATION=32M

# Health Check Settings
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s

# Log Rotation
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# High Availability Mode Configuration
# Set to true if using SKFenceHA (multi-node HA), false if using SKFence (single-node)
# Default: false (assumes SKFence single-node)
# Note: Must match the Traefik service being used (skfence = false, skfenceha = true)
TRAEFIK_HA_MODE=false
